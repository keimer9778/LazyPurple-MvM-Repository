//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Helpers
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
local function setup_text_general()
{
	local text_entity = Entities.CreateByClassname("game_text")
	text_entity.__KeyValueFromInt("channel", 0)
	text_entity.__KeyValueFromString("color", "125 255 125")
	text_entity.__KeyValueFromString("color2", "240 110 0")
	text_entity.__KeyValueFromInt("effect", 2)
	text_entity.__KeyValueFromFloat("fadein", 0.02)
	text_entity.__KeyValueFromFloat("fxtime", 0.1)
	text_entity.__KeyValueFromInt("holdtime", 15)
	text_entity.__KeyValueFromString("message", "Upgrades")
	text_entity.__KeyValueFromInt("spawnflags", 0)
	text_entity.__KeyValueFromString("x", "-1")
	text_entity.__KeyValueFromString("y", "0.4")

	return text_entity
}

local function is_player_from_red_team(tf2_player)
{
	if (tf2_player.IsPlayer() && 2 == activator.GetTeam())
	{
		return true
	}
	else
	{
		return false
	}
}

local function display_text_message(text_message)
{
	local text = setup_text_general()

	EntFireByHandle(text, "AddOutput", "message " + text_message, 0, activator, null)
	EntFireByHandle(text, "Display", "", 0.01, activator, null)
	EntFireByHandle(text, "Kill", "", 0.02, null, null)
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Tiny mode
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
function kmlp_mvm_tiny_mode()
{
	if (is_player_from_red_team(activator))
	{
		activator.SetModelScale(0.35, 0.01)

		display_text_message("You are TINY!  Walk to the blimp nearby to return to normal.")
	}
}

function kmlp_mvm_deep_voice()
{
	if (is_player_from_red_team(activator))
	{
		activator.AddCustomAttribute("voice pitch scale", 0.5, 0)

		display_text_message("Psst.. try using voice commands.")
	}
}

function kmlp_mvm_regular_size()
{
	if (is_player_from_red_team(activator))
	{
		activator.SetModelScale(1, 0.01)
	}
}

function kmlp_mvm_fast_taunt()
{
	if (is_player_from_red_team(activator))
	{
		activator.AddCustomAttribute("gesture speed increase", 4, 0)

		display_text_message("Psst... try taunting.")
	}
}