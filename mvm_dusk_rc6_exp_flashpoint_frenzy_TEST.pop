WaveSchedule
{
	StartingCurrency 600
	RespawnWaveTime	4
	CanBotsAttackWhileInSpawnRoom No
	
//sentry busters
	Mission
	{
		Objective	DestroySentries
		Where	spawnbot_mission_sentrybuster
		BeginAtWave	1
		RunForThisManyWaves 4
		CooldownTime	30
		DesiredCount	1
		
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}
	
	Mission
	{
		Objective	Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 3
		RunForThisManyWaves 2
		InitialCooldown	30
		CooldownTime	30
		DesiredCount	2
		
		TFBot
		{
			Template	Cow_Mangler_Soldier
		}
	}
	
	Mission
	{
		Objective	Spy
		Where	spawnbot_mission_spy
		BeginAtWave 4
		RunForThisManyWaves	1
		CooldownTime	60
		InitialCooldown	30
		DesiredCount	2
		
		TFBot
			{
				Template	Fire_Spy
			}
	}

