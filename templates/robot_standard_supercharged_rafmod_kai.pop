WaveSchedule
{
	//// PRECACHES ////

	PrecacheModel "models/weapons/c_models/c_critbanner/c_critbanner.mdl"

	//// POINT TEMPLATES ////

	PointTemplates
	{

	}

	//// ROBOT TEMPLATES ////
	
	Templates
	{
		//// SOLDIER TEMPLATES ////

		// Minigiant

		T_TFBot_Soldier_Extended_Buff_Banner_Supercharged
		{
			Name "Supercharged Banner Soldier"
			Class Soldier
			ClassIcon soldier_critbuff
			Skill Expert
			Health 600
			Scale 1.4
			Attributes SpawnWithFullCharge
			WeaponRestrictions PrimaryOnly

			Item "The Buff Banner"

			CharacterAttributes
			{
				"deploy time decreased" 0.33
			}

			ItemAttributes
			{
				ItemName "TF_WEAPON_ROCKETLAUNCHER"
				"fire rate bonus" 0.6
				"faster reload rate" 0.001
			}

			ItemAttributes
			{
				ItemName "The Buff Banner"

				"increase buff duration" 9.0
				"effect cond override" 56
				"custom item model" "models/weapons/c_models/c_critbanner/c_critbanner.mdl"
			}
		}

		T_TFBot_Soldier_DiveBomber
		{
			Name "Dive-Bomber Soldier"
			Class Soldier
			ClassIcon soldier_airstrike_lite
			Skill Expert
			Health 600
			Scale 1.4
			Attributes SuppressFire
			Attributes HoldFireUntilFullReload
			WeaponRestrictions PrimaryOnly
			
			Item "The Air Strike"
			Item "The B.A.S.E. Jumper"

			CharacterAttributes
			{
				"cancel falling damage" 1
				"self dmg push force increased" 3
				"blast dmg to self increased" 0
			}

			ItemAttributes
			{
				ItemName "The Air Strike"
				"faster reload rate" 0.5
				"clip size upgrade atomic" 4
				"projectile spread angle penalty" 2
			}

			ItemAttributes
			{
				ItemName "The B.A.S.E. Jumper"

				"parachute redeploy" 1
			}

			FireInput
			{
				Target !self
				Action $ChangeAttributes
				Param DiveBombInit
				Delay 0
				Repeats 0
				Cooldown 8
				IfSeeTarget 1
				IfLeftSpawn 1
			}

			EventChangeAttributes
			{
				DiveBombInit [$SIGSEGV]
				{
					AimOffset "0 0 -10000"

					FireWeapon
					{
						Type "Jump"
						Delay 0
						Repeats 1
						Cooldown -1
					}
					FireWeapon
					{
						Type "Primary"
						Delay 0.5
						Repeats 1
						Cooldown -1
					}
					FireInput
					{
						Target !self
						Action $ChangeAttributes
						Param DiveBomb
						Delay 1
						Repeats 1
						Cooldown -1
					}
				}
				DiveBomb [$SIGSEGV]
				{
					FireWeapon
					{
						Type "Jump"
						Delay 0
						Repeats 1
						Cooldown -1
					}
					FireWeapon
					{
						Type "Jump"
						Delay 5
						Repeats 1
						Cooldown -1
					}
					FireWeapon
					{
						Type "Primary"
						Delay 0
						Duration 7
						Repeats 1
						Cooldown -1
						IfSeeTarget 1
					}
				}
			}
		}

