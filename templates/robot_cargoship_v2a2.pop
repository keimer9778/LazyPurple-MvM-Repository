//Advice From HeRp-A-dErP-a-NErp.eXe: Give Giants a prenerf Jungle Inferno airblast resist. Jungle Inferno broke airblast resist on giants so this is what you would give Giant bots now.
//Giant Scout - "airblast vulnerability multiplier" 0.3
//Giant Pyro / Medic - "airblast vulnerability multiplier" 0.25
//Giant Demoman - "airblast vulnerability multiplier" 0.2
//Giant Soldier - "airblast vulnerability multiplier" 0.15
//Giant Heavy - "airblast vulnerability multiplier" 0.1
//All giants also come with "airblast vertical vulnerability multiplier"	0.5
//For bosses, I reccomend giving them absolutely 100% immunity to airblast, which would be like this.
//"airblast vulnerability multiplier" 0.001
//"airblast vertical vulnerability multiplier"	0.001
//I would also give Sentry Busters 100% airblast immunity as well because Pyros can get really annoying with airblast. 
//They've gotten especially airblast happy when JI broke Giant airblast resist.

//-----Custom ClassIcons-----//
// MvM Class Icons: scout_milk, soldier_equalizer, soldier_disciplinary, pyro_axtinguisher, demo_caber, heavy_dwarf, medic_syringe, medic_kritz
// Potato's Assorted Definitive MvM Icons: pyro_dragon_fury_swordstone

WaveSchedule {
	Templates {
		//-----Scouts-----//
		T_TFGateBot_DSL_Scout_Giant_PocketPistol {
			Name "Giant Pocket Pistol Scout"
			Class Scout
			Health 1600
			ClassIcon scout_giant
			
			EventChangeAttributes {
				Default {
					Skill Hard
					Attributes IgnoreFlag
					Attributes MiniBoss
					BehaviorModifiers Push
					Tag bot_gatebot
					Tag bot_giant
					CharacterAttributes {
						"airblast vertical vulnerability multiplier" 0.5
						"airblast vulnerability multiplier" 0.3
						"damage force reduction" 0.7
						"override footstep sound set" 5
					} // End CharacterAttributes
					
					WeaponRestrictions SecondaryOnly
					Item "Pretty Boy's Pocket Pistol"
