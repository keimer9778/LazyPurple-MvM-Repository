		T_TFBot_Scout_Bat_Signal
		{
			Class Scout
			ClassIcon scout_bat_nys_signal
			Health 125
			Name "Signal Bat Scout"
			Skill Easy
			WeaponRestrictions MeleeOnly
			Item "Lo-Fi Longwave"
			MaxVisionRange 1200

			AddCond [$SIGSEGV]	//Adds conditions to bots
			{
				Name TF_COND_MVM_BOT_STUN_RADIOWAVE	// Condition to apply. List of available conditions https://wiki.teamfortress.com/wiki/Cheats#addcond
				//Index 43 //Condition index can be used instead
				Delay 0	// Delay before the condition activates (Default: 0)
				Duration 0.5	// Duration of the condition effect (Default: -1 - infinite duration)
				IfHealthBelow 50	//When set, the task activates only when the bot health is below specified value
				//IfHealthAbove 0 //When set, the task activates only when the bot health is above specified value
			}

			AddCond [$SIGSEGV]	//Adds conditions to bots
			{
				Name TF_COND_DEFENSEBUFF_NO_CRIT_BLOCK	// Condition to apply. List of available conditions https://wiki.teamfortress.com/wiki/Cheats#addcond
				//Index 43 //Condition index can be used instead
				Delay 0	// Delay before the condition activates (Default: 0)
				Duration 6	// Duration of the condition effect (Default: -1 - infinite duration)
				IfHealthBelow 50	//When set, the task activates only when the bot health is below specified value
				//IfHealthAbove 0 //When set, the task activates only when the bot health is above specified value
			}

			ChangeAttributes [$SIGSEGV]
			{
				Delay 0
				Cooldown 40
				Repeats 1
				IfSeeTarget 0
				Name Normal
			}

			ChangeAttributes [$SIGSEGV]
			{
				Delay 0
				Cooldown 40
				Repeats 1
				IfSeeTarget 0
				IfHealthBelow 50
				Name Reboot
			}

			EventChangeAttributes
			{
				Reboot
				{
					CharacterAttributes
					{
						"dmg taken increased" 0.5
						"move speed bonus" 1.2
					}
				}

				Normal
				{
					CharacterAttributes
					{
						"dmg taken increased" 1
						"move speed bonus" 1
					}
				}
			}
		}

