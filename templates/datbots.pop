		T_TFBot_Giant_Scout_Fast_Signal
		{
			Class Scout
			Name "Super Signal Scout"
			ClassIcon scout_fast_signal_giant
			Skill Easy
			Item "Bonk Boy"
			Item "The Holy Mackerel"
			Item "Lo-Fi Longwave"
			Health 1200
			WeaponRestrictions MeleeOnly
			Attributes MiniBoss

			CharacterAttributes
			{
				"damage force reduction" 0.7
				"airblast vulnerability multiplier" 0.7
				"override footstep sound set" 5
			}

			AddCond [$SIGSEGV]	//Adds conditions to bots
			{
				Name TF_COND_MVM_BOT_STUN_RADIOWAVE	// Condition to apply. List of available conditions https://wiki.teamfortress.com/wiki/Cheats#addcond
				//Index 43 //Condition index can be used instead
				Delay 0	// Delay before the condition activates (Default: 0)
				Duration 1.25	// Duration of the condition effect (Default: -1 - infinite duration)
				IfHealthBelow 600	//When set, the task activates only when the bot health is below specified value
				//IfHealthAbove 0 //When set, the task activates only when the bot health is above specified value
			}

			AddCond [$SIGSEGV]	//Adds conditions to bots
			{
				Name TF_COND_DEFENSEBUFF_NO_CRIT_BLOCK	// Condition to apply. List of available conditions https://wiki.teamfortress.com/wiki/Cheats#addcond
				//Index 43 //Condition index can be used instead
				Delay 0	// Delay before the condition activates (Default: 0)
				Duration 2	// Duration of the condition effect (Default: -1 - infinite duration)
				IfHealthBelow 600	//When set, the task activates only when the bot health is below specified value
				//IfHealthAbove 0 //When set, the task activates only when the bot health is above specified value
			}

			ChangeAttributes [$SIGSEGV]
			{
				Delay 0
				Cooldown 40
				Repeats 1
				IfSeeTarget 0
				Name Normal
			}

			ChangeAttributes [$SIGSEGV]
			{
				Delay 0
				Cooldown 40
				Repeats 1
				IfSeeTarget 0
				IfHealthBelow 600
				Name Reboot
			}

			EventChangeAttributes
			{
				Reboot
				{
					CharacterAttributes
					{
						"dmg taken increased" 0.6
						"move speed bonus" 2
					}
				}

				Normal
				{
					CharacterAttributes
					{
						"dmg taken increased" 1
						"move speed bonus" 1.3
					}
				}
			}
		}

