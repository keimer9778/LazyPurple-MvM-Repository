        T_TFBot_Scout_Pirate //Scout w/ Three-Rune Blade
        {
            Class Scout
            Skill Easy
            Name "Swabbie"
            Item "Three-Rune Blade"
            Item "B'aaarrgh-n-Bicorne"
            Item "B'aaarrgh-n-Britches"
			WeaponRestrictions MeleeOnly
            ItemAttributes
            {
                ItemName "Three-Rune Blade"
                "hit self on miss" 0
            }
        }
        T_TFBot_Giant_Scout_Pirate //Super Scout w/ Three-Rune Blade
        {
            Class Scout
