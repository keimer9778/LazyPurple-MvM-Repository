WaveSchedule
{
	PointTemplates
	{
		//// ROCKET BARRAGE TANK ////

		CombatTankBarragePT
		{
			OnSpawnOutput
			{
				Target CombatTankIdleMode
				Action Trigger
			}
			OnSpawnOutput
			{
				Target CombatTankBarrageMode
				Action Trigger
				Delay 5
			}
			logic_relay
			{
				"targetname" "CombatTankIdleMode"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`hl1/ambience/steamburst1.wav`);EmitSoundEx({sound_name=`hl1/ambience/steamburst1.wav`,pitch = 100,filter_type=5})0-1"

				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1})0-1"

				"OnTrigger" "CombatTankBarrageMode,Trigger,,10,-1"
			}
			logic_relay
			{
				"targetname" "CombatTankBarrageMode"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"

				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_FIRE_DELAY = 0.16})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_RELOAD_DELAY = 0})0-1`"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_ROCKET_SPEED = 360})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1800})0-1"

				"OnTrigger" "CombatTankIdleMode,Trigger,,10,-1"
			}
		}
	}

	Templates
	{
		Tank_Tiny
