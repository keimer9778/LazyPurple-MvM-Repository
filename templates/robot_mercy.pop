		Pyro_Phlog
		{
			Name    "Phlog Pyro"
            Class    Pyro
            Skill    Hard
            ClassIcon pyro_phlog_v2
            WeaponRestrictions    PrimaryOnly
            Attributes SpawnWithFullCharge
            // Tag "popext_altfire{ duration = 9999 delay = 1 seendelay = 1.0}"
            Item    "The Phlogistinator"
            ItemAttributes
            {
                ItemName    "The Phlogistinator"
                "airblast disabled"    1
            }
            Taunt [$SIGSEGV]  //Taunt periodically
            {
                Delay 2 //Time before the taunt starts once the target is within range (Default: 10)
                Cooldown 1 //Time between each taunt (Default: 10)
                Repeats 1 //How many times the bot should taunt in total (Default: 0 - Infinite)
                IfSeeTarget 1 //When set to 1, this task activates only when the bot can see player (0 = Always activate)
                IfLeftSpawn 1 // When = 1, this task activates only when the bot has left the spawn
                MaxTargetRange 700 // If set, the task activates only when the target is within specified units away
            }
		}
		
