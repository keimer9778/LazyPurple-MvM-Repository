// This is a modified version of the original robot_click_gatebot.pop
// This version improves the VSC VDF extension's compatibility with this file.
// Unlike robot_click.pop, these templates are not reordered, so the templates
// have not changed in their order. All templates will have this block in their
// `Default` behavior, with additional Attributes following afterwards instead
// of being grouped together:

//	Default
//	{
//		BehaviorModifiers	Push
//		Attributes	IgnoreFlag
//		Tag bot_gatebot
//		Tag nav_prefer_gate1_flank
//	}

// This file should not be used on the map "Downtown" since it has its own
// gatebot file by Clickin.

// /!\ Notice for people creating missions for LazyPurple's MvM Servers:

// DO NOT CHANGE ANYTHING IN THIS FILE WITHOUT APPROVAL FROM THE FOLLOWING:
// * PixelBitie
// * keimer9778

// Improved file written by keimer9778

WaveSchedule
{
	Templates
	{
		// Standard GateBots
		
