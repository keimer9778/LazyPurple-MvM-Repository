		T_AtomicAscent_BombBat_Scout
		{
			Class Scout
			Name "Bomb/Bat Scout"
			Skill Normal
			ClassIcon bomb_bat_scout
			Tag bomb_bat_scout   // this hook required for our bomb script
			Health 90  // a bit more fragile than regular scouts
			WeaponRestrictions MeleeOnly
			Attributes AlwaysCrit
			CharacterAttributes
			{
				"head scale" 2
			}
			ItemAttributes
			{
				ItemName "TF_WEAPON_BAT"
				"damage penalty" 0.25
				// crits do basically normal dmg
				// we just want the crit FX so they appear dangerous up close
				// due to exploding on death
			}
		}
