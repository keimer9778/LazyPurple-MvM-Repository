WaveSchedule
{
	//// PRECACHES ////

	// Precached Models //
	PrecacheModel "models/weapons/w_models/w_rocketbullet.mdl"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"MasterWeaponsBullet"
		{
			OriginalItemName "The Cow Mangler 5000"
			
			"override projectile type" 13
			"energy weapon penetration" 1
			"dmg penalty vs players" 1.25
			"dmg bonus vs buildings" 1.5
			"projectile speed increased" 1.5
			"projectile spread angle penalty" 2
		}
		"MasterWeaponsRocket"
		{
			OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"

			"damage bonus" 1.5
			
			"mod projectile heat seek power" 360
			"mod projectile heat aim error" 360
			"mod projectile heat aim time" 1
			"mod projectile heat no predict target speed" 1
		}
	}

	//// POINT TEMPLATES ////

	//// ROBOT TEMPLATES ////

	Templates
	{
		//// SOLDIER TEMPLATES ////

		T_TFBot_Giant_Soldier_Burst_Supercharged
