		//// ENGINEER TEMPLATES ////

		T_TFBot_Giant_Engineer_MasterWeapons
		{
			Name "Giant Master-Weapons Engineer"
			Class Engineer
			ClassIcon engineer_upgraded_giant
			Skill Expert
			Health 3500
			Scale 1.5
			Attributes MiniBoss

			CharacterAttributes
			{
				"move speed penalty" 0.65
                "damage force reduction" 0.6
                "airblast vulnerability multiplier" 0.6
				"override footstep sound set" 7
				"voice pitch scale" 0
				"head scale" 0.7
				"hand scale" 1.1
			}

			ItemAttributes
			{
				ItemName "TF_WEAPON_WRENCH"

				"fire rate penalty" 1.5
				"repair rate increased" 2

				"engineer sentry build rate multiplier" 100
				"engineer teleporter build rate multiplier" 3

				"engy sentry fire rate increased" 2.76
				"sentry bullet weapon" "MasterWeaponsBullet"
				"sentry rocket weapon" "MasterWeaponsRocket"
			}

			ItemAttributes
			{
				ItemName "TF_WEAPON_PDA_ENGINEER_BUILD"

				"engy building health bonus" 3
				"building scale" 1.4
			}

			AddAttribute
			{
				Item "Player"
				Name "move speed bonus"
				Value 5
				Delay 0
				Repeats 1
				Cooldown -1
			}
			AddAttribute
			{
				Item "Player"
				Name "move speed bonus"
				Value 1
				Delay 5
				Repeats 1
				Cooldown -1
			}
		}

		//// MEDIC TEMPLATES ////

		T_TFBot_Giant_Medic_Vaccinator_Cycler
		{
			Name "Giant Vaccinator-Cycler Medic"
			Class Medic
			ClassIcon medic_vac_trio_nys_giant
			Skill Expert
			Health 4500
			Attributes MiniBoss
			Attributes IgnoreEnemies

			UseHumanAnimations 1
			
			Item "The Vaccinator"

			CharacterAttributes
			{
				"move speed penalty" 0.5
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"health regen" 40
				"mod weapon blocks healing" 1
			}

			ItemAttributes
			{
				ItemName "TF_WEAPON_SYRINGEGUN_MEDIC"
				"damage penalty" 0.1
			}

			ItemAttributes
			{
				ItemName "The Vaccinator"
				"heal rate bonus" 200
				"ubercharge rate bonus" 100
			}
			
			ChangeAttributes
            {
                Name "BulletResistStage"
                Delay 0
                Repeats 1
				IfLeftSpawn 1
            }

			FireWeapon
			{
				Type "Secondary"
				Delay 0
				Duration 1
				Repeats 0
				Cooldown 1
			}

			EventChangeAttributes
			{
				BulletResistStage [$SIGSEGV]
				{
					Attributes VaccinatorBullets

					ItemAttributes
					{
						ItemName "The Vaccinator"

						"medigun bullet resist passive" 1
						"medigun bullet resist deployed" 1
					}
					FireInput
					{
						Target !activator
						Action RunScriptCode
						Param "PrecacheSound(`weapons/vaccinator_toggle.wav`);EmitSoundEx({sound_name = `weapons/vaccinator_toggle.wav`, channel = 6, filter_type = 5, entity = self})"
						Delay 0
						Repeats 1
						Cooldown -1
					}

					ChangeAttributes
					{
						Name "BlastResistStage"
						Delay 3
						Repeats 1
					}
				}
				BlastResistStage [$SIGSEGV]
				{
					Attributes VaccinatorBlast

					ItemAttributes
					{
						ItemName "The Vaccinator"

						"medigun blast resist passive" 1
						"medigun blast resist deployed" 1
					}
					FireInput
					{
						Target !activator
						Action RunScriptCode
						Param "PrecacheSound(`weapons/vaccinator_toggle.wav`);EmitSoundEx({sound_name = `weapons/vaccinator_toggle.wav`, channel = 6, filter_type = 5, entity = self})"
						Delay 0
						Repeats 1
						Cooldown -1
					}

					ChangeAttributes
					{
						Name "FireResistStage"
						Delay 3
						Repeats 1
					}
				}
				FireResistStage [$SIGSEGV]
				{
					Attributes VaccinatorFire

					ItemAttributes
					{
						ItemName "The Vaccinator"

						"medigun fire resist passive" 1
						"medigun fire resist deployed" 1
					}
					FireInput
					{
						Target !activator
						Action RunScriptCode
						Param "PrecacheSound(`weapons/vaccinator_toggle.wav`);EmitSoundEx({sound_name = `weapons/vaccinator_toggle.wav`, channel = 6, filter_type = 5, entity = self})"
						Delay 0
						Repeats 1
						Cooldown -1
					}

					ChangeAttributes
					{
						Name "BulletResistStage"
						Delay 3
						Repeats 1
					}
				}
			}
		}

		//// SNIPER TEMPLATES ////

		T_TFBot_Giant_Sniper
		{
			Name "Giant Sniper"
			Class Sniper
			ClassIcon sniper_giant
			Skill Expert
			Health 3000
			Attributes MiniBoss
			WeaponRestrictions PrimaryOnly
            Action Sniper

			MaxVisionRange 2500

			AimTrackingInterval 0.01

			UseCustomModel "models/bots/sniper_boss/bot_sniper_boss.mdl"

			CharacterAttributes
			{
				"move speed penalty" 0.5
				"damage force reduction" 0.7
				"airblast vulnerability multiplier" 0.7
				"override footstep sound set" 5
			}

			ItemAttributes
			{
				ItemName "TF_WEAPON_SNIPERRIFLE"
				
				"damage bonus" 2.0
			}

			FireWeapon
			{
				Type "Primary"
				Delay 0
				Cooldown 2.5
				Duration 0.1
				IfSeeTarget 1
				IfLeftSpawn 1
			}

			FireInput
			{
				Target !self
				Action $AddCond
				Param 1
				Delay 0.1
				Cooldown 0.1
				IfSeeTarget 1
				IfLeftSpawn 1
			}

			FireInput
			{
				Target !self
				Action $RemoveCond
				Param 1
				Delay 2
				Cooldown 1
				IfNoTarget 1
				IfLeftSpawn 1
			}
		}
	}
}