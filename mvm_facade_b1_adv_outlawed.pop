        {
            Name "w1a"

            Where spawnbot
            TotalCount 18
            MaxActive 9
            SpawnCount 3
            WaitBeforeStarting 0
            WaitBetweenSpawns 14
        
            TotalCurrency 100
        
            TFBot
            { 
                Template T_TFBot_Scout_Sandman_FastCharge
