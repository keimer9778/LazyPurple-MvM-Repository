	#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
	StartingCurrency	1100
	RespawnWaveTime	6
	CanBotsAttackWhileInSpawnRoom no
	
	// Spawn Locations:
	// spawnbot (middle)
	// spawnbot_flank (left)
	// spawnbot_flank_short (right)
	// spawnbot_flank_hard (comes from forward upgrade)
	// spawnbot_mission_sniper
	// spawnbot_mission_engy
	// spawnbot_mission_spy
	// spawnbot_chief
	
	// Tank Path Node: StartingPathTrackNode "boss_path_0_1"
	
	Mission // spies
	{
		Where	spawnbot_mission_spy
		Objective	Spy
		InitialCooldown	18
		BeginAtWave	1
		RunForThisManyWaves	1
		CooldownTime	35
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Spy
		}
	}
	
	Mission // snipers
	{
		Where	spawnbot_mission_sniper
