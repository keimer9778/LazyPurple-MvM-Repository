	//WAVE 2 - 700 CREDITS (1500 + 100) (REMOVE MINI CRITS, REPLACE DEMO ICON (INFINITE))
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
			EntFire(`bombpath_1_relay`, `Trigger`)
				
