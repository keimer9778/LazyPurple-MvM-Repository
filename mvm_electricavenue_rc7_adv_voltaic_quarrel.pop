			"
			Delay 1
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param " 
			EntFire(`wave_start_relay`, `Trigger`)

			EntFire(`tank_hologram_disable_relay`, `Trigger`)
