//mvm_electricavenue_rc6
//mission name: Voltaic Quarrel
//mission difficulty: Advanced

//OBS: Right and Left Flanks are taken from the PLAYERS POV, not ROBOT POV
#base robot_giant.pop
#base robot_standard.pop
//////CUSTOM ICONS//////
//soldier_directhit_lite
//demo_infinite

WaveSchedule
{
	StartingCurrency 800
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 4
	AddSentryBusterWhenDamageDealtExceeds 3000
	AddSentryBusterWhenKillCountExceeds	15
	
	Templates
	{
		T_TFBot_Giant_Pyro_Flare_Spammer_Alt // Spams flare gun fire
		{
			Class Pyro
			Name "Giant Flare Pyro"
			ClassIcon pyro_flare_giant
			Skill Expert
			Health 3000
			Item "The Flare Gun"
			Item "Old Guadalajara"
			WeaponRestrictions SecondaryOnly
			Attributes MiniBoss
			ItemAttributes
			{
				ItemName "The Flare Gun"
				"fire rate bonus" 0.3
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"override footstep sound set" 6
			}
		}
		
		T_TFBot_Heavyweapons_Deflector
		{
			Class Heavyweapons
			Name "Deflector Heavy"
			ClassIcon heavy_deflector
			Skill Hard
			Item "The U-clank-a"
			Item "Deflector"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 1200
			ItemAttributes 
			{
				ItemName "Deflector"
				"attack projectiles" 1
			}
		}
		
		T_TFBot_Soldier_Crit
		{
			Class Soldier
			Name "Charged Soldier"
			ClassIcon soldier_crit
			Skill Normal
			Item "The Original"
			Attributes AlwaysCrit
			WeaponRestrictions PrimaryOnly
			ItemAttributes
			{
				ItemName "The Original"
				"faster reload rate" 0.2
				"fire rate bonus" 2
				"Projectile speed increased" 0.5
			}
		}
	}
	
	//Sentry Buster
	Mission
	{
		Objective DestroySentries
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 6
		InitialCooldown 15
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
			Tag bot_giant
		}
	}
	
	//Engi Wave 2
	Mission
	{
		Objective Engineer
		Where spawnbot
		BeginAtWave	2
		RunForThisManyWaves	1
		InitialCooldown	45
		CooldownTime 60
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_aggr
			TeleportWhere spawnbot_right
		}
	}
	
	//Spy Wave 3
	Mission
	{
		Objective Spy
		Where spawnbot
		BeginAtWave	3
		RunForThisManyWaves	1
		InitialCooldown	20
		CooldownTime 30
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Spy
			Skill Expert
		}
	}
	
	//Sniper Wave 4
	Mission
	{
		Objective Sniper
		Where spawnbot_right
		BeginAtWave	4
		RunForThisManyWaves	1
		InitialCooldown	15
		CooldownTime 30
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
			Skill Hard
		}
	}
	
	//Engi Wave 5
	Mission
	{
		Objective Engineer
		Where spawnbot
		BeginAtWave	5
		RunForThisManyWaves	1
		InitialCooldown	30
		CooldownTime 50
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_aggr
			TeleportWhere spawnbot_right
		}
	}
	
