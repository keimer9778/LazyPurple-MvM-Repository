	StartingCurrency 400
	Advanced 0
	AddSentryBusterWhenDamageDealtExceeds 4000
	AddSentryBusterWhenKillCountExceeds	20
	// EventPopFile Halloween
	Templates
	{
		boss
		{
			Class Soldier
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Name "Chief Caustic Blaster"
			ClassIcon soldier_sergeant_crits
			Health 20000
			Item "Tyrant's Helm"
			Attributes MiniBoss Tag bot_giant
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			Item "concealedkiller_rocketlauncher_woodlandwarrior"
			ItemAttributes
			{
				ItemName "concealedkiller_rocketlauncher_woodlandwarrior"
				"faster reload rate" 0.7
				"fire rate bonus" 0.3
				"clip size upgrade atomic" 6.0
				"attach particle effect" 702
				"set_item_texture_wear" 0.2
				"damage penalty" 0.5
				"bleeding duration" 1000
			}
			ItemAttributes
			{
				ItemName "Tyrant's Helm"
				"set item tint RGB" 7511618
			}
			CharacterAttributes
			{
				"move speed bonus"	0.4
				"damage force reduction" 0.0 
				"airblast vulnerability multiplier" 0.0 
				"override footstep sound set" 3
				"airblast vertical vulnerability multiplier" 0.0 // 0.0 //0.1
				"rage giving scale" 0.25
			}
		}
	}
	
