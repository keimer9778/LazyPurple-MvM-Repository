//MISSION NAME: Textile Termination
//DIFFICULTY: EXPERT

#base robot_izotope.pop

WaveSchedule
{
	Advanced 1
	StartingCurrency				400
	RespawnWaveTime					7
	CanBotsAttackWhileInSpawnRoom	No
	
	Mission // Sentry Buster
	{
		Objective DestroySentries
		InitialCooldown 96
		CooldownTime 64
		BeginAtWave 1
		RunForThisManyWaves 7
		Where spawnbot_sentrybuster
		
		TFBot
		{
			Template IT_Sentry_Buster
		}
	}
	Mission // Spy A
	{
		Objective Spy
		InitialCooldown 60
		CooldownTime 60
		BeginAtWave 2
		RunForThisManyWaves 1
		DesiredCount 4
		Where spawnbot_mission_spy
		
		TFBot
		{
			Template IT_Expert_Spy
		}
	}
	Mission // Spy B
	{
		Objective Spy
		InitialCooldown 2
		CooldownTime 60
