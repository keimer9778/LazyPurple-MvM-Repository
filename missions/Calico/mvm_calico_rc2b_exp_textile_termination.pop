		}
	}
	Mission // Spy C
	{
		Objective Spy
		InitialCooldown 20
		CooldownTime 80
		BeginAtWave 5
		RunForThisManyWaves 2
		DesiredCount 4
		Where spawnbot_mission_spy
		
