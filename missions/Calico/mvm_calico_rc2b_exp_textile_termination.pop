				ItemAttributes
				{
					ItemName "TF_WEAPON_INVIS"
					"set cloak is feign death" 1
				}
			}
		}
	}
	Mission // Engineer A
	{
		Objective Engineer
		InitialCooldown 10
		CooldownTime 30
		BeginAtWave 4
		RunForThisManyWaves 1
		DesiredCount 1
		Where spawnbot
		
		TFBot
		{
			Template IT_Expert_Engineer
			TeleportWhere spawnbot
			TeleportWhere spawnbot_upper
			TeleportWhere spawnbot_boss
		}
	}
	Mission // Engineer B
