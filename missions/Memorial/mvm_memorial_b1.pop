				}
			}
		}
		WaveSpawn
		{
			Where spawnbot
			TotalCount 20
			MaxActive 9
			SpawnCount 3
			RandomSpawn 1
			WaitBetweenSpawns 2
			WaitBeforeStarting 20
			TotalCurrency 300

			RandomChoice
			{
				TFBot
				{
					Class Soldier
					Skill Easy
				}
				TFBot
				{
					Class Scout
					BehaviorModifiers push
					Action Mobber [$SIGSEGV]
				}
				TFBot
				{
					Class Pyro
					BehaviorModifiers push
					Action Mobber [$SIGSEGV]
				}
			}
		}
	}

