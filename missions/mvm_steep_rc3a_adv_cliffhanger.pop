			Template T_TFBot_Fast_Buster
		}
		
		TFBot
		{
			Template T_TFBot_Fast_Buster
		}
		
		TFBot
		{
			Template T_TFBot_Fast_Buster
		}
		
		TFBot
		{
			Template T_TFBot_Fast_Buster_Basher
		}
		}
	}
	
