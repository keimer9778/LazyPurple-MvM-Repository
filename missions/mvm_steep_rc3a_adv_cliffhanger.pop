 ///spawns: spawnbot_high and spawnbot_low, use spawnbot for both
WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	2
	StartingCurrency 800
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 3000
	AddSentryBusterWhenKillCountExceeds	25
	Templates
	{
	
	T_TFBot_Giant_Cola_Scout
		{
			Class Scout
			Name "Giant Cola Scout"
			ClassIcon scout_cola_giant
			Skill Expert
			Health 1800
			WeaponRestrictions PrimaryOnly
			Attributes MiniBoss
			Item "Crit-a-Cola"
			CharacterAttributes
			{
				"damage force reduction" 0.5
				"airblast vulnerability multiplier" 0.5
				"override footstep sound set" 5
			}
			ItemAttributes
			{
			 ItemName "Crit-a-Cola"
			 "deploy time increased" .5
			 "effect bar recharge rate increased" 0.001
			}
		}
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 15
		Where spawnbot_mission_spy
		BeginAtWave 0
		RunForThisManyWaves 1
		CooldownTime 40
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission
	{
		Objective Sniper
		
		Where spawnbot_high
		BeginAtWave 0
		RunForThisManyWaves 1
		InitialCooldown 25
		CooldownTime 40
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission
	{
		Objective Engineer
		
		Where spawnbot_high
		BeginAtWave 0
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 60
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
		}
	}
	Mission
	{
		Objective	DestroySentries
		
		Where spawnbot
		InitialCooldown 30
		CooldownTime 30
		BeginAtWave 1
		RunForThisManyWaves 10
		
		RandomChoice
		{
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
		
		TFBot
		{
			Template T_TFBot_Surprise_Buster
		}
		
		TFBot
