#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop

WaveSchedule
{
	StartingCurrency 1000
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 8
	Advanced	1

	
	Mission //
	{
		Objective DestroySentries
		Where spawnbot_main0
		Where spawnbot_main0a
		Where spawnbot_main0b
		Where spawnbot_main1
		Where spawnbot_main1
		CooldownTime 30

		TFBot
		{
			Template T_TFBot_SentryBuster
			Tag bot_sentrybuster
		}
	}
	Mission // Sniper wave02-03
	{
		Objective Sniper

		InitialCooldown 40
		Where spawnbot_mission_sniper0
		Where spawnbot_mission_sniper0a
		Where spawnbot_mission_sniper0b
		Where spawnbot_mission_sniper1
		Where spawnbot_mission_sniper2
		BeginAtWave 2
		RunForThisManyWaves 1
		CooldownTime 85
		DesiredCount 2

		TFBot
		{
			Class Sniper
			Skill Expert
			Name Sniper
			MaxVisionRange 4000
		}
	}
	Mission // Spy wave04-05
	{
		Objective Spy

		InitialCooldown 25
		Where spawnbot_upper0
		Where spawnbot_upper0a
		Where spawnbot_upper0b
		Where spawnbot_upper1
		Where spawnbot_upper2
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 40
		DesiredCount 2

		TFBot
		{
			Class Spy
			Skill Expert
			Name Spy
		}
	}
	//Wave01
	Wave
	{
		WaitWhenDone 60
		Sound "Announcer.IncomingMob"
		Checkpoint Yes

		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		InitWaveOutput
		{
			Target wave_setup
			Action Trigger
		}
		WaveSpawn // Batsaber Scout
		{
			TotalCurrency 50
			Name "w1a_batsaber"
			Where spawnbot_main0
			Where spawnbot_main0a
			Where spawnbot_main0b
			Where spawnbot_main1
			Where spawnbot_main2
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			RandomSpawn 1

			TFBot
			{
				Template T_TFBot_Giant_Scout_Batsaber
				Tag bot_giant
				Attributes AlwaysCrit
			}
		}
		WaveSpawn // Scout gatebots
		{
			TotalCurrency 50
			Name "w1a_scout_gatebots"
			Where spawnbot_main0
			Where spawnbot_main0a
			Where spawnbot_main0b
			Where spawnbot_main1
			Where spawnbot_main2
			TotalCount 24
			MaxActive 8
			SpawnCount 8
			WaitBetweenSpawns 0
			WaitBeforeStarting 0
			RandomSpawn 1

			TFBot
			{
				Template T_TFGateBot_Scout_Normal
			}
		}
		WaveSpawn // heavy bots
		{
			Name "w1b_heavy_bots"
			TotalCurrency 50
			Where spawnbot_main0
			Where spawnbot_main0a
			Where spawnbot_main0b
			Where spawnbot_main1_slow
			Where spawnbot_main2
			TotalCount 16
			MaxActive 8
			SpawnCount 1
			WaitBetweenSpawns 0
			WaitBeforeStarting 30
			RandomSpawn 1

			TFBot
			{
				Class Heavy
				Skill Normal
			}
		}		
		WaveSpawn // demo gatebots
		{
			WaitForAllSpawned "w1a_scout_gatebots"
			Name "w1b_demo_gatebots"
			TotalCurrency 50
			Where spawnbot_upper0
			Where spawnbot_upper0a
			Where spawnbot_upper0b
			Where spawnbot_upper1
			Where spawnbot_upper2
			TotalCount 24
			MaxActive 12
			SpawnCount 12
			WaitBetweenSpawns 0
			WaitBeforeStarting 0
			RandomSpawn 1

			TFBot
			{
				Template T_TFGateBot_Demoman_Normal
			}
		}		
		WaveSpawn // Giant demo gatebot with uber medics
		{
			TotalCurrency 50
			WaitForAllDead "w1b_heavy_bots"
			Name "w1c_giant_demo_gatebot"
			Where spawnbot_main0_squad
			Where spawnbot_main0a_squad
			Where spawnbot_main0b_squad
			Where spawnbot_main1
			Where spawnbot_main2
			TotalCount 3
			MaxActive 3
			SpawnCount 1
			WaitBetweenSpawns 26
			WaitBeforeStarting 8
			Randomspawn 1

			Squad
			{
				TFBot
				{
					Template T_TFGateBot_Giant_Demo_Burst
				}
				TFBot
				{
					Template T_TFBot_Medic
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Medic
					Tag bot_squad_member
				}
			}
		}		
		WaveSpawn // Scout bots
		{
			TotalCurrency 50
			Name "w3c_scout_bots"
			Where spawnbot_upper0
			Where spawnbot_upper0a
			Where spawnbot_upper0b
			Where spawnbot_upper1
			Where spawnbot_upper2
			TotalCount 16
			MaxActive 8
			SpawnCount 8
			WaitBetweenSpawns 0
			WaitBeforeStarting 0
			RandomSpawn 1

			TFBot
			{
				Class Scout
			}
		}		
		WaveSpawn // conch soldier gatebots
		{
			TotalCurrency 100
			WaitForAllDead "w1b_heavy_bots"
			Name "w1d_soldier_gatebot"
			Where spawnbot_upper0
			Where spawnbot_upper0a
			Where spawnbot_upper0b
			Where spawnbot_upper1
			Where spawnbot_upper2
			TotalCount 24
			MaxActive 12
			SpawnCount 1
			WaitBetweenSpawns 0
			WaitBeforeStarting 5
			RandomSpawn 1

			TFBot
			{
				Template T_TFGateBot_Soldier_Normal
			}
		}		
		WaveSpawn // soldier giant cluster
		{
			TotalCurrency 400
			WaitForAllDead "w1c_giant_demo_gatebot"
			Name "w1e_giant_soldier_cluster"
			Where spawnbot_main0
			Where spawnbot_main0a
			Where spawnbot_main0b
			Where spawnbot_main1
			Where spawnbot_main2
			TotalCount 21
			MaxActive 7
			SpawnCount 7
			WaitBetweenSpawns 5
			WaitBeforeStarting 5
			Randomspawn 1

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer_Reload
					ClassIcon soldier_spammer
					Tag bot_giant
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Concheror
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Battalion
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Buff_Banner
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Concheror
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Battalion
					Tag bot_squad_member
				}
				TFBot
				{
					Template T_TFBot_Soldier_Extended_Buff_Banner
					Tag bot_squad_member
				}
			}
		}
	}
