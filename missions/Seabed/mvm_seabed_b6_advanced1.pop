	Templates
	{
   		T_TFBot_Giant_Scout_Batsaber
		{
			Class scout
			Skill Expert
			Health 1200
			ClassIcon scout_jumping_g
			Name "Giant Batsaber Knight"
			WeaponRestrictions MeleeOnly
			Item "Batsaber"
			Item "The Southie Shinobi"
			Attributes MiniBoss
			Attributes AutoJump
				AutoJumpMin 5
				AutoJumpMax 5
			ItemAttributes
			{
				ItemName "Batsaber"
				"damage bonus"	2
			}
			CharacterAttributes
			{
				"increased jump height" 2
				//"move speed bonus"	1.5
				"damage force reduction" 0.7
				"airblast vulnerability multiplier" 0.7
				"override footstep sound set" 5
			}
		}
