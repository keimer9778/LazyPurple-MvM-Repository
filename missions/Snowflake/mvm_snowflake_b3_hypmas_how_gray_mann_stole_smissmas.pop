	////////////////////////////////////////////////////////////////////////////////////////
	
	Mission
	{
		Objective Engineer  

		InitialCooldown 240
		Where spawnbot
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 28
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot
			Item "Industrial Festivizer"
			Item "Face Full of Festive"
			Item "Sleuth Suit"
			Health 3000
			Name "Robots, Go Where Engi Send Thee"
			Scale 1.35
			CharacterAttributes
			{
				"engineer sentry build rate multiplier"    3
				"engineer teleporter build rate multiplier"    3
				"damage force reduction"			0.3
				"airblast vulnerability multiplier"	0.3
				"engy building health bonus" 2
			}
		}
	}
	
	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target bignet // gamerules or tf_gamerules, depending on the map
            Action RunScriptCode
            Param "
			// Skybox changing
			::LocalSkybox <- {
			Cleanup = function() {
			SetSkyboxTexture(`sky_halloween`)
			delete ::LocalSkybox
			}
			OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
			OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
			}
			__CollectGameEventCallbacks(LocalSkybox)
			SetSkyboxTexture(`sky_halloween`)
			
			"
		}
		
		WaveSpawn
		{
			Name	w4_timer_int
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			FirstSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param "
					EntFire(`item_teamflag`, `SetReturnTime`, `60`)
					EntFire(`relay`, `Trigger`)
				"
			}
		}
		
