#base robot_giant.pop
#base robot_standard.pop
#base robot_pixelbitie.pop

// This MvM smissmas special was made by: Pixelbitie
// Special thanks to Clickin for the infamous robot templates!
// This mission takes large inspiration from the 'shocking stocking' mission. Thanks to the mission creator!
// Dialogue is hugely based on Lazypurple Silly Server lore!!!

population
{
	StartingCurrency	0
	RespawnWaveTime	5
	CanBotsAttackWhileInSpawnRoom	no
	AddSentryBusterWhenDamageDealtExceeds	2500
	AddSentryBusterWhenKillCountExceeds	20
	Advanced	1
	Mission
	{
		Objective	DestroySentries
		Where	spawnbot
		BeginAtWave	1
		RunForThisManyWaves	4
		InitialCooldown	40
		CooldownTime	40
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_SentryBuster
			Health 4000
			Name "Jolly Buster"
			ItemAttributes
			{
				ItemName	"a rather festive tree"
				"head scale"	2.0
			}
			Item	"a rather festive tree"
		}
	}
	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target bignet // gamerules or tf_gamerules, depending on the map
            Action RunScriptCode
            Param "


			
			// Skybox changing
			::LocalSkybox <- {
			Cleanup = function() {
			SetSkyboxTexture(`sky_halloween`)
			delete ::LocalSkybox
			}
			OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
			OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
			}
			__CollectGameEventCallbacks(LocalSkybox)
			SetSkyboxTexture(`sky_morningsnow_01`)
			//SetSkyboxTexture(`sky_volcano_01`)
			"
		}

		WaveSpawn
		{
			Name	w1_music
			TotalCount	1
			MaxActive	1
			SpawnCount	1
