	Mission
	{
		Objective Sniper

		InitialCooldown 120
		Where spawnbot
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 25
		DesiredCount 2
		

		TFBot
		{
			Class   Soldier
			ClassIcon soldier_mangler
            Skill   Expert
            Item    "The Cow Mangler 5000"
			Name "IONIC ABSOLUTION 5000"
			MaxVisionRange 5000
			Health 2000
			Item "Dapper Noel"
			ItemAttributes
			{
				ItemName "The Cow Mangler 5000"
				"faster reload rate" 0.01
			}
			CharacterAttributes
			{
				"attach particle effect"	3139
			}
		}
	}
	
	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target bignet // gamerules or tf_gamerules, depending on the map
            Action RunScriptCode
            Param "
			// Skybox changing
			::LocalSkybox <- {
			Cleanup = function() {
			SetSkyboxTexture(`sky_halloween`)
			delete ::LocalSkybox
			}
			OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
			OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
			}
			__CollectGameEventCallbacks(LocalSkybox)
			SetSkyboxTexture(`sky_badlands_01`)
			
			"
		}
		
		WaveSpawn
		{
			Name	w3_timer_int
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			FirstSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param "
					EntFire(`item_teamflag`, `SetReturnTime`, `60`)
					EntFire(`relay`, `Trigger`)
				"
			}
		}
		
