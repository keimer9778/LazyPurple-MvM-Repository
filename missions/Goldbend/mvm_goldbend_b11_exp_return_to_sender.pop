// Ismac
#base robot_giant.pop
#base robot_standard.pop
#base ismac_robots.pop

WaveSchedule
{
    StartingCurrency                      200 
    RespawnWaveTime                       7 
    CanBotsAttackWhileInSpawnRoom         No 
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  Yes
    Advanced                              1 

    Mission
    {
        Objective           DestroySentries
        Where               spawnbot
        BeginAtWave         6
        RunForThisManyWaves 1
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }
    
    // Wave 1 Support Sniper
    Mission
    {
        Objective           Sniper 
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         1
        RunForThisManyWaves 1
        CooldownTime        30
        DesiredCount        2
    
        TFBot
        {
           Class Sniper
           Skill Hard
        }
    }
     // Wave 2 Support Spy
    Mission
    {
        Objective           Spy
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         2
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        4
    
        TFBot
        {
           Class Spy
           Skill Expert
        }
    }
     // Wave 4 Support Spy
    Mission
    {
        Objective           Spy
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         4
        RunForThisManyWaves 1
        CooldownTime        30
        DesiredCount        2
    
        TFBot
        {
           Class Spy
           Skill Expert
        }
    }
     // Wave 5 Support Spy
    Mission
    {
        Objective           Spy
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         4
        RunForThisManyWaves 1
        CooldownTime        30
        DesiredCount        2
    
        TFBot
        {
           Class Spy
           Skill Expert
        }
    }
    // Wave 1 - Currency 600
    Wave 
    {

       
        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

         WaveSpawn
        {
            Name "wave1ab"
            Where spawnbot1
            TotalCount 50
            MaxActive 10
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 0.5
            TotalCurrency 200
            TFBot
            {
               Template T_TFBot_Scout_SunStick_Fix
            }
        }
         WaveSpawn
        {
            Name "wave1b"
            Where spawnbot1
            TotalCount 30
            MaxActive 8
            SpawnCount 4
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Pyro_Flaregun
                Skill Easy
            }
        }
        WaveSpawn
        {
            Name "wave1ba"
            Where spawnbot3
            TotalCount 2
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 20
            WaitBetweenSpawns 15
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Giant_Soldier
            }
        }
        WaveSpawn
        {
            Name "wave1c"
            Where spawnbot_tank
            TotalCount 10
            MaxActive 5
            SpawnCount 5
            WaitForAllDead "wave1ba"
            WaitBeforeStarting 5
            WaitBetweenSpawns 30
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Heavyweapons_Fist
            }
        }
        WaveSpawn
        {
            Name "wave1d"
            Where spawnbot_tank
            TotalCount 12
            MaxActive 6
            SpawnCount 6
            WaitForAllDead "wave1ba"
            WaitBeforeStarting 5
            WaitBetweenSpawns 30
            TotalCurrency 200
            Squad
            {
              TFBot
              {
                Template T_TFBot_Giant_Soldier
              }
              TFBot
              {
                Template T_TFBot_Giant_Soldier
              }
              TFBot
              {
                Template T_TFBot_Medic_SlowRecharge
              }
              TFBot
              {
                Template T_TFBot_Medic_SlowRecharge
              }
              TFBot
              {
                Template T_TFBot_Medic_SlowRecharge
              }
              TFBot
              {
                Template T_TFBot_Medic_SlowRecharge
              }
            }
        }
        WaveSpawn
        {
            Name "wave1e"
            Where spawnbot
            TotalCount 200
            MaxActive 2
            SpawnCount 2
            Support Limited
            WaitBeforeStarting 15
            WaitBetweenSpawns 20
            TotalCurrency 0
            TFBot
            {
                Class Pyro
                Skill Easy
                Attributes AlwaysFireWeapon
            }
        }
       
        
    }

    // Wave 2 - 250
