WaveSchedule
{
	StartingCurrency 600
	RespawnWaveTime 7
	CanBotsAttackWhileInSpawnRoom no
	
	Mission
	{
		Objective DestroySentries
		
		InitialCooldown 5
		Where spawnbot_mission_sentrybuster
		
		BeginAtWave 1
		RunForThisManyWaves 9
		CooldownTime 35
	
		TFBot
		{
			Template T_TFBot_SentryBuster
			Tag nav_giant_roof_avoid
			Tag nav_flank_bridge_prefer
		}
	}
	
	Mission // Spy wave 2
	{
		Objective Spy
		
		InitialCooldown 15
		Where spawnbot_mission_spy
		
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 35
	
		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	Mission // Sniper wave 3
	{
		Objective Sniper

		InitialCooldown 35
		Where spawnbot3_house_flank
		BeginAtWave 4
		RunForThisManyWaves 3
		CooldownTime 35
		DesiredCount 2

		TFBot
		{
			Class Sniper
			Skill Expert
			Name Sniper
			MaxVisionRange 3000
		}
	}
	
