            Name "wave3c"
            Where spawnbot
            TotalCount 24
            MaxActive 6
            SpawnCount 2
            WaitForAllDead "wave3a"
            WaitBeforeStarting 15
            WaitBetweenSpawns 1
            TotalCurrency 100
            Squad
            {
                FormationSize 200
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                   Class Soldier
                   Skill Easy
                }
        
                TFBot
                {
                   Template T_TFBot_Medic_QuickFix
                }
            }
        }

    }

