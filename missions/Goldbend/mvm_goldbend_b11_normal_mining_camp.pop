    // Wave 3 - X 800
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        // 1 Tank 
        WaveSpawn
        {
            Name "wave3a"
            TotalCount 1
            WaitBeforeStarting 0
            TotalCurrency 400
            Tank
            {
                Name "tankboss" 
                Health 20000
                Speed 75
                StartingPathTrackNode "tank_path_long"
                OnKilledOutput
                {
                    Target boss_dead_relay
                    Action Trigger
                }
        
                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
            }
        }
        WaveSpawn
        {
            Name "wave3b" 
            Where spawnbot
            TotalCount 25
            WaitForAllDead "wave3a"
            MaxActive 10
            SpawnCount 5
            WaitBeforeStarting 0 
            WaitBetweenSpawns 10
            TotalCurrency 200 
            TFBot
            {
                Class Heavyweapons
                Skill Easy
                MaxVisionRange 1200
            }
        }
        WaveSpawn
        {
            Name "wave3b" 
            Where spawnbot3
            TotalCount 25
            WaitForAllDead "wave3a"
            MaxActive 10
            SpawnCount 5
            WaitBeforeStarting 0 
            WaitBetweenSpawns 10
            TotalCurrency 100
            TFBot
