// Ismac //
// should be titled Mining Camp on menu
// NORMAL Difficulty mission for mvm_goldbend
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
    StartingCurrency                      1200
    RespawnWaveTime                       2 
    CanBotsAttackWhileInSpawnRoom         No 
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  No 

    // Wave 1-8 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot
        BeginAtWave         1
        RunForThisManyWaves 8
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }
    // Wave 4 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot3
        BeginAtWave         4
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        1
        InitialCooldown     10
        TFBot
        {
            Template T_TFBot_Sniper
        }
    }
    // Wave 6 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot3
        BeginAtWave         6
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        1
        InitialCooldown     10
        TFBot
        {
            Template T_TFBot_Sniper
        }
    }

    // Wave 5 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot
        BeginAtWave         5
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_Spy
        }
    }

    // Wave 7 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot
        BeginAtWave         7
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    
    

    // Wave 1 - X 7000
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        // Easy Scout Melee + Gru Heavies
        WaveSpawn
        {
            Name "wave1a" 
            Where spawnbot1
            TotalCount 27 
            MaxActive 9
            SpawnCount 9
            WaitBeforeStarting 0 
            WaitBetweenSpawns 9 
            TotalCurrency 60 
            TFBot
            {
                Class Scout
                Skill Normal
                WeaponRestrictions MeleeOnly
            }
        }
        WaveSpawn
        {
            Name "wave1a" 
            Where spawnbot3_house_flank
            TotalCount 20
            MaxActive 5
            SpawnCount 5
            WaitBeforeStarting 0 
            WaitBetweenSpawns 5 
            TotalCurrency 200 
            TFBot
            {
                Template T_TFBot_Heavyweapons_Heavyweight_Champ_Fast
            }
        }
        WaveSpawn
        {
            Name "wave1b" 
            Where spawnbot2
            TotalCount 20
            MaxActive 5
            SpawnCount 5
            WaitBeforeStarting 0 
            WaitForAllDead "wave1a"
            WaitBetweenSpawns 5 
            TotalCurrency 140
            TFBot
            {
                Template T_TFBot_Heavyweapons_Heavyweight_Champ
            }
        }
        WaveSpawn
        {
            Name "wave1b" 
            Where spawnbot2
            TotalCount 20
            MaxActive 5
            SpawnCount 5
            WaitBeforeStarting 0 
            WaitForAllDead "wave1a"
            WaitBetweenSpawns 5 
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Pyro_Flaregun
                Skill Easy
            }
        }
    }

