				EntFire(`bombpath_2_relay`, `Trigger`)
				EntFire(`bombpath_arrows_path1`, `TurnOff`)
				EntFire(`bombpath_arrows_path2`, `TurnOn`)
				EntFire(`bombpath_arrows_path3`, `TurnOff`)
            "
		}
