WaveSchedule
{
	StartingCurrency 1200 // ADJUST > 600
	RespawnWaveTime 3 // ADJUST > 4
  FixedRespawnWaveTime Yes
	CanBotsAttackWhileInSpawnRoom no
    Advanced 1
    
	Mission // BUSTERS WAVE 1
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        Where spawnbot_sentrybuster_d
        Where spawnbot_sentrybuster_e
        
		Objective DestroySentries
		InitialCooldown 25
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 60
		TFBot
		{
			Template NV_SentryBuster
		}
	}
    Mission // BUSTERS WAVES 2-5
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        Where spawnbot_sentrybuster_d
        Where spawnbot_sentrybuster_e
        
		Objective DestroySentries
		InitialCooldown 20
		BeginAtWave 2
		RunForThisManyWaves 4
		CooldownTime 45
		TFBot
		{
			Template NV_SentryBuster
		}
	}
    
    Mission // SPIES WAVE 2
	{
		Where spawnbot_spy_a
        Where spawnbot_spy_b
        Where spawnbot_spy_c
        Where spawnbot_spy_d
        Where spawnbot_spy_e
        
		Objective Spy
		InitialCooldown 15
		BeginAtWave 2
		RunForThisManyWaves 1
		CooldownTime 60
		DesiredCount 3
		TFBot
		{
			Template NV_Spy
		}
	}
    
