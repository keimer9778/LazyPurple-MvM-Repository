#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
	StartingCurrency 700
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 4
	
	//testing restrictions
	//MaxRedPlayers 4
	//ClassLimit{Spy 0 Medic 0}DisallowUpgrade "ubercharge"DisallowUpgrade "critboost"DisallowUpgrade "explode_on_ignite"DisallowUpgrade	"explosive sniper shot"
	
	Mission	//	sentry busters
	{
		Objective	DestroySentries
		Where	spawnbot
		BeginAtWave	1
		RunForThisManyWaves	10
		CooldownTime	40
		DesiredCount	1
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 30
		Where spawnbot_mission_spy
		BeginAtWave 2
		RunForThisManyWaves 1
		CooldownTime 40
		DesiredCount 3

		TFBot
		{
			Template	T_TFBot_Spy
			Attributes	IgnoreFlag
		}
	}
	
