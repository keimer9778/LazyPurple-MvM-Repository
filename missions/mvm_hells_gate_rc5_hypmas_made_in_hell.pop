					spellFireballSpinner [$SIGSEGV]
					{
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action $SetProp$m_iszClassIcon
							Param fireball_spinner_keimer
							Delay 0
							Cooldown 0
							Repeats 1
						}
						CharacterAttributes		// Lock the boss's actions so that he can't exit his taunt
						{
							"no_attack" 1
							"move speed bonus" 0
							"dmg from ranged reduced" 0.8
							"dmg from melee increased" 0.8
						}
						Taunt [$SIGSEGV]
						{
							Delay 0.1
							Repeats 1 
							Duration 99999 //Duration of a looping taunt (Default: 0.1)
							Name "Taunt: Second Rate Sorcery"
						}
						FireInput [$SIGSEGV]				// Pushback
                        {
                            Target "!self"
                            Action "RunScriptCode"
                            Param	"local radius = 250;
									local power = 900;
									local up = 550;
									local center = self.GetOrigin();
									for (local p = null; p = Entities.FindByClassnameWithin(p, `player`, center, radius);)
									{ 
										if (p.GetTeam() != self.GetTeam() && p.IsAlive())
										{ 
											local dir = p.GetOrigin() - center;
											dir.z = 0;
											if (dir.Length() < 1) dir = Vector(1,0,0);
											dir.Norm(); 
											p.SetVelocity(dir * power + Vector(0,0,up));
										} 
									}"
                            Delay 2.5
                            Repeats 1
                        }
						FireInput [$SIGSEGV]	// Destroy buildings because we can't have nice things
						{
							Target "!self"
							Action "RunScriptCode"
							Param 	"local sentry = null;
									local center = self.GetOrigin();

									while (sentry = Entities.FindByClassnameWithin(sentry, `obj_sentrygun`, center, 25))
									{
										if (sentry.GetTeam() != self.GetTeam())
											EntFireByHandle(sentry, `Kill`, ``, 0, self, self);
									}"
							Delay 2.5
							Repeats 1
						}
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param	"self.ValidateScriptScope();
									local sc = self.GetScriptScope();
									local boss = self;
									sc.spinStep <- 0;
									sc.FireSpinner <- function(){
										local center = boss.GetOrigin() + Vector(0, 0, 50);
										local phase = spinStep * 10.0;
										spinStep++;
										local rad = phase*0.0174533;
										local dir = Vector(cos(rad), sin(rad), 0);
										local offset = 75;
										local speed = 850;
										local pos1 = center + dir * offset;
										local pos2 = center - dir * offset;
										local fb1 = SpawnEntityFromTable(`tf_projectile_spellfireball`, {origin = pos1, angles = QAngle(0, phase, 0)});
										local fb2 = SpawnEntityFromTable(`tf_projectile_spellfireball`, {origin = pos2, angles = QAngle(0, phase + 180, 0)});
										fb1.SetOwner(boss);
										fb2.SetOwner(boss);
										fb1.SetTeam(boss.GetTeam());
										fb2.SetTeam(boss.GetTeam());
										fb1.SetVelocity(dir*speed); fb2.SetVelocity(dir * -speed);
									};
									for(local i = 0; i < 30; i++)
									{
										EntFireByHandle(boss, `RunScriptCode`, `FireSpinner()`, i * 0.08, boss, boss);
									}"
							Delay 2.5
							Repeats 1
						}
						AddAttribute [$SIGSEGV]  			
						{
							Item "player" 		// Target is self
							Name "no_attack"	// Attr. name
