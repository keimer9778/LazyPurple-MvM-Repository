#base robot_giant.pop
#base robot_standard.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_lazypurple.pop

// boss_path_a1 (Tank left)
// boss_path_b1 (Tank right)

// Right side:
// spawnbot_right ... spawnbot_flank_right

// Left side:
// spawnbot_left ... spawnbot_flank_left

// Middle:
// spawnbot

// Start: 800
// Wave 1: 800 + [800   + 100] = 1700
// Wave 2: 1700 + [950  + 100] = 2750
// Wave 3: 2750 + [900  + 100] = 3750
// Wave 4: 3750 + [1000 + 100] = 4850
// Wave 5: 4850 + [850  + 100] = 5530
// Wave 6: 5530 + [1000]       = 6530

WaveSchedule
{
	StartingCurrency				1000
	RespawnWaveTime 				1
	CanBotsAttackWhileInSpawnRoom	No
	DisableSound "Announcer.MVM_Wave_End" [$SIGSEGV]
	PrecacheModel "models\bots\soldier_boss\bot_soldier_boss_gibby.mdl" [$SIGSEGV]					// Credit to CTriggerHurt for creating the gibby model
	PrecacheModel "models/props_mvm/indicator/indicator_circle.mdl" [$SIGSEGV]
	FixedRespawnWaveTime Yes
	

	PointTemplates [$SIGSEGV]
	{
		Interface													// Use this to allow for pausing and resuming subwaves.
		{															// Note that all subwaves need to be ACTIVE when the wave
			NoFixUp 1												// ends, including support. Otherwise, the wave will softlock.
			point_populator_interface{}
		}
		relativeRecallVisuals										// Spawn the particle relative to where Wrath does his RECALL.
		{
			KeepAlive 1
			info_particle_system									// I need to not look boring when I recall :c
			{
				"TargetName" "relativePositionParticle"
				"origin" "0 0 10"
				"effect_name" "mvm_hatch_destroy"
			}
		}
		introExplosion												// Visual transition from Wave 5 to Wave 6
		{
			OnSpawnOutput											// When the dummy subwave spawns this PointTemplate, immediately
			{														// trigger 'bossIntro' as a result.
				Target "bossIntro"
				Action Trigger
			}
			info_particle_system									// When 'introExplosionColumn' is triggered, play this smoke effect
			{														// at the middle robot spawn. The 'origin' is the set of coordinates.
				"TargetName" "introExplosionColumn"					// The 'angle' determines the particle's rotation. The 'effect_name' is
				"origin" "-10 -4310 -250"							// what particle should be displayed.
				"angles" "0 0 0"
				"effect_name" "fireSmoke_Collumn_mvmAcres"			// Particle borrowed from Echoes of a Warzone by Sergeant Table
			}
			info_particle_system									// Secondary particle used for added explosive visual intensity
			{
				"TargetName" "introExplosionHatch"
				"origin" "-10 -4310 -250"
				"angles" "0 0 0"
				"effect_name" "mvm_hatch_destroy"
			}
			logic_timer												// Play this every second using 'RefireTime' when Wave 5 ends
			{
				"TargetName" "introExplosionLoop"
				"StartDisabled" "1"
				"RefireTime" "1.0"
				"OnTimer" "introExplosionHatch,Stop,,0,-1"
				"OnTimer" "introExplosionHatch,Start,,0.05,-1"
			}
			logic_relay												// This relay triggers at the end of Wave 5.
			{
				"TargetName" "bossIntro"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_directhittaunt02.mp3,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\explosions\explode_4.wav,0,-1"
				"OnTrigger"	"introExplosionHatch,Start,,0,-1"
				"OnTrigger"	"introExplosionColumn,Start,,0,-1"
				"OnTrigger" "introExplosionLoop,Enable,,0.1,-1"
				"OnTrigger"  "bossText,Display,,0.5,1"
			}
			game_text												// Title text
			{
				"origin" "10000 10000 10000"						// Dummy position, this is where the entity spawns. Just keep it out of the way.
				"TargetName" "bossText"								// Name of entity
				"message" "MANN'S LAST STAND"						// Text to display
				"x" "-1"											// 0 = left, -1 = middle, 1 = right
				"y" "0.45"											// 0 = top, 1 = bottom, 0.45 = slightly above center
				"spawnflags" "1"									// Just set to 1
				"effect" "1"										// 
				"channel" "1"										// Channels are essentially output layers (think of it in paint.NET)
				"color" "255 0 0"									// Message color in RGB
				"fxtime" "0.2"										// Delay between characters appearing (shorter = faster)
				//"fadein" "0.6"									// Time for text to fade in
				"fadeout" "1"										// Time for text to fade out
				"holdtime" "7"										// Time for text to remain on screen
			}
		}
		introExplosionSecond										// This particle plays when Wrath RECALLS.
		{
			logic_relay																			// Since this PointTemplate is spawned by Wrath, it follows the boss's
			{																					// position. Any particles spawned by this template will not use absolute
				"TargetName" "bossIntroSubordinate"												// coordinates, instead they will use coordinates relative to Wrath.
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\explosions\explode_4.wav,0,-1"			// You can create a second PointTemplate spawned via FirstSpawnOutput to 
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,darkFlame,0,-1"			// make this second template's relay use absolute coordinates. An example of
				"OnTrigger" "point_populator_interface,$PauseWavespawn,firstSupportLeft,0,-1"	// particles via VScript is on Line 3225, though this is not a recommended way
				"OnTrigger" "point_populator_interface,$PauseWavespawn,firstSupportRight,0,-1"	// of creating particles.
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,secondSupportLeft,0,-1"
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,secondSupportRight,0,-1"
			}
		}
		introPauseSupport											// You can use a PointTemplate to trigger an action on point_populator_interface.
		{															// When you trigger the logic_relay called 'pauseSupport,' the subwaves will stop
			OnSpawnOutput											// spawning bots (this will not kill the already-spawned bots).
			{
				Target "pauseSupport"								
				Action "trigger"
				Delay 0.1											// The 'Delay' argument defines how long the PointTemplate should wait before triggering
			}														// the 'pauseSupport' relay.
			logic_relay
			{
				"TargetName" "pauseSupport"
				"OnTrigger" "point_populator_interface,$PauseWavespawn,wave04cSupport,0,-1"		// YOU MUST RESUME THE SUBWAVE TO END IT! Otherwise, the wave will softlock
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,wave04cSupport,26,-1"	// because all subwaves must be TERMINATED to conclude the wave.
			}
		}
		boss_logic													// This PointTemplate handles picking what moves Wrath will use.
		{
			NoFixUp 1 												// If the entity targetname is used somewhere else in the template, any additional spawn
																	// of this template will have a unique suffix added to the entity name if NoFixUp = 0. Use '1' to avoid this.
			OnSpawnOutput											// If multiple bots use this template, NoFixUp = 1 will avoid name collisions, which will break the bots.
			{
				Target "pauseSecondaryBosses"						// As soon as the boss spawns, pause the Dark Flame Pyro subwaves from spawning.
				Action "trigger"
				Delay 0.1
			}
			logic_relay
            {
                "TargetName" "pauseSecondaryBosses"
				"OnTrigger" "point_populator_interface,$PauseWavespawn,darkFlame,0,-1"
				"OnTrigger" "point_populator_interface,$PauseWavespawn,secondSupportLeft,0,-1"	// This boss fight uses two sets of support bots. Using $PauseWavespawn will
				"OnTrigger" "point_populator_interface,$PauseWavespawn,secondSupportRight,0,-1"	// prevent the second set from spawning until we demand it to.
            }
			logic_case														// This relay is used in the first half of the boss fight.
			{																// It determines what type of attack Wrath will use for his rocket launcher.
				"TargetName" "rocketCases"									// When it picks a Case, it will look up what command to fire via OnCase.
				"Case01" "laserWall"
				"Case02" "mortar"
				"Case04" "blast"
				"OnCase01" "!activator,$ChangeAttributes,laserWall,0,-1"	// '!activator' refers to whoever called the relay (in this case, Wrath). 
				"OnCase02" "!activator,$ChangeAttributes,mortar,0,-1"		// '$ChangeAttributes' means to use EventChangeAttributes and apply the event name (e.g. mortar).
				"OnCase04" "!activator,$ChangeAttributes,blast,0,-1"		// '0' defines the Delay before triggering the event.
			}																// '-1' defines how many times the event should fire. -1 means to repeat only once.
			logic_case
			{
				"TargetName" "rocketCasesSecondMoveset"						// This relay is used in the second half of the boss fight.
				"Case01" "laserWallSecondMoveset"							// These are just buffed versions of the first moveset.
				"Case02" "mortarSecondMoveset"
				"Case04" "blastSecondMoveset"
				"OnCase01" "!activator,$ChangeAttributes,laserWallSecondMoveset,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,mortarSecondMoveset,0,-1"
				"OnCase04" "!activator,$ChangeAttributes,blastSecondMoveset,0,-1"
			}
			logic_case														// This relay is used to determine what banner Wrath uses.
			{
				"TargetName" "bannerCases"
				"Case01" "buffBanner"
				"Case02" "conchBanner"
				"OnCase01" "!activator,$ChangeAttributes,buffBanner,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,conchBanner,0,-1"
			}
			logic_case														// This relay is used to determine what spell Wrath uses in the first half.
			{
				"TargetName" "spellFirstMoveset"
				"Case01" "spellMonoculusTwoSpread"
				"Case02" "spellTeslaboltThreeSpread"
				"OnCase01" "!activator,$ChangeAttributes,spellMonoculusTwoSpread,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,spellTeslaboltThreeSpread,0,-1"
			}
			logic_case														// This relay is used to determine what spell Wrath uses after recalling at 50% HP.
			{
				"TargetName" "spellSecondMoveset"
				"Case01" "spellFireballCollapsingSkies"
				"Case02" "spellFireballSpinner"
				"OnCase01" "!activator,$ChangeAttributes,spellFireballCollapsingSkies,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,spellFireballSpinner,0,-1"
			}
			logic_relay														// This relay transitions from the banner-rolling phase to spells.
			{
				"TargetName" "firstMovesetOpening"
				"OnTrigger" "!activator,$ChangeAttributes,spellFireballCollapsingSkiesInitial,0,1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient_mp3\alarms\doomsday_lift_alarm.mp3,0,-1"
				"startDisabled" 1			// Under no circumstances should this relay ever fire unless we go from rolling banners to using the first set of spells.
			}																
			logic_relay														// This relay triggers when Wrath hits 50% HP. It activates the summonSubordinateTaunt event,
			{																// which makes him use the Unleashed Rage taunt, recall, and trigger further relays defined
				"TargetName" "weAreGonnaJumpYou"							// in the event.
				"OnTrigger" "!activator,$ChangeAttributes,summonSubordinateTaunt,0,1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_directhittaunt02.mp3,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_directhittaunt02.mp3,1,-1"
			}
			logic_relay														// This relay triggers when Wrath hits 5% HP and activates his last hurrah phase.
			{
				"TargetName" "meleeRushRelay"
				"OnTrigger" "!activator,$ChangeAttributes,meleeRush,0,1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/mght/Soldier_mvm_m_paincrticialdeath02.mp3,0.5,-1"
			}
		}
		bossStopSupport														// This relay resumes the subwaves defining the first set of support bots for reasons
		{																	// explained on Lines 152 and 153.
			OnSpawnOutput
			{
				Target "cease"
				Action "trigger"
				Delay 0.1
			}
			logic_relay
            {
                "TargetName" "cease"
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,firstSupportLeft,0,-1"
				"OnTrigger" "point_populator_interface,$ResumeWavespawn,firstSupportRight,0,-1"
            }
		}
		spellVisualCollapsingSkies												// This PointTemplate is responsible for the circle indicators used by the
		{																		// Collapsing Skies spell.
			logic_relay
			{
				"TargetName" "collapingSkiesVisual"
				"OnTrigger" "spellRadiusBottom,Enable,,0.1,-1"						// Enable the circle
				"OnTrigger" "spellRadiusTop,Enable,,0.1,-1"							// Enable the circle
				"OnTrigger" "spellRadiusBottom,Disable,,5.5,-1"						// Disable the circle
				"OnTrigger" "spellRadiusTop,Disable,,5.5,-1"						// Disable the circle
				// "OnTrigger"	"tf_gamerules,PlayVO,ambient_mp3\alarms\doomsday_lift_alarm.mp3,0,-1"
			}
			prop_dynamic
			{
				"TargetName" "spellRadiusBottom"
				"DisableBoneFollowers" "1"
				"skin" "1"														// 0 = RED, 1 = BLUE
				"model" "models/props_mvm/indicator/indicator_circle.mdl"		// Indicator model name
				"modelscale" "19"												// Scale of the indicator
				"DefaultAnim" "start"
				"disableshadows" "1"
				"origin" "0 0 800"												// Fire 800 Hammer Units above the boss
				"angles" "0 0 0"												// Don't rotate the indicator
				"StartDisabled" "1"												// Only fire when the spell is being cast
			}
			prop_dynamic
			{
				"TargetName" "spellRadiusTop"
				"DisableBoneFollowers" "1"
				"skin" "1"														// 0 = RED, 1 = BLUE
				"model" "models/props_mvm/indicator/indicator_circle.mdl"		// Indicator model name
				"modelscale" "19"												// Scale of the indicator
				"DefaultAnim" "start"
				"disableshadows" "1"
				"origin" "0 0 000"												// Fire at the boss's feet
				"angles" "0 0 0"												// Don't rotate the indicator
				"StartDisabled" "1"												// Only fire when the spell is being cast
			}
		}
	}

	

	Mission // Spy - wave 4
	{
		Objective Spy

		InitialCooldown 150
		Where spawnbot_mission_spy
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 20
		DesiredCount 2

		TFBot
		{
			Class Spy
			Skill Expert
			Name Spy
		}
	}

	Wave
	{
		CustomWaveNumber 1 [$SIGSEGV]											// You can use CustomWaveNumber and CustomMaxWaveNumber
		CustomMaxWaveNumber 5 [$SIGSEGV]										// via rafmod. When you reach Wave 5, it will play the last
		StartWaveOutput															// wave starting sounds.
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
		// The first wave only has two subwaves, which is intended to serve as a litmus test.
		// Giant Pyros serve as anti-shield robots and come with BigHeal Medics while Direct Hit
		// Soldiers serve as the main source of the robots' DPS. Giant Rapid Fire Demomen slowly
		// Deploy over the course of the wave to serve as bulkier support DPS units. The second
		// subwave is more hitscan oriented as opposed to the projectiles and flames of its
		// predecessor, but comes with increased damage output courtesy of the Giant Buff Banner
		// Soldiers. Super Scouts here are intended to rush up and force attention on themselves
		// while the Deflector Heavies use the distraction to push up, healed by BigHeal Medics
		// to mitigate some of the oncoming fire.


		// Subwave 1 (maxActive: 22)
		// Giant Pyro + BigHeal Medic (4 + 4 = 8)
		// Direct Hit Soldier (12)
		// Giant Rapid Fire Demo (2)

		WaveSpawn	// First set. Bulk units (left) to free up space.
		{
			Name "wave01aGiant"
			Where spawnbot_left
			TotalCount 8
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Pyro
					Attributes AlwaysFireWeapon
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.25
						"airblast vulnerability multiplier" 0.25
						"damage force reduction" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}
		WaveSpawn	// First set. Bulk units (right) to free up space.
		{
			Name "wave01aGiant"
			Where spawnbot_right
			TotalCount 8
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Pyro
					Attributes AlwaysFireWeapon
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.25
						"airblast vulnerability multiplier" 0.25
						"damage force reduction" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}
		WaveSpawn	// First set. Bulk units (Middle)
		{
			Name "wave01aGiantDemo"
			Where spawnbot
			TotalCount 3
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 25
			WaitBetweenSpawns 20
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Giant_Demoman
				ClassIcon demo_rapid_giant
				CharacterAttributes
				{
					"airblast vertical vulnerability multiplier" 0.25
					"airblast vulnerability multiplier" 0.25
					"damage force reduction" 0.25
				}
			}
		}
		WaveSpawn	// First set. Supporting units (middle)
		{
			Name "wave01a"
			Where spawnbot
			TotalCount 18
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 5
			WaitBetweenSpawns 10
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Soldier_DirectHit
			}
		}
		
		// Subwave 2 (maxActive: 20)
		// Super Scout (1)
		// Giant Buff Banner Soldier (2)
		// Deflector Heavy + BigHeal Medic (12)
		// Rapid Fire Scout (4)
		// Armored Homewrecker Pyro (1)

		WaveSpawn	// Second set. Rushing units (middle)
		{
			Name "wave01bSupers"
			Where spawnbot
			TotalCount 4
			MaxActive 1
			SpawnCount 1
			WaitForAllSpawned "wave01aGiant"
			WaitBeforeStarting 6
			WaitBetweenSpawns 15
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Giant_Scout_Fast
				CharacterAttributes
				{
					"airblast vertical vulnerability multiplier" 0.35
					"airblast vulnerability multiplier" 0.35
					"damage force reduction" 0.35
				}
			}
		}
		WaveSpawn	// Second set. Bulk supporting units (middle)
		{
			Name "wave01b"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitForAllSpawned "wave01aGiant"
			WaitBeforeStarting 15
			WaitBetweenSpawns 5
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Giant_Soldier_Extended_Buff_Banner
				CharacterAttributes
				{
					"airblast vertical vulnerability multiplier" 0.25
					"airblast vulnerability multiplier" 0.25
					"damage force reduction" 0.25
				}
			}
		}
		WaveSpawn	// Second set. Survivability units (middle)
		{
			Name "wave01b"
			Where spawnbot
			TotalCount 16
			MaxActive 12
			SpawnCount 2
			WaitBeforeStarting 2
			WaitBetweenSpawns 3
			TotalCurrency 50
			WaitForAllSpawned wave01aGiant
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Heavy_Deflector
					
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}
		WaveSpawn	// Second set. Bulk support units
		{
			Name "wave01b"
			Where spawnbot
			TotalCount 16
			MaxActive 4
			SpawnCount 2
			WaitForAllSpawned "wave01aGiant"
			WaitBeforeStarting 0
			WaitBetweenSpawns 2
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Scout_FastFire
				Skill Hard
			}
		}
		WaveSpawn	// Second set. Support tank units (middle)
		{
			Name "wave01b"
			Where spawnbot
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 2
			WaitBetweenSpawns 8
			TotalCurrency 50
			WaitForAllDead wave01aGiant
			Support 1

			TFBot
			{
				Template T_TFBot_Pyro_Homewrecker_Armored
			}
		}
	}
	Wave
	{
		CustomWaveNumber 2 [$SIGSEGV]
		CustomMaxWaveNumber 5 [$SIGSEGV]
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
		// This wave has only two subwaves, but depending on the team's ability to either drop the Armored Uber Medics or isolate them after
		// they have Ubercharged, the second half of this wave can quickly spiral out of control. A Medic's shield is the only requirement
		// on the second half, but a class capable of dropping Armored Uber Medics (most notably Spy) makes this wave substantially easier.
		// The first subwave is intended as a simple soften-up subwave chained before the main DPS subwave.

		// Subwave 1 (maxActive: 20)
		// Giant Shotgun Heavy + Giant Regen Medic (2) | only one pair spawns
		// Giant Rapid Fire Soldier (4)
		// Crit Burst Demo (6)
		// Fury Pyro (10)

		WaveSpawn	// First set. Create breathing space for robots (middle)
		{
			Name "wave02Preamble"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavyweapons_Shotgun
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.25
						"airblast vulnerability multiplier" 0.25
						"damage force reduction" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic_Regen
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.25
						"airblast vulnerability multiplier" 0.25
						"damage force reduction" 0.25
					}
				}
			}
		}
		WaveSpawn	// First. Bulk DPS units (Left)
		{
			Name "wave02aGiant"
			Where spawnbot
			TotalCount 4
			MaxActive 4
			SpawnCount 1
			WaitBeforeStarting 10
			WaitBetweenSpawns 6
			TotalCurrency 50

			TFBot
			{
				Template T_TFBot_Giant_Soldier_Spammer
				CharacterAttributes
