	Wave
	{
		CustomWaveNumber 6 [$SIGSEGV] // Display custom wave number. 511 is max value
		CustomMaxWaveNumber 6 [$SIGSEGV] // Display custom max wave number. 0 hides the max wave number
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		WaitWhenDone 65
		Checkpoint Yes

		WaveSpawn
		{
			StartWaveWarningSound mvm/giant_heavy/giant_heavy_entrance.wav
		}
		WaveSpawn	// "vo/mvm/mght/soldier_mvm_m_laughlong01.mp3"
		{
			Name "Sin"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 0
		
			TFBot
			{
				Class Soldier
				ClassIcon soldier_infernal_impaler
				Health	100000
				UseCustomModel "models\bots\soldier_boss\bot_soldier_boss_gibby.mdl" [$SIGSEGV]
				Name "Sinful Emperor Wrath"
				Scale 2.2
				Skill Expert
				Attributes AlwaysCrit
				Attributes UseBossHealthBar
				Attributes SpawnWithFullCharge
				Attributes MiniBoss
				Attributes HoldFireUntilFullReload
				Tag dontdoublehp
				Tag dontdoublehp_damageres
				RocketCustomParticle flare_glow [$SIGSEGV]
				SpawnTemplate boss_logic [$SIGSEGV]					// Manages the boss's moveset
				SpawnTemplate relativeRecallVisuals [$SIGSEGV]		// Particles upon recall 
				SpawnTemplate introExplosionSecond [$SIGSEGV]		// Sounds for when the Dark Flames spawn (this should have been placed outside of the bot's definition, but oh well)
				SpawnTemplate Interface [$SIGSEGV]					// Manages support spawns to properly conclude the wave (does not use $FinishWave)
				SpawnTemplate spellVisualCollapsingSkies [$SIGSEGV]	// Custom meteor shower
				Item	TF_WEAPON_ROCKETLAUNCHER
				Item	"The Infernal Impaler"
				Item	"Field Fatigues"
				ItemAttributes
				{
					ItemName TF_WEAPON_ROCKETLAUNCHER
					"damage bonus" 2
					"fire rate bonus" 0.1
					"clip size upgrade atomic" 3
					"reload time increased" 0.15
					"projectile spread angle penalty" 5
				}
				CharacterAttributes
				{
					"no_jump" 1
					"displace touched enemies" 1
					"blast dmg to self increased" 0
					"cancel falling damage" 1
					"damage force reduction" 0
					"airblast vulnerability multiplier" 0
					"airblast vertical vulnerability multiplier" 0
					"move speed bonus" 0.4
				}
				FireInput [$SIGSEGV] // This banner-locking isn't foolproof but it works most of the time
				{
					Target "!self"
					Action "RunScriptCode"
					Param "ClientPrint(null, 3, `\x0799CCFFSinful Emperor Wrath \x07FFFFFFwill lock their selected banner at \x07FF3F3F70% (70,000) \x07FFFFFFHP. The Buff Banner will provide increased weapon handling, and the Concheror will provide a minor speed boost.`);"
					Delay 0
					Repeats 1
				}
				FireInput [$SIGSEGV]
				{
					Target !activator
					Action $AddCond
					Param 28
					Delay 1
					Cooldown 5
					Repeats -1
					IfSeeTarget 1
					IfLeftSpawn 1
				}
				FireInput [$SIGSEGV]													// Start using banners at 90% HP
				{
					Target "bannerCases"
					Action "PickRandomShuffle"
					Delay  0
					IfHealthBelow 90000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 70% HP, enable the first spell moveset
				{
					Target "firstMovesetOpening"
					Action "enable"
					Delay  0
					IfHealthBelow 70000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 70% HP, trigger the first spell moveset
				{
					Target "firstMovesetOpening"
					Action "trigger"
					Delay  0.1
					IfHealthBelow 70000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 70% HP, disable the first spell moveset
				{
					Target "bannerCases"
					Action "disable"
					Delay  0
					IfHealthBelow 70000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 50% HP, disable the first spell moveset
				{
					Target "spellFirstMoveset"
					Action "disable"
					Delay  0
					IfHealthBelow 50000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 50% HP, disable the first rocket moveset
				{
					Target "rocketCooldown"
					Action "disable"
					Delay 0
					IfHealthBelow 50000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 50% HP, trigger the second spell moveset
				{
					Target "spellSecondMoveset"
					Action "trigger"
					Delay  1
					IfHealthBelow 50000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 50% HP, summon the subordinates
				{
					Target "weAreGonnaJumpYou"
					Action "trigger"
					Delay 0
					IfHealthBelow 50000
					Repeats 1
				}
				FireInput [$SIGSEGV]													// At 5% HP, start the melee rush
				{
					Target "meleeRushRelay"
					Action "trigger"
					Delay 0
					IfHealthBelow 5000
					Repeats 1
				}

				EventChangeAttributes
				{
					bannerCooldown [$SIGSEGV]
					{
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param 	"self.ValidateScriptScope();
									local sc = self.GetScriptScope();												// Fetch the script-side data associated with the bot
									if(!(`wrathBanner` in sc)) return;
									if(sc.wrathBanner == `buff`) {													// If banner = Buff
										sc.keepBuff <- true;
										sc.keepConch <- false;
										self.RemoveCond(29);
										sc.KeepBuff <- function() {													// Repeatedly apply increased weapon handling
											local s = self.GetScriptScope();										// if we cross to using spells. This block
											if(!(`keepBuff` in s) || !s.keepBuff) return;							// defines the function itself.
											self.AddCond(113);
											EntFireByHandle(self,`RunScriptCode`,`KeepBuff()`,0.10,self,self);
										}; 
										sc.KeepBuff(); 																// Refire to re-apply.
									}
									else if(sc.wrathBanner == `conch`) {											// if banner = Conch
										sc.keepConch <- true;
										sc.keepBuff <- false;
										self.RemoveCond(113);
										sc.KeepConch <- function() {												// Repeatedly apply healing and speed boost
											local s=self.GetScriptScope();
											if(!(`keepConch` in s) || !s.keepConch) return;
											self.AddCond(29);
											EntFireByHandle(self,`RunScriptCode`,`KeepConch()`,0.10,self,self);
										};
										sc.KeepConch();
									}"
							Delay 0
							Repeats 1
						}
						ItemAttributes
						{
							ItemName "TF_WEAPON_ROCKETLAUNCHER"
							"damage bonus" 0
							"fire rate bonus" 0.45
							"reload time increased" -0.8
							"projectile spread angle penalty" 3
							"Projectile speed increased" 0.65
						}
						
						WeaponRestrictions PrimaryOnly
						CharacterAttributes									// Revert damage reduction from holding a banner
						{
							"dmg from ranged reduced" 1
							"dmg from melee increased" 1
						}
						FireInput [$SIGSEGV]								// every day im shuffling
						{
							Target "bannerCases"
							Action "PickRandomShuffle"
							Delay  10
							Repeats 1
						}
					}
					buffBanner [$SIGSEGV]									// Buff banner event
					{
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param	"self.ValidateScriptScope();
									local sc = self.GetScriptScope();
									sc.keepConch <- false;
									self.RemoveCond(29);
									self.RemoveCond(73);
									sc.wrathBanner <- `buff`;
									sc.keepBuff <- true;"
							Delay 0
							Repeats 1
						}
						RingOfFire 100 [$SIGSEGV]
						WeaponRestrictions SecondaryOnly
						Item "The Buff Banner"								// They just stand there awkwardly if you're too close
						ItemAttributes
						{
							ItemName "The Buff Banner"
							"increase buff duration" 100.0
							"dmg from ranged reduced" 0.9					// Reduce damage to further discourage bodyblocking during banners
							"dmg from melee increased" 0.9
						}
						CharacterAttributes
						{
							"no_jump" 0
							"increased jump height" 3
						}
						AddAttribute [$SIGSEGV]   							// Revert the jump behavior
						{
							Item "player" 		
							Name "no_jump"
							Value 1
							Delay 3
							Repeats 1
						}
						FireInput [$SIGSEGV]								// Empty rage meter properly
						{
							Target "!self"
							Action "RunScriptCode"
							Param "NetProps.SetPropFloat(self, `m_Shared.m_flRageMeter`, 0.0)"
							Delay 0.5
							Repeats 1
						}
						FireInput [$SIGSEGV]								// Fill rage meter
						{
							Target "!self"
							Action "RunScriptCode"
							Param "NetProps.SetPropFloat(self, `m_Shared.m_flRageMeter`, 100.0)" // ; printl(`RAGE: ` + NetProps.GetPropFloat(self, `m_Shared.m_flRageMeter`));
							Delay 1
							Repeats 1
						}
						ChangeAttributes [$SIGSEGV]							// After 4 seconds, exit this move and swap back to Primary (hopefully)
						{													// ((Screw you buggy banner AI!))
							Name "bannerCooldown"
							Delay 4
							Repeats 1
						}
					}
					conchBanner [$SIGSEGV]
					{
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param	"self.ValidateScriptScope();
									local sc=self.GetScriptScope();
									sc.keepBuff <- false;
									self.RemoveCond(113);
									sc.wrathBanner <- `conch`;
									sc.keepConch <- true;"
							Delay 0
							Repeats 1
						}
						RingOfFire 100 [$SIGSEGV]
						Item "The Concheror"
						WeaponRestrictions SecondaryOnly
						ItemAttributes
						{
							ItemName "The Concheror"
							"increase buff duration" 100.0
							"dmg from ranged reduced" 0.9						// Reduce damage to further discourage bodyblocking during banners
							"dmg from melee increased" 0.9
						}
						CharacterAttributes
						{
							"no_jump" 0
							"increased jump height" 3
						}
						AddAttribute [$SIGSEGV]   								// Revert the jump behavior
						{
							Item "player" 		
							Name "no_jump"
							Value 1
							Delay 3
							Repeats 1
						}
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action $SetProp$m_iszClassIcon
							Param Conch
							Delay 0
							Cooldown 0
							Repeats 1
						}
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param "NetProps.SetPropFloat(self, `m_Shared.m_flRageMeter`, 0.0)"
							Delay 0.5
							Repeats 1
						}
						FireInput [$SIGSEGV]
						{
							Target "!self"
							Action "RunScriptCode"
							Param "NetProps.SetPropFloat(self, `m_Shared.m_flRageMeter`, 100.0);"
							Delay 1
							Repeats 1
						}
						ChangeAttributes [$SIGSEGV]
						{
							Name "bannerCooldown"
							Delay 4
							Repeats 1
						}
					}
					spellCooldownFirstMoveset [$SIGSEGV]
					{
						WeaponRestrictions PrimaryOnly
						CharacterAttributes									// Revert damage reduction from holding a banner
						{
							"dmg from ranged reduced" 1
							"dmg from melee increased" 1
						}
						FireInput											// every day im shuffling
