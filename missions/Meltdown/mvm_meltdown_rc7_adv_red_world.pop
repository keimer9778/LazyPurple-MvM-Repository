	//==========================
	//			Wave 7
	//==========================
	Wave
	{
		StartWaveOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "EntFire(`wave_start_relay`, `Trigger`);
			EntFire(`door1_trigger`, `Disable`);
			EntFire(`door1_door`, `Close`);
			EntFire(`door1_door`, `Lock`);
			EntFire(`door2_trigger`, `Disable`);
			EntFire(`door2_door`, `Close`);
			EntFire(`door2_door`, `Lock`);
			RedWorld.AllRedDeathCheck = true;
			RedWorld.DoGiantSpawnSound = true;
			AlternateWaves.ClearWaveIcons();
			AlternateWaves.AddWaveIcons([
					[ `heavy_titanium`, 1, MVM_CLASS_FLAG_MINIBOSS ],
					[ `scout`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `soldier`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `pyro`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `demo`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `heavy`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ]
			]);
			RedWorld.SpawnAllDispensers();
			EntFire(`gamerules`, `SetRedTeamRespawnWaveTime`, `15.0`, 0.1);
			"
		}
		DoneOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "EntFire(`wave_finished_relay`, `Trigger`)
			RedWorld.KillAllDispensers();
			RedWorld.AllRedDeathCheck = false;
			AlternateWaves.bTrackIcons = true;
			RedWorld.DoGiantSpawnSound = false;
			RedWorld.CleanAllUpgradeStations();

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null)
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/red_alert_3_hell_march_3.wav`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}

			Convars.SetValue(`tf_allow_sliding_taunt`, 0);"
		}
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
				EntFire(`boss_pit_close_door`, `Trigger`)
				if (!(`alternatewaves` in getroottable()))
				{
					IncludeScript(`alternatewaves`, getroottable());
				}
				AlternateWaves.bTrackIcons = false;
				AlternateWaves.ClearWaveIcons();
				AlternateWaves.AddWaveIcons([
					[ `heavy_titanium`, 1, MVM_CLASS_FLAG_MINIBOSS ],
					[ `scout`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `soldier`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `pyro`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `demo`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ],
					[ `heavy`, 1, MVM_CLASS_FLAG_NORMAL | MVM_CLASS_FLAG_SUPPORT ]
				])
				if (!(`mvm_meltdown_red_world` in getroottable()))
				{
					IncludeScript(`mvm_meltdown_red_world`, getroottable());
				}
				RedWorld.AllRedDeathCheck = false;
				RedWorld.DoGiantSpawnSound = false;
				RedWorld.DeleteAllNavs();
				RedWorld.SpawnUpgradeTable(Vector(0.0, -150.0, 45.0), QAngle(0.0, -90.0, 0.0), Vector(0.0, -64.0, 205.0), QAngle(0.0, -90.0, 0.0));
				PrecacheSound(`#mentrillum/mvm/music/red_alert_3_hell_march_3.wav`);
				PrecacheSound(`)mentrillum/mvm/sfx/attack_groundpound.wav`);
				PrecacheSound(`)mentrillum/mvm/sfx/attack_chestbeam.wav`);
				for (local i = 1, player; i <= MaxClients().tointeger(); i++)
				{
					if ((player = PlayerInstanceFromIndex(i)) != null)
					{
						EmitSoundEx({
							sound_name = `#mentrillum/mvm/music/red_alert_3_hell_march_3.wav`
							entity = player
							filter_type = 4
							flags = 4
						})
					}
				}
				Convars.SetValue(`tf_allow_sliding_taunt`, 1); // For Tonka Weapons's sandvich eating
			"
		}

		Explanation [$SIGSEGV]
		{
			Line "{FF2626}WARNING: {FFFFFF}If everyone dies at the same time the wave instantly fails."
			Line "{FFFFFF}Respawn times have been extended and the spawn doors will be locked on wave start."
			Line "{FFFFFF}Look out for the upgrade table to buy upgrades, check out what it looks like in spawn..."
		}

