	PointTemplates [$SIGSEGV]
	{
		Dispenser
		{
			NoFixup 1
			obj_dispenser
			{
				"origin" "0 0 0"
				"teamnum" "2"
				"SolidToPlayer" "0"
				"defaultupgrade" "2"
			}
		}

		item_support_shotgun
		{
			OnSpawnOutput
			{
				Target !activator
				Action RunScriptCode
				Param "RedWorld.SupportShotgun.call(this)"
			}
		}

		OnWaveEndRelays
		{
			logic_relay
			{
				"targetname" "kill_buildings"
				"OnTrigger" "obj_dispenser, RemoveHealth, 5000, 0, -1"
			}

			OnSpawnOutput
			{
				Target wave_finished_relay
				Action AddOutput
				Param "OnTrigger kill_buildings:Trigger:0:0"
			}
		}

		PopulatorInterface
		{
			point_populator_interface
			{
				"targetname" "pop_interface"
			}
		}

		W7Teleporter
		{
			NoFixup 1
			trigger_multiple
			{
				"origin" "0 -288 152"
				"mins" "-576 -288 -152"
				"maxs" "576 288 152"
				"spawnflags" "1"
				"filtername" "filter_redteam"
				"OnStartTouch" "!activatorRunScriptCodeRedWorld.RandomizeTeleport(self, `w7_teleport_destination`)0.0-1"
			}

			info_target
			{
				"targetname" "w7_teleport_destination"
				"origin" "352 192 96"
				"angles" "0.0 90.0 0.0"
			}

			info_target
