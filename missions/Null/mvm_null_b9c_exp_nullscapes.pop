	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "EntFire(`wave_finished_relay`, `Trigger`)

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/creo_flow.mp3`,
						entity = player,
						filter_type = 4,
						flags = 4
					})
				}
			}"
		}
		InitWaveOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "
				EntFire(`bombpath_choose_relay`, `Kill`);
				EntFire(`bombpath_arrows_clear_relay`, `Trigger`, null, 0.1);
				EntFire(`bombpath_clearall_relay`, `Trigger`, null, 0.1);
				EntFire(`bombpath_right_relay`, `Trigger`, null, 0.5);
				EntFire(`skybox_whiteout_fade`, `Kill`, null, 0.0); // Bad flashbang

				if (!(`tankextensions_main` in getroottable()))
				{
					IncludeScript(`tankextensions_main`, getroottable())
				}

				if (!(`tankextensions/speedtank` in getroottable()))
				{
					IncludeScript(`tankextensions/speedtank`, getroottable())
				}

				PrecacheSound(`#mentrillum/mvm/music/creo_flow.mp3`)
				for (local i = 1, player; i <= MaxClients().tointeger(); i++)
				{
					if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
					{
						EmitSoundEx({
							sound_name = `#mentrillum/mvm/music/creo_flow.mp3`,
							entity = player,
							filter_type = 4,
							flags = 4
						})
					}
				}
			"
		}

		Checkpoint Yes

		WaveSpawn
		{
			Name "01"
			TotalCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 45
			TotalCurrency 50

			FirstSpawnOutput
			{
				Target gamerules
				Action RunScriptCode
				Param "
				for (local i = 1, player; i <= MaxClients().tointeger(); i++)
				{
					if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
					{
						EmitSoundEx({sound_name = `#mentrillum/mvm/music/creo_flow.mp3`,
						entity = player,
						filter_type = 4}) // Yes, based on the actual Geometry Dash level Nullscapes
					}
				}
				ClientPrint(null, 3, `\x0799CCFF[MvM] \x01Now Playing: \x070080FFCreo - Flow`)"
			}

			Tank
			{
				Health 30000
				Speed 75
				StartingPathTrackNode "tank_path_a_1"

				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}

				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}

