#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum.pop

WaveSchedule
{
	StartingCurrency 500
	RespawnWaveTime 5
	FixedRespawnWaveTime Yes
	CanBotsAttackWhileInSpawnRoom no
	Advanced 1

	PrecacheSound "mentrillum/mvm/music/creo_flow.mp3"
	WaveStartCountdown 3
	RedPlayersAreRobots 1

	Mission
	{
		Objective Spy

		InitialCooldown 30
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 50
		DesiredCount 2

