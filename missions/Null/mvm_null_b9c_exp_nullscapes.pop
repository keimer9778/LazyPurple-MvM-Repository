				ClientPrint(null, 1, `GET OUT OF MY HEAD`);
				ClientPrint(null, 4, `GET OUT OF MY HEAD`);
				ScreenFade(null, 75, 75, 75, 255, 0.3, 0.1, 1)"
			}
		}

