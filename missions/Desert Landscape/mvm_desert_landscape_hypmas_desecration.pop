#base robot_giant.pop
#base robot_standard.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_lazypurple.pop

// boss_path_1 (Tank)
// nav_prefer_flank_right (Robot flank)

// (Estimated Completion Time) considering:
	// s = seconds to kill
	// d = deploy time
	// g = # of groups
	// s and d will be relatively interchangeable depending on the robot type

// Start: 800
// Wave 1: 800	+ [700 + 100] = 1600
// Wave 2: 1600 + [800 + 100] = 2500
// Wave 3: 2500 + [850 + 100] = 3450
// Wave 4: 3450 + [800 + 100] = 4350
// Wave 5: 4350 + [750 + 100] = 5200

WaveSchedule
{

	StartingCurrency				1200
	RespawnWaveTime 				7
	CanBotsAttackWhileInSpawnRoom	No

	Mission // Spy - wave 4
	{
		Objective Spy

		InitialCooldown 80
		Where spawnbot_mission_spy
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 50
		DesiredCount 4

		TFBot
		{
			Class Spy
			Skill Expert
			Name Spy
		}
	}


	
	//WAVE 1 ($650)
	Wave
	{
		StartWaveOutput
			{
				Target wave_start_relay
				Action Trigger
			}
		DoneOutput
			{
				Target wave_finished_relay
				Action trigger
			}
		WaitWhenDone 65
		Checkpoint Yes

		WaveSpawn	// Create space for the robots to jump down
					// ECT: 14s * 3g = 42s
		{
			Name "wave01a"
			Where spawnbot
			TotalCount 24
			MaxActive 6
			SpawnCount 6
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 200
		
			TFBot
			{
				Template T_TFBot_Scout_Bonk_Expert
				Attributes AlwaysCrit
			}
		}
		WaveSpawn	// Initial giant to create breathing space for bots
					// This pair should ideally go down with the last of the Hyper Bonk Scouts
		{
			Name "wave01b"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 150
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.2
						"airblast vulnerability multiplier" 0.2
						"damage force reduction" 0.3
					}
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic_Regen
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.2
						"airblast vulnerability multiplier" 0.2
						"damage force reduction" 0.3
					}
				}
			}
		}
		WaveSpawn	// Secondary force in initial push
		{
			Name "wave01c"
			WaitForAllDead "wave01b"
			Where spawnbot
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 200
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Fastrocket_Spammer_Armored
					Skill Hard
				}
				TFBot
				{
					Template T_TFBot_Medic_Quickheal_Armored_NoPop
				}
				TFBot
				{
					Template T_TFBot_Medic_Quickheal_Armored_NoPop
				}
				TFBot
				{
					Template T_TFBot_Medic_Quickheal_Armored_NoPop
				}
			}
		}
		WaveSpawn	// Rapid Fire Demomen + Uber Medics to create the most space for robots
		{
			Name "wave01d"
			Where spawnbot
			TotalCount 24
			MaxActive 16
			SpawnCount 8
			WaitForAllDead "wave01c"
			WaitBeforeStarting 0
			WaitBetweenSpawns 5
			TotalCurrency 100
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Demo_Conch
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
		WaveSpawn	// Small fodder support to keep the team occupied
		{
			Name "wave01e"
			WaitForAllSpawned "wave01b"
			Where spawnbot
			Support 1
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			
			TFBot
			{
				Template T_TFBot_Pyro_Dragon
			}
		}
		WaveSpawn	// Final stretch, endurance run. Buff section
		{
			Name "wave01eBuffBanner"
			WaitForAllSpawned "wave01d"
			Where spawnbot
			TotalCount 3
			MaxActive 3
			SpawnCount 1
			WaitBeforeStarting 15
			WaitBetweenSpawns 6
			TotalCurrency 50
		
			TFBot
			{
				Template T_TFBot_Giant_Soldier_Extended_Buff_Banner
				CharacterAttributes
				{
					"airblast vertical vulnerability multiplier" 0.2
					"airblast vulnerability multiplier" 0.2
					"damage force reduction" 0.3
				}
			}
		}
		WaveSpawn	// Onslaught support
		{
			Name "wave01eSupport"
			WaitForAllSpawned "wave01d"
			Where spawnbot
			Support 1
			MaxActive 18
			SpawnCount 3
			WaitBeforeStarting 15
			WaitBetweenSpawns 1
			TFBot
			{
				Class Soldier
				Skill Expert
			}
		}
	}	
