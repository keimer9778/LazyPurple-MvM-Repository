WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	2
	StartingCurrency 1200
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 3000
	AddSentryBusterWhenKillCountExceeds	15
	// EventPopFile Halloween
	Templates
	{
		boss
		{
			Class Pyro
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Name "The Firespreader"
			ClassIcon pyro_giant
			Health 45000
			Attributes MiniBoss Tag bot_giant
			Attributes UseBossHealthBar
			Attributes AlwaysFireWeapon
			Item "Upgradeable TF_WEAPON_FLAMETHROWER"
			Item "The Flare Gun"
			Item "The Person in the Iron Mask"
			Item "The Backpack Broiler"
			ItemAttributes
			{
				ItemName "The Flare Gun"
				"is_passive_weapon" 1
				"fire rate bonus" 0.3
				"faster reload rate" 0.5
				"damage bonus" 2.5
			}
			ItemAttributes
			{
				ItemName "Upgradeable TF_WEAPON_FLAMETHROWER"
				"flame_drag" 10.5
				"flame_spread_degree" 5
				"flame_speed" 11000
				"flame_up_speed" 50
				"item style override" 1
				"is australium item" 1
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"health regen"	30
				"damage force reduction" 0.0
				"airblast vulnerability multiplier" 0.0
				"override footstep sound set" 2
				"airblast vertical vulnerability multiplier" 0.0
				"rage giving scale" 0.1
			}
		}
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 5
		Where spawnbot_carrier_any
		BeginAtWave 5
		RunForThisManyWaves 2
		CooldownTime 60
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Mission
	{
		Objective Sniper
		
		Where spawnbot_carrier_altside
		BeginAtWave 0
		RunForThisManyWaves 1
		InitialCooldown 25
		CooldownTime 40
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	
	Mission
	{
		Objective Engineer
		
		Where spawnbot_carrier_any
		BeginAtWave 6
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 60
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Battle_TeleIn
		}
	}
	
	Mission
	{
		Objective	DestroySentries
		
		Where spawnbot_carrier_altside
		InitialCooldown 30
		CooldownTime 30
		BeginAtWave 1
		RunForThisManyWaves 10
		TFBot
		{
			Template T_TFBot_SentryBuster
			Tag giant
		}
	}
	
