	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 5	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////
	
	Mission
	{
		Where spawnbot
		Objective Spy
		BeginAtWave 5
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 20
		DesiredCount 2
		TFBot
		{
			Template FW_Spy
		}
	}
	
	Wave
	{
		Checkpoint Yes
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`popextensions_main`, getroottable())
				
				IncludeScript(`pseudo_medieval`)
				
				// Tankextensions
				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/targetank`, getroottable())
				IncludeScript(`tankextensions/hammertank`, getroottable())
				
				// MissionAttributes.SetConvar(`tf_bot_flag_escort_max_count`, 0)
				
				PopExt.AddRobotTag(`leave_squad`,
				{
					OnSpawn = function(bot,tag)
					{
						bot.LeaveSquad();
					}
				})
			"
		}
		
