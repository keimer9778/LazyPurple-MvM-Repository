WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 0
	CanBotsAttackWhileInSpawnRoom no

	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 1	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////
	
	Wave
	{
		Checkpoint Yes
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`popextensions_main`, getroottable())
				
				IncludeScript(`pseudo_medieval`)
			"
		}
		
		//////////////////////////
		//		 W1Support		//
		//////////////////////////
        
		WaveSpawn
