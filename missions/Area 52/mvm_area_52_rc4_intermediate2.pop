	// WAVE 3 //////////CURRENCY 1000///////////////////////////////////
	Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		
		InitWaveOutput
        {
            Target bignet
            Action RunScriptCode
            Param "
			EntFire(`wave_finished_relay`, `Trigger`)
            TankExtPacked.AddTankIcon(4, `tank_gate`, `gatetank*`, 2)    
            "
        }

