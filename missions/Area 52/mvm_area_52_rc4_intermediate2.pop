	// WAVE 1 //////////CURRENCY 1000///////////////////////////////////
	Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}

		InitWaveOutput
		{
			Target	wave_finished_relay
			Action	trigger
		}

