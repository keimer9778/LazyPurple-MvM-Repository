#base robot_standard.pop
#base robot_giant.pop
#base robot_gatebot_modular.pop
#base robot_click.pop
#base robot_click_giant.pop
#base ex_upgrade_click.pop

https://youtu.be/o4OsvOqHnZM?si=0BZpZjrYNRjJEXCa
{
	StartingCurrency	600
	RespawnWaveTime		3
	CanBotsAttackWhileInSpawnRoom	no
	FixedRespawnWaveTime			no

	PrecacheModel "models/buildables/amplifier_test/amplifier.mdl"

	PointTemplates
	{
		init_mission_logic
		{
			point_populator_interface
			{
				"targetname" "pop_interface"
			}
		}

		uber_generator_template
		{
			RemoveIfKilled "uber_generator"
			OnSpawnOutput
			{
				target boss_hint
				action Show
			}
			training_annotation
			{
				"targetname"   "boss_hint"
				"display_text" "Uber Generator Deployed!"
				"lifetime"     "8"
				"origin" "0 0 0"
			}
			OnSpawnOutput
			{
				Target "tf_gamerules"
				Action "PLayVO"
				Param "mvm\mvm_tele_deliver.wav"
			}
			OnParentKilledOutput
			{
				Target flag_glow
				Action Enable
				Delay 1
			}
			OnSpawnOutput
			{
				Target "uber_generator"
				Action "Sethealth"
				Param 500
			}
			OnSpawnOutput
			{
				Target "uber_generator"
				Action "$setmodeloverride"
				Param "models/buildables/amplifier_test/amplifier.mdl"
			}
			tf_glow
            {
                "GlowColor" "0 176 199 255"
                "target" "uber_generator"
				"targetname" "flag_glow"
				"startdisabled" "1"
            }
			obj_dispenser
			{
				"targetname" "uber_generator"
				"origin" "0 0 0"
				"teamnum" "3"
				"SolidToPlayer" "0"
				"defaultupgrade" "1"
				"$attributeoverride" 1
				// "$radiusmult" 3
				"OnDestroyed" "boss_uber_counter,Add,1,0,1"
				"OnDestroyed" "tf_gamerules,PlayVO,ambient\machines\thumper_shutdown1.wav,0.1,1"
			}
			info_particle_system
            {
                "targetname"   "beam"
                "origin"       "0 0 0"
                "effect_name"  "teleporter_mvm_bot_persist"
                "start_active" "1"
            }
		}

		teleporter_template
		{
			RemoveIfKilled "teleporter"
			OnSpawnOutput
			{
				target boss_hint
				action Show
			}
			training_annotation
			{
				"targetname"   "boss_hint"
				"display_text" "Enemy Teleporter Deployed!"
				"lifetime"     "8"
				"origin" "0 0 0"
			}
			OnSpawnOutput
			{
				Target "tf_gamerules"
				Action "PLayVO"
				Param "mvm\mvm_tele_deliver.wav"
			}
			OnParentKilledOutput
			{
				Target flag_glow
				Action Enable
				Delay 1
			}
			OnSpawnOutput
			{
				Target "teleporter"
				Action "Sethealth"
				Param 2000
			}
			tf_glow
            {
                "GlowColor" "0 176 199 255"
                "target" "teleporter"
				"targetname" "flag_glow"
				"startdisabled" "1"
            }
			obj_teleporter
			{
				"targetname" "teleporter"
				"origin" "0 0 0"
				"teamnum" "3"
				"SolidToPlayer" "0"
				"TeleportWhere" "spawnbot"
				"TeleportWhere" "spawnbot_side"
				"TeleportWhere" "spawnbot_invasion"
				"TeleportWhere" "spawnbot_mission_sentrybuster"
				"TeleportWhere" "spawnbot_mission_sniper"
				"TeleportWhere" "spawnbot_mission_sniper_side"
			}
			info_particle_system
            {
                "targetname"   "beam"
                "origin"       "0 0 0"
                "effect_name"  "teleporter_mvm_bot_persist"
                "start_active" "1"
            }
		}

        boss_logic
        {
			KeepAlive 1
            OnSpawnOutput
            {
                Target boss
				Action SetParent
				Param "!activator"
				Delay 0.05
            }
			OnSpawnOutput
            {
                Target temporary_solution
                Action $SetOwner
                Param "@p@boss"
                Delay 2
            }
            info_target
            {
                "TargetName" "boss"
                "origin" "0 0 0"
            }
        }

		boss_wave_logic
		{
			OnSpawnOutput
			{
				Target "pause_spawn"
				Action "Trigger"
				Delay 1
			}
			logic_relay
			{
				"targetname" "pause_spawn"
				"OnTrigger"  "pop_interface,$PauseWavespawn,w8_phase3,0,-1"
			}

