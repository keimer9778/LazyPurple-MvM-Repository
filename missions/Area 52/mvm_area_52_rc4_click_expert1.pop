			info_target
			{
				"targetname" "uber_generator_spawnpoint8"
				"origin"     "-230 -574 -576"
			}
			info_target
			{
				"targetname" "uber_generator_spawnpoint9"
				"origin"     "429 568 -256"
			}
			logic_case
			{
				"targetname" "uber_generator_spawn_cases"
				"OnCase01" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint1,0.0,-1"
				"OnCase02" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint2,0.0,-1"	
				"OnCase03" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint3,0.0,-1"
				"OnCase04" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint4,0.0,-1"
				"OnCase05" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint5,0.0,-1"
				"OnCase06" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint6,0.0,-1"
				"OnCase07" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint7,0.0,-1"
				"OnCase08" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint8,0.0,-1"
				"OnCase09" "uber_generator_template,ForceSpawnAtEntityOrigin,uber_generator_spawnpoint9,0.0,-1"
			}
			math_counter
            {
                "targetname" "boss_uber_counter"
                "startvalue" "0"
                "min" "0"
                "max" "3"
				"OnHitMax" "boss_uber_counter,SetValue,0,2,-1"
				"OnHitMax" "boss_uber_counter,SetHitMax,5,2,-1"
				"OnHitMax" "@p@boss,$RemoveCond,51,0,-1"
				"OnHitMax" "tf_gamerules,PlayVO,player\invulnerable_off.wav,0,-1"
            }

			info_target
			{
				"targetname" "teleporter_spawnpoint1"
				"origin"     "-230 -574 -576"
			}
			info_target
