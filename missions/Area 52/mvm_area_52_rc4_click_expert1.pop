			{
				"targetname" "teleporter_spawn_cases"
				"OnCase01" "teleporter_template,ForceSpawnAtEntityOrigin,teleporter_spawnpoint1,0.0,-1"
				"OnCase02" "teleporter_template,ForceSpawnAtEntityOrigin,teleporter_spawnpoint2,0.0,-1"	
