    // Wave 5-6 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         5
        RunForThisManyWaves 2
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }

    // Wave 5 Engineers
    Mission
    {
        Objective           Engineer
        InitialCooldown     15
        Where               spawnbot
        BeginAtWave         5
        RunForThisManyWaves 1
        CooldownTime        45
        DesiredCount        2
    
        TFBot
        {
            Template T_TFBot_Engineer_Sentry_Battle
        }
    }

    // Wave 2 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         2
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }
    

    // Wave 3 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         3
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    
    // Wave 1-6 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot
        BeginAtWave         1
        RunForThisManyWaves 6
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 1 - X 700
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        // Soldier + GHammer Pyro
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 20
            MaxActive 8
            SpawnCount 4
            WaitBeforeStarting 0
            WaitBetweenSpawns 12
            TotalCurrency 200
            TFBot
            {
                Class Soldier
                Skill Expert
            }
        }

         WaveSpawn
        {
            Name "wave1a"
            Where spawnbot_mid_giant
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 30
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Giant_Pyro_Sledgehammer
                Skill Expert
            }
        }

        // SANDMEN
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 30
            MaxActive 15
            SpawnCount 5
            WaitBeforeStarting 0.5
            WaitBetweenSpawns 6
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Scout_Bonk
            }
        }
         WaveSpawn
        {
            Name "wave1b"
            Where spawnbot_mid_giant
            TotalCount 6
            MaxActive 6
            SpawnCount 6
            WaitForAllDead "wave1a"
            WaitBeforeStarting 10
            WaitBetweenSpawns 0
            TotalCurrency 200
            Squad
            {
                FormationSize 200
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                    Template T_TFBot_Giant_Pyro_Sledgehammer
                }
        
                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }

                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }

                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }

                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }

                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }
            }
        }
        // Pyro + Meds
        WaveSpawn
        {
            Name "wave1b"
            Where spawnbot
            TotalCount 40
            MaxActive 18
            SpawnCount 6
            WaitForAllDead "wave1a"
            WaitBeforeStarting 0
            WaitBetweenSpawns 6
            TotalCurrency 100
            Squad
            {
                FormationSize 200
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                    Class Pyro
                    Skill Expert
                    Attributes AlwaysFireWeapon
                }
        
                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }
            }
        }
         WaveSpawn
        {
            Name "wave1b"
            Where spawnbot
            TotalCount 30
            MaxActive 15
            WaitForAllDead "wave1a"
            SpawnCount 5
            WaitBeforeStarting 0.5
            WaitBetweenSpawns 6
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Scout_Bonk
            }
        }
    }

