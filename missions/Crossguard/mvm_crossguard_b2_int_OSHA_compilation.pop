// Ismac //
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
    StartingCurrency                      400
    RespawnWaveTime                       7
    CanBotsAttackWhileInSpawnRoom         No
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  Yes
    Advanced                              1

    Templates
	{
        T_TFBot_Heavyweapons_Nailgun
		{
			Class Heavyweapons
			Name "Nailgun Heavy"
			ClassIcon heavy_nail 
			Skill Expert
            Item "The Data Mining Light"
			Item "Natascha"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 784
			ItemAttributes 
			{
				ItemName "Natascha"
                "override projectile type" 5
                "fire rate penalty" 0.25
                "damage bonus" 1.1
                "head scale" 1.1
                "projectile spread angle penalty" 9
                "slow enemy on hit" 0
			}
		}

        T_TFBot_Heavyweapons_Nailgun_MadMilk
		{
			Class Heavyweapons
			Name "Milk Nailgun Heavy"
			ClassIcon heavy_nail_milk 
			Skill Expert
            Item "Der Maschinensoldaten-Helm"
			Item "Natascha"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 784
			ItemAttributes 
			{
				ItemName "Natascha"
                "override projectile type" 5
                "fire rate penalty" 0.25
                "damage bonus" 1.1
                "head scale" 1.1
                "projectile spread angle penalty" 9
                "slow enemy on hit" 0
                "heal on hit for rapidfire" 20
                "mad milk syringes" 1
			}
		}

        T_TFBot_Giant_Heavyweapons_Nailgun
		{
			Class Heavyweapons
			Name "Giant Nailgun Heavy"
			ClassIcon heavy_nail_giant
			Skill Expert
			Health 5000
            Item "The Data Mining Light"
            Item "Big Steel Jaw of Summer Fun"
			Item "Natascha"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 1200
			Attributes MiniBoss
			ItemAttributes 
			{
				ItemName "Natascha"
                "override projectile type" 5
                "centerfire projectile" 1
                "fire rate penalty" 0.15
                "damage bonus" 1.76
                "head scale" 0.8
                "projectile spread angle penalty" 12
                "slow enemy on hit" 0
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.3
				"airblast vulnerability multiplier" 0.3
				"override footstep sound set" 2
			}
		}
        T_TFBot_Giant_Heavyweapons_Nailgun_MadMilk
		{
			Class Heavyweapons
			Name "Giant Milk Nailgun Heavy"
			ClassIcon heavy_nail_milk_giant
			Skill Expert
			Health 6500
            Item "Der Maschinensoldaten-Helm"
            Item "Big Steel Jaw of Summer Fun"
			Item "Natascha"
			WeaponRestrictions PrimaryOnly
            Attributes UseBossHealthBar
			MaxVisionRange 1200
			Attributes MiniBoss
			ItemAttributes 
			{
				ItemName "Natascha"
                "override projectile type" 5
                "centerfire projectile" 1
                "fire rate penalty" 0.15
                "damage bonus" 1.76
                "head scale" 0.8
                "projectile spread angle penalty" 12
                "slow enemy on hit" 0
                "heal on hit for rapidfire" 20
                "mad milk syringes" 1
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.3
				"airblast vulnerability multiplier" 0.3
				"override footstep sound set" 2
			}
		}
        T_TFBot_Medic_Kritz
        {
            Class Medic
            Name "Kritz Medic"
            Skill Expert
            ClassIcon medic_kritz_lite
            WeaponRestrictions SecondaryOnly
            Attributes SpawnWithFullCharge
            Attributes IgnoreEnemies
            Item  "the kritzkrieg"
            Item "Platinum Pickelhaube"
            ItemAttributes
            {
                ItemName "The Kritzkrieg"
                "ubercharge rate bonus" 999
                "uber duration bonus" 999
            }
            CharacterAttributes
            {
                "bot medic uber health threshold" 999            
            }
        }
        T_TFBot_Giant_Pyro_Sledgehammer
		{
			Class Pyro
			Name "Giant Homewrecker Pyro"
			ClassIcon pyro_homewrecker_lite_giant
			Skill Expert
			Health 3500
			WeaponRestrictions MeleeOnly
            Item "The Homewrecker"
            Item "The Tin-1000"
			Attributes MiniBoss
            ItemAttributes
            {
                ItemName "The Homewrecker"
                "damage bonus" 2
                "melee range multiplier" 1.2
                "dmg bonus vs buildings" 100
            }
			CharacterAttributes
			{
				"move speed bonus"	0.4
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.1
				"override footstep sound set" 6
                "SET BONUS: dmg from sentry reduced" 0.15
			}
		}

        T_TFBot_Pyro_Sledgehammer
		{
			Class Pyro
			Skill Normal
            Health 150
            ClassIcon pyro_homewrecker_lite
			WeaponRestrictions MeleeOnly
            Item "The Homewrecker"
            Item "The Tin-1000"
            ItemAttributes
            {
                ItemName "The Homewrecker"
                "damage bonus" 1.5
                "melee range multiplier" 1.2
                "dmg bonus vs buildings" 20
            }
            CharacterAttributes
			{
                "SET BONUS: dmg from sentry reduced" 0.5
			}
		}
	}
    

    // Wave 5-6 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         5
        RunForThisManyWaves 2
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }

    // Wave 2 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         2
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }
    

    // Wave 4 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         4
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    
    // Wave 1-6 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot
        BeginAtWave         1
        RunForThisManyWaves 6
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 1 - X 700
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				
			"
		}

        // hammer Pyros
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 35
            MaxActive 10
            SpawnCount 5
            WaitBeforeStarting 0
            WaitBetweenSpawns 1
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
            }
        }
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 35
            MaxActive 12
            SpawnCount 4
            WaitBeforeStarting 15
            WaitBetweenSpawns 1
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Heavyweapons_Heavyweight_Champ_Fast
            }
        }
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot_left
            TotalCount 5
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 7
            TotalCurrency 100
            TFBot
            {
                Class Soldier
                Skill Normal
            }
        }
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot_right
            TotalCount 5
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 7
            TotalCurrency 100
            TFBot
            {
                Class Soldier
                Skill Normal
            }
        }
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot_mid
            TotalCount 5
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 7
            TotalCurrency 100
            TFBot
            {
                Class Soldier
                Skill Normal
            }
        }
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 10
            MaxActive 4
            SpawnCount 2
            WaitBeforeStarting 60
            WaitBetweenSpawns 1
            TotalCurrency 100
            Squad
            {
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                   Class Soldier
                   Skill Normal
                }
        
                TFBot
                {
                   Template T_TFBot_Medic_QuickFix
                }
            }
        }
    }

    // Wave 2 - 700 
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				
			"
		}

        WaveSpawn
        {
            Name "wave2a"
            Where spawnbot
            TotalCount 48
            MaxActive 12
            SpawnCount 6
            WaitBeforeStarting 1
            WaitBetweenSpawns 10
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Heavyweapons_Gnome
            }
        }

        WaveSpawn
        {
            Name "wave2a"
            Where spawnbot
            TotalCount 4
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 25
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Giant_Scout_Fast
            }
        }
        WaveSpawn
        {
            Name "wave2A"
            Where spawnbot_mid_giant
            TotalCount 8
            MaxActive 4
            SpawnCount 4
            WaitBeforeStarting  35
            WaitBetweenSpawns 25
            TotalCurrency 400
            Squad
            {
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                  Template T_TFBot_Giant_Pyro_Sledgehammer
                }
        
                TFBot
                {
                   Template T_TFBot_Medic_QuickFix
                }

                TFBot
                {
                   Template T_TFBot_Medic_QuickFix
                }

                TFBot
                {
                   Template T_TFBot_Medic_QuickFix
                }
            }
        }
    }

    // Wave 3 - X 700
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay // Replace with "Target wave_start_relay_classic" for Rottenburg
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        
        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				
			"
		}

        // Roller Tank Intro
        WaveSpawn
        {
            Name "wave3aTank"
            TotalCount 1
            WaitBeforeStarting 0
            TotalCurrency 200
            Tank
            {
                Name "tank_roller" // It's not recommended to change this name, as it will break most maps.
                Health 20000
                Speed 75
                StartingPathTrackNode "tank_path_left_1"
                OnKilledOutput
                {
                    Target boss_dead_relay
                    Action Trigger
                }
        
                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
            }
        }

         WaveSpawn
        {
            Name "wave3aKritzintro"
            Where spawnbot
            TotalCount 48
            MaxActive 12
            SpawnCount 4
            WaitBeforeStarting 10
            WaitBetweenSpawns 5
            TotalCurrency 200
            Squad
            {
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                    Template T_TFBot_Heavyweapons_Nailgun
                }
        
                TFBot
                {
                    Template T_TFBot_Medic_Kritz
                }
            }
        }
        WaveSpawn
        {
            Name "wave3ascouts"
            Where spawnbot
            TotalCount 48
            MaxActive 10
            SpawnCount 2
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 200
            Support 1
            RandomChoice
			{
				TFBot
				{
					Template T_TFBot_Scout_Melee
				}
				TFBot
				{
					Template T_TFBot_Scout_Scattergun_SlowFire
				}
			}
        }
        WaveSpawn
        {
            Name "wave3a"
            Where spawnbot_mid_giant
            TotalCount 5
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 45
            WaitBetweenSpawns 5
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Heavyweapons_Fist
            }
        }
        
    }

    // Wave 4 - X 800
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				
			"
		}

        WaveSpawn
        {
            Name "wave4Bulldozerintro"
            TotalCount 1
            WaitBeforeStarting 10
            TotalCurrency 200
            Tank
            {
                Name "tank_bulldozer" 
                Health 30000
                Speed 75
                StartingPathTrackNode "tank_path_right_1"
                OnKilledOutput
                {
                    Target boss_dead_relay
                    Action Trigger
                }
        
                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
            }
        }
        WaveSpawn
        {
            Name "wave4a"
            Where spawnbot
            TotalCount 24
            MaxActive 6
            SpawnCount 3
            WaitBeforeStarting 1
            WaitBetweenSpawns 10
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Heavyweapons_Nailgun
            }
        }

         WaveSpawn
        {
            Name "wave4a"
            Where spawnbot
            TotalCount 64
            MaxActive 12
            SpawnCount 6
            WaitBeforeStarting 1
            WaitBetweenSpawns 10
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
            }
        }

        WaveSpawn
        {
            Name "wave4a"
            Where spawnbot_mid_giant
            TotalCount 4
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 20
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Giant_Soldier
            }
        }
        
    }

    // Wave 5 - 1000
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				
			"
		}
       
        WaveSpawn
        {
            Name "wave5a_GNailHeavy"
            Where spawnbot_mid_giant
            TotalCount 2
            MaxActive 2
            SpawnCount 2
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 200
            Squad
            {
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                    Template T_TFBot_Giant_Heavyweapons_Nailgun
                }
        
                TFBot
                {
                    Template T_TFBot_Giant_Medic
                }
            }
        }

        WaveSpawn
        {
            Name "wave5aSoldiers"
            Where spawnbot_mid
            TotalCount 48
            MaxActive 6
            SpawnCount 6
            WaitForAllDead "wave5a_GNailHeavy"
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 200
            Support 1
            TFBot
            {
                Class Soldier
                Skill Hard
            }
        }
        WaveSpawn
        {
            Name "wave5aSoldiers"
            Where spawnbot_mid
            TotalCount 24
            MaxActive 1
            SpawnCount 1
            WaitForAllDead "wave5a_GNailHeavy"
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 200
            Support 1
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Buff_Banner
            }
        }
        WaveSpawn
        {
            Name "wave5aSoldiers"
            Where spawnbot_mid
            TotalCount 24
            MaxActive 8
            SpawnCount 4
            WaitForAllDead "wave5a_GNailHeavy"
            WaitBeforeStarting 0
            WaitBetweenSpawns 5
            TotalCurrency 200
            Support 1
            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
            }
        }

        WaveSpawn
        {
            Name "wave5a_GNailHeavy2"
            Where spawnbot_left_giant
            TotalCount 4
            MaxActive 2
            SpawnCount 2
            WaitForAllDead "wave5a_GNailHeavy"
            WaitBeforeStarting 15
            WaitBetweenSpawns 35
            TotalCurrency 200
            Squad
            {
                ShouldPreserveSquad 1 // If the squad leader dies, should the rest stay as a squad?
                TFBot
                {
                    Template T_TFBot_Giant_Heavyweapons_Nailgun
                }
        
                TFBot
                {
                    Template T_TFBot_Giant_Medic
                }
            }
        }

       
    }

    // Wave 6 - 1200
    Wave
    {
        StartWaveOutput
        {
            Target wave_start_relay // Replace with "Target wave_start_relay_classic" for Rottenburg
            Action Trigger
        }
        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) OSHA Compilation`)
				EntFire(`pits_close_relay`,`Trigger`)
			"
		}

        WaveSpawn
        {
            Name "wave6a"
            Where spawnbot
            TotalCount 24
            MaxActive 12
            SpawnCount 6
            WaitBeforeStarting 0
            WaitBetweenSpawns 7
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Heavyweapons_Nailgun_MadMilk
            }
        }

        WaveSpawn
        {
            Name "wave6a"
            Where spawnbot
            TotalCount 24
            MaxActive 6
            SpawnCount 3
            WaitBeforeStarting 0
            WaitBetweenSpawns 3
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Soldier_RocketShotgun
            }
        }

        WaveSpawn
        {
            Name "wave6a"
            Where spawnbot
            TotalCount 12
            MaxActive 6
            SpawnCount 3
            WaitBeforeStarting 15
            WaitBetweenSpawns 15
            TotalCurrency 100
            Support 1
            TFBot
            {
                Template T_TFBot_Medic_QuickFix
            }
        }

        WaveSpawn
        {
            Name "wave6a_GiantBoss"
            Where spawnbot_left_giant
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 30
            WaitBetweenSpawns 15
            TotalCurrency 450
            TFBot
            {
                Template T_TFBot_Giant_Heavyweapons_Nailgun_MadMilk
            }
        }

        WaveSpawn
        {
            Name "wave6a_GiantBoss"
            Where spawnbot_right_giant
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 15
            WaitBetweenSpawns 15
            TotalCurrency 450
            TFBot
            {
                Template T_TFBot_Giant_Heavyweapons_Nailgun_MadMilk
            }
        }

    }
}