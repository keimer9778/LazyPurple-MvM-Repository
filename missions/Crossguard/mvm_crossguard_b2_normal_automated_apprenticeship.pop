    // Wave 4-6 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         4
        RunForThisManyWaves 6
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }
    

    // Wave 3 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
