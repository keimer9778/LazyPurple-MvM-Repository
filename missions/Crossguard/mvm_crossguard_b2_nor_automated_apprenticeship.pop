        }

        WaveSpawn
        {
            Name wave3c
            Where spawnbot_mid_giant
            TotalCount 8
            MaxActive 4
            SpawnCount 4
            WaitForAllSpawned wave3b
            WaitBeforeStarting 0
            WaitBetweenSpawns 25
            TotalCurrency 100

            Squad
            {
                ShouldPreserveSquad 1	// If the squad leader dies, should the rest stay as a squad?

                TFBot
                {
                    Template T_TFBot_Giant_Pyro_Sledgehammer
                }

                TFBot
                {
                    Template T_TFBot_Medic_QuickFix
                }

                TFBot
                {
                    Template T_TFBot_Medic_QuickFix
                }

                TFBot
                {
                    Template T_TFBot_Medic_QuickFix
                }
            }
        }

        WaveSpawn
        {
            Name wave3d
            Where spawnbot_mid_giant
            TotalCount 16
            MaxActive 8
            SpawnCount 4
            WaitForAllSpawned wave3c
            WaitBeforeStarting 0
            WaitBetweenSpawns 7
            TotalCurrency 200

            Squad
            {
                ShouldPreserveSquad 1	// If the squad leader dies, should the rest stay as a squad?

                TFBot
                {
                    Template T_TFBot_Soldier_Extended_Buff_Banner
                }

                TFBot
                {
                    Template T_TFBot_Heavyweapons_Nailgun
                }

                TFBot
                {
                    Template T_TFBot_Heavyweapons_Nailgun
                }

                TFBot
                {
                    Template T_TFBot_Heavyweapons_Nailgun
                }
            }
        }

        WaveSpawn
        {
            Name wave3support
            Where spawnbot
            TotalCount 27
            MaxActive 9
            SpawnCount 3
            WaitForAllSpawned wave3c
            WaitBeforeStarting 0
            WaitBetweenSpawns 3
            TotalCurrency 100
            Support 1

            TFBot
            {
                Template T_TFBot_Scout_Melee
                Skill Normal
            }
        }
    }

    // Wave 4 - 1000
    Wave
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
