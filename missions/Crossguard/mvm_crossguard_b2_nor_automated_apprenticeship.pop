// Ismac //
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
    StartingCurrency 1100
    RespawnWaveTime 2
    CanBotsAttackWhileInSpawnRoom No
    AddSentryBusterWhenKillCountExceeds 15
    AddSentryBusterWhenDamageDealtExceeds 3000
    FixedRespawnWaveTime Yes

    Templates
    {
        T_TFBot_Heavyweapons_Nailgun
        {
            Class Heavyweapons
            Name "Nailgun Heavy"
            ClassIcon heavy_nail
            Skill Expert
            Item "The Data Mining Light"
            Item Natascha
            WeaponRestrictions PrimaryOnly
            MaxVisionRange 784

            ItemAttributes
            {
                ItemName Natascha
                "override projectile type" 5
                "fire rate penalty" 0.25
                "damage bonus" 1.1
                "head scale" 1.1
                "projectile spread angle penalty" 9
                "slow enemy on hit" 0
            }
        }

        T_TFBot_Giant_Heavyweapons_Nailgun
        {
            Class Heavyweapons
            Name "Giant Nailgun Heavy"
            ClassIcon heavy_nail_giant
            Skill Expert
            Health 5000
            Item "The Data Mining Light"
            Item "Big Steel Jaw of Summer Fun"
            Item Natascha
            WeaponRestrictions PrimaryOnly
            MaxVisionRange 1200
            Attributes MiniBoss

            ItemAttributes
            {
                ItemName Natascha
                "override projectile type" 5
                "centerfire projectile" 1
                "fire rate penalty" 0.15
                "damage bonus" 1.76
                "head scale" 0.8
                "projectile spread angle penalty" 12
                "slow enemy on hit" 0
            }

            CharacterAttributes
            {
                "move speed bonus" 0.5
                "damage force reduction" 0.3
                "airblast vulnerability multiplier" 0.3
                "override footstep sound set" 2
            }
        }

        T_TFBot_Giant_Pyro_Sledgehammer
        {
            Class Pyro
            Name "Giant Homewrecker Pyro"
            ClassIcon pyro_homewrecker_lite_giant
            Skill Expert
            Health 3500
            WeaponRestrictions MeleeOnly
            Item "The Homewrecker"
            Item "The Tin-1000"
            Attributes MiniBoss

            ItemAttributes
            {
                ItemName "The Homewrecker"
                "damage bonus" 2
                "melee range multiplier" 1.2
                "dmg bonus vs buildings" 100
            }

            CharacterAttributes
            {
                "move speed bonus" 0.4
                "damage force reduction" 0.6
                "airblast vulnerability multiplier" 0.1
                "override footstep sound set" 6
                "SET BONUS: dmg from sentry reduced" 0.15
            }
        }

        T_TFBot_Pyro_Sledgehammer
        {
            Class Pyro
            Skill Normal
            Health 150
            ClassIcon pyro_homewrecker_lite
            WeaponRestrictions MeleeOnly
            Item "The Homewrecker"
            Item "The Tin-1000"

            ItemAttributes
            {
                ItemName "The Homewrecker"
                "damage bonus" 1.5
                "melee range multiplier" 1.2
                "dmg bonus vs buildings" 20
            }

            CharacterAttributes
            {
                "SET BONUS: dmg from sentry reduced" 0.5
            }
        }
    }

    // Wave 4-6 Snipers
    Mission
    {
        Objective Sniper
        Where spawnbot_mission_sniper
        BeginAtWave 4
        RunForThisManyWaves 6
        CooldownTime 60
        DesiredCount 2
        InitialCooldown 60

        TFBot
        {
            Template T_TFBot_Sniper
            Skill Normal
        }
    }

    // Wave 3 Spies
    Mission
    {
        Objective Spy
        Where spawnbot_mission_spy
        BeginAtWave 3
        RunForThisManyWaves 1
        CooldownTime 60
        DesiredCount 2
        InitialCooldown 60

        TFBot
        {
            Template T_TFBot_Spy
        }
    }

    // Wave 5 Spies
    Mission
    {
        Objective Spy
        Where spawnbot_mission_spy
        BeginAtWave 5
        RunForThisManyWaves 1
        CooldownTime 60
        DesiredCount 2
        InitialCooldown 60

        TFBot
        {
            Template T_TFBot_Spy
        }
    }

    // Wave 1-6 Sentry Busters
    Mission
    {
        Objective DestroySentries
        Where spawnbot
        BeginAtWave 1
        RunForThisManyWaves 6
        CooldownTime 70
        DesiredCount 1
        InitialCooldown 30

        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 1 - 700
    Wave
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Normal) Automated Apprenticeship`)
				
			"
        }

        //Scout + Hammer Pyro Intro
        WaveSpawn
        {
            Name wave1a
            Where spawnbot
            TotalCount 25
            MaxActive 5
            SpawnCount 5
            WaitBeforeStarting 4
            WaitBetweenSpawns 7
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Scout_Melee
                Skill Normal
            }
        }

        WaveSpawn
        {
            Name wave1a
            Where spawnbot
            TotalCount 20
            MaxActive 6
            SpawnCount 3
            WaitBeforeStarting 15
            WaitBetweenSpawns 8
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
                Skill Normal
            }
        }

        WaveSpawn
        {
            Name wave1b
            Where spawnbot
            TotalCount 20
            MaxActive 10
            SpawnCount 5
            WaitForAllSpawned wave1a
            WaitBetweenSpawns 7
            TotalCurrency 100

            TFBot
            {
                Class Pyro
                Skill Easy
            }
        }

        WaveSpawn
        {
            Name wave1b
            Where spawnbot
            TotalCount 25
            MaxActive 15
            SpawnCount 5
            WaitForAllSpawned wave1a
            WaitBeforeStarting 4
            WaitBetweenSpawns 7
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Scout_Sandman
                Skill Normal
            }
        }
    }

    // Wave 2 - 800
    Wave
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Normal) Automated Apprenticeship`)
				
			"
        }

        // Demo + Pyro Sledgehammers
        WaveSpawn
        {
            Name wave2a
            Where spawnbot
            TotalCount 27
            MaxActive 9
            SpawnCount 3
            WaitBeforeStarting 1
            WaitBetweenSpawns 10
            TotalCurrency 150

            TFBot
            {
                Class Demoman
                Skill Normal
            }
        }

        WaveSpawn
        {
            Name wave2Support
            Where spawnbot
            TotalCount 27
            MaxActive 3
            SpawnCount 3
            WaitBeforeStarting 1
            WaitBetweenSpawns 3
            TotalCurrency 50
            Support 1

            TFBot
            {
                Template T_TFBot_Scout_Melee
                Skill Normal
            }
        }

        WaveSpawn
        {
            Name wave2a
            Where spawnbot
            TotalCount 18
            MaxActive 9
            SpawnCount 3
            WaitBeforeStarting 0
            WaitBetweenSpawns 7
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
            }
        }

        // Wave 2 Part B
        WaveSpawn
        {
            Name wave2b
            Where spawnbot
            TotalCount 18
            MaxActive 9
            SpawnCount 3
            WaitForAllSpawned wave2a
            WaitBeforeStarting 0
            WaitBetweenSpawns 7
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Pyro_Sledgehammer
            }
        }

        WaveSpawn
        {
            Name wave2b
            Where spawnbot
            TotalCount 3
            MaxActive 3
            SpawnCount 1
            WaitForAllSpawned wave2a
            WaitBeforeStarting 15
            WaitBetweenSpawns 25
            TotalCurrency 200

            TFBot
            {
                Template T_TFBot_Giant_Pyro_Flare_Spammer
            }
        }
    }

    // Wave 3 - 800
    Wave
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Normal) Automated Apprenticeship`)
				
			"
		}

        WaveSpawn
        {
            Name wave3a
            Where spawnbot
            TotalCount 27
            MaxActive 9
            SpawnCount 3
            WaitBeforeStarting 0
            WaitBetweenSpawns 3
            TotalCurrency 200

            TFBot
