			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Normal) Automated Apprenticeship`)
				
			"
		}

        WaveSpawn
        {
            Name wave4a
            TotalCount 1
            WaitBeforeStarting 10
            TotalCurrency 500

            Tank
            {
                Name tank_roller
                Health 20000
                Speed 75
                StartingPathTrackNode tank_path_left_1

                OnKilledOutput
                {
                    Target boss_dead_relay
                    Action Trigger
                }

                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
