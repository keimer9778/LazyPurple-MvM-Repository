        }

        WaveSpawn
        {
            Name wave4a
            Where spawnbot
            TotalCount 8
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 15
            WaitBetweenSpawns 25
            TotalCurrency 250

            Squad
            {
                ShouldPreserveSquad 1

                TFBot
                {
                    Template T_TFBot_Giant_Soldier
                    Skill Normal
                }

                TFBot
                {
                    Template T_TFBot_Medic_SlowRecharge
                }
            }
        }

        WaveSpawn
        {
            Name wave4b
            Where spawnbot
            TotalCount 24
            MaxActive 6
            SpawnCount 4
            WaitBeforeStarting 60
            WaitBetweenSpawns 3
            TotalCurrency 250

            Squad
            {
                ShouldPreserveSquad 1

                TFBot
                {
                    Class Pyro
                    Skill Normal
                }

                TFBot
                {
                    Template T_TFBot_Medic_QuickFix
                }
