// Ismac //
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
    StartingCurrency                      400
    RespawnWaveTime                       6
    CanBotsAttackWhileInSpawnRoom         No
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  Yes
    Advanced                              1

    Templates
	{
        T_TFBot_Demoman_Caber
		{
			Class Demoman
			Name "Demo Caber"
			ClassIcon demo_caber_nys
			Skill Hard
			Item "The Chargin' Targe"
			Item "The Ullapool Caber"
            Item "Blast Defense"
			WeaponRestrictions MeleeOnly
			ItemAttributes
			{
				ItemName "The Ullapool Caber"
				"charge time increased" 1.5
                "charge recharge rate increased" 2
                "charge impact damage increased" 1.50
                "damage bonus" 1.15
			}
		}
        T_TFBot_Heavyweapons_Nailgun
		{
			Class Heavyweapons
			Name "Nailgun Heavy"
			ClassIcon heavy_accurate_lite
			Skill Expert
            Item "The Data Mining Light"
			Item "Natascha"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 784
			ItemAttributes 
			{
				ItemName "Natascha"
                "override projectile type" 5
                "fire rate penalty" 0.25
                "damage bonus" 1.1
                "head scale" 1.1
                "projectile spread angle penalty" 9
                "slow enemy on hit" 0
			}
		}
        T_TFBot_Pyro_Sledgehammer
		{
			Class Pyro
			Skill Normal
            Health 150
            ClassIcon pyro_homewrecker_lite
			WeaponRestrictions MeleeOnly
            Item "The Homewrecker"
            Item "The Tin-1000"
            ItemAttributes
            {
                ItemName "The Homewrecker"
                "damage bonus" 1.5
                "melee range multiplier" 1.2
                "dmg bonus vs buildings" 20
            }
            CharacterAttributes
			{
                "SET BONUS: dmg from sentry reduced" 0.5
			}
		}
	}

   //Wave 3 Engineers
    Mission
    {
        Objective           Engineer
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         3
        RunForThisManyWaves 1
        CooldownTime        45
        DesiredCount        1
    
        TFBot
        {
            Template T_TFBot_Engineer_Sentry_Battle
        }
    }

    //Wave 7 Engineers
    Mission
    {
        Objective           Engineer
        InitialCooldown     40
        Where               spawnbot
        BeginAtWave         7
        RunForThisManyWaves 1
        CooldownTime        45
        DesiredCount        1
    
        TFBot
        {
            Template T_TFBot_Engineer_Sentry_Battle
        }
    }

    // Wave 4 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         4
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     10
        TFBot
        {
            Template T_TFBot_Spy
        }
    }

    // Wave 6-7 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         6
        RunForThisManyWaves 2
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     10
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    
    
    // Wave 1-7 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot
        BeginAtWave         1
        RunForThisManyWaves 7
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     5
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 1 - 800
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Intermediate) Mannual Labor`)
				
			"
		}

        // hammer Pyros
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot
            TotalCount 70
            MaxActive 10
            SpawnCount 5
            WaitBeforeStarting 0
            WaitBetweenSpawns 1
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Scout_Sandman
            }
        }
        WaveSpawn
        {
            Name "wave1b"
            Where spawnbot_mid_giant
            TotalCount 8
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 15
            WaitBetweenSpawns 3
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Scout_Shortstop
            }
        }
         WaveSpawn
        {
            Name "wave1c"
            Where spawnbot_mid_giant
            TotalCount 2
            MaxActive 2
            SpawnCount 1
            WaitForAllSpawned "wave1b"
            WaitBeforeStarting 0
            WaitBetweenSpawns 25
            TotalCurrency 200
            TFBot
            {
                Template T_TFBot_Giant_Demoman
            }
        }
         WaveSpawn
        {
            Name "wave1c"
            Where spawnbot_mid_giant
            TotalCount 15
            MaxActive 6
            SpawnCount 3
            WaitForAllSpawned "wave1a"
            WaitBeforeStarting 0
            WaitBetweenSpawns 7
            TotalCurrency 200
            TFBot
            {
                Class Soldier
                Skill Easy
            }
        }
    }

