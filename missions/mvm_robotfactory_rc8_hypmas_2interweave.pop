        T_TFBot_Pyro_Powerjack
		{
			Name "Armored Powerjack Pyro"
			Class Pyro
			Skill Expert
			Health 700
			Scale 1.5
			ClassIcon pyro_powerjack_armored
			WeaponRestrictions MeleeOnly
			Item "The Powerjack"
			ItemAttributes
			{
				ItemName "The Powerjack"
				"damage bonus" 1.5
			}
		}
	}
	StartingCurrency	350
	RespawnWaveTime	3
	CanBotsAttackWhileInSpawnRoom	no
	Advanced 1
	Mission
	{
		Objective	DestroySentries
		Where	spawnbot_left
		Where	spawnbot_right
