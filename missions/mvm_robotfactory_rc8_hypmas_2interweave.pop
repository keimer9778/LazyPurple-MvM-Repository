	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
                EntFire(`relay_D`, `Trigger`, null, -1)
                TankExtPacked.CreatePaths({
                drill_breach_path = [
                    Vector(-2680, 1352, -152)    // tank_path_1
                    Vector(-2496, 1560, -144)    // tank_path_2
                    Vector(-2376, 1640, -152)    // tank_path_3
                    Vector(-2256, 1688, -152)    // tank_path_4
                    Vector(-2136, 1704, -152)    // tank_path_5
                    Vector(-2008, 1664, -152)    // tank_path_6
                    Vector(-1912, 1600, -152)    // tank_path_7
                    Vector(-1792, 1544, -152)    // tank_path_8
                    Vector(-1720, 1456, -152)    // tank_path_9
                    Vector(-1688, 1168, -160)    // tank_path_10
                    Vector(-1736, -80, -144)    // tank_path_11
                    Vector(-1728, -776, 24)    // tank_path_12
                    Vector(-1648, -1024, 24)    // tank_path_13
                    Vector(-1592, -1128, 24)    // tank_path_14
                    Vector(-1472, -1216, 16)    // tank_path_15
                    Vector(-1328, -1264, 24)    // tank_path_16
                    Vector(-1176, -1280, 24)    // tank_path_17
                    Vector(0, -1280, 24)    // tank_path_18
                ]
                })
                
				//IncludeScript(`tankextensions/ubertank`, getroottable())
                
                local DrilltankKill = SpawnEntityFromTable(`logic_relay`, {
                    targetname = `DrilltankKill`,
                    `OnTrigger#1` : `drill_breach_path_18,AddOutput,OnPass drilltank_watermine:RemoveHealth:999999999:7.7:-1.0,0.0,-1.0`
                });

                PrecacheSound(`2int_final.mp3`)

				::LocalMusic <- {
					Cleanup = function()
					{
						SendGlobalGameEvent(`teamplay_broadcast_audio`, 
						{
							sound = `2int_final.mp3`
							additional_flags = 0x4 // SND_STOP
							team = 255
						})
					}
					OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
					OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
				}
				
				__CollectGameEventCallbacks(LocalMusic)

				if (`inter_boss` in getroottable()) inter_boss.Cleanup()
			"
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}

