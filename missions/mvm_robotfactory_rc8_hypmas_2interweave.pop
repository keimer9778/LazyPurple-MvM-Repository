#base robot_giant.pop
#base robot_standard.pop
#base robot_pixelbitie.pop
#base robot_click_pixelstate.pop
#base robot_click_updated.pop
#base robot_click_giant_pixelstate.pop

// thanks to clickin for the infamous click robot templates

population
{
	PrecacheSound "2int_final.mp3" [$SIGSEGV]

	PointTemplates [$SIGSEGV]
	{
		interwovenTemplate
		{
			OnSpawnOutput
			{
				Target "InterwovenText"
				Action Trigger
			}
			logic_relay												// This relay triggers at the end of Wave 5.
			{
				"TargetName" "InterwovenText"
				"OnTrigger"  "InterwovenMessage,Display,,0,1"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "InterwovenMessage"
				"message" "KILL THE BOSS TO DEACTIVATE THE TANK'S UBER"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "52 176 247"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "3"
			}
		}
		finalWaveText
		{
			OnSpawnOutput
			{
				Target "warningText"
				Action Trigger
			}
			logic_relay
			{
				"TargetName" "warningText"
				"OnTrigger"  "warningMessage,Display,,0,1"
			}
			logic_relay
			{
				"TargetName" "emergencyText"
				"OnTrigger"  "emergencyMessage,Display,,0,1"
			}
			logic_relay
			{
				"TargetName" "drillText"
				"OnTrigger"  "drillMessage,Display,,0,1"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "warningMessage"
				"message" "/// WARNING ///"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "3"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "emergencyMessage"
				"message" "/// FACILITY EMERGENCY SYSTEMS ENGAGED ///"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "3"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "drillMessage"
				"message" "/// A TELEPORTER HAS BEEN DRILLED INTO THE GROUND ///"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "5"
			}
		}
	}

	Templates
	{
        T_TFBot_Soldier_FastRocket
		{
			ClassIcon	soldier_accel
			Name	"Fast Rocket Soldier"
			Class	Soldier
			Skill	Hard
			Item "gentlemanne_rocketlauncher_coffinnail"
			ItemAttributes
			{
				ItemName "gentlemanne_rocketlauncher_coffinnail"
				"projectile speed increased" 0.25 [$SIGSEGV]
				"projectile acceleration" 5000 [$SIGSEGV]
        		"projectile acceleration time" 1 [$SIGSEGV]
        		"projectile acceleration start time" 0.25 [$SIGSEGV]
			}
		}
        T_TFBot_Giant_Soldier_Reserve
		{
			Class Soldier
			Name "Giant Reserve Soldier"
			ClassIcon shotgun_reserve_lite
			Skill Expert
			Health 3800
			WeaponRestrictions SecondaryOnly
			Attributes MiniBoss
			Item "The Reserve Shooter"
			ItemAttributes
			{
				ItemName	"The Reserve Shooter"
				"faster reload rate" -0.8
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
			}
		}
