            Health 400
			ItemAttributes
			{
				ItemName	"Batsaber"
				"damage bonus"	3.0
			}
			Item	"Batsaber"
		}
        T_TFBot_Heavyweapons_Eviction_Armored
		{
			Class Heavyweapons
