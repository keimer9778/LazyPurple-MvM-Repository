
#base robot_standard.pop 
#base robot_giant.pop
#base robot_moonlight_nai.pop

// Hanami Int
// Why Not

//spawnbot - Near Tank Barrier
//spawnbot_flank - Near Tank Start Path
//spawnbot_river - Front

WaveSchedule
{
	StartingCurrency 1000
	RespawnWaveTime 4
	FixedRespawnWaveTime No
	NoRomevisionCosmetics 1
	CanBotsAttackWhileInSpawnRoom No

	PrecacheGeneric "materials/hud/leaderboard_class_demoknight_samurai_sakura"
	PrecacheGeneric "materials/hud/leaderboard_class_soldier_sakura"

	PrecacheModel "models/bots/boss_bot/boss_blimp_main.mdl"    
	PrecacheModel "models/bots/boss_bot/boss_blimp_main_damage1.mdl"    
	PrecacheModel "models/bots/boss_bot/boss_blimp_main_damage2.mdl"    
 	PrecacheModel "models/bots/boss_bot/boss_blimp_main_damage3.mdl"   

	PointTemplates
	{
		PinkTank
		{
			OnspawnOutput
			{
				Target !activator
				Action color
				Param "255 153 204"
			}
		}
		Springtext
        {
			OnSpawnOutput
			{
				Target "upper_text"
				Action "Display"
				Delay 1.5
			}
			OnSpawnOutput
			{
				Target "text_lower"
				Action "Display"
				Delay 3
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text"
				"message" "Embodiment of Spring"
				"x" "-1"
				"y" "0.4"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 255"
				"fxtime" "0.2"
				"fadeout" "1"
				//"fadein" "0"
				"holdtime" "3"
			}

			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "text_lower"
				"message" "Takizakura & Zakura"
				"x" "-1"
				"y" "0.45"
				"channel" "0"
				"spawnflags" "1"
				"color" "255 153 204"
				"fadein" "0.2"
				"fadeout" "1"
				"holdtime" "3.5"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "layer_text"
				"message" "Takizakura & Zakura"
				"x" "-1"
				"y" "0.45"
				"channel" "4"
				"spawnflags" "1"
				"color" "255 153 204"
				"fadein" "0.2"
				"fadeout" "1"
				"holdtime" "3.5"
			}
        }
	}
	ExtraTankPath
	{
		Name "tank_blimp_path1"
		Node "-1920 -1536 384"    // tank_path_1
		Node "-1536 -1064 328"    // tank_path_2
		Node "-1216 -232 288"    // tank_path_3
		Node "-1200 976 272"    // tank_path_4
