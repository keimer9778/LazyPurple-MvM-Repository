                    Damage1    "models/bots/boss_bot/boss_blimp_main_damage1.mdl"
                    Damage2    "models/bots/boss_bot/boss_blimp_main_damage2.mdl"
                    Damage3    "models/bots/boss_bot/boss_blimp_main_damage3.mdl"
                }
