	Wave
	{
        InitWaveOutput
		{
			Target gamerules
			Action RunScriptCode
			Param
			"
				EntFire(`spawnbot_placeholder1`, `Disable`)

				::subwaveCount <- 0

				::advanceSubwaveCounter <- function() {
					subwaveCount++
					switch(subwaveCount) {
						case 1:
							EntFire(`spawnbot_placeholder1`, `Enable`, null, 24)
						break
						case 2:
							EntFire(`spawnbot_placeholder1`, `Enable`, null, 12)
						break
						case 3:
							EntFire(`spawnbot_placeholder1`, `Enable`, null, 6)
						break

						case 4:
							EntFire(`spawnbot_placeholder1`, `Enable`)
						break
					}
				}
			"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput					
		{
			Target wave_finished_relay
			Action trigger
		}

