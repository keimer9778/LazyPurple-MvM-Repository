	AddSentryBusterWhenDamageDealtExceeds	2000
	AddSentryBusterWhenKillCountExceeds	18
	Advanced	1
	BodyPartScaleSpeed 35 [$SIGSEGV]
	SentryHintBombForwardRange 500 [$SIGSEGV] // How far in front of the bomb the engineer can teleport in (default: 0)
	SentryHintBombBackwardRange 5000 [$SIGSEGV] // How far behind the bomb the engineer can teleport in (default: 3000)
	
	
	
