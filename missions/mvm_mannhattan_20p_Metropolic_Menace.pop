    PointTemplates 
    {
        airstrike_buster_detonation
        {
            KeepAlive 1
            RemoveIfKilled detonation_airsb
            OnParentKilledOutput
            {
                Target detonation_airsb
                Action firemultiple
                Param 12 // This number controlls how many pills are ejected
                Delay -1
            }
            tf_point_weapon_mimic
            {
                "targetname"   "detonation_airsb"
                "angles"       "0 0 0"
                "origin"       "0 0 820"
                "teamnum"      "3"
                "$weaponname"   "buster_airstrike"
            } 
            OnSpawnOutput // Assinging an owner to the weapon mimic enables a kill cam displaying the buster as the killer 
            {
                Target detonation_airsb
                Action $SetOwner
                Param "!activator"
                Delay -1
            }
            OnParentKilledOutput
            {
                Target detonation_airsb // Cleans up to avoid possible edict stuff
                Action Kill
                Delay 2
            }
        }
		airstrike_buster_detonation_crit
        {
            KeepAlive 1
            RemoveIfKilled detonation_airsb
            OnParentKilledOutput
            {
                Target detonation_airsb
                Action firemultiple
                Param 12 // This number controlls how many pills are ejected
                Delay -1
            }
            tf_point_weapon_mimic
            {
                "targetname"   "detonation_airsb"
                "angles"       "0 0 0"
                "origin"       "0 0 820"
                "teamnum"      "3"
                "$weaponname"   "buster_airstrike_crit"
            } 
            OnSpawnOutput // Assinging an owner to the weapon mimic enables a kill cam displaying the buster as the killer 
            {
                Target detonation_airsb
                Action $SetOwner
                Param "!activator"
                Delay -1
            }
            OnParentKilledOutput
            {
                Target detonation_airsb // Cleans up to avoid possible edict stuff
                Action Kill
                Delay 2
            }
        }
	}
