WaveSchedule
{
	StartingCurrency 800
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 2

	Advanced 1

// MISSION: Sentry Buster
	Mission
	{
		Objective DestroySentries
		Where spawnbot
		CooldownTime 27
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	// MISSION: Spy 01
	Mission
	{
		Objective Spy
		
		Where spawnbot_mission_spy
		
		BeginAtWave	1
		RunForThisManyWaves 1
		CooldownTime 30
		InitialCooldown 20
		DesiredCount 2
		
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Mission // Engineer - wave 2
	{
		Objective Engineer  

		InitialCooldown 40
		Where spawnbot
