	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
					EntFire(`bombpath_choose_right`, `Trigger`)

					TankExt.SetValueOverrides({
						HELICOPTER_MAX_RANGE = 1500
						HELICOPTER_ROCKET_HOMING_POWER = 0.2
						HELICOPTER_ROCKET_HOMING_DURATION = 0.1
						HELICOPTER_ROCKET_COOLDOWN = 0.4
					})
            	  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

