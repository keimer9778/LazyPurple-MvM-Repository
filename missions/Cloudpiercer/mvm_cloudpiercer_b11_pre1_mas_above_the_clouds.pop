#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 850
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/bots/boss_helicopter/boss_helicopter.mdl"
	
	PrecacheModel "models/bots/sniper_boss/bot_sniper_boss.mdl"

	//// CUSTOM WEAPONS ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
                        Convars.SetValue(`tf_playergib`, 0)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/helicopter`)

						TankExt.CreateLoopPaths({
							tank_path_helicopter = [
								Vector(-628, -2525, -416)
								Vector(-192, -2688, -416)
								Vector(-104, -2664, -416)
								Vector(-57, -2603, -416)
								Vector(-32, -880, -416)
								Vector(-32, 128, -416)
								Vector(0, 256, -416)
								Vector(64, 352, -416)
								Vector(192, 416, -416)
								Vector(320, 416, -416)
								Vector(416, 352, -416)
								Vector(480, 256, -416) // START OF LOOP
								Vector(544, 128, -416)
								Vector(608, 0, -416)
								Vector(736, -128, -416)
								Vector(896, -160, -416)
								Vector(1840, -248, -416)
								Vector(1968, -216, -416)
								Vector(2152, -88, -416)
								Vector(2256, 132, -388)
								Vector(2352, 284, -358)
								Vector(2368, 512, -302)
								Vector(2368, 896, -244)
								Vector(2400, 1056, -244)
								Vector(2464, 1184, -244)
								Vector(2440, 1272, -244)
								Vector(2376, 1328, -244)
								Vector(2216, 1344, -244)
								Vector(958, 1344, -244)
								Vector(880, 1312, -244)
								Vector(808, 1252, -244)
								Vector(592, 1072, -272)
								Vector(528, 1016, -288)
								Vector(480, 928, -302)
								Vector(480, 256, -416)
							]
						})
					  "
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_red"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_red"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		MissionPT
		{
			logic_relay
			{
				"targetname" "TheWarCry"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_directhittaunt02.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_directhittaunt02.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry02.mp3,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry04.mp3,2.25,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry06.mp3,2.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry01.mp3,2.75,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry03.mp3,3,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/soldier_mvm_battlecry05.mp3,3.25,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_battlecry05.mp3,5,-1"
			}

			logic_relay
			{
				"targetname" "TankMoveRelay"

				"OnTrigger" "tank_boss*,SetSpeed,25,0,-1"
				"OnTrigger" "tank_boss*,SetSpeed,50,1.5,-1"
				"OnTrigger" "tank_boss*,SetSpeed,75,3,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}
		}
	}

	PointTemplates
	{
		MissionNamePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Master) Above the Clouds`)
					  "
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "MissionPT"
	SpawnTemplate "MissionNamePT"

	//// EXTRA TANK PATHS ////

	//// ROBOT TEMPLATES ////

	Templates
	{
		//// GIANTS ////

		T_TFBot_Giant_Soldier_Barrage_Paradrop
		{
			Name "Colonel Para-Barrage"
			Template T_TFBot_Giant_Soldier_Barrage
			ClassIcon soldier_barrage_parachute_gud

			Tag common
			Tag parachute

			Item "The B.A.S.E. Jumper"

			CharacterAttributes
			{
				"cancel falling damage" 1
			}
		}

		//// MINIGIANTS ////

		T_TFBot_Soldier_Spammer_Paradrop
		{
			Name "Rapid Fire Para-Soldier"
			Template T_TFBot_Soldier_Spammer
			ClassIcon soldier_spammer_para

			Tag common
			Tag parachute

			Item "The B.A.S.E. Jumper"

			CharacterAttributes
			{
				"cancel falling damage" 1
			}
		}

		//// COMMONS ////

		T_TFBot_Soldier_Paradrop
		{
			Name "Para-Soldier"
			Class Soldier
			ClassIcon soldier_para

			Tag common
			Tag parachute

			Item "The B.A.S.E. Jumper"

			CharacterAttributes
			{
				"cancel falling damage" 1
			}
		}

		T_TFBot_Demo_Burst_Paradrop
		{
			Name "Burst Fire Para-Demoman"
			Template T_TFBot_Demoman_Burst
			ClassIcon demo_burst_para

			Tag common
			Tag parachute

			CharacterAttributes
			{
				"cancel falling damage" 1
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentry_buster
		BeginAtWave 1
		RunForThisManyWaves 7
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission // Sniper (Wave 2)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 20
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission // Spy (Wave 3)
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 12
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	//// WAVES ////

	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
					EntFire(`bombpath_choose_right`, `Trigger`)
            	  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 GBarrage Soldier
		{
			Name "Wave1_Subwave1_GBarrageSoldier"
			Where spawnbot_parachute
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 0
			TotalCurrency 50

			TFBot
			{
				Template T_TFBot_Giant_Soldier_Barrage_Paradrop
			}

			FirstSpawnOutput
			{
				Target TheWarCry
				Action Trigger
			}
		}
		WaveSpawn // 7 Soldiers
		{
			Name "Wave1_Subwave1_Soldiers"
			WaitForAllSpawned "Wave1_Subwave1_GBarrageSoldier"
