    // Sentry Buster
	Mission
	{
		Objective DestroySentries
		Where spawnbot
		BeginAtWave 1
		
        InitialCooldown 30
		CooldownTime 40
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

