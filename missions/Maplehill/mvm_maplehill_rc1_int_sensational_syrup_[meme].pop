				"OnTrigger" "boss_fade_green,Fade,,0.76,-1"
				"OnTrigger" "error_skybox_1,Trigger,,0.75,-1"
				
				"OnTrigger" "boss_fade_white_out,Fade,,1.51,-1"
				"OnTrigger" "boss_fade_white,Fade,,2.26,-1"
