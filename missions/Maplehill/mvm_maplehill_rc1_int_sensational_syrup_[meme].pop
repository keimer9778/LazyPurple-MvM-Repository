		Spycrab
		{
			OnSpawnOutput
			{
				//when above frame 54/74, jump to frame 14/74
				Target "specrab"
				Action RunScriptCode
				Param "	function OnAnimThink() { if (self.GetCycle() > 0.73) self.SetCycle(0.19);  self.StudioFrameAdvance(); self.DispatchAnimEvents(self); return 0.0; } self.SetModelSimple(`models/player/spy.mdl`); self.SetSkin(1); self.SetPlaybackRate(1.0); self.SetSequence(self.LookupSequence(`taunt05`)); AddThinkToEnt(self, `OnAnimThink`);"
						//spycrab taunt
			}
			funCBaseFlex
			{
				"targetname" "specrab"
			}
		}

