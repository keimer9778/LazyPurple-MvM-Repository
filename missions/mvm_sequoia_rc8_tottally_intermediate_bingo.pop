		}
		
		TFBot
		{
			Template T_TFBot_Buster_MiniGun_Grapple_2
		}
		}
	}
	
//WAVE 1 //////////CURRENCY 950/////////////////////////////////// 20+ stragglers, triple vacc (and strechy cosmetics), nonthreat tanks, unsorted icons
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		
		WaveSpawn
		{
			Name stage3
			WaitForAllDead stage2
			Where spawnbot_left
			Where spawnbot_mission_sentrybuster
