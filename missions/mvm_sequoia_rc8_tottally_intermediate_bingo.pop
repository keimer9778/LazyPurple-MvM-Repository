//filling out all parts of potato bingo sheet EXCEPT less than $5000 https://media.discordapp.net/attachments/655472399713828865/716973238043017287/unknown-27.png?width=613&height=613
//mission by randomguy
#base robot_randomguy.pop
#base robot_gatebot_randomguy.pop

WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	2
	StartingCurrency 800
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 4000
	AddSentryBusterWhenKillCountExceeds	20
	// EventPopFile Halloween
	Templates
	{
		T_TFBot_Medic_Vaccinator_Bullet_Click //clickin's meds are used because they have the vacc
		{
			ClassIcon	medic_bullet
			Name	"Bullet Vaccinator Medic"
			Class	Medic
			Skill	Expert
			Attributes	"SpawnWithFullCharge"
			Attributes	"VaccinatorBullets"
			ItemAttributes
			{
				ItemName	tf_weapon_syringegun_medic
				"damage penalty"	0.1
			}
			CharacterAttributes
			{
				"ubercharge rate bonus"	25
				"heal rate bonus"	1
				"uber duration bonus"	100
				"medigun bullet resist passive"	1
				"medigun bullet resist deployed"	1
			}
			Item	"the vaccinator"
		}
		T_TFBot_Medic_Vaccinator_Blast_Click //clickin's meds are used because they have the vacc
		{
			ClassIcon	medic_blast
			Name	"Blast Vaccinator Medic"
			Class	Medic
			Skill	Expert
			Attributes	"SpawnWithFullCharge"
			Attributes	"VaccinatorBlast"
			ItemAttributes
			{
				ItemName	tf_weapon_syringegun_medic
				"damage penalty"	0.1
			}
			CharacterAttributes
			{
				"ubercharge rate bonus"	25
				"heal rate bonus"	1
				"uber duration bonus"	100
				"medigun blast resist passive"	1
				"medigun blast resist deployed"	1
			}
			Item	"the vaccinator"
		}
		T_TFBot_Medic_Vaccinator_Fire_Click //clickin's meds are used because they have the vacc
		{
			ClassIcon	medic_fire
			Name	"Fire Vaccinator Medic"
