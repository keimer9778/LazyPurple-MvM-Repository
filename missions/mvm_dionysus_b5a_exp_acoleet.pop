//More verbose comments left behind for curious eyes

#base robot_standard.pop
#base robot_giant.pop
#base robot_dionysus_startacker.pop

WaveSchedule
{
    StartingCurrency 400
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 4
	Advanced 1

    Mission
	{
		Objective	DestroySentries
		Where	spawnbot
		BeginAtWave	1
		InitialCooldown	30
		CooldownTime	40
		DesiredCount	1
		
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}
	Mission //Wave 2
	{
		Objective	Spy
		Where	spawnbot
		BeginAtWave	2
		RunForThisManyWaves	1
		InitialCooldown	30
		CooldownTime	30
		DesiredCount	2
		
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission //Wave 3-5
    {
        Objective Sniper
        Where spawnbot_mission_sniper
        Where spawnbot
        BeginAtWave 3
        RunForThisManyWaves 3
        InitialCooldown 30
        CooldownTime 35
        DesiredCount 2

        TFBot
        {
            Class Sniper
            Skill Expert
            ClassIcon sniper_machina_nys
            Name "Railgun Sniper"
            Item "The Machina"
            MaxVisionRange 1500
            Scale 1.2
            Health 400

            ItemAttributes
            {
                ItemName "The Machina"
                "damage bonus" 1.2 //Deals enough to kill full health soldiers
            }
        }
    }

    Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}

        WaveSpawn //Did you know? I started writing this and this is all the mission had for maybe 2 days while I got distracted elsewhere. Now you know!
        {
            Name "wave01_a"
            TotalCount 20
            SpawnCount 20
            Where spawnbot
            TotalCurrency 100

            TFBot
            {
                Template T_TFBot_Scout_Sandman_FastCharge
                Attributes AlwaysCrit
            }
        }
		WaveSpawn
		{
			Name "wave01_b"
			TotalCount 80
			SpawnCount 1
			MaxActive 12
			WaitBeforeStarting 0
			WaitForAllDead "wave01_a"
			WaitBetweenSpawns 1
			Where spawnbot
			Where flankers
			TotalCurrency 250
			
			TFBot
			{
				Class Soldier
				Skill Normal
				Name "Charged-on-Kill Soldier"
				Classicon soldier_crit
				Item "The Original"
				ItemAttributes
				{
					ItemName "The Original"
					"faster reload rate" 0.2
					"fire rate bonus" 2
					"Projectile speed increased" 0.5
					//"critboost on kill" 1337
				}
				CharacterAttributes
				{
					"critboost on kill" 1337 //Pyros reflecting rockets could steal these critboosts. Funny! But no
				}
			}
		}
		WaveSpawn
		{
			Name "wave01_b"
			TotalCount 15
			SpawnCount 3
			MaxActive 9
			WaitBeforeStarting 10
			WaitForAllDead "wave01_a"
			WaitBetweenSpawns 15
			Where spawnbot
			TotalCurrency 250

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Pyro_Flare_Spammer
				}
				TFBot
				{
					Class Pyro
					Name "Giant Scorch Pyro"
					ClassIcon pyro_flare_giant
					Skill Expert
					Health 3000
					Item "The Scorch Shot"
					WeaponRestrictions SecondaryOnly
					Attributes MiniBoss
					Attributes AlwaysCrit
					ItemAttributes
					{
						ItemName "The Scorch Shot"
						"fire rate bonus" 0.8
						//"damage causes airblast" 1
					}
					CharacterAttributes
					{
						"move speed bonus"	0.35
						"damage force reduction" 0.6
						"airblast vulnerability multiplier" 0.6
						"override footstep sound set" 6
					}
				}
				TFBot
				{
					Class Pyro
					Name "Giant Airblast Pyro"
					Skill Expert
					Item "The Degreaser"
					Item "Traffic Cone"
					Health 3000
					WeaponRestrictions PrimaryOnly
					Attributes MiniBoss
					ItemAttributes
					{
						ItemName "The Degreaser"
						//"damage bonus"	0.75
						"fire rate bonus" 1
						"airblast pushback scale" 5
					}
					CharacterAttributes
					{
						"move speed bonus"	0.5
						"damage force reduction" 0.6
						"airblast vulnerability multiplier" 0.6
						"override footstep sound set" 6
					}
				}
			}
		}
		WaveSpawn
        {
            Name "wave01_engineers"
            TotalCount 1
            SpawnCount 1
			MaxActive 2
            WaitBeforeStarting 40
            WaitBetweenSpawns 30
            Where flankers
