				}
				TFBot
				{
					Template T_TFBot_Demoman_Pirate
				}
				TFBot //This only has a 28% chance to spawn over the rest
				{
					Class Demoman
					Name "Samurai Demo"
					ClassIcon demoknight
					Skill Expert
					Item "The Half-Zatoichi"
					Item "The Splendid Screen"
					Item "Demo Kabuto"
					Scale "1.3"
					Health 650
					WeaponRestrictions MeleeOnly
					CharacterAttributes
					{
						"charge time increased" 2
						"charge recharge rate increased" 1
						"damage bonus"	1.0
					}
				}
			}
		}
		WaveSpawn
		{
			Name "wave02_b1"
			TotalCount 5
			SpawnCount 1
			MaxActive 2
			WaitBeforeStarting 20
			WaitBetweenSpawns 30
			Where spawnbot
			TotalCurrency 150

			TFBot
			{
            	Class Demoman
            	Skill Expert
            	Health 3300
            	ClassIcon demo_giant
            	Name "Giant Cannon Demoman"
            	Item "The Loose Cannon"
            	Item "The Chargin' Targe"
            	Item "The Buccaneer's Bicorne"
            	Item "A Whiff of the Old Brimstone"
            	Attributes MiniBoss
				Attributes AlwaysCrit
				ItemAttributes
				{
					ItemName "The Loose Cannon"
					"grenade launcher mortar mode" 0 //Without this, demobots will just hold down M1 and self-det bombs
					"damage bonus" 1.5
					"clip size penalty" 0.5
					"faster reload rate" 0.2
					"fire rate bonus" 2
				}
				CharacterAttributes
				{
					"move speed bonus" 0.5
					"damage force reduction" 0.5
					"airblast vulnerability multiplier" 0.5
					"override footstep sound set" 4
				}
        	}
		}
		WaveSpawn
		{
			Name "wave02_b2"
			TotalCount 4
			SpawnCount 1
			MaxActive 2
			WaitBeforeStarting 35
			WaitBetweenSpawns 30
			Where spawnbot
			TotalCurrency 150

			TFBot //This guy was pulled from Brugge, and made not a boss
			{
				Class Demoman
				Skill Expert
				Health 3300
				ClassIcon demo_sticky_daan
				Name "Giant Sticky Demoman"
				Item "Upgradeable TF_WEAPON_GRENADELAUNCHER"
				WeaponRestrictions SecondaryOnly
				Attributes HoldFireUntilFullReload
				Attributes MiniBoss
				ItemAttributes 
            	{ 
            	    ItemName "Upgradeable TF_WEAPON_GRENADELAUNCHER"
            	    "override projectile type" 15 //Flying Guillotine, makes the grenade launcher not fire anything
            	    "is_passive_weapon" 1 //This applies the grenade launcher animations to the demo, otherwise they spin around a lot
					"faster reload rate" 0.2 //Prevent any interruptions with holdfireuntilfullreload
            	}
				ItemAttributes
				{
					ItemName "TF_WEAPON_PIPEBOMBLAUNCHER" //Demobots don't know how to activate stickies...
					"stickybomb charge rate" 0.001 //brrrt
					"fire rate bonus" 0.1
					"faster reload rate" 0.2 //So we just blow them up once they start firing again, with the max of 8. Delayed explosion!
				}
				CharacterAttributes
				{
					"move speed bonus" 0.5
					"damage force reduction" 0.5
					"airblast vulnerability multiplier" 0.5
					"override footstep sound set" 4
				}
			}
		}
