    Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}

		WaveSpawn //Wave spawns don't actually need to have anything in them and can be used as abstract outputs, just remember to use 0s!
		{
			Name "empty_wave_spawn_so_we_can_play_a_sound_before_robots_spawn"
			TotalCount 0
			SpawnCount 0
			FirstSpawnWarningSound "vo/mvm/norm/demoman_mvm_jeers06.mp3"
		} //For relayed events, you can still use waitforallspawned to create an abstract chain of events

		WaveSpawn
		{
			Name "wave02_a"
			TotalCount 125
			SpawnCount 2
			MaxActive 16
			WaitBetweenSpawns 2
			WaitBeforeStarting 5
			Where spawnbot
			Where flankers
			TotalCurrency 200
			FirstSpawnWarningSound "vo/mvm/norm/demoman_mvm_laughevil04.mp3"

			RandomChoice
			{
				TFBot
				{
					Class Demoman
					Name "Bottle Demo"
					ClassIcon demoknight
					Skill Hard
					Item "The Chargin' Targe"
					WeaponRestrictions MeleeOnly
					Attributes AlwaysCrit
					ItemAttributes
					{
						ItemName "TF_WEAPON_BOTTLE"
					}
				}
				TFBot
				{
					Class Demoman
					Name "Bottle Demo"
					ClassIcon demoknight
					Skill Hard
					Item "The Chargin' Targe"
					WeaponRestrictions MeleeOnly
					Attributes AlwaysCrit
					ItemAttributes
					{
						ItemName "TF_WEAPON_BOTTLE"
					}
				}
				TFBot
				{
					Template T_TFBot_Demoman_Knight
				}
