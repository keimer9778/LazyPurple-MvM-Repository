WaveSchedule
{

	StartingCurrency 1000
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 5
	FixedRespawnWaveTime Yes
	Advanced 1

    Mission //Wave 1-3
	{
		Objective	DestroySentries
		Where	spawnbot
		BeginAtWave	1
        RunForThisManyWaves 3
		InitialCooldown	30
		CooldownTime	40
		DesiredCount	1
		
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}

