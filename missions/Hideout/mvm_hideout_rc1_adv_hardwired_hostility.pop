    Templates {
        T_TFBot_Medic_Vaccinator_Bullet_Fix
		{
			Class Medic
			Skill Expert
			ClassIcon medic_bullet
			//Item "The Vaccinator"
			Attributes SpawnWithFullCharge
			Attributes VaccinatorBullets
			CharacterAttributes
			{
				"heal rate bonus" 1
				"medigun charge is resists" 3 //3 = Bullet; 4 = Blast; 5 = Fire
				"lunchbox adds minicrits" 3 //Fixes permabubbles
				"medigun bullet resist deployed" 0.75
				"medigun bullet resist passive" 0.75
				"ubercharge rate bonus" 100
				"bot medic uber health threshold" 500
