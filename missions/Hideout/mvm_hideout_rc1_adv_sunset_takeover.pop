		john_logic
        {
            NoFixUp 1
            logic_relay
            {
                "targetname" "johntearinghouse"
                "OnTrigger" "tf_gamerules,playVO,vo\mvm\mght\soldier_mvm_m_taunts08.mp3,1,-1"
