		johnisdead
		{
			UseHumanAnimations 1
			OnSpawnOutput
			{
				Target "captain"
				Action "TurnOff"
			}
			OnSpawnOutput
			{
				Target "badge"
				Action "TurnOff"
			}
			OnSpawnOutput
			{
				Target "tf_gamerules"
				Action PlayVO
				Param "vo\mvm\mght\soldier_mvm_m_taunts06.mp3"
				Delay "0.1"
			}
			OnParentKilledOutput
			{
				Target "captain"
				Action "TurnOn"
			}
			OnParentKilledOutput
			{
				Target "badge"
				Action "TurnOn"
			}
			OnParentKilledOutput
			{
				Target "nomorebots"
				Action "Enable"
			}
			OnParentKilledOutput
			{
				Target "nomorebots"
				Delay "0.1"
				Action "Kill"
			}
			OnParentKilledOutput
			{
				Target where_spawnbot
				Action "Disable"
				Delay "0.1"
			}
			OnParentKilledOutput
			{
				Target "johndyinganim"
				Action "Enable"
			}
			OnParentKilledOutput
			{
				Target "victory"
				Action Trigger
				Delay 0
			}
			OnParentKilledOutput
			{
				Target "deathanimation"
				Action Trigger
				Delay 0
			}
