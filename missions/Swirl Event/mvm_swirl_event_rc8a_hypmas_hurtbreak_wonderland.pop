	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// POINT-TEMPLATE WEAPONS ////

		"MasqueradeFireRainWeapon"
		{
			OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"

			"add damage type" 8
			"remove damage type" 64
			"Set DamageType Ignite" 1

			"projectile speed decreased" 0.9
			"projectile spread angle penalty" 3

			"custom projectile model" "models/empty.mdl"
			"projectile trail particle" "~spell_fireball_small_blue"
			
			"custom weapon fire sound" "=75|misc/halloween/spell_fireball_cast.wav"
			"custom impact sound" "=75|misc/halloween/spell_fireball_impact.wav"
			"custom kill icon" "firedeath"
