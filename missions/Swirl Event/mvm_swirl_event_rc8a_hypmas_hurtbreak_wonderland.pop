	// Wave 2 Notes
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_init_upper_relay`, `Trigger`)
					EntFire(`MasqueradeIdleRelay`, `Trigger`)

					local bomb = Entities.FindByName(null, `intel_35`)
					bomb.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)

					TankExt.SetValueOverrides({
						COMBATTANK_CANNON_ROCKET_SPEED = 2000
						COMBATTANK_CANNON_ROCKET_DAMAGE = 400
					})
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_boss_relay`, `Trigger`)
					EntFire(`MasqueradeWave2IntroRelay`, `Trigger`)
				  "
		}

