			"custom item model" "models/workshop/player/items/pyro/tw_pyrobot_armor/tw_pyrobot_armor.mdl"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// Core PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						Convars.SetValue(`tf_playergib`, 0)

						EntFire(`snd_wavestart`, `Kill`)

						PrecacheSound(`misc/halloween/spell_stealth.wav`)
						PrecacheSound(`ambient/energy/zap9.wav`)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/hammertank`)

						IncludeScript(`mvm_summoner_script`)

						::DispatchParticleEffectOn <- function(hEntity, sName)
						{
							if(!sName) { hEntity.AcceptInput(`DispatchEffect`, `ParticleEffectStop`, null, null); return }
							local hParticle = Entities.CreateByClassname(`trigger_particle`)
							NetProps.SetPropBool(hParticle, `m_bForcePurgeFixedupStrings`, true)
							hParticle.KeyValueFromString(`particle_name`, sName)
							hParticle.KeyValueFromInt(`attachment_type`, 1)
							hParticle.KeyValueFromInt(`spawnflags`, 64)
							hParticle.DispatchSpawn()
							hParticle.AcceptInput(`StartTouch`, null, hEntity, hEntity)
							hParticle.Kill()
						}

						::DispatchParticleAttached <- function(entity, name, attachment)
						{
							if(entity == null) return
							if(name == null) { entity.AcceptInput(`DispatchEffect`, `ParticleEffectStop`, null, null); return }
							local hParticle = CreateByClassname(`trigger_particle`)
							SetPropBool(hParticle, `m_bForcePurgeFixedupStrings`, true)
							hParticle.KeyValueFromInt(`attachment_type`, 4)
							hParticle.KeyValueFromInt(`spawnflags`, 64)
							hParticle.KeyValueFromString(`particle_name`, name)
							hParticle.KeyValueFromString(`attachment_name`, attachment)
							hParticle.DispatchSpawn()
							hParticle.AcceptInput(`StartTouch`, ``, entity, entity)
							hParticle.Kill()
						}

						IncludeScript(`music_system_ment`)

						PrecacheSound(`#music/hurtbreakwonderland/in_absentia_logos_calm.wav`)
						PrecacheSound(`#music/hurtbreakwonderland/in_absentia_logos.wav`)
						PrecacheSound(`#music/hurtbreakwonderland/spiral_out.wav`)
						PrecacheSound(`#music/hurtbreakwonderland/no_devil_lived_on.wav`)
						PrecacheSound(`#music/hurtbreakwonderland/the_break.wav`)
						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)
					  "
			}
			logic_relay
			{
				"targetname" "PathSwitchUpperRelay"

				"OnTrigger" "item_teamflag*,ForceReset,,0,-1"
				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "wave_prepare_relay_upper,Trigger,,0,-1"
				"OnTrigger" "PathSwitchChangeAnnotation,Show,,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})21"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})21"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})41"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})41"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})61"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})61"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,channel = 6,pitch = 90,filter_type=5})81"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,channel = 6,pitch = 90,filter_type=5})81"
				"OnTrigger" "wave_start_relay,Trigger,,8,-1"
			}
			logic_relay
			{
				"targetname" "PathSwitchLowerRelay"

				"OnTrigger" "item_teamflag*,ForceReset,,0,-1"
				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "wave_prepare_relay_lower,Trigger,,0,-1"
				"OnTrigger" "PathSwitchChangeAnnotation,Show,,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})21"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})21"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})41"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})41"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})61"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_cpoint_klaxon.wav`);EmitSoundEx({sound_name=`mvm/mvm_cpoint_klaxon.wav`,channel = 6, pitch = 90,filter_type=5})61"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,channel = 6,pitch = 90,filter_type=5})81"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,channel = 6,pitch = 90,filter_type=5})81"
				"OnTrigger" "wave_start_relay,Trigger,,8,-1"
			}
			training_annotation
			{
				"targetname" "PathSwitchChangeAnnotation"
				"origin" "208 370 676"
				"display_text" "The paths have changed! Follow the holograms!"
				"lifetime" "5"
			}

			point_populator_interface
			{
				"targetname" "pop_interface"
			}

			filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_red"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
