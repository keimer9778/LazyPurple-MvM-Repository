	//// WAVES ////

	// General Notes

	// Wave 1 Notes
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_init_lower_relay`, `Trigger`)
					EntFire(`MasqueradePortalRelay`, `Trigger`)

					local bomb = Entities.FindByName(null, `intel_35`)
					bomb.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_boss_relay`, `Trigger`)
					EntFire(`MasqueradeIntroRelay`, `Trigger`)
				  "
		}

		Explanation  
		{
			Line ""
			Line "{12E8EE}This mission will feature music potentially protected by copyright."
			Line "{12E8EE}This music comes from the Ultrakill OST by Arsi 'Hakita' Patala, under the alias 'Heaven Pierce Her'."
			Line "{12E8EE}Opt in/out with the Music Volume Slider in the Audio Settings."
			Line ""
		}

