WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	WaveStartCountdown 5

	AllowBotExtraSlots 1
	RobotLimit 25

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/reudina/vortex_reu.mdl"
	PrecacheModel "models/reudina/wof_reu.mdl"

	PrecacheModel "models/bots/scout_boss/bot_scout_gray_boss.mdl"

	PrecacheModel "models/bots/demo/bot_demo_gibby.mdl"
	PrecacheModel "models/bots/demo_boss/bot_demo_boss_gibby.mdl"
	PrecacheModel "models/bots/pyro/bot_pyro_gibby.mdl"
	PrecacheModel "models/bots/pyro_boss/bot_pyro_boss_gibby.mdl"
	PrecacheModel "models/bots/heavy/bot_heavy_gibby.mdl"
	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"
	PrecacheModel "models/bots/soldier/bot_soldier_gibby.mdl"
	PrecacheModel "models/bots/soldier_boss/bot_soldier_boss_gibby.mdl"

	PrecacheModel "models/props_mvm/indicator/indicator_circle.mdl"

	// Precached Particles

	PrecacheParticle "spell_lightningball_glow2_blue"

	// Precached Sounds

	PrecacheSound "music/hurtbreakwonderland/in_absentia_logos_calm.wav"
	PrecacheSound "music/hurtbreakwonderland/in_absentia_logos.wav"
	PrecacheSound "music/hurtbreakwonderland/spiral_out.wav"
	PrecacheSound "music/hurtbreakwonderland/no_devil_lived_on.wav"
	PrecacheSound "music/hurtbreakwonderland/the_break.wav"
 
	//// DISABLED SOUNDS ////

	DisableSound "Announcer.MVM_Wave_End"
    DisableSound "Announcer.MVM_Final_Wave_End"
	DisableSound "Announcer.MVM_Bonus"
	DisableSound "Announcer.MVM_Get_To_Upgrade"

	DisableSound "Announcer.MVM_Bomb_Alert_Near_Hatch"
	DisableSound "Announcer.MVM_Robots_Planted"
	DisableSound "Announcer.MVM_Wave_Lose"
	DisableSound "Announcer.MVM_Game_Over_Loss"
	DisableSound "Announcer.MVM_Bomb_Reset"

	DisableSound "Announcer.MVM_First_Engineer_Teleport_Spawned"
	DisableSound "Announcer.MVM_Another_Engineer_Teleport_Spawned"
	DisableSound "Announcer.MVM_An_Engineer_Bot_Is_Dead_But_Not_Teleporter"
	DisableSound "Announcer.MVM_An_Engineer_Bot_Is_Dead"

	DisableSound "Announcer.MVM_Tank_Alert_Spawn"
	DisableSound "Announcer.MVM_Tank_Alert_Another"
	DisableSound "Announcer.MVM_Tank_Alert_Multiple"
	DisableSound "Announcer.MVM_Tank_Alert_Halfway"
	DisableSound "Announcer.MVM_Tank_Alert_Halfway_Multiple"
	DisableSound "Announcer.MVM_Tank_Alert_Near_Hatch"
	DisableSound "Announcer.MVM_Tank_Alert_Deploying"
	DisableSound "Announcer.MVM_Tank_Planted" 
