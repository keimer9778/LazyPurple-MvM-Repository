	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "EntFire(`wave_start_relay`, `Trigger`, null, 0.0);
			WatersRegime.SetMaxWaveNumber(5);"
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
				if (!(`mvm_spybase_waters_of_a_robot_regime` in getroottable()))
