					[ `soldier_gib_lite`, 1, MVM_CLASS_FLAG_MINIBOSS | MVM_CLASS_FLAG_SUPPORT],
					[ `soldier_gib_lite`, 1, MVM_CLASS_FLAG_SUPPORT],
					[ `timer_lite`, 1, MVM_CLASS_FLAG_SUPPORT],
				]);
			WatersRegime.AvailableEMPSpawns.clear();
			WatersRegime.AvailableEMPSpawns.push(Vector(-1616.641357, 7038.530273, 852.031311));
			WatersRegime.AvailableEMPSpawns.push(Vector(-3039.901855, 5524.085449, 753.031311));
			WatersRegime.AvailableEMPSpawns.push(Vector(-5135.274414, 4742.371582, 973.031311));
			WatersRegime.AvailableEMPSpawns.push(Vector(-4652.203613, 1283.163208, 577.031311));
			WatersRegime.AvailableEMPSpawns.push(Vector(-4036.684326, 2372.755371, 769.031311));"
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
				if (!(`mvm_spybase_waters_of_a_robot_regime` in getroottable()))
				{
					IncludeScript(`mvm_spybase_waters_of_a_robot_regime`, getroottable());
				}
				WatersRegime.DoExplanation(`\x07FFFF00///TIMER ACTIVATED. 6 MINUTES TO KILL THE BOSS///`);
				AlternateWaves.ClearWaveIcons();
				AlternateWaves.bTrackIcons = false;
				AlternateWaves.AddWaveIcons([
					[ `soldier_hellmet_lite`, 1, MVM_CLASS_FLAG_ALWAYSCRIT | MVM_CLASS_FLAG_MINIBOSS],
					[ `demo_robot_nys`, 1, MVM_CLASS_FLAG_ALWAYSCRIT | MVM_CLASS_FLAG_MINIBOSS | MVM_CLASS_FLAG_SUPPORT],
					[ `heavy_robot_nys`, 1, MVM_CLASS_FLAG_MINIBOSS | MVM_CLASS_FLAG_SUPPORT],
					[ `boss_death_pyro`, 1, MVM_CLASS_FLAG_ALWAYSCRIT | MVM_CLASS_FLAG_MINIBOSS | MVM_CLASS_FLAG_SUPPORT],
					[ `soldier_gib_lite`, 1, MVM_CLASS_FLAG_MINIBOSS | MVM_CLASS_FLAG_SUPPORT],
					[ `soldier_gib_lite`, 1, MVM_CLASS_FLAG_SUPPORT],
					[ `timer_lite`, 1, MVM_CLASS_FLAG_SUPPORT],
				]);
				AlternateWaves.SetWaveCount(6, 6);
				PointTemplates.SpawnMissionTemplates();
				PointTemplates.BossPrelude();
				EntFire(`correction`, `Disable`, null, 0.1);
				EntFire(`sky_sunset_relay`, `Trigger`, null, 0.1);
				EntFire(`dont_touch_that`, `Enable`, null, 0.1);
				EntFire(`BURN_THE_PLACE_DOWN*`, `Start`, null, 0.1);
				WatersRegime.RedWon = false;
			"
		}

