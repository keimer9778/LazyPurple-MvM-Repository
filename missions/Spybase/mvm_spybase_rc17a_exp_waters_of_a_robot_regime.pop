					IncludeScript(`mvm_spybase_waters_of_a_robot_regime`, getroottable());
				}
				WatersRegime.SetMaxWaveNumber(5);
				PointTemplates.SpawnMissionTemplates();
				EntFire(`sky_normal_relay`, `Trigger`, null, 0.0);
				Convars.SetValue(`tf_playergib`, 0)
