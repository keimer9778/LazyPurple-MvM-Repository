				if (!(`mvm_spybase_waters_of_a_robot_regime` in getroottable()))
				{
					IncludeScript(`mvm_spybase_waters_of_a_robot_regime`, getroottable());
				}
				WatersRegime.DoExplanation(`\x07FFFF00///DEPLOYING BLIMP. OBJECTIVE: DO NOT LET RED OFF THIS ISLAND///`);
				WatersRegime.SetMaxWaveNumber(5);
				WatersRegime.SetMaxTurnRate(80);
				PointTemplates.SpawnMissionTemplates();
				EntFire(`sky_normal_relay`, `Trigger`, null, 0.0);
			"
		}
