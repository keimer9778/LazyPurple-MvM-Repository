#base robot_standard.pop
#base robot_giant.pop
#base robot_akure.pop

WaveSchedule
{
	StartingCurrency 600
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 6
	Advanced 1

    Mission
	{
		Objective	DestroySentries
		Where	spawnbot
		BeginAtWave	1
		InitialCooldown	30
		CooldownTime	40
		DesiredCount	1
		
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}
    Mission
	{
		Objective Sniper
		Where spawnbot
		BeginAtWave 4
		RunForThisManyWaves 3
		InitialCooldown 45
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
    Mission
	{
		Objective Spy
		Where spawnbot
		BeginAtWave 3
		RunForThisManyWaves 2
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
    Mission
	{
		Objective Engineer  

		InitialCooldown 45
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 45
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Tele_Battle
			TeleportWhere spawnbot
			Attributes TeleportToHint
		}
	}
    Mission
	{
		Objective Engineer  

		InitialCooldown 15
		Where spawnbot
		BeginAtWave 6
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Tele_Battle
			TeleportWhere spawnbot
			Attributes TeleportToHint
		}
	}

    Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}

        InitWaveOutput
        {
            Target gamerules
            Action RunScriptCode
            Param
            "IncludeScript(`tankextensions_main`, getroottable())
            IncludeScript(`tankextensions/combattank`, getroottable())
            IncludeScript(`tankextensions/combattank_weapons/minigun`, getroottable())
            IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())
            IncludeScript(`tankextensions/vactank`, getroottable())"
        }
		
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}

        //Old W1: Shotgun soldier rush, 6 Giant Boxing heavies with support, ends with a giant blast soldier with a giant medic

        WaveSpawn //I like this opener, so we're gonna keep it but wait longer for them to die
        {
            Name "wave01_a"
			TotalCount 20
			SpawnCount 20
			Where spawnbot
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Soldier_Shotgun
			}
        }
        WaveSpawn //Less heavies, longer waits
		{
			Name "wave01_b"
			TotalCount 3
			SpawnCount 1
			MaxActive 2
			WaitBeforeStarting 0
            WaitForAllDead "wave01_a"
			WaitBetweenSpawns 20
			Where spawnbot_flank
			TotalCurrency 200

			TFBot
			{
				Template T_TFBot_Giant_Boxing_Heavy
			}
		}
        WaveSpawn //Less pyros
		{
			Name "wave01_b"
			TotalCount 24
			SpawnCount 6
			MaxActive 10
			WaitBeforeStarting 6
            WaitForAllDead "wave01_a"
			WaitBetweenSpawns 12
			Where spawnbot
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Pyro_GeoThermal
			}
		}
        WaveSpawn
        {
            Name "wave01_c"
            TotalCount 30
            SpawnCount 6
            MaxActive 12
            WaitBeforeStarting 12
            WaitForAllSpawned "wave01_b"
            WaitBetweenSpawns 8
            Where spawnbot_flank
            TotalCurrency 100

            TFBot
            {
                Template T_TFBot_Demoman_Knight
            }
        }
        WaveSpawn
        {
            Name "wave01_c"
            TotalCount 20
            SpawnCount 4
            MaxActive 8
            WaitBeforeStarting 16
            WaitForAllSpawned "wave01_b"
            WaitBetweenSpawns 6
            Where spawnbot_building
            TotalCurrency 100

            TFBot
            {
                Class Scout
                Skill Easy
            }
        }
        WaveSpawn //Remove the small support, instead have a boxing heavy. Soldier knockback makes it harder to reach, but less annoying than with scouts
        {
            Name "wave01_d"
            TotalCount 2
            SpawnCount 2
            MaxActive 2
            WaitBeforeStarting 10
            WaitForAllDead "wave01_c"
            Where spawnbot
            TotalCurrency 100

            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Soldier_RocketPush
                }
                TFBot
                {
                    Template T_TFBot_Giant_Medic_Regen
                }
            }
        }
        WaveSpawn
        {
            Name "wave01_d"
            TotalCount 1
            SpawnCount 1
            WaitBeforeStarting 12
            WaitForAllDead "wave01_c"
            Where spawnbot
            TotalCurrency 50

            TFBot
            {
                Template T_TFBot_Giant_Boxing_Heavy
            }
        }
    }
