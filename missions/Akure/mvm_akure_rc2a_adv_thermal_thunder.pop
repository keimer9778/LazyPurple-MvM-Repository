        WaveSpawn //Finale, combat tank
        {
            Name "wave03_tank"
            TotalCount 1
            SpawnCount 1
            WaitBeforeStarting 2
            WaitForAllDead "wave03_c"
            TotalCurrency 300

            Tank
			{
				Name "combattank_bomb|minigun"
