#base robot_randomguy.pop

WaveSchedule
{

	StartingCurrency 400
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no
	
	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 40
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 8

		CooldownTime 40

            TFBot
			{
				Template T_TFBot_SentryBuster
            }
	}
	Mission // Sniper - wave boss
	{
		Objective Sniper

		InitialCooldown 5
		Where spawnbot_mission_sniper
		BeginAtWave 7
		RunForThisManyWaves 1
		CooldownTime 40
		DesiredCount 10

		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
		}
	}
	Mission // Spy - wave boss
	{
		Objective Spy  

		InitialCooldown 0
		Where spawnbot_mission_spy
		BeginAtWave 7
		RunForThisManyWaves 1
		CooldownTime 45
		DesiredCount 6

		TFBot
		{
			Class Spy
			Skill Expert
			Name Spy
		}
	}	
	
Templates
{
 T_TFBot_Boss_1
 {
            Class Soldier
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Item "The Liberty Launcher"
			ClassIcon soldier_libertylauncher
			Attributes MiniBoss
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			Attributes AlwaysCrit
			Health 45000
			Name "Supreme Blast Soldier"
			ItemAttributes
			{
				ItemName "The Liberty Launcher"
				"damage causes airblast" 1
				//"damage bonus" 1.5
				"fire rate bonus" -0.5
				"clip size upgrade atomic" 17
				"faster reload rate" -0.1
				"projectile spread angle penalty" 6
				"Projectile speed increased" 0.8
			}
			CharacterAttributes
			{
				"move speed bonus"	0.4
				"override footstep sound set" 3
				"damage force reduction" 0.0
				"airblast vulnerability multiplier" 0.0
				"airblast vertical vulnerability multiplier" 0.0
				"rage giving scale"	0.1
				"health regen"	50 //150
			}
 }
}
