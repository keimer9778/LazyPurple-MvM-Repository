	// Encore
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`ImpasseEncorePT`, `ForceSpawn`)
					EntFire(`popscript`, `$encoreWaveCycler`, null, 0.1)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`WaveStartEncoreRelay`, `Trigger`, null, 1)
					EntFire(`wave_start_relay`, `Trigger`)

					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}M@n@gement : You have accepted to face The Void.`)
					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}M@n@gement : My deepest gratitude, Team Fortress.`, 5)
					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}M@n@gement : We will put our Data Experiment Result to the test.`, 10)
					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}Loading {red}Mission.File Wave1.pop -//`, 13.8)
					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}-NOW PLAYING : BREAK EXPECTATIONS (By: {yellow}Snurper_Bob)`, 13.8)
					EntFire(`Player`, `$DisplayTextChat`, `{FFC0CB}M@n@gement : Good luck. Let us receive the fruits of our labor.`, 16)

					AlternateWaves.ClearWaveIcons()
					
					MusicSystemMent.SetMusicTrack(`#impasse/break_expectations.wav`)
				  "
		}

