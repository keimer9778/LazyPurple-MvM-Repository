// I HATE SHIT POPFILE FORMATTING - Kai

#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
	StartingCurrency 800
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom No

	FlagEscortCountOffset -2

	WaveStartCountdown 5
	TextPrintTime 0
	UseOriginalAnimsForUnintendedClassWeapons 1
	SniperAllowHeadshots 1

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/bots/boss_bot/ubertank/boss_tank_uber.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/tank_uber_track_l.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/tank_uber_track_r.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/bomb_mechanism_uber.mdl"

	PrecacheModel "models/props_mvm/indicator/indicator_circle_long.mdl"

	PrecacheModel "models/bots/soldier_boss/bot_soldier_boss_gibby.mdl"
	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"

	// Precached Sounds //

	// SFX

	PrecacheSound "impasse/tank_park.mp3"
	PrecacheSound "impasse/tank_startup.mp3"

	// Music

	PrecacheSound "impasse/the_asparagus_beyond_the_obscure.wav"
	PrecacheSound "impasse/t_error_on_the_dance_floor.wav"
	PrecacheSound "impasse/sky_fall_trigger.wav"
	PrecacheSound "impasse/hard_struck.wav"
	PrecacheSound "impasse/yet_here_we_are_at_an_impasse.wav"

	PrecacheSound "impasse/encore_interlude.mp3"

	PrecacheSound "impasse/break_expectations.wav"
	PrecacheSound "impasse/reaching_for_a_finality.wav"

	PrecacheSound "impasse/the_end.mp3"

	// Colour Correction

	PrecacheGeneric "materials/colorcorrection/voidfields.raw"

	//// LUA SCRIPTS ////

	LuaScriptFile "scripts/impasse/impasse_mechanic.lua"
	LuaScriptFile "scripts/impasse/snurperweapons.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// ROBOT WEAPONS ////

		"VoidOpportunistStickyLauncher"
		{
			OriginalItemName "TF_WEAPON_PIPEBOMBLAUNCHER"
			"damage bonus" 2
			"damage causes airblast" 1
			"blast radius increased" 2
			"use large smoke explosion" 1

			"mult projectile scale" 1.8

			"projectile speed increased" 3.5
			"projectile spread angle penalty" 60
			"energy weapon no deflect" 1
			"custom kill icon" "megaton"
		}

		//// PLAYER WEAPONS ////
		"The Primal Protector"
        {
            OriginalItemName                "Ali Baba's Wee Booties"
            "cannot be upgraded"            1
            "custom item model"             models/empty.mdl
            "max health additive bonus"     5
            "special item description"      "Trade being raw DPS to be more of a Supportive Burst Tank That Eats Crits For Breakfast!"
            "special item description 3"    "Buffs : +65% Damage Bonus For Shotguns | Always Mini-Crit using melees. | Melee Kills Drops Small Health Packs | Steak Grants Crits Instead"
        }

        "The Broken Oath"
        {
            OriginalItemName                "The Quick-Fix"
            "medigun attack enemy"          1.25
            "fire input on hit"             popscript^$brokenAttack
            // "fire input on hit ally"    popscript^$fixup
            "medigun particle"              passtime_beam
            "medigun particle enemy"        ~bombonomicon_spell_trail
            "uber duration bonus"           -2
            "special item description"      "Become a medic of death by dealing damage with your medigun!"
            "special item description 2"    "Dealing damage will fill up your thresholds which when reached, will grant you buffs/Super Uber!"
            "special item description 3"    "BUT! Don't forget your duties as a medic! Be decisive between damaging and healing."
        }

        //
        "The Power-Player"
        {
            OriginalItemName                TF_WEAPON_PDA_ENGINEER_BUILD
            "special item description"      "The Power-Player grants strong power ups when activated"
            "special item description 2"    "To activate a power up, simply [TAUNT] when reaching a tier"
            "special item description 3"    "Every Building starts at lvl 2 in compensation of losing your Build Canteens."
        }

        //
        "THE BLAST-BASH DASH-BACK"
        {
            OriginalItemName                    "The Tide Turner"
            "fire input on hit"                 popscript^$blastBash
            "item color rgb"                    223424
            "dmg taken from blast reduced"      0.90
            "dmg taken from fire reduced"       0.90
            "special item description"          "A Custom Weapon made with [hybrid-knight] in mind!"
            "special item description 2"        "You gain 3 [SUPERCHARGES] under your crosshair. Bashing with an available [SUPERCHARGE] will grant you powerful buffs"
            "special item description 3"        "[BUFFS] : [UBERCHARGE | SPEEDBOOST | INSTANTLY RELOAD YOUR PRIMARY]"
            "special item description 4"        "If the meter is empty, Wait for 30 seconds to get a free [SUPERCHARGE] or kill 6 enemies!"
        }

        "^^^ Warning: Cannot Use Power Up Canteens"
        {
            OriginalItemName    "Battery Canteens"
        }

        "The Doppelsapper"
        {
            OriginalItemName                "Festive Sapper"
            "fire input on effect"          popscript^$sapperCopy
            mod_disguise_consumes_cloak     1
            "special item description"      "Sap a target and when the target dies, you'll become the target."
            "special item description 2"    "This weapon desires patience and dependent to your target, you'll be powerfully rewarded!"
            "special item description 3"    "TIP: Although Giants are very strong, Commons can be as effective! Ex. having an extra heavy on your team!"
        }
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/ubertank`)
						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/minigun`)
                		IncludeScript(`tankextensions/combattank_weapons/fireball`)

						TankExt.SetValueOverrides({
							COMBATTANK_ROTATE_SPEED_DEFAULT = 0.85
							COMBATTANK_MAX_RANGE = 2000
							COMBATTANK_MINIGUN_SPREAD_MULTIPLIER = 1.25
						})

						IncludeScript(`alternatewaves`)

						IncludeScript(`music_system_ment`)
						PrecacheSound(`#impasse/the_asparagus_beyond_the_obscure.wav`)
						PrecacheSound(`#impasse/t_error_on_the_dance_floor.wav`)
						PrecacheSound(`#impasse/sky_fall_trigger.wav`)
						PrecacheSound(`#impasse/hard_struck.wav`)
						PrecacheSound(`#impasse/yet_here_we_are_at_an_impasse.wav`)
						PrecacheSound(`#impasse/break_expectations.wav`)
						PrecacheSound(`#impasse/reaching_for_a_finality.wav`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)
					  "
			}

			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_relay
			{
				"targetname" "EncoreFailRelay"

				"OnTrigger" "Wave5CompleteRelay,CancelPending,,2,-1"
			}
			logic_relay
			{
				"targetname" "Wave5CompleteRelay"

				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "popscript,$encoreCheck,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave2_Engineers,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave2_Engineers,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave3_Pyros,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave3_Pyros,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_ArmoredBlackBoxes,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_ArmoredBlackBoxes,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_Heavies,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_Heavies,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_Scouts,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_Scouts,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_QuickUberMedics,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_QuickUberMedics,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,#impasse/encore_interlude.mp3,5,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management of the Void {reset}: Highest Priority Set - Team Fortress,5,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management of the Void {reset}: Condition for High Resourced Invasion : {green} VALIDATED.,9,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management of the Void : But... I'll let you decide Mercenaries. {red}Shall we?,13,-1"
				"OnTrigger" "popscript,$VoteForEncore,,12,-1"
			}
			logic_relay
			{
				"targetname" "EncoreTransitionRelay"

				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 5, 3, 2)0-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 5, 3, 1)8-1"
			}

			filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		ImpasseEncorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptFile
				Param "impasse/snurper_encorewavebar.nut"
			}

			logic_relay
			{
				"targetname" "WaveStartEncoreRelay"

				"OnTrigger" "relay_clear_bombpath,Disable,,0,-1"
				"OnTrigger" "relay_close_front_upgrade,Trigger,,0,-1"
				"OnTrigger" "popscript,$killCycle,,0,-1"

				"OnTrigger" "EncoreCC,Enable,,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 8, 2, 50000, 0, true)0-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_revive.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/giant_heavy/giant_heavy_entrance.wav,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(0),14,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_warning.wav,14,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm_mann_up_mode02.mp3,18,-1"

				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,23,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,24,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,25,-1"
				"OnTrigger" "EncoreBeamEffect1,Start,,23,-1"
				"OnTrigger" "EncoreBeamEffect2,Start,,24,-1"
				"OnTrigger" "EncoreBeamEffect3,Start,,25,-1"
			}
			logic_relay
			{
				"targetname" "EncoreWave1"
				
				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(0),0,-1"
			}
			logic_relay
			{
				"targetname" "EncoreWave2"
				
				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(1),0,-1"
			}
			logic_relay
			{
				"targetname" "EncoreWave3"
				
				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(2),0,-1"
			}
			logic_relay
			{
				"targetname" "EncoreWave4"
				
				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(3),0,-1"
			}

			color_correction
			{
				"targetname" "EncoreCC"
				"origin" "0 0 0"
				"filename" "materials/colorcorrection/voidfields.raw"
				"maxweight" "0.8"
				"minfalloff" "-1"
				"maxfalloff" "-1"
				"fadeInDuration" "1"
				"fadeOutDuration" "1"
				"startdisabled" "1"
			}
			info_particle_system
			{
				"targetname" "EncoreBeamEffect1"
				"origin" "1174 -2084 660"
				"effect_name" "teleporter_mvm_bot_persist"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "EncoreBeamEffect2"
				"origin" "-267 -3256 655"
				"effect_name" "teleporter_mvm_bot_persist"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "EncoreBeamEffect3"
				"origin" "-1656 -2658 517"
				"effect_name" "teleporter_mvm_bot_persist"
				"start_active" "0"
			}

			logic_relay
			{
				"targetname" "EncoreWave1CompleteRelay"

				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave1_Subwave2_SandmanScouts,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave1_Subwave2_SandmanScouts,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave1_Subwave3_GRUHeavies,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave1_Subwave3_GRUHeavies,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWaves.ClearWaveIcons(),0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Mission-name. Wave1.pop {red}EXPURGATED-//,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(1),7,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Loading {red}Mission-name. Wave2.pop...,7,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/giant_heavy/giant_heavy_entrance.wav,7,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,pitch = 85,filter_type=5})7-1"
			}

			logic_relay
			{
				"targetname" "EncoreVoidOppressionistSummonRelay"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_helpme02.mp3,0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}The Void Oppressionist Calls For Backup,0,-1"

				"OnTrigger" "EncoreVoidOppressionistSummonWarning1,Show,,1,-1"
				"OnTrigger" "EncoreVoidOppressionistSummonWarning2,Show,,2,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_battlecry04.mp3,4,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Damaged Void Oppressionist {reset}: Last One Alive. LOCK THE DOOR!,4,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,EncoreWave2_Subwave3_HandsoftheVoid,5,-1"
			}

			training_annotation
			{
				"targetname" "EncoreVoidOppressionistSummonWarning1"
				"origin" "1088 207 640"
				"display_text" "INCOMING!"
				"lifetime" "4"
			}
			training_annotation
			{
				"targetname" "EncoreVoidOppressionistSummonWarning2"
				"origin" "-23 -513 640"
				"display_text" "INCOMING!"
				"lifetime" "4"
			}

			logic_relay
			{
				"targetname" "EncoreWave2CompleteRelay"

				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave2_Subwave3_Demoknights,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave2_Subwave3_Demoknights,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave2_Subwave3_Pyros,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave2_Subwave3_Pyros,0,-1"

				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "BigNet,RunScriptCode,AlternateWaves.ClearWaveIcons(),0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Mission-name. Wave2.pop {red}EXPURGATED-//,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(2),5,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Loading {red}Mission-name. Wave2.pop...,5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/giant_heavy/giant_heavy_entrance.wav,5,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,pitch = 85,filter_type=5})5-1"

				"OnTrigger" "relay_open_front_upgrade,Trigger,,7,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm_get_to_upgrade01.mp3,7,-1"
				"OnTrigger" "EncoreBreakAnnotation,Show,,7,-1"

				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}...,10,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Processing... Estimated 25 seconds.,15,-1"
				
				"OnTrigger" "EncoreSoundtrackFakeOut,PlaySound,,35,-1"
				"OnTrigger" "EncoreSoundtrackFakeOut,StopSound,,40,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm_general_wav_start01.mp3,40,-1"
				"OnTrigger" "relay_close_front_upgrade,Trigger,,40,-1"

				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(`#impasse/reaching_for_a_finality.wav`)45-1"
			}
			training_annotation
			{
				"targetname" "EncoreBreakAnnotation"
				"origin" "-925 -697 546"
				"display_text" "You have been given time. Refill your canteens or buy some upgrades."
				"lifetime" "5"
			}
			ambient_generic
			{
				"targetname" "EncoreSoundtrackFakeout"
				"message" "#impasse/break_expectations.wav"
				"health" "10"
				"pitch" "100"
				"spindown" "90"
				"spawnflags" "17"
			}

			training_annotation
            {
                "targetname" "EncoreWave3Warning"
				"origin" "-325 -1750 592"
                "display_text" "Eradicate the fodder quickly to spawn in THE MAINTAINER!"
                "lifetime" "5"
            }

			logic_relay
			{
				"targetname" "EncoreWave3CompleteRelay"

				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave3_Subwave3_DirectHitSoldiers,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave3_Subwave3_DirectHitSoldiers,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave3_Subwave3_Demomen,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave3_Subwave3_Demomen,0,-1"

				"OnTrigger" "route_middle,Trigger,,0,-1"
				"OnTrigger" "EncoreWave4Warning,Show,,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWaves.ClearWaveIcons(),0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Mission-name. Wave3.pop {red}EXPURGATED-//,0,-1"

				"OnTrigger" "BigNet,RunScriptCode,AlternateWavebars(3),10,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Loading {red}Mission-name. Wave4.pop...,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/giant_heavy/giant_heavy_entrance.wav,10,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_warning.wav`);EmitSoundEx({sound_name=`mvm/mvm_warning.wav`,pitch = 85,filter_type=5})10-1"
			}
			training_annotation
            {
                "targetname" "EncoreWave4Warning"
				"origin" "-305 -1899 681"
                "display_text" "The bots have switched routes! They're approaching at the bridge!"
                "lifetime" "5"
            }

			logic_relay
			{
				"targetname" "EncoreWave4CompleteRelay"

				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave4_Subwave1_Soldiers,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave4_Subwave1_Soldiers,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,EncoreWave4_Subwave1_LochDemos,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,EncoreWave4_Subwave1_LochDemos,0,-1"
				"OnTrigger" "pop_interface,PauseBotSpawning,0,-1"
				
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management : All of that... You still stand.,3,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management : You have exceeded my expectations. You have dwindled my numbers. You... won. Well done.,6,-1"
				"OnTrigger" "popscript,$theEndofImpasse,,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ui/quest_alert.wav,15,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFA500}---HIGHER CONNECTION ESTABLISHED---,15,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFA500}TF Industries : Mercenaries. The contract has finally been initiated.,17,-1"

				"OnTrigger" "tf_gamerules,PlayVO,impasse/the_end.mp3,19.2,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFA500}TF Industries : It's time to get a hold of that island.,21,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFA500}TF Industries : Rewards and funding have been set. It's time to end this war once and for all.,24,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFA500}TF Industries : Get ready.,28,-1"
