    // Wave 8/8
	// Total $ in this wave : 1000$
	// Total $ when wave starts : 700$ (Starting money) + 9000$ (Collected money) + 700$ (Bonus) = 10400$
	// Total $ when wave ends : 700$ (Starting money) + 10000$ (Collected money) + 700$ (Bonus) = 11400$

    // You can pickup robot's weapon in this wave
    // Alwayscrit option will be preserved
    //
    // 1. Harvester Tank (300000)
    // 2. Boss (Love Machine X), Brother Heavy Mittens (Hidden, Support)
    // Support:
    // - Giant Double Barrel Shotgunner (Crit) + Armored Public Enemy Scout (Crit)
    // - Hyper Colonel Barrage (Homing) + Giant Nuker Soldier
    // - Giant Ancient Dragon Pyro (Crit) + Giant Hyper Flare Pyro 
    // - Giant Hyper Burst Fire Demo + Giant Nuclear Sticky Demo
    // - Giant Hyper Goldgun Heavy (Crit) + Giant Extended Shield Medic (Uber) + Giant Hyper Burst Shotgun Heavy (Crit)
    // Mission: Full-Auto Sniper (Crit)

    Wave
    {
		WaitWhenDone 60
		Checkpoint Yes
        StartWaveOutput
        {
            Target  wave_start_relay
            Action  Trigger
        }
		InitWaveOutput
		{
			Target	wave_start_relay
            Action	RunScriptCode
            Param	"
            ClientPrint(null, 3,`\x07E7B53B지원 거대 로봇 처치 시 드랍된 무기를 사용할 수 있습니다.`)
			ClientPrint(null, 3,`\x07E7B53B드랍된 무기를 개선하는 것도 가능합니다.`)
			// ClientPrint(null, 3,`\x07E7B53BDestroying support giant robots will drop weapons that can be used.`)
			EntFire(`wave_init_relay`, `Trigger`, null, 0.5)
			EntFire(`boss_wave_logic`,`forcespawn`)
            "
		}
        DoneOutput
        {
            Target  wave_finished_relay
            Action  Trigger
        }

		// 1. Harvester Tank (300000)
		WaveSpawn
		{
			Name "w8_harvester"
			Where spawnbot_main
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 1000

			FirstSpawnOutput                                                                                                                                                            
			{
				Target relay_tankboss_harvester                                           
				Action Trigger                         
			}

			Tank
			{
				Health 300000
				Speed 75
				Name "tankboss_harvester"
				Skin 1
				StartingPathTrackNode "tank_start_harvester"
				ClassIcon tank_combine_harvester
				OnKilledOutput
				{
					Target relay_harvester_destroy
					Action Trigger
				}
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}

