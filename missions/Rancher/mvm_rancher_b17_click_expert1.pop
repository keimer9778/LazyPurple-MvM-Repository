// Rancher : click_expert1

// ========== Spawnbot list ==========
// spawnbot_right: Right side from the perspective of red team looking at bot spawn
// spawnbot_center
// spawnbot_left
// spawnbot_main
// spawnbot_chief: Passage on the left

// ========== Tank Path List ==========
// path_tank_right
// path_tank_left
// tank_start_harvester: path_track in shack. Must be used for harvester tanks

// ========== Relays ==========
// wave_start_relay_timer: bomb with 45 second timer
// wave_start_relay: bomb does not reset
// wave_finish_relay
// wave_init_relay: chooses middle or right path
// wave_init_relay_route_r: forces right path
// wave_init_relay_route_m: forces middle path
// wave_init_relay_route_l: forces left path

// Relays for harvester tanks
// relay_tankboss_harvester: FirstSpawnOutput relay for harvester tanks
// relay_harvester_destroy: OnKilledOutput relay for harvester tanks but you dont actually need it.

#base robot_standard.pop
#base robot_giant.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_click_sig.pop
#base ex_upgrade_click.pop

https://www.youtube.com/watch?v=zsVsVGuLGlc
{
    RobotLimit		                22
    StartingCurrency	            700
	RespawnWaveTime 		        5
    CanBotsAttackWhileInSpawnRoom   No

	PrecacheModel "models/weapons/c_models/c_critbanner/c_critbanner.mdl"
	PrecacheModel "models/bots/boss_bot/boss_tank_ubered.mdl"

	PointTemplates
	{
		no_mannpower
        {
            NoFixup 1
            logic_timer
            {
                "targetname" "mannpower_kill"
                "RefireTime" "0.01"
                "spawnflags" "0"
                "UseRandomTime" "0"
                "OnTimer" "item_powerup_rune,kill,,0,-1"
            }
        }

		init_mission_logic
		{
			point_populator_interface
			{
				"targetname" "pop_interface"
			}
		}


		boss_wave_logic
		{
			OnSpawnOutput
			{
				Target "pause_spawn"
				Action "Trigger"
				Delay 1
			}
			logic_relay
			{
				"targetname" "pause_spawn"
				"OnTrigger"  "pop_interface,$PauseWavespawn,w8_boss_support,0,-1"
			}
		}

		crit_radius
        {
            KeepAlive 1
            OnParentKilledOutput
            {
                Target "crit_radius_brush"
                Action Disable
            }
            OnParentKilledOutput
            {
                Target "crit_radius_brush"
                Action Kill
                Delay 0.2
            }
            OnSpawnOutput
            {
                Target "crit_radius_brush"
                Action Enable
                Delay 0.2
            }
            trigger_multiple
			{
				"targetname" "crit_radius_brush"
                "filtername" "filter_bluteam"
				"spawnflags" "1"
                "StartDisabled" "1"
				"mins" "-450 -450 -450"
				"maxs" "450 450 450"
				"origin" "100 0 0"

                "onstarttouch" "@c@!activator,$fireuser5,,0,-1"
                "onendtouch" "@c@!activator,$fireuser6,,0,-1"
			}
            RemoveIfKilled "crit_radius_brush"
        }
        powerup_logic_critbuff_recipient
        {
            OnParentKilledOutput
            {
                Target "item_powerup_rune"
                Action Kill
            }
            OnSpawnOutput
            {
                Target "parentoutput_target"
                Action SetParent
                Param "!activator"
            }
            info_target
            {
                "targetname" "parentoutput_target"
                "$OnUser5" "recipient_counter,Add,1,0,-1"
                "$OnUser6" "recipient_counter,Subtract,1,0,-1"
            }
            math_counter
            {
                "targetname" "recipient_counter"
                "max" "9999"
                "outvalue" "countcompare,setvaluecompare,,0,-1"
            }
            logic_compare
            {
                "targetname" "countcompare"
                "onequalto" "!parent,$removecond,40,0,-1"
                "onequalto" "!parent,$removecond,20,0,-1"
                "ongreaterthan" "!parent,$addcond,40,0,-1"
                "ongreaterthan" "!parent,$addcond,20,0,-1"
            }
        }

		// Use ubertank pointtemplate for multi-tank support
		uber_tank_1
		{
			NoFixup 1
			logic_relay
			{
				"targetname" "tank1_uber_on"
				"OnTrigger" "ubertank1,SetDamageFilter,filter_yes,0,-1"
			}
			logic_relay
			{
				"targetname" "tank1_uber_off"
				"OnTrigger" "ubertank1,SetDamageFilter,filter_red,0,-1"
				"OnTrigger" "ubertank1,Skin,0,0,-1"
			}
			filter_activator_name
			{
				"filtername" "absolutely"
				"Negated" "0"
				"targetname" "filter_yes"
			}
		}
		uber_tank_2
		{
			NoFixup 1
			logic_relay
			{
				"targetname" "tank2_uber_on"
				"OnTrigger" "ubertank2,SetDamageFilter,filter_yes,0,-1"
			}
			logic_relay
			{
				"targetname" "tank2_uber_off"
				"OnTrigger" "ubertank2,SetDamageFilter,filter_red,0,-1"
				"OnTrigger" "ubertank2,Skin,0,0,-1"
			}
			filter_activator_name
			{
				"filtername" "absolutely"
				"Negated" "0"
				"targetname" "filter_yes"
			}
		}
		uber_tank_3
		{
			NoFixup 1
			logic_relay
			{
				"targetname" "tank3_uber_on"
				"OnTrigger" "ubertank3,SetDamageFilter,filter_yes,0,-1"
			}
			logic_relay
			{
				"targetname" "tank3_uber_off"
				"OnTrigger" "ubertank3,SetDamageFilter,filter_red,0,-1"
				"OnTrigger" "ubertank3,Skin,0,0,-1"
			}
			filter_activator_name
			{
				"filtername" "absolutely"
				"Negated" "0"
				"targetname" "filter_yes"
			}
		}

		powerup_strength_logic
        {
            OnParentKilledOutput
            {
                Target "item_powerup_rune"
                Action Kill
            }
            OnSpawnOutput
            {
                Target "ubercond_checker"
                Action Trigger
                Delay 0.1
            }
            filter_tf_condition
            {
                "targetname" "filter_ubercond"
                "condition" "78"
                "OnPass" "!activator,$AddCond,90,0,-1"
                "OnFail" "!activator,$RemoveCond,90,0,-1"
            }
            logic_relay 
            {
                "targetname" "ubercond_checker"
                "spawnflags" "2"

                "OnTrigger" "!self,Trigger,,0.1,-1"  
                "OnTrigger" "!activator,$RemoveCond,78,0,-1"
                "OnTrigger" "filter_ubercond,TestActivator,!activator,0,-1"  
            }
        }
		powerup_haste_logic
        {
            OnParentKilledOutput
            {
                Target "item_powerup_rune"
                Action Kill
            }
            OnSpawnOutput
            {
                Target "ubercond_checker"
                Action Trigger
                Delay 0.1
            }
            filter_tf_condition
            {
                "targetname" "filter_ubercond"
                "condition" "78"
                "OnPass" "!activator,$AddCond,91,0,-1"
                "OnFail" "!activator,$RemoveCond,91,0,-1"
            }
            logic_relay 
            {
                "targetname" "ubercond_checker"
                "spawnflags" "2"

                "OnTrigger" "!self,Trigger,,0.1,-1"  
                "OnTrigger" "!activator,$RemoveCond,78,0,-1"
                "OnTrigger" "filter_ubercond,TestActivator,!activator,0,-1"  
            }
        }
	}

	ExtraTankPath
	{
		Name "path_tank_battle1"
		Node "-1728 -2744 576"
		Node "-1344 -2744 576"
		Node "-1272 -2720 576"
		Node "-1216 -2680 576"
		Node "-1160 -2608 576"
		Node "-1128 -2488 576"
		Node "-984 -1992 576"
		Node "-864 -1632 584"
		Node "-832 -1400 584"
		Node "-824 -760 600" 
		Node "-784 -624 592"
		Node "-736 -544 600"
		Node "-624 -456 632"
		Node "-448 -456 688"
		Node "-240 -448 712"
		Node "-40 -440 720"
	}

	ExtraTankPath
	{
		Name "path_tank_battle2"
		Node "-1760 1408 1750"
		Node "-1760 1408 704"
		Node "-1824 1664 704"
		Node "-1856 1984 704"
		Node "-1856 2512 704"
		Node "-1824 2608 704"
		Node "-1776 2688 704"
		Node "-1696 2736 704"
		Node "-1440 2752 704"
		Node "-960 2752 592"
		Node "-744 2752 584"
		Node "-272 2752 592"
		Node "32 2752 576"
		Node "152 2744 576"
		Node "256 2720 576"
		Node "328 2656 576"
		Node "473 2709 576"
	}

	SpawnTemplate	no_mannpower
	SpawnTemplate   init_mission_logic
	SpawnTemplate   uber_tank_1
	SpawnTemplate   uber_tank_2 
	SpawnTemplate   uber_tank_3 

	PlayerSpawnTemplate // for last wave
	{
		Name "powerup_haste_logic"
	}

    // Sentry Buster
	Mission
	{
		Objective   DestroySentries
		Where       spawnbot_main
		BeginAtWave 1

        InitialCooldown 80
		CooldownTime    120

		TFBot
		{
			Template    T_TFBot_SentryBuster
		}
	}

    // Wave 1/8
	// Total $ in this wave : 1000$
	// Total $ when wave starts : 700$ (Starting money)
	// Total $ when wave ends : 700$ (Starting money) + 1000$ (Collected money) + 100$ (Bonus) = 1800$

	// 1. Heavy (Normal), Soldier (Normal)
    // 2. Giant Uncharged Soldier + Giant Demoman + 3 Medic (Bigheal), Scout (Normal)
    // 3. Giant Heavy + 4 Pyro (Expert), Giant Pyro + 4 Demoman (Normal)
    // Support: Crit Buff Soldier (Easy)
    // Mission: Spy, Sniper

	Mission
	{
		Objective Spy
		Where spawnbot_right
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 40
		CooldownTime 60
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	Mission
	{
		Objective Sniper
		Where spawnbot_left
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 50
		CooldownTime 60
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}

    Wave
    {
		WaitWhenDone 60
		Checkpoint Yes
        StartWaveOutput
        {
            Target  wave_start_relay
            Action  Trigger
        }
		InitWaveOutput
		{
			Target wave_init_relay
			Action Trigger
		}
        DoneOutput
        {
            Target  wave_finished_relay
            Action  Trigger
        }

		// 1. Heavy (Normal), Soldier (Normal)
		WaveSpawn
		{
			Name "w1_stage01"
			Where spawnbot_main
			TotalCount 24
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 4
			TotalCurrency 100
			TFBot
			{
				Class Heavy
				Skill Normal
				SpawnTemplate "powerup_logic_critbuff_recipient"
			}
		}
		WaveSpawn
		{
			Name "w1_stage01"
			Where spawnbot_main
			TotalCount 24
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 4
			TotalCurrency 100
			TFBot
			{
				Class Soldier
				Skill Normal
				SpawnTemplate "powerup_logic_critbuff_recipient"
			}
		}

		// 2. Giant Uncharged Soldier + Giant Demoman + 3 Medic (Bigheal), Scout (Easy)
		WaveSpawn
		{
			Name "w1_stage02"
			WaitForAllSpawned "w1_stage01"
			Where spawnbot_main
			TotalCount 20
			MaxActive 12
			SpawnCount 5
			WaitBeforeStarting 10
			WaitBetweenSpawns 15
			TotalCurrency 200
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Charged_NoCrit
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Template T_TFBot_Giant_Demoman
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
			}
		}
		WaveSpawn
		{
			Name "w1_stage02_support"
			WaitForAllSpawned "w1_stage01"
			Where spawnbot_main
			TotalCount 40
			MaxActive 10
			SpawnCount 5
			WaitBeforeStarting 0
			WaitBetweenSpawns 3
			TotalCurrency 200
			TFBot
			{
				Class Scout
				Skill Normal
				SpawnTemplate "powerup_logic_critbuff_recipient"
			}
		}

		// 3. Giant Heavy + 4 Pyro (Expert), Giant Pyro + 4 Demoman (Normal)
		WaveSpawn
		{
			Name "w1_stage03"
			WaitForAllSpawned "w1_stage02"
			Where spawnbot_center
			TotalCount 10
			MaxActive 10
			SpawnCount 5
			WaitBeforeStarting 10
			WaitBetweenSpawns 15
			TotalCurrency 150
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavyweapons
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Pyro
					Skill Expert
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Pyro
					Skill Expert
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Pyro
					Skill Expert
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Pyro
					Skill Expert
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
			}
		}
		WaveSpawn
		{
			Name "w1_stage03"
			WaitForAllSpawned "w1_stage02"
			Where spawnbot_right
			TotalCount 10
			MaxActive 10
			SpawnCount 5
			WaitBeforeStarting 10
			WaitBetweenSpawns 15
			TotalCurrency 150
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Pyro
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Demoman
					Skill Normal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Demoman
					Skill Normal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Demoman
					Skill Normal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
				TFBot
				{
					Class Demoman
					Skill Normal
					SpawnTemplate "powerup_logic_critbuff_recipient"
				}
			}
		}

		// Support: Crit Buff Soldier (Easy)
		WaveSpawn
		{
			Name "w1_support"
			Where spawnbot_main
			Support 1
			TotalCount 20
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 15
			TotalCurrency 100
			TFBot
			{
				Template T_TFBot_Soldier_Critbuff
			}
		}
    }

    // Wave 2/8 (Left Path)
	// Total $ in this wave : 800$
	// Total $ when wave starts : 700$ (Starting money) + 1000$ (Collected money) + 100$ (Bonus) = 1800$
	// Total $ when wave ends : 700$ (Starting money) + 1800$ (Collected money) + 200$ (Bonus) = 2700$

    // Main. Super Scout
    // 1. Tank (20000, Uber), Bonk League Scout [Trigger] (Melee, Crit), Fast Scout [Trigger]
    // 2. Tank (15000, Uber), Giant Burst Fire Soldier (Crit) [Trigger] + Giant Medic [Trigger], Infinity Engineer
    // 3. Tank (15000, Uber), Big Bear Guy [Trigger], Frontier Engineer (Support)
    // Mission: Engineer

	Mission
	{
		Objective Engineer
		Where spawnbot_main
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 60
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_right
			TeleportWhere spawnbot_center
			TeleportWhere spawnbot_left
			TeleportWhere spawnbot_main
		}
	}

    Wave
    {
		WaitWhenDone 60
		Checkpoint Yes
        StartWaveOutput
        {
            Target  wave_start_relay
            Action  Trigger
        }
		InitWaveOutput
		{
			Target	wave_start_relay
            Action	RunScriptCode
            Param	"

            ClientPrint(null, 3,`\x07E7B53B우버 탱크 주의: 같이 스폰되는 transmitter 로봇을 모두 제거해야 우버 상태가 해제됩니다.`)
            // ClientPrint(null, 3,`\x07E7B53BUber Tank Warning: You must destroy all transmitter robots that spawn together to remove the Uber state.`)
            EntFire(`wave_init_relay_route_l`, `Trigger`, null, 0.5)
            "
		}
        DoneOutput
        {
            Target  wave_finished_relay
            Action  Trigger
        }

		// Main. Super Scout
		WaveSpawn
		{
			Name "w2_main"
			Where spawnbot_left
			TotalCount 12
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 20
			WaitBetweenSpawns 25
			TotalCurrency 200
			TFBot
			{
				Template T_TFBot_Giant_Scout_Fast
			}
		}

		// 1. Tank (20000, Uber), Bonk League Scout [Trigger] (Melee, Crit), Fast Scout [Trigger]
		WaveSpawn
		{
			Name "w2_tank01"
			Where spawnbot_main
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100

			FirstSpawnOutput
			{
				Target	wave_start_relay
            	Action	RunScriptCode
           		Param "
            	ClientPrint(null, 3,`\x07803020===== UBER TANK APPROACHING =====`)
				ClientPrint(null, 3,`\x07E7B53BTransmitter #1: Bonk League Scout`)
				ClientPrint(null, 3,`\x07E7B53BTransmitter #2: Fast Scout`)
            	"
			}
			
			Tank
			{
				Health 20000
				Speed 75
				Name "ubertank1"
				StartingPathTrackNode path_tank_left
				Classicon tank_uber_lite
				Model "models/bots/boss_bot/boss_tank_ubered.mdl"
				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}
		WaveSpawn
		{
			Name "w2_tank01_uber_trigger"
			WaitBeforeStarting 1
			
			DoneOutput                                                                                                                                                            
			{
				Target tank1_uber_on                                 
				Action Trigger              
			}
		}

		WaveSpawn
		{
			Name "w2_stage01"
			Where spawnbot_main
			TotalCount 25
			MaxActive 12
			SpawnCount 5
			WaitBeforeStarting 5
			WaitBetweenSpawns 1
			TotalCurrency 50
			TFBot
			{
				Template T_TFBot_Scout_Sandman_Bonk
				Item "The Sandman"
				Attributes AlwaysCrit
			}
		}
		WaveSpawn
		{
			Name "w2_stage01"
			Where spawnbot_main
			TotalCount 25
			MaxActive 12
			SpawnCount 5
			WaitBeforeStarting 5
			WaitBetweenSpawns 1
			TotalCurrency 50
			TFBot
			{
				Template T_TFBot_Scout_Fast
			}
		}
		WaveSpawn
		{
			Name "w2_stage01_dead_trigger"
			WaitForAllDead "w2_stage01"
            WaitBeforeStarting 0
			DoneWarningSound player\invulnerable_off.wav

			DoneOutput
            {
                Target tank1_uber_off
                Action Trigger
            }
		}

		// 2. Tank (15000, Uber), Giant Burst Fire Soldier [Trigger] + Giant Medic [Trigger], Infinity Engineer
		WaveSpawn
		{
			Name "w2_tank02"
			WaitForAllSpawned "w2_stage01"
			Where spawnbot_main
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 10
			WaitBetweenSpawns 0
			TotalCurrency 100

			FirstSpawnOutput
			{
				Target	wave_start_relay
            	Action	RunScriptCode
           		Param "
            	ClientPrint(null, 3,`\x07803020===== UBER TANK APPROACHING =====`)
				ClientPrint(null, 3,`\x07E7B53BTransmitter #1: Giant Burst Fire Soldier`)
				ClientPrint(null, 3,`\x07E7B53BTransmitter #2: Giant Medic`)
            	"
			}

			Tank
			{
				Health 15000
				Speed 75
				Name "ubertank2"
				StartingPathTrackNode path_tank_right
				Classicon tank_uber_lite
				Model "models/bots/boss_bot/boss_tank_ubered.mdl"
				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}
		WaveSpawn
		{
			Name "w2_tank02_uber_trigger"
			WaitForAllSpawned "w2_stage01"
			WaitBeforeStarting 11
			DoneWarningSound player\invulnerable_off.wav
			
			DoneOutput                                                                                                                                                            
			{
				Target tank2_uber_on                                 
				Action Trigger              
			}
		}

		WaveSpawn
		{
			Name "w2_giant02"
			WaitForAllSpawned "w2_stage01"
			Where spawnbot_center
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 0
			TotalCurrency 30
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer_Reload
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic
				}
			}
		}
		WaveSpawn
		{
			Name "w2_giant02"
			WaitForAllSpawned "w2_stage01"
			Where spawnbot_right
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 0
			TotalCurrency 30
			Squad
			{
