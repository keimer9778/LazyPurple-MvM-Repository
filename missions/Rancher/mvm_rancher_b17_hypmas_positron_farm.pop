			WaitBetweenSpawns 1
			FirstSpawnWarningSound	"misc/doomsday_lift_warning.wav"
			FirstSpawnOutput                                                                                                                                                            
			{
				Target BigNet                                         
				Action RunScriptCode
				Param
				"
					ClientPrint(null,3,`\x08FFFF00FFThe UFO's DEFENCE dropped to 0!`)
					for (local ufoboss; ufoboss = Entities.FindByClassname(ufoboss, `tank_boss`);)
					{
						if (ufoboss.GetName() != `tankboss_harvester` && ufoboss.GetName() != `tankboss` && ufoboss.GetName() != ``)
						{
							ufoboss.AcceptInput(`SetHealth`, `75000`, null, null)
							if (`__missionmodifier` in getroottable())
							{
								if (__missionmodifier.mod_active_double_robot_health == 1) ufoboss.AcceptInput(`SetHealth`, `123750`, null, null)
								if (__missionmodifier.mod_active_double_robot_health == 2) ufoboss.AcceptInput(`SetHealth`, `183750`, null, null)
								if (__missionmodifier.mod_active_double_robot_health == 3) ufoboss.AcceptInput(`SetHealth`, `247500`, null, null)
							}
						}
					}
				"
			}
		}
		
