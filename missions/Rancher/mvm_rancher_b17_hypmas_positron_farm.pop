		WaveSpawn
		{
			Name "w7_b_script"
			
			Where spawnbot_main
			WaitBeforeStarting 18
			FirstSpawnOutput                                                                                                                                                   
			{
				Target bignet                                          
				Action RunScriptCode
				Param
				"
					ClientPrint(null,3,`\x08FFFF00FFThe UFO is invincible for now! Defeat the robots!`)
					for (local ufoboss; ufoboss = Entities.FindByClassname(ufoboss, `tank_boss`);)
					{
						if (ufoboss.GetName() != `tankboss_harvester` && ufoboss.GetName() != `tankboss` && ufoboss.GetName() != ``)
						{
							ufoboss.AcceptInput(`SetHealth`, `9999999`, null, null)
						}
					}
				"
			}
		}
		
