		WaveSpawn
		{
			Name "w7_b_script"
			
			Where spawnbot_main
			WaitBeforeStarting 190
			Support 1
			FirstSpawnOutput                                                                                                                                                   
			{
				Target bignet                                          
				Action RunScriptCode
				Param
				"
					for (local ufoboss; ufoboss = Entities.FindByClassname(ufoboss, `tank_boss`);)
					{
						if (ufoboss.GetName() != `tankboss_harvester` && ufoboss.GetName() != `tankboss` && ufoboss.GetName() != ``)
						{
							ufoboss.ResetSequence(1)
							EntFire(`ufo|true|0.15|30|80|1.5`, `CallScriptFunction`, `ForceBombDeploy`, 0.5)
							PrecacheSound(`vo/mvm_bomb_alerts07.mp3`)
							PrecacheSound(`mvm/mvm_tank_deploy.wav`)
							EmitSoundEx({
								sound_name = `vo/mvm_bomb_alerts07.mp3`
								entity = ufoboss
								filter_type = RECIPIENT_FILTER_GLOBAL
								sound_level = 0
								channel = CHAN_VOICE2
							})
							EmitSoundEx({
								sound_name = `mvm/mvm_tank_deploy.wav`
								entity = ufoboss
								filter_type = RECIPIENT_FILTER_GLOBAL
								sound_level = 0
							})
						}
					}
				"
			}
		}
		
