		}
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
			Convars.SetValue(`tf_airblast_cray`, 0);
			if (!(`tankextensions_main` in getroottable()))
			{
				IncludeScript(`tankextensions_main`, getroottable())
			}

			if (!(`tankextensions/vactank` in getroottable()))
			{
				IncludeScript(`tankextensions/vactank`, getroottable())
			}

			local ent = Entities.FindByClassname(null, `tf_objective_resource`)
			if (ent)
			{
				NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `(Grandmaster) Sailent Clubstar`)
			}

			::GGEZ <-
			{
				function OnGameEvent_ctf_flag_captured(params)
				{
					local player = GetPlayerFromUserID(params.capper)
					if (player == null || !player.IsValid() || !player.IsBotOfType(TF_BOT_TYPE))
					{
						return;
					}

					if (player.HasBotTag(`ez_cap`))
					{
						local str = format(`\x0899CCFFFF%s\x07fbeccb: \x07fbeccbgg ez`, Convars.GetClientConvarValue(`name`, player.entindex()));
						ClientPrint(null, 3, str);
					}
				}
			}
			__CollectGameEventCallbacks(GGEZ);
			"
		}

