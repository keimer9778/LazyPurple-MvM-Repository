#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum.pop

WaveSchedule
{
	StartingCurrency 300
	RespawnWaveTime 4
	CanBotsAttackWhileInSpawnRoom no
	PrecacheSound "08_Last_Legs.mp3" [$SIGSEGV]

	Templates
	{
		T_TFBot_Heavyweapons_Shotgun_Unmodified
		{
			Name "Heavy Shotgun"
			Class Heavy
			Skill Hard
			WeaponRestrictions SecondaryOnly
			ClassIcon heavy_shotgun
			CharacterAttributes
			{
				"damage force reduction" 0.35
				"airblast vulnerability multiplier" 0.35
			}
		}

		T_TFBot_Heavy_Mitten_Armored
		{
			Template T_TFBot_Heavyweapons_Gnome
			Health 900
			ClassIcon heavy_mittens
			Scale 1.5
			Name "Jumbo Mitten Heavy"
			Skill Expert
			Item "point and shoot"
			Item "the all-father"
			CharacterAttributes
			{
				"damage force reduction"	0.5
			}
		}

		T_TFBot_Giant_Samurai_Soldier
		{
			Name "Giant Samurai Soldier"
			Class Soldier
			Skill Expert
			Health 4200
			ClassIcon demoknight_samurai
			Item "The Half-Zatoichi"
			Item "Soldier Samurai Hat"
			Item "The Concheror"
			Attributes MiniBoss
			WeaponRestrictions MeleeOnly
			Attributes SpawnWithFullCharge
			Attributes AlwaysCrit
			ItemAttributes
			{
				ItemName "The Half-Zatoichi"
				"fire rate bonus" 0.6
				"damage bonus" 2.0
				"honorbound" 0 // AGA
				"restore health on kill" 100.0
			}
			ItemAttributes
			{
				ItemName "The Concheror"
				"increase buff duration" 90.0
			}
			CharacterAttributes
			{
				"airblast vulnerability multiplier" 0.0
				"airblast vertical vulnerability multiplier" 0.0
				"damage force reduction" 0.3
				"move speed bonus" 0.55
				"override footstep sound set" 2
				"fire input on kill" "tf_gamerules^PlayVO^vo/sandwicheat09.mp3"
			}
		}

		T_TFBot_Giant_Medic_Penetrator
		{
			Class Medic
			ClassIcon medic_crossbow_burst_penetration
			Name "Giant Crossbow Medic"
			Health 4500
			Skill Expert
			Attributes MiniBoss
			Item	"the crusader's crossbow"
			Item	"the crone's dome"
			Item	"the merc's muffler"
			WeaponRestrictions	PrimaryOnly
			AimAt Head  [$SIGSEGV]
			AimLeadProjectileSpeed 2400 [$SIGSEGV]
			ItemAttributes
			{
				ItemName "the crusader's crossbow"
				"auto fires when full" 1
				"auto fires full clip" 1
				"clip size bonus" 5
				"faster reload rate" 0.4
				"override projectile type"	8
				"fire rate bonus" 0.5
				"projectile penetration" 1
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.01
				"airblast vulnerability multiplier" 0.01
				"airblast vertical vulnerability multiplier"	0.01
			}
		}
	}

	Mission
	{
		Objective DestroySentries

		InitialCooldown 15
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1

		CooldownTime 15
        RandomChoice
        {
            TFBot
		    {
			    Template T_TFBot_SentryBuster
				Attributes DisableDodge
				WeaponRestrictions PrimaryOnly
            }

            TFBot
            {
			    Class Spy
			    Name "Attributes										 deez"
			    Skill Expert
			    Health 2500
			    Scale 1.0
                Attributes AlwaysFireWeapon
			    WeaponRestrictions SecondaryOnly
			    ClassIcon sentry_buster
			    Attributes MiniBoss
				Attributes DisableDodge

			    CharacterAttributes
			    {
					"damage bonus" 0.1
					"fire rate bonus" 0.8
					"damage force reduction" 0.5
					"airblast vulnerability multiplier" 0.0
					"airblast vertical vulnerability multiplier" 0.0
					"cannot be backstabbed" 1
					"Reload time decreased" 0.01
					"move speed bonus" 2
			    }
		    }

			TFBot
			{
				Template	T_TFBot_SentryBuster
				Item	"scotsman's stove pipe"
				Item	"The Gunboats"
				Name		"Foolish Fellow"
				Item "the chargin' targe"
				Attributes AlwaysCrit
				ItemAttributes
				{
					ItemName "the chargin' targe"
					"charge recharge rate increased"    8
					"charge impact damage increased"    0
				}
				CharacterAttributes
				{
					"head scale" 3.0
					"torso scale" 0
					"voice pitch scale" 2
					"dmg penalty vs players" 0
					"move speed bonus" 2
					"gesture speed increase" 4
				}
			}
		}
	}

