			{
				ItemName	tf_weapon_syringegun_medic
				"damage penalty"	0.1
			}
			ItemAttributes
            {
                ItemName "The Vaccinator"
                "ubercharge rate bonus"	200
				"heal rate bonus"	1
				"medigun fire resist passive"	1
				"medigun fire resist deployed"	1
            }
			Item "the vaccinator"
		}
	}
	
	Mission
	{
		Objective	DestroySentries
		Where	spawnbot
