#base robot_giant.pop
#base robot_standard.pop
#base robot_pixelbitie.pop

WaveSchedule
{

	StartingCurrency	1500
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no
	
	Templates
	{
		T_TFBot_Medic_Vaccinator_Bullet_Click
		{
			ClassIcon	medic_bullet
			Name	"Vaccinator Medic"
			Class	Medic
			Skill	Expert
			Attributes	"SpawnWithFullCharge"
			Attributes	"VaccinatorBullets"
			ItemAttributes
			{
				ItemName	tf_weapon_syringegun_medic
				"damage penalty"	0.1
			}
			ItemAttributes
            {
                ItemName "The Vaccinator"
                "ubercharge rate bonus"	200
				"heal rate bonus"	1
				"medigun bullet resist passive"	1
				"medigun bullet resist deployed" 1
            }
			Item "the vaccinator"
		}
		T_TFBot_Medic_Vaccinator_Blast_Click
		{
			ClassIcon	medic_blast
			Name	"Vaccinator Medic"
			Class	Medic
			Skill	Expert
			Attributes	"SpawnWithFullCharge"
			Attributes	"VaccinatorBlast"
			ItemAttributes
			{
				ItemName	tf_weapon_syringegun_medic
				"damage penalty"	0.1
			}
			ItemAttributes
            {
                ItemName "The Vaccinator"
                "ubercharge rate bonus"	200
				"heal rate bonus"	1
				"medigun blast resist passive"	1
				"medigun blast resist deployed"	1
            }
			Item "the vaccinator"
		}
		T_TFBot_Medic_Vaccinator_Fire_Click
		{
			ClassIcon	medic_fire
