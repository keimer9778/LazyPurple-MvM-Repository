#base robot_giant.pop
#base robot_standard.pop
#base robot_pixelbitie.pop

WaveSchedule
{

	StartingCurrency	30000
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput					
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target bignet // gamerules or tf_gamerules, depending on the map
            Action RunScriptCode
            Param "
			IncludeScript(`tankextensions_main`, getroottable())
			IncludeScript(`tankextensions/blimp`, getroottable())
			IncludeScript(`tankextensions/combattank`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/minigun`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/fireball`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/railgun`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/cannon`, getroottable())
			IncludeScript(`tankextensions/drilltank_watermine`, getroottable())
			IncludeScript(`tankextensions/frontlinecart`, getroottable())
			IncludeScript(`tankextensions/helicopter`, getroottable())
			IncludeScript(`tankextensions/paratank`, getroottable())
			IncludeScript(`tankextensions/targetank`, getroottable())
			IncludeScript(`tankextensions/stickytank`, getroottable())
			IncludeScript(`tankextensions/tankdozer`, getroottable())
			IncludeScript(`tankextensions/ubertank`, getroottable())
			IncludeScript(`tankextensions/vactank`, getroottable())
			IncludeScript(`tankextensions/sentrytank`, getroottable())
			IncludeScript(`tankextensions/teletank`, getroottable())
			IncludeScript(`tankextensions/speedtank`, getroottable())
			IncludeScript(`tankextensions/jumptank`, getroottable())
			
			
			TankExt.CreatePaths({
			para_path = [
				Vector(1768, 0, 488)
				Vector(-816, 0, 152)
				Vector(-936, 0, -72)
				Vector(-1144, 0, -80)
			]})
			TankExt.CreatePaths({
			blimp_path = [
				Vector(1768, 0, 488)
				Vector(-1144, 0, 488)
			]})
			"
		}
		WaitWhenDone 65
		Checkpoint Yes
		
		WaveSpawn
		{
			Name	"t1"
			TotalCurrency	100
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			WaitBeforeStarting	0
			WaitBetweenSpawns	1
			Where	spawnbot
			Tank
			{
				Health	5000
				Name	"blimp^vacblimp_fire"
				ClassIcon blimp2_lite [$SIGSEGV]
				Speed	50
				StartingPathTrackNode blimp_path_1
				OnKilledOutput
				{
					Target	boss_dead_relay
					Action	Trigger
				}
				OnBombDroppedOutput
				{
					Target	boss_deploy_relay
					Action	Trigger
				}
			}
		}
		WaveSpawn
		{
			Name	"t2"
