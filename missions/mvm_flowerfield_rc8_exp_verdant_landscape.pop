					{
						EmitSoundEx({sound_name = `#mentrillum/mvm/music/xomu_pagoda.mp3`
						entity = player
						filter_type = 4
						volume = 0.55})
					}
				}
				ClientPrint(null, 3, `\x0799CCFF[MvM] \x01Now Playing: \x070080FFXomu & Amidst - Pagoda`)"
