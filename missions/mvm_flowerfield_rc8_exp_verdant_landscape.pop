	//==========================
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_noreset_relay
			Action Trigger
		}
		DoneOutput
		{
			Target bignet
			Action RunScriptCode
			Param "EntFire(`wave_finish_relay`, `Trigger`)

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/xomu_pagoda.mp3`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "EntFire(`bombpath_flank`, `Trigger`)

			if(!(`mvm_flowerfield_verdant_landscape` in getroottable()))
			{
				IncludeScript(`mvm_flowerfield_verdant_landscape`, getroottable())
			}

			PrecacheSound(`#mentrillum/mvm/music/xomu_pagoda.mp3`)
			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/xomu_pagoda.mp3`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}

