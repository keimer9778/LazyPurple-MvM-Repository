//mission by randomguy
#base robot_randomguy.pop
#base robot_gatebot_randomguy.pop

// spawns: spawnbot, spawnbot_upper, spawnbot_elevator, spawnbot_support (gate0), spawnbot_garage, spawnbot_garage_giant (gate1), spawnbot_mensch, spawnbot_mensch_giant, (gate2), spawnbot_trainstation (gate3) 
WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	2
	StartingCurrency 800
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 5000
	AddSentryBusterWhenKillCountExceeds	25
	// EventPopFile Halloween
	Templates
	{
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 15
		Where spawnbot_support
		Where spawnbot_garage
		Where spawnbot_mensch
		Where spawnbot_trainstation
		BeginAtWave 0
		RunForThisManyWaves 1
		CooldownTime 40
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Mission
	{
		Objective Sniper
		
		Where spawnbot_support
		Where spawnbot_garage
		Where spawnbot_mensch
		Where spawnbot_trainstation
		BeginAtWave 0
		RunForThisManyWaves 1
		InitialCooldown 25
		CooldownTime 40
		DesiredCount 1
		TFBot
		{
