		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
		}
	}
	
	Mission
	{
		Objective	DestroySentries
		
		Where spawnbot_elevator
		Where spawnbot_garage
		Where spawnbot_mensch
		Where spawnbot_trainstation
