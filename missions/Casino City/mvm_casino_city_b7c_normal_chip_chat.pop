				{
					Template T_TFBot_HeavyWeapons_HeavyWeight_Champ
					Name "Chip Smasher"
				}
				
				TFBot
				{
					Template T_TFBot_HeavyWeapons_Gnome
					Name "Chipped Comedian"
				}
			}
		}
		
		WaveSpawn
		{
			Name stage2
			WaitForAllSpawned stage1
