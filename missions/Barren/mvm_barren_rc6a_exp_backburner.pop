			}
		}
		
		Boss_final
		{
			Class Soldier
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Item "The Liberty Launcher"
			Item "Jumper's Jeepcap"
			ClassIcon soldier_libertylauncher
			Attributes MiniBoss
