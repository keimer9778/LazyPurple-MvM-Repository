//mission by randomguy
#base robot_randomguy.pop

WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	1
	StartingCurrency 600
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 3000
	AddSentryBusterWhenKillCountExceeds	25
	Templates
	{
	T_TFBot_Fishy_Scout
		{
			Class Scout
			Skill Expert
