		{
			"move speed bonus"	0.3
			"damage force reduction" 0.0
			"airblast vulnerability multiplier" 0.0
			"override footstep sound set" 4
			"airblast vertical vulnerability multiplier" 0.0
			"rage giving scale" 0.25
		}
	 }
	}
	
