		InitialCooldown 30
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 45
		TFBot
		{
			Template T_TFBot_SentryBuster
			Attributes          DisableDodge
		}
	}
	Mission
	{
        	Where spawnbot_spy_a
		Objective Spy
		InitialCooldown 45
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 45
		DesiredCount 2
