WaveSchedule
{
	StartingCurrency 1200 // 800
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom no
    
	Mission // BUSTERS WAVES 1-2
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        Where spawnbot_sentrybuster_d
        
		Objective DestroySentries
		InitialCooldown 45
		BeginAtWave 1
		RunForThisManyWaves 3
		CooldownTime 50
		TFBot
		{
			Template NV_SentryBuster
		}
	}
    Mission // BUSTERS WAVES 3-7
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        Where spawnbot_sentrybuster_d
        
