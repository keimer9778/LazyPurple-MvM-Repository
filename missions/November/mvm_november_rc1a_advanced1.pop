#base robot_november.pop
WaveSchedule
{ 
	StartingCurrency 1400 // ADJUST > 800
	RespawnWaveTime 3 // ADJUST > 4
	FixedRespawnWaveTime Yes
	CanBotsAttackWhileInSpawnRoom No
	Advanced 1

  //SPIES W3
  Mission
	{
		Where spawnbot_spy_a
    Where spawnbot_spy_b
    Where spawnbot_spy_c
    Where spawnbot_spy_d
    Where spawnbot_spy_e
		Objective Spy
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 20
		CooldownTime 60
		DesiredCount 2
		TFBot
		{
			Template NV_Spy
		}
	}

  //SNIPERS W2
  Mission
	{
		Where spawnbot_sniper_a
