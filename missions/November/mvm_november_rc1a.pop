			Template NV_Spy
		}
	}

	Wave // WAVE 1 - 700 CREDITS
	{
    InitWaveOutput
    {
        Target bignet
        Action RunScriptCode
        Param  "
        EntFire(`spawn_a_arrows_flank_enable`, `Disable`, `null`, 0.0)
        EntFire(`normal_spawn_a_relay`, `Trigger`, `null`, 0.0)"
    }
		StartWaveOutput
		{
			Target wave_start_tutorial_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
        
    WaveSpawn // 1a_a - PYROS
		{
			Where spawnbot_a
			Name "1a_a"
			TotalCount 30
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 5
			WaitBetweenSpawns 10
			TotalCurrency 200
      TFBot
      {
          Template NV_Pyro
      }
		}
