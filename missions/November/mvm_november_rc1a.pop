WaveSchedule
{
	StartingCurrency 1200 // 800
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom no
    
	Mission // BUSTERS WAVES 1-3
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        
		Objective DestroySentries
		InitialCooldown 55
		BeginAtWave 1
		RunForThisManyWaves 3
		CooldownTime 60
		TFBot
		{
			Template NV_SentryBuster
		}
	}
    Mission // BUSTERS WAVES 4-7
	{
		Where spawnbot_sentrybuster_a
        Where spawnbot_sentrybuster_b
        Where spawnbot_sentrybuster_c
        
		Objective DestroySentries
		InitialCooldown 45
		BeginAtWave 4
		RunForThisManyWaves 4
		CooldownTime 45
		TFBot
		{
			Template NV_SentryBuster
		}
	}
    
	Mission // SNIPERS WAVE 3
	{
		Where spawnbot_sniper_a
        Where spawnbot_sniper_b
        Where spawnbot_sniper_c
        
