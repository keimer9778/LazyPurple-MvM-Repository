		InitialCooldown 35
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 45
		DesiredCount 1
		TFBot
		{
			Template NV_Sniper_Support
		}
	}
	Mission // SPIES WAVE 5-6
	{
		Where spawnbot_spy_a
        Where spawnbot_spy_b
        Where spawnbot_spy_c
        
