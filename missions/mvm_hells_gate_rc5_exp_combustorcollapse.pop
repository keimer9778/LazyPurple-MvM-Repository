// WAVE 1
// Soldier main pushforce slowly gains strength via skill increase while bowmen constantly flood in as support
// After that, two giant soldiers (one at a time) push in with constant Soldier + Bowman supports
// Time: Less than 2 minutes

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}

		Checkpoint Yes

		WaveSpawn
		{
			Where spawnbot
			Name "wave1_a1"
			TotalCount 60
			MaxActive 8
			SpawnCount 2
	
			WaitBeforeStarting 0
			WaitBetweenSpawns 4
			
			TotalCurrency 200
			
            RandomChoice
            {
				TFBot
				{
					Class Soldier
					Skill Normal
				}
                TFBot
				{
					Class Soldier
					Skill Normal
				}
                TFBot
				{
					Class Soldier
					Skill Hard
				}
            }
		}
		WaveSpawn
