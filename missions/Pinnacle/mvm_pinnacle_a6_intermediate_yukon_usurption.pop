
// Imports bot templates from other pop files (Valve robots in this case).
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
	// Init
	StartingCurrency 600
	RespawnWaveTime 6
	CanBotsAttackWhileInSpawnRoom no
	
	// Bot templates
	Templates
	{
	
	}

	// Sentry buster mission
	Mission
	{
		Objective DestroySentries
		InitialCooldown 20
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 6
		CooldownTime 40
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	
	// Wave 2,3 spies
	Mission
	{
		Objective Spy
		InitialCooldown 90
		Where spawnbot_mission_spy
		BeginAtWave 3
		RunForThisManyWaves 3
		CooldownTime 60
		DesiredCount 3
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	// Wave 5,7 spies
	Mission
	{
		Objective Spy
		InitialCooldown 60
		Where spawnbot_mission_spy
		BeginAtWave 5
		RunForThisManyWaves 7
		CooldownTime 60
		DesiredCount 3
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	// Wave 4,5 snipers
	Mission
	{
		Objective Sniper
		InitialCooldown 120
		Where spawnbot_mission_sniper
		BeginAtWave 4
		RunForThisManyWaves 5
		CooldownTime 60
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	
	

	// Wave 1
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		
		// 35 Demos
		WaveSpawn
		{
			Name "wave1a"
			Where spawnbot_right
			TotalCount 35
			MaxActive 14
			SpawnCount 7
			WaitBeforeStarting 0
			WaitBetweenSpawns 8
			TotalCurrency 100
			TFBot
			{
				Class Demoman
				Skill Easy
			}
		}
		
		// 20 Pyros
		WaveSpawn
		{
			Name "wave1b"
			Where spawnbot_shack
			TotalCount 20
			MaxActive 10
			SpawnCount 5
			WaitBeforeStarting 5
			WaitBetweenSpawns 8
			TotalCurrency 100
			TFBot
			{
				Template T_TFBot_Sniper_Huntsman
				Skill Normal
			}
		}
		
		// 18 Pyros
		WaveSpawn
		{
			Name "wave1c"
			WaitForAllDead "wave1a"	
			Where spawnbot_right
			TotalCount 18
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 2
			WaitBetweenSpawns 8
			TotalCurrency 100
			TFBot
			{
				Class Soldier
				Skill Easy
			}
		}
		
		// 18 Pyros
		WaveSpawn
		{
			Name "wave1d"
			WaitForAllDead "wave1a"	
			Where spawnbot_left
			TotalCount 21
			MaxActive 14
			SpawnCount 7
			WaitBeforeStarting 5
			WaitBetweenSpawns 9
			TotalCurrency 100
			TFBot
			{
				Template T_TFBot_Heavyweapons_Heavyweight_Champ
				Skill Normal
            }
		}
	}	
	
	
