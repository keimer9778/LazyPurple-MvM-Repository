			Name "wave3a"
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 10	// Start immediately
			WaitBetweenSpawns 0		// Irrelevant - only 1 tank in this wavespawn
			TotalCurrency 400
			FirstSpawnOutput
			{
				Target boss_spawn_relay
				Action Trigger
			}
			Tank
			{
				Name "tankboss"
				Health 15000
				Speed 75
				StartingPathTrackNode "tank_path_b_1"		// Left path
				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
