		{
			Template T_TFBot_Spy
            Item "Charmer's Chapeau"
		}
	}

    Wave
	{
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}

		InitWaveOutput //If/When Valve picks this up, comment this out
		{
			Target "gamerules"
			Action "RunScriptCode"
			Param "
			local god = Entities.FindByClassname(null, `tf_objective_resource`)
			NetProps.SetPropString(god, `m_iszMvMPopfileName`, `Κρασάρισμα Συστήματος`)"
		}
		
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}

		WaveSpawn
		{
			Name "wave01_tank"
			TotalCount 1
			SpawnCount 1
			TotalCurrency 300

			Tank
			{
				Health 26000
				Speed 75
				Name "tankboss"
				StartingPathTrackNode "tank_path_a1"
				
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}
		WaveSpawn
		{
			Name "wave01_a"
			TotalCount 4
			SpawnCount 1
			MaxActive 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 25
			Where spawnbot
			TotalCurrency 200

			TFBot
