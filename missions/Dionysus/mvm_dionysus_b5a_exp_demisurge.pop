						{
							Target "!self"
							Action "RunScriptCode"
							Param "ClientPrint(null, 3, `\x0799CCFFDionysian Demolisher \x01has used their \x079BBF4DCRITS \x01Power Up Canteen!`)"
							Delay 4
							Repeats 1
						}

						FireInput
						{
							Target "player"
							Action "$PlaySoundToSelf"
							Param "=40|battery_canteen.wav" // custom canteen sound by SantiGuardianUniversalXD2
							Delay 4
							Repeats 1
						}

						FireInput
						{
							Target "!self"
							Action "RunScriptCode"
							Param "self.AddCond(11);"
							Delay 4
							Repeats 1
						}

						AddAttribute
						{
							Item "player"
							Name "no_attack"
							Value 0
							Delay 5
							Repeats 1
						}

						AddAttribute
						{
							Item "player"
							Name "move speed bonus"
							Value 0.5
							Delay 5
							Repeats 1
						}

						AddAttribute
						{
							Item "player"
							Name "dmg from ranged reduced"
							Value 1
							Delay 5
						}

						AddAttribute
						{
							Item "player"
							Name "dmg from melee increased"
							Value 1
							Delay 5
						}
					}
				}
            }
        }

