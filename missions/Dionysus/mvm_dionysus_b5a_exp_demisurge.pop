//// Wave 5 ////
    Wave
    {
        StartWaveOutput
        {
            Target	wave_start_relay
            Action	Trigger
        }
        DoneOutput
        {
            Target	wave_finished_relay
            Action	Trigger
        }
        InitWaveOutput
        {
            Target Bignet
            Action RunScriptCode
            Param
            "::pos <- -1
			
			::BossPhases <- {
				function OnGameEvent_player_death(params) {
					local player = GetPlayerFromUserID(params.userid)

					if (player.GetTeam() != 3 || !player.IsBotOfType(1337)) {
                        return
                    }
					if (player.HasBotTag(`phase1`)) {
						pos = player.GetOrigin()
						EntFireByHandle(player, `RunScriptCode`, `BossPhases.teleportPhase2A()`, 0.05, null, null)
						EntFireByHandle(player, `RunScriptCode`, `BossPhases.teleportPhase2B()`, 0.05, null, null)
					}
					if (player.HasBotTag(`phase2a`)) {
						pos = player.GetOrigin()
						EntFireByHandle(player, `RunScriptCode`, `BossPhases.teleportPhase3A()`, 0.05, null, null)
					}
					if (player.HasBotTag(`phase2b`)) {
						pos = player.GetOrigin()
						EntFireByHandle(player, `RunScriptCode`, `BossPhases.teleportPhase3B()`, 0.05, null, null)
					}
				}

				function teleportPhase2A() {
					for (local i = 0; i <= MaxClients(); i++) {
						local brobot = PlayerInstanceFromIndex(i)
						if (brobot != null) {
							if (brobot.GetTeam() == 3 && brobot.IsBotOfType(1337) && brobot.HasBotTag(`phase2a`)) {
								EntFireByHandle(brobot, `RunScriptCode`, `self.Teleport(true, pos, false, self.GetAbsAngles(), true, self.GetAbsVelocity())`, 0.05, null, null)
							}
						}
					}
				}
				function teleportPhase2B() {
					for (local i = 0; i <= MaxClients(); i++) {
						local brobot = PlayerInstanceFromIndex(i)
						if (brobot != null) {
							if (brobot.GetTeam() == 3 && brobot.IsBotOfType(1337) && brobot.HasBotTag(`phase2b`)) {
								EntFireByHandle(brobot, `RunScriptCode`, `self.Teleport(true, pos, false, self.GetAbsAngles(), true, self.GetAbsVelocity())`, 0.05, null, null)
							}
						}
					}
				}
				function teleportPhase3A() {
					for (local i = 0; i <= MaxClients(); i++) {
						local brobot = PlayerInstanceFromIndex(i)
						if (brobot != null) {
							if (brobot.GetTeam() == 3 && brobot.IsBotOfType(1337) && brobot.HasBotTag(`phase3a`)) {
								EntFireByHandle(brobot, `RunScriptCode`, `self.Teleport(true, pos, false, self.GetAbsAngles(), true, self.GetAbsVelocity())`, 0.05, null, null)
							}
						}
					}
				}
				function teleportPhase3B() {
					for (local i = 0; i <= MaxClients(); i++) {
						local brobot = PlayerInstanceFromIndex(i)
						if (brobot != null) {
							if (brobot.GetTeam() == 3 && brobot.IsBotOfType(1337) && brobot.HasBotTag(`phase3b`)) {
								EntFireByHandle(brobot, `RunScriptCode`, `self.Teleport(true, pos, false, self.GetAbsAngles(), true, self.GetAbsVelocity())`, 0.05, null, null)
							}
						}
					}
				}
			}
			__CollectGameEventCallbacks(BossPhases)"
        }

