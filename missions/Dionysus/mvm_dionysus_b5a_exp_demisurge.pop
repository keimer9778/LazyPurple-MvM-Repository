//// Dionysus Expert - Demisurge by hoshikayz ////

// StartingCurrency             = 600
// Wave 1: 600  + (750  +  100) = 1450
// Wave 2: 1450 + (800  +  100) = 2350
// Wave 3: 2350 + (950  +  100) = 3400
// Wave 4: 3400 + (850  +  100) = 4350
// Wave 5: 4350 + (1050 +  100) = 5500
// Wave 6: 5500 + (1100)        = 6600
// Green is Good :)

WaveSchedule
{
    StartingCurrency 600
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 4
    NoRomevisionCosmetics 1                                                 [$SIGSEGV]
    PrecacheModel "models\bots\soldier_boss\bot_soldier_boss_gibby.mdl"     [$SIGSEGV]
    PrecacheModel "models\bots\demo_boss\bot_demo_boss_gibby.mdl"           [$SIGSEGV]
