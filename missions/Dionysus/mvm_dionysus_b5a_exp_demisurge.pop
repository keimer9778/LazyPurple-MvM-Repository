        WaveSpawn 
        {
            FirstSpawnWarningSound vo/mvm/mght/soldier_mvm_m_robot24.mp3
            WaitBeforeStarting 0
            WaitForAllDead "wave_6c"
        }
        WaveSpawn
        {
            Name                "boss" // oh lawd he comin'
            Where               spawnbot
            WaitForAllDead      "wave_6c"
            TotalCount          1
            SpawnCount          1
            MaxActive           1
            WaitBetweenSpawns   0
            WaitBeforeStarting  0
            TotalCurrency       0
            FirstSpawnWarningSound "demisurge_finalboss.mp3"
            DoneWarningSound vo/mvm/mght/soldier_mvm_m_paincrticialdeath03.mp3
			FirstSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param 
				"
				ClientPrint(null,3,`\x08AA00FFFFSong Name: To All Things Strifeful - Honkai: Star Rail`)
				"
			}
            TFBot
            {
                Class Soldier
                ClassIcon soldier_spartan_kayz
                Name "Neos Evo"
                Health 80000
                Skill Expert
                Attributes HoldFireUntilFullReload
                Attributes MiniBoss
                Attributes UseBossHealthBar
                Attributes DisableDodge
                BehaviorModifiers Push
				Scale 2.5
                Item "The Gaelic Garb"
                Item "Hephaistos' Handcraft"
                UseCustomModel "models\bots\soldier_boss\bot_soldier_boss_gibby.mdl"    [$SIGSEGV]
                AlwaysGlow 1                                                            [$SIGSEGV]
                SpawnTemplate neos_logos                                                [$SIGSEGV]
				SpawnTemplate BossIntro                                                 [$SIGSEGV]
				Tag dontdoublehp
				Tag dontdoublehp_damageres
				CharacterAttributes
                {
                    "blast dmg to self increased" 0
                    "cancel falling damage" 1
                    "move speed bonus" 0.5
                    "damage force reduction" 0
                    "airblast vulnerability multiplier"	0
					"airblast vertical vulnerability multiplier" 0
                    "override footstep sound set" 3
                    "no_jump" 1
			    }
                // Primary
                Item "gentlemanne_rocketlauncher_coffinnail"
                    WeaponSwitch [$SIGSEGV]
                    {
                        Delay 0.1
                        Cooldown 10
                        Type "Primary"
                    }
                    ItemAttributes
                    {
                        ItemName "gentlemanne_rocketlauncher_coffinnail"
                        "faster reload rate" -0.8
                        "fire rate bonus" 0.5
                        "damage bonus" 1.2
                    }
                // Melee
                Item "The Equalizer"
                    WeaponSwitch [$SIGSEGV]
                    {
                        Delay 16
                        Cooldown 10
                        Type "Melee"
                    }
                    ItemAttributes
                    {
                        ItemName "The Equalizer"
                        "fire rate bonus" 0.6
                        "damage causes airblast" 1
                        "melee range multiplier" 2.0
                        "melee bounds multiplier" 4
                        "melee cleave attack" 1
                        "damage penalty" 0.5
                        "dmg bonus vs buildings" 100
                    }
                // Secondary
                Item "The Short Circuit"
                    WeaponSwitch [$SIGSEGV]
                    {
                        Delay 18
                        Cooldown 10
                        Type "Secondary"
                    }
                    FireWeapon [$SIGSEGV]
                    {
                        Delay 0.25
                        Cooldown 0.25
                        IfSeeTarget 1
                        Type Secondary
                    }
                    CustomWeaponModel [$SIGSEGV]
                    {
                        Slot 1
                        Model "models/weapons/c_models/c_drg_pomson/c_drg_pomson.mdl"
                    }
                    FireInput [$SIGSEGV]
                    {
                        Target "swapphase"
                        Action "trigger"
                        Delay 0
                        IfHealthBelow 40000
                        Repeats 1
                    }

                // Change primary stats, gain crits, change secondary and melee behavior
                    EventChangeAttributes
                    {
                        telosProtocol [$SIGSEGV]
                        {
                            Item "warbird_rocketlauncher_warhawk" // Rockets are now homing
                                ItemAttributes
                                {
                                    ItemName "warbird_rocketlauncher_warhawk"
                                    "clip size upgrade atomic" 30.0
                                    "faster reload rate" 0.15
                                    "fire rate bonus" 0.5
                                    "damage bonus" 1.5
                                    "Projectile speed increased" 0.6
                                    "projectile trail particle" "eyeboss_projectile"
                                    "mod projectile heat seek power" 80
                                    "mod projectile heat aim error" 100
                                    "projectile spread angle penalty" 5
                                }
                            Item "The Short Circuit" // Secondary now shoots sentries
                                ItemAttributes
                                {
                                    ItemName "The Short Circuit"
                                    "projectile speed" 0.5
                                    "fire rate penalty" 13
                                    "projectile gravity" 2600
                                    "override projectile type" 2
                                    "damage causes airblast" 1
                                }
                                ShootTemplate
                                {
                                    Name TelosSentry
                                    AttachToProjectile 1
                                    ItemName "The Short Circuit"
                                }
                            Item "The Equalizer" // Remove dmg penalty, reflects projectiles
                                ItemAttributes
                                {
                                    ItemName "The Equalizer"
                                    "fire rate bonus" 0.4
                                    "damage causes airblast" 1
                                    "melee range multiplier" 2.0
                                    "melee bounds multiplier" 4
                                    "melee cleave attack" 1
                                    "melee airblast" 1              // can reflect projectiles
                                    "dmg bonus vs buildings" 100    // anti-sentryblock
                                }
                            CharacterAttributes
                            {
                                "no_attack" 1
                                "move speed bonus" 0
                                "dmg from ranged reduced" 0
                                "dmg from melee increased" 0
                            }

                            Taunt
                            {
                                Delay 0.2
                                Duration 4
                                Name "Taunt: Cheers!"
                                Repeats 1
                            }

                            FireInput
                            {
                                Target "!self"
                                Action "RunScriptCode"
                                Param "ClientPrint(null, 3, `\x0799CCFFNeos Evo \x01has used their \x079BBF4DTELOS PROTOCOL \x01Power Up Canteen!`)"
                                Delay 4
                                Repeats 1
                            }

                            FireInput
                            {
                                Target "player"
                                Action "$PlaySoundToSelf"
                                Param "=40|battery_canteen.wav" //// custom canteen sound by SantiGuardianUniversalXD2
                                Delay 4
                                Repeats 1
                            }

                            FireInput
                            {
                                Target "!self"
                                Action "RunScriptCode"
                                Param "self.AddCond(11);"
                                Delay 4
                                Repeats 1
                            }
                    
                            AddAttribute
                            {
                                Item "player"
                                Name "no_attack"
                                Value 0
                                Delay 6
                                Repeats 1
                            }

                            AddAttribute
                            {
                                Item "player"
                                Name "move speed bonus"
                                Value 0.75
                                Delay 6
                                Repeats 1
                            }

                            AddAttribute
                            {
                                Item "player"
                                Name "dmg from ranged reduced"
                                Value 1
                                Delay 6.5
                            }

                            AddAttribute
                            {
                                Item "player"
                                Name "dmg from melee increased"
                                Value 1
                                Delay 6.5
                            }
                        }
                    }
            }
        }
    }

//// PointTemplates ////
    PointTemplates [$SIGSEGV]
	{
		DemoBottle
		{
			KeepAlive 1
			OnParentKilledOutput
			{
				Target "bottle_death_relay"
				Action Trigger
				Delay 0.01
			}
			
			OnParentKilledOutput
			{
				Target "bottle"
				Action Kill
				Delay 0.02
			}
			
			prop_dynamic
			{
				"targetname" "bottle"
				"modelscale" "1.5"
				"DisableBoneFollowers" "1"
				"disableshadows" "1"
				"model" "models\weapons\c_models\c_bottle\c_bottle.mdl"
				"solid" "0"
				"spawnflags" "0"
				"StartDisabled" "0"
			}
		}
        dionysian_logic
		{
			logic_relay														
			{																
				"TargetName" "drinkscrumpy"									
				"OnTrigger" "!activator,$ChangeAttributes,drinkCrits,0,1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/mght/demoman_mvm_m_laughevil05.mp3,0,-1"
			}
		}
        trojanText
		{
			OnSpawnOutput
			{
				Target "trojanrelay"
				Action Trigger
			}
			logic_relay
			{
				"TargetName" "trojanrelay"
				"OnTrigger"  "trojanmessage,show,,0,1"
			}
			training_annotation 
			{
				"targetname"   "trojanmessage"
				"display_text" "A suspicious tank has spawned near the base..."
				"lifetime"     "10"
				"origin"        "0 0 0"
			}
		}
        reinforceText
		{
			OnSpawnOutput
			{
				Target "reinforcerelay"
				Action Trigger
			}
			logic_relay
			{
				"TargetName" "reinforcerelay"
				"OnTrigger"  "reinforcemessage,show,,0,1"
			}
			training_annotation 
			{
				"targetname"   "reinforcemessage"
				"display_text" "The trojan tank has spawned in reinforcements!"
				"lifetime"     "8"
				"origin" "0 0 0"
			}
		}
		SpawnPoints
		{
			NoFixup 1
			info_player_teamspawn
			{
				"targetname" "spawnbot_trojan"
				"StartDisabled" "1"
				"spawnflags" "511"
				"TeamNum" "2"
				"origin" "-4784 -2112 -1040"
			}
		}
		TrojanTank
		{
			KeepAlive 1
			OnParentKilledOutput
			{
				Target "trojan_teleport_maker"
				Action ForceSpawnAtEntityOrigin
				Param  "trojan"
				Delay 0.00
			}
			OnParentKilledOutput
			{
				Target "trojan_death_relay"
				Action Trigger
				Delay 0.01
			}
			OnParentKilledOutput
			{
				Target "trojan"
				Action Kill
				Delay 0.02
			}
            prop_dynamic
			{
				"targetname" "trojan"
				"origin" "0 0 150"
				"DisableBoneFollowers" "1"
				"disableshadows" "1"
				"model" "models\props_halloween\halloween_gift.mdl"
				"solid" "0"
			}
		}
		TrojanTeleportLogic
		{
			NoFixup 1
			filter_tf_bot_has_tag
			{
				"targetname" "filter_trojan_bot"
				"Negated" "0"
				"require_all_tags" "1"
				"tags" "bot_trojan"
				
				"OnPass" "trojan_teleport,Teleport,,0,-1"
			}
			logic_relay
			{
				"targetname" "trojan_death_relay"
				"OnTrigger" "spawnbot_trojan,Enable,,0.01,-1"
				"OnTrigger" "spawnbot_trojan,Disable,,0.06,-1"
				"OnTrigger" "trojan_teleport,Kill,,0.1,-1"
			}
			env_entity_maker
			{
				"targetname"     "trojan_teleport_maker"	
				"EntityTemplate" "trojan_teleport_template"
			}	
		}
		trojan_teleport_template
		{
			NoFixup   1
			KeepAlive 1
			point_teleport
			{
				"targetname" "trojan_teleport"
				"target"     "!activator"
				"origin"     "0 0 0"
			}
		}
