			heli_path = [
				Vector(5245, 4227, 1016)    // tank_path_1
				Vector(5136, 4896, 1184)    // tank_path_2
				Vector(4032, 3472, 1104)    // tank_path_3
				Vector(3800, 3448, 1016)    // tank_path_4
