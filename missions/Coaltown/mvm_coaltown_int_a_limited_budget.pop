			{
				ItemName "The Eyelander"
				"critboost on kill" 3
			}
			ItemAttributes
			{
				ItemName "The Tide Turner"
				"lose demo charge on damage when charging" 0
			}
			CharacterAttributes
			{
				"increase buff duration" 9.0
				"deploy time increased" 0.01
				"airblast vulnerability multiplier" 0.0
				"override footstep sound set" 4.0
				"damage force reduction" 0.40
				"move speed bonus" 0.50
