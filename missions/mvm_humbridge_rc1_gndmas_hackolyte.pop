			WaitBetweenSpawns 2
			TotalCurrency 25
		
			TFBot
            {
                Class	Pyro
				Skill	Expert
				WeaponRestrictions	PrimaryOnly
				Attributes	AlwaysCrit
            }
		}
		WaveSpawn	// 
		{
			Name "wave01a"
			Where flankers
			TotalCount 10
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 5
			WaitBetweenSpawns 2
			TotalCurrency 30
		
			TFBot
            {
                Class	Pyro
				Skill	Expert
				WeaponRestrictions	PrimaryOnly
				Attributes	AlwaysCrit
            }
		}

		// Subwave 3 (maxActive = 21)
		// Giant Soldier / Giant Heavy + Uber Medic (12)
		// Soldier [5]
		// Rapid Fire Scout [4]

		// This subwave uses the tank that spawned in the preceding subwave
		// as an opportunity to push up without losing significant amounts of
		// HP. These giants are not particularly noteworthy, but are split
		// between burst and sustained damage output types, covering both
		// close and mid-range combat for the bots. The Uber Medics help
		// prolong the general longevity of these giants, while the Support
		// bots here add additional attackers to pester RED and drag some
		// attention away from the giants.

		WaveSpawn	// 
		{
			Name "wave01bGiant"
			Where spawnbot
			TotalCount 6
			MaxActive 3
			SpawnCount 3
			WaitForAllSpawned wave01aGiant2
			WaitBeforeStarting 5
			WaitBetweenSpawns 8
			TotalCurrency 100
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer
					CharacterAttributes
					{
						"damage force reduction" 0.25
						"airblast vulnerability multiplier" 0.25
						"airblast vertical vulnerability multiplier" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
		WaveSpawn	// 
		{
			Name "wave01bGiant2"
			Where spawnbot_tank
			TotalCount 9
			MaxActive 9
			SpawnCount 2
			WaitForAllSpawned wave01aGiant2
			WaitBeforeStarting 8
			WaitBetweenSpawns 4
			TotalCurrency 100
		
			Squad
