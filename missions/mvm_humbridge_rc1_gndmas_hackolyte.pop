				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
		WaveSpawn	// 
		{
			Name "wave01aGiant"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 7
			WaitBetweenSpawns 0
			TotalCurrency 10
		
			TFBot
            {
                Template T_TFBot_Giant_DemoKnight_BattleAxe
				Attributes	AlwaysCrit
				CharacterAttributes
				{
					"damage force reduction" 0.25
					"airblast vulnerability multiplier" 0.25
					"airblast vertical vulnerability multiplier" 0.25
				}
            }
		}
        WaveSpawn	// 
		{
			Name "wave01aGiant"
			Where flankers
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 7
			WaitBetweenSpawns 0
			TotalCurrency 10
		
			TFBot
            {
                Template T_TFBot_Giant_DemoKnight_BattleAxe
				Attributes	AlwaysCrit
