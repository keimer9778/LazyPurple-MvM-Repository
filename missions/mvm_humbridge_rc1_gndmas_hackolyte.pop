					Template T_TFBot_Medic_QuickUber
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
        WaveSpawn	// 
		{
			Name "wave01aGiant2"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitForAllSpawned wave01aTank
			WaitBeforeStarting 6
