	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		InitWaveOutput
		{
			Target wave_a_init
			Action Trigger
		}
		
		WaitWhenDone 65
		Checkpoint Yes

		// Subwave 1 (maxActive: 22)
		// Giant Crit Rapid Demo + Uber Medic (2)
		// Crit Fast Bonk Scout (4)
		// Backburner Pyro (14)

		// This first subwave is a doomstack (i.e. made with very
		// strong robots relative to the cash payout at that point).
		// The Giant Fast Pyro and Armored Uber Medic quickly rush
		// to the defending line to try and force a quick retreat. If
		// they are unsuccessful, the Rapid Demo and Giant Uber Medic
		// will generally force RED out of the first choke. The
		// small Fast Bonk Scouts force shield uptime if a Backup is
		// not already popped, and Fast Pyros are a nudge to try and
		// get Medic players to retreat, pushing the defending line
		// back if DPS is not high enough.

		WaveSpawn
		{
			Name "wave02aGiant"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 6
			WaitBetweenSpawns 0
			TotalCurrency 25
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Demo_Spammer
					Attributes	AlwaysCrit
					CharacterAttributes
					{
						"damage force reduction" 0.25
						"airblast vulnerability multiplier" 0.25
						"airblast vertical vulnerability multiplier" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic_Uber
					CharacterAttributes
					{
						"bot medic uber health threshold" 300
					}
				}
			}
		}
		WaveSpawn
		{
			Name "wave02aGiant"
			Where spawnbot_tank
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 25
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Pyro_Fast
					Attributes AlwaysCrit
					CharacterAttributes
					{
						"damage force reduction" 0.25
						"airblast vulnerability multiplier" 0.25
						"airblast vertical vulnerability multiplier" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_Armored
				}
			}
		}
		WaveSpawn
		{
			Name "wave02aBonk"
			Where spawnbot_tank
			TotalCount 16
			MaxActive 4
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 2
			TotalCurrency 50
			Support Limited
		
			TFBot
			{
				Template T_TFBot_Scout_Bonk_Fast
				Attributes AlwaysCrit
			}
		}
		WaveSpawn
		{
			Name "wave02a"
			Where spawnbot
			TotalCount 30
			MaxActive 14
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 1
			TotalCurrency 100
		
			TFBot
			{
				Template T_TFBot_Pyro_Fast
				Skill Hard
			}
		}

		// Subwave 2 (maxActive: 18)
		// Combat Tank: Railgun
		// Giant Black Box Soldier + Armored Uber Medic (4)
		// Giant Crit Rapid Fire Demo + Giant Uber Shield Medic (2)
		// Steel Gauntlet (10)
		// Chain -> Giant Ancored FaN Scout (2)

		// The focal pushing force this wave is the combat tank.
		// The Giant Black Box Soldier and Armored Uber Medic mostly
		// serve as additional HP walls to keep any backlining players
		// occupied. They last much longer when part of the team is
		// focused on the tank, and take the bomb a fair distance.
		// The second Giant Rapid Demo + Giant Uber Medic pair are the
		// main source of damage output here and push RED even further.
		// Steel Gauntlets serve as additional sponges to increase the
		// longevity of the giants on this subwave. A Giant Anchored
		// FaN Scout will accompany these giants, chained into the
		// third subwave.

		WaveSpawn
		{
			Name	"wave02bTank"
			WaitForAllSpawned	wave02aGiant
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 0
			TotalCurrency 50
			Where	spawnbot
			Tank
			{
				Health	35000
				Name	combattank_bomb|railgun|railgun
				ClassIcon tank_combat_railgun_better [$SIGSEGV]
				Speed	75
				StartingPathTrackNode "boss_path_a1"
				OnKilledOutput
				{
					Target	boss_dead_relay
					Action	Trigger
				}
				OnBombDroppedOutput
				{
					Target	boss_deploy_relay
					Action	Trigger
				}
			}
		}

		WaveSpawn
		{
			Name "wave02bGiant"
			Where flankers
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitForAllSpawned wave02bTank
