#base robot_giant.pop
#base robot_standard.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_lazypurple.pop

WaveSchedule
{
	// A reference list for spawn locations and the starting tank path.
	// ----------------------------------------------------------------
    // flankers (left)
    // spawnbot (right)
    // spawnbot_tank
	// tank_path_a1 (only 1 path)

	// Basic mission definitions
	StartingCurrency				900
	RespawnWaveTime 				2
	FixedRespawnWaveTime			Yes
	CanBotsAttackWhileInSpawnRoom	No
	RobotLimit 22 [$SIGSEGV]

	// This section uses PointTemplates to utilize TankExtensions
	// throughout the mission without needing to call it each wave.
	PointTemplates [$SIGSEGV]
	{
		Scripts
		{
			OnSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param
					"IncludeScript(`tankextensions_main`)
					IncludeScript(`tankextensions/combattank`)
					IncludeScript(`tankextensions/combattank_weapons/minigun`)
					IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
					IncludeScript(`tankextensions/combattank_weapons/railgun`)
					IncludeScript(`tankextensions/combattank_weapons/fireball`)
				"
			}
		}
	}
	// Directly call the script when the mission loads.
	SpawnTemplate Scripts [$SIGSEGV]

	Mission
	{
		Objective			Spy
		InitialCooldown		30
		Where				spawnbot_mission_spy
		BeginAtWave			4
		RunForThisManyWaves	1
		CooldownTime		30
		DesiredCount		2

		TFBot
		{
			Template	T_TFBot_Spy
		}
	}
	Mission
	{
		Objective	DestroySentries
		BeginAtWave 1
		RunForThisManyWaves	5
		InitialCooldown	5
		CooldownTime	60
		DesiredCount	1
		Where spawnbot
		TFBot
		{
			Template	T_TFBot_SentryBuster
		}
	}

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		// Bots will take the upper path.
		// When the wave starts, stop playing the radio.
		// Disable player gibbing once the mission begins.
			// (You can still explode during 1st wave setup for fun)
		InitWaveOutput
		{
			Target bignet
    		Action RunScriptCode
			Param "
					EntFire(`wave_a_init`, `Trigger`)
					EntFire(`radio_music_stop`, `Trigger`)
					Convars.SetValue(`tf_playergib`, 0)
				"
		}
		WaitWhenDone 65
		Checkpoint Yes

		// Subwave 1 (maxActive = 20 - 22)
		// Giant Crit Battleaxe Demoknight (4 - 6)
		// Giant Rapid Fire Soldier + Uber Medic (6 - 9)
		// Standard Tank
		// Conch Soldier (4)
		// Crit Pyro (6)

		// This subwave is very HP-heavy and is intended to exhaust
		// the team's resources. The Giant Battleaxe Demoknight
		// and Pyros make holding the funnel choke very risky, and
		// the Uber Medics allow the Giant Rapid Fire Soldiers to push
		// in for ranged damage. In order to lessen the significant
		// impact an experienced Spy player can have, the Uber Medics
		// and Giant Rapid Fire Soldiers alternate spawns to approach
		// from different angles. The tank serves as a physical obstacle
		// for RED such that the robots take less gunfire.

		WaveSpawn	// 
		{
			Name "wave01aGiant"
			Where flankers
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 10
		
			TFBot
            {
                Template T_TFBot_Giant_DemoKnight_BattleAxe
				Attributes	AlwaysCrit
				CharacterAttributes
				{
					"damage force reduction" 0.25
					"airblast vulnerability multiplier" 0.25
					"airblast vertical vulnerability multiplier" 0.25
				}
            }
		}
        WaveSpawn	// 
		{
			Name "wave01aGiant"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 10
		
			TFBot
            {
                Template T_TFBot_Giant_DemoKnight_BattleAxe
				Attributes	AlwaysCrit
				CharacterAttributes
				{
					"damage force reduction" 0.25
					"airblast vulnerability multiplier" 0.25
					"airblast vertical vulnerability multiplier" 0.25
				}
			}
		}
        WaveSpawn	// 
		{
			Name "wave01aGiant"
			Where spawnbot_tank
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 15
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer
					CharacterAttributes
					{
						"damage force reduction" 0.25
						"airblast vulnerability multiplier" 0.25
						"airblast vertical vulnerability multiplier" 0.25
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
		WaveSpawn	// 
