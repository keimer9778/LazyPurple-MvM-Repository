		}
		WaveSpawn	// 
		{
			Name "wave01bSupport"
			Where spawnbot_tank
			MaxActive 4
			SpawnCount 2
			WaitForAllSpawned "wave01bGiant"
			WaitBeforeStarting 10
			WaitBetweenSpawns 2
			TotalCurrency 50
			Support 1

			TFBot
			{
				Class Soldier
				WeaponRestrictions PrimaryOnly
				Skill Expert
			}
		}
		WaveSpawn	// 
		{
			Name "wave01cSupportPostGiant"
			Where flankers
			MaxActive 4
			SpawnCount 2
			WaitForAllDead "wave01bGiant"
			WaitBeforeStarting 10
			WaitBetweenSpawns 2
			TotalCurrency 50
			Support 1

			TFBot
			{
				Class Soldier
				WeaponRestrictions PrimaryOnly
				Skill Expert
			}
		}
