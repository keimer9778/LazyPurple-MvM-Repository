    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_a_init`, `Trigger`)
                    EntFire(`radio_music_stop`, `Trigger`)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1

		WaveSpawn // 1 GLaser Heavy
		{
			Name "Wave6_Subwave1_GLaserHeavy"
			Where spawnbot_tank
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100

			FirstSpawnWarningSound "vo/mvm/mght/heavy_mvm_m_laughlong01.mp3"
			DoneWarningSound "ambient/explosions/explode_4.wav"

			TFBot
			{
				Name "Laser Leitmotif"
				Template T_TFBot_Giant_Heavy_Laser
				Health 40000
				Attributes AlwaysCrit
				Attributes UseBossHealthBar
			}
		}
		WaveSpawn // 1 Redetonator Soldier
		{
			Name "Wave6_Subwave1_Redetonator"
			WaitForAllSpawned "Wave6_Subwave1_GLaserHeavy"
			Where flankers
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 4
			WaitBetweenSpawns 0
			TotalCurrency 100

			FirstSpawnWarningSound "vo/mvm/mght/soldier_mvm_m_laughlong01.mp3"
            DoneWarningSound "ambient/explosions/explode_4.wav"

			TFBot
			{
				Name "Redetonator Reprise"
				Template T_TFBot_Giant_Soldier_Redetonator
				Health 30000
				Attributes AlwaysCrit
				Attributes UseBossHealthBar

				FireInput
				{
					Target "tf_point_weapon_mimic*"
					Action "AddOutput"
					Param "Crits 1"
					Delay 0
					Repeats 1
				}
			}
		}

		WaveSpawn // 18 Demomen
		{
			Name "Wave6_Subwave1_Demomen"
