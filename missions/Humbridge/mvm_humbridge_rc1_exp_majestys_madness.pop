    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_a_init`, `Trigger`)
                    EntFire(`radio_music_stop`, `Trigger`)
                "
        }
		StartWaveOutput
