            TeleportWhere spawnbot

            ExtAttr BuildDispenserAsTeleporter

            AlwaysGlow 1

            CharacterAttributes
            {
                "engy dispenser radius increased" 5
            }
        }
    }

    Wave //Wave 1 - $1200
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Summer's End (Adv)`)
					EntFire(`init_path_a_flank`, `Trigger`)
                    local bomb = Entities.FindByName(null, `bomb`)
                    bomb.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)
                  "
        }

		StartWaveOutput
		{
			Target wave_start_relay
            Action Trigger
		}

		DoneOutput
		{
			Target wave_finished_relay
            Action Trigger
		}

        WaveSpawn
        {
            Name 1a
            Where spawnbot
            TotalCount 3
            SpawnCount 1
            MaxActive 2

            TotalCurrency 250
            WaitBetweenSpawns 18

            TFBot
            {
                Name "Giant SMG Sniper"
                Class Sniper
                ClassIcon sniper_smg_tind
                Skill Expert
                Health 3000
                Item teufort_smg_teamsprayer
                Item "The Triggerman's Tacticals"
                Attributes MiniBoss
                WeaponRestrictions SecondaryOnly
                MaxVisionRange 1600

                UseCustomModel models/bots/sniper_boss/bot_sniper_boss.mdl
                PreferClass Spy
                PreferClass Soldier
                PreferClass Heavyweapons
                PreferClass Sniper

                Tag bot_giant

                ItemAttributes
                {
                    ItemName teufort_smg_teamsprayer
                    "weapon spread bonus" 0.8
                    "fire rate bonus" 0.8
                    "killstreak tier" 2
                    "killstreak idleeffect" 1
                }

                CharacterAttributes
                {
                    "move speed penalty" 0.5
                    "damage force reduction" 0.35
                    "airblast vulnerability multiplier" 0.35
                    "airblast vertical vulnerability multiplier" 0.5
                    "override footstep sound set" 7
                }
            }
        }

        WaveSpawn
        {
            Name 1a
            Where spawnbot_flank_right
            Where spawnbot_flank_left
            RandomSpawn 1
            TotalCount 44
            SpawnCount 4
            MaxActive 9

            WaitBeforeStarting 1
            WaitBetweenSpawns 3

            TotalCurrency 275

            RandomChoice
            {
                Shuffle 1
                TFBot
                {
                    Name "Crit-a-Cola Scout"
                    Class Scout
                    ClassIcon scout_cola
                    Skill Normal
                    Item "Bonk Helm"
                    Item "Upgradeable TF_WEAPON_SCATTERGUN"
                    Item "Crit-a-Cola"

                    ItemAttributes
                    {
                        ItemName "Bonk Helm"
                        "set item tint rgb" 5322826
                    }

                    CharacterAttributes
                    {
                        "deploy time decreased" 0.33
                    }
                }

                NextSpawnerClone 2
                TFBot
                {
                    Name "Crit-a-Cola Scout"
                    Class Scout
                    ClassIcon scout_cola
                    Skill Normal
                    Item "Bonk Helm"
                    Item "Crit-a-Cola"
                    Item "The Atomizer"
                    WeaponRestrictions MeleeOnly

                    ItemAttributes
                    {
                        ItemName "Bonk Helm"
                        "set item tint rgb" 5322826
                    }

                    CharacterAttributes
                    {
                        "deploy time decreased" 0.33
                    }
                }
            }
        }

        WaveSpawn
        {
            Where spawnbot
            Support Limited
            TotalCount 10
            SpawnCount 1
            MaxActive 2

            WaitBetweenSpawns 8

            TotalCurrency 75

            TFBot
            {
                Name "Bonk Scout"
                Class Scout
                ClassIcon scout_bonk_nys
                Skill Hard
                Health 500
                Scale 1.35
                Item "Bonk Helm"
                Item "The Soda Popper"
                Item "Bonk! Atomic Punch"
                Item "The Atomizer"
                WeaponRestrictions MeleeOnly
                BehaviorModifiers Push

                Tag flank

