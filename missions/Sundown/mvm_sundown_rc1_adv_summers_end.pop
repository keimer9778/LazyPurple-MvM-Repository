#base robot_standard.pop
#base robot_giant.pop

//
// Starting Currency: 1200
//
// +----------+----------+----------+
// | Wave     | Currency | A+       |
// +----------+----------+----------+
// | Wave 1   | 1200     | 1300     |
// | Wave 2   | 1200     | 1300     |
// | Wave 3   | 1200     | 1300     |
// | Wave 4   | 1200     | 1300     |
// | Wave 5   | 1200     | 1300     |
// +----------+----------+----------+
// | Total    | 6000     | 6500     |
// +----------+----------+----------+
//

gettysburg
{
    StartingCurrency 1200
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 2

    Advanced 1

    BodyPartScaleSpeed 50
    NoRomevisionCosmetics 1
    FixSetCustomModelInput 1
    ImprovedAirblast 1
    AllowBotExtraSlots 1
    StuckTimeMultiplier 2
    RobotLimit 50
    PrecacheModel models/bots/sniper_boss/bot_sniper_boss.mdl
    WaveStartCountdown 5

    SpawnTemplate ExtraPacks

    OverrideSounds  
	{
        "MVM.BombWarning"			"ambient/alarms/doomsday_lift_alarm.wav"
        "MVM.GiantHeavyExplodes"	"npc/env_headcrabcanister/explosion.wav"
		"MVM.GiantCommonExplodes"	"npc/env_headcrabcanister/explosion.wav"
	}

    Mission //Buster (fast)
    {
        Objective DestroySentries
        Where spawnbot_flank_right
        Where spawnbot_flank_left
        CooldownTime 35
        BeginAtWave 1
        RunForThisManyWaves 5

        TFBot
        {
            Class Scout
            Name "Speedy Buster"
            Template T_TFBot_SentryBuster
            Health 2000
            Scale 1.5
            Skill Easy
            Attributes IgnoreEnemies
            Attributes DisableDodge
            Tag bot_sentrybuster

            CharacterAttributes
            {
                "damage force reduction" 0
                "airblast vulnerability multiplier" 0
                "airblast vertical vulnerability multiplier" 0
                "rage giving scale" 0
            }
        }
    }

    Mission //Wave 1 Sniper + Bigheal
    {
        Objective Sniper
        Where spawnbot_flank_right
        DesiredCount 1
        InitialCooldown 15
        CooldownTime 25
        BeginAtWave 1
        RunForThisManyWaves 1

        Squad
        {
            TFBot
            {
                Class Sniper
                Skill Normal
                Item "The Cozy Camper"
                Item "The Crossing Guard"
            }

            TFBot
            {
                Name "Big Heal Medic"
                Class Medic
                ClassIcon medic_pop
                Skill Hard
                Item "The Quick-Fix"
                Item "The Surgeon's Stahlhelm"
                Item "Das Metalmeatencasen"
                Attributes SpawnWithFullCharge
                Attributes IgnoreEnemies

                ItemAttributes
                {
                    ItemName "The Quick-Fix"
                    "heal rate bonus" 11
                    "ubercharge rate penalty" 0.01
                }
            }
        }
    }

    Mission //Wave 2 Bowmen Snipers
    {
        Objective Sniper
        Where spawnbot_flank_left
        DesiredCount 3
        InitialCooldown 5
        CooldownTime 30
        BeginAtWave 2
        RunForThisManyWaves 1

        TFBot
        {
            Name Bowman
            Class Sniper
            ClassIcon sniper_bow
            Skill Hard
            Item "The Huntsman"
            Item "The Cozy Camper"
            Item "The Crossing Guard"

            ItemAttributes
            {
                ItemName "The Huntsman"
                "damage penalty" 0.5
            }
        }
    }

    Mission //Wave 2 Sentry + Dispenser Engineer
    {
        Objective Engineer
        Where spawnbot_flank_right
        Where spawnbot_flank_left
        DesiredCount 1
        InitialCooldown 45
        CooldownTime 45
        BeginAtWave 2
        RunForThisManyWaves 1

        TFBot
        {
            Class Engineer
			Skill Expert
			Health 500
			Item "The Data Mining Light"
			Item "The Texas Half-Pants"
			Item "Packable Provisions"
			Item "The Southern Hospitality"
            Attributes TeleportToHint
            TeleportWhere spawnbot

            ExtAttr BuildDispenserAsTeleporter

            AlwaysGlow 1

            CharacterAttributes
            {
                "engy dispenser radius increased" 5
            }
        }
    }

    Mission //Wave 3 Sentry + Dispenser Engineer
    {
        Objective Engineer
        Where spawnbot_flank_right
