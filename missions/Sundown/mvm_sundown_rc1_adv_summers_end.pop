        TFBot
        {
            Class Engineer
			Skill Expert
			Health 500
			Item "The Data Mining Light"
			Item "The Texas Half-Pants"
			Item "Packable Provisions"
			Item "The Southern Hospitality"
			Attributes TeleportToHint
            TeleportWhere spawnbot

            ExtAttr BuildDispenserAsTeleporter

            AlwaysGlow 1

            CharacterAttributes
            {
                "engy dispenser radius increased" 5
            }
        }
    }

    Mission //Wave 4 YER Red Tape Spies
    {
        Objective Spy
        Where spawnbot_flank_right
        DesiredCount 3
        InitialCooldown 30
        CooldownTime 70
        BeginAtWave 4
        RunForThisManyWaves 1

        TFBot
        {
            Name "Saharan Spy"
			Class Spy
			Skill Expert
