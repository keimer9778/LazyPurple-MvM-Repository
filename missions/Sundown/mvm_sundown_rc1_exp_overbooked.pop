#base robot_standard.pop
#base robot_giant.pop
#base robot_click.pop
#base robot_click_giant.pop

//// Expert - Overbooked by hoshikayz ////
population
{
    StartingCurrency 900
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 5
    NoRomevisionCosmetics 1 [$SIGSEGV]
    SniperAllowHeadshots 1 [$SIGSEGV]

//////// TEMPLATES ////////
    Templates
    {
        T_TFBot_Medic_Shield
        {
            ClassIcon	medic_shield_ala
            Health	150
            Name	"Shield Medic"
            Class	Medic
            Skill	Expert
            WeaponRestrictions	SecondaryOnly
            Attributes	"SpawnWithFullCharge"
            Attributes	"ProjectileShield"
            Item "Summer Shades"
            Item "Doc's Holiday"
            ItemAttributes
            {
                ItemName	TF_WEAPON_MEDIGUN
                "ubercharge rate bonus"	0.2
                "increase buff duration" 500
            }
            CharacterAttributes
            {
                "heal rate bonus"	5
            }
        }
        T_TFBot_Medic_Kritz
        {  
            Class Medic
            Name "Kritzkrieg Medic"
            ClassIcon medic_kritz_lite
            Health 150
            Skill Expert
            Item "The Kritzkrieg"
            Item "Das Feelinbeterbager"
            Item "Practitioner's Processing Mask"
            Item "Halogen Head Lamp"
            WeaponRestrictions SecondaryOnly
            Attributes "SpawnWithFullCharge"
            Attributes "AlwaysCrit"
            CharacterAttributes
            {
                "heal rate bonus" 5
                "ubercharge rate bonus" 25
                "bot medic uber health threshold" 95
                "bot medic uber deploy delay duration" 0.5
            }    

        }
        Drunk_Demoman
        {
            Name "Drunk Demoman"
            Class Demoman
            ClassIcon demoknight_bottle_lite
            Skill Hard
            Health 175
            Item "Summer Hat"
            Item "The Tide Turner"
            WeaponRestrictions MeleeOnly
            Attributes AlwaysCrit
            CharacterAttributes
            {
                "effect bar recharge rate increased" 2.0
            }
            ItemAttributes
            {
                ItemName "Summer Hat"
                "attach particle effect" 373
            }
        }
        
    }
    Mission //Sentry Busters
    {
            Objective DestroySentries
            Where spawnbot_flank_left
            CooldownTime 30
            InitialCooldown 0
            BeginAtWave 1
            RunForThisManyWaves 5
            TFBot
            {
                Template    T_TFBot_SentryBuster
                Attributes DisableDodge
                CharacterAttributes
                {
                    "damage force reduction" 0
                    "airblast vulnerability multiplier" 0
                    "airblast vertical vulnerability multiplier" 0
                }
            }

    }
    Mission //Snipers
    {
        Objective Sniper
        Where spawnbot_flank_right
        DesiredCount 2
        InitialCooldown 15
        CooldownTime 25
        BeginAtWave 1
        RunForThisManyWaves 2
        TFBot
        {
            Template    T_TFBot_Sniper
        }
    }
    Mission //Sydney Snipers
    {
        Objective Sniper
        Where spawnbot_flank_right
        DesiredCount 1
        InitialCooldown 15
        CooldownTime 25
        BeginAtWave 4
        RunForThisManyWaves 1
        TFBot
        {
            Template T_TFBot_Sniper_Sydney_Sleeper
        }
    }
    Mission //YER Spy
    {
        Objective Spy
        Where spawnbot_flank_right
        DesiredCount 2
        InitialCooldown 30
        CooldownTime 70
        BeginAtWave 3
        RunForThisManyWaves 2
        TFBot
        {
            Name "Your Eternal Spy"
			Class Spy
			Skill Expert
			Item "L'Etranger"
			Item "Your Eternal Reward"
            Item "Charmer's Chapeau"
        }
    }
    Mission //YER Spy
    {
        Objective Spy
        Where spawnbot_flank_right
        DesiredCount 2
        InitialCooldown 30
        CooldownTime 70
        BeginAtWave 6
