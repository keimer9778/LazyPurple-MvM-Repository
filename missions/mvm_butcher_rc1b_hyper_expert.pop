	////////////////////// WAVE 8 //////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////////////////////////
	
	Mission
	{
		Objective Engineer  

		InitialCooldown 10
		Where spawnbot_invasion
		BeginAtWave 8
		RunForThisManyWaves 1
		CooldownTime 12
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_invasion
			TeleportWhere spawnbot_chief
			Attributes TeleportToHint
			Health 600
		}
	}
	
	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
			{
				Target wave_start_relay
				action runscriptcode 
                param "
				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/blimp`, getroottable())
				IncludeScript(`tankextensions/combattank`, getroottable())
				IncludeScript(`tankextensions/combattank_weapons/minigun`, getroottable())
				IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())
				IncludeScript(`tankextensions/combattank_weapons/fireball`, getroottable())
				IncludeScript(`tankextensions/combattank_weapons/railgun`, getroottable())
				::altspawn <- 
						{
							Cleanup = function()
							{
								local objRes = Entities.FindByClassname(null, `tf_objective_resource`)
								local missionString = NetProps.GetPropString(objRes, `m_iszMvMPopfileName`)
								const NAME = `hyper_expert`
								
								if(missionString.find(NAME) == null) {
									delete ::altspawn
								}
							}
							
							// mandatory events
							OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
							OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
							
							OnGameEvent_player_spawn = function(params) {
								local player = GetPlayerFromUserID(params.userid)
								
								if(!IsPlayerABot(player)) {
									return
								}
								
								EntFireByHandle(player, `RunScriptCode`, `altspawn.teletospawn(activator)`, -1, player, null)
							}

							teletospawn = function(player) {
								//if(player.HasBotAttribute(134217728)) { //projectile shield
								//	player.Teleport(true, Vector(0, 145, 1000), true, bot.EyeAngles(), true, bot.GetAbsVelocity())
								//}
								local bottags = {}
								player.GetAllBotTags(bottags)
								
								foreach(i, tag in bottags) {
									if (tag == `altspawn1`)
									{
										player.Teleport(true, Vector(2280, 1970, 600), true, player.EyeAngles(), true, player.GetAbsVelocity())
									}
									if (tag == `altspawn2`)
									{
										player.Teleport(true, Vector(2100, 3510, 400), true, player.EyeAngles(), true, player.GetAbsVelocity())
									}
								}
							}
						};
						__CollectGameEventCallbacks(altspawn)
						
						SpawnEntityFromTable(`info_particle_system`,
						{
							targetname = `tele_indicator1`
							origin = `2280, 1970, 263`
							start_active = 1,
							effect_name = `teleporter_mvm_bot_persist`
						})
						SpawnEntityFromTable(`prop_dynamic`,
						{
							targetname = `tele_indicator1`
							origin = `2280, 1970, 323`
							model = `models/pickups/emitter.mdl`
							skin = 1
						})
						SpawnEntityFromTable(`info_particle_system`,
						{
							targetname = `tele_indicator2`
							origin = `2100 3510 71`
							start_active = 1,
							effect_name = `teleporter_mvm_bot_persist`
						})
						SpawnEntityFromTable(`prop_dynamic`,
						{
							targetname = `tele_indicator2`
							origin = `2100 3510 131`
							model = `models/pickups/emitter.mdl`
							skin = 1
						})
						ClientPrint(null,3,`\x08FFFF00FF WARNING: Some robots will teleport in during the wave!`);
						"
			}
		
		DoneOutput
		{
			Target wave_start_relay
				action runscriptcode 
                param "
				delete ::altspawn
				"
		}
		
		WaveSpawn
		{
			Name	w8a1_tank1
			TotalCurrency	50
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			WaitBeforeStarting	15
			WaitBetweenSpawns	14
			Where	spawnbot_left
			FirstSpawnOutput                                                                                                                                                            
			{
				 Target boss_spawn_relay                                            
