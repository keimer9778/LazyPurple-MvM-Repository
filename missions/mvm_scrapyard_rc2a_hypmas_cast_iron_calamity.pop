		MinibossHeavyPT
		{
			OnSpawnOutput
			{
				Target PrototypeTarget
				Action SetParent
				Param "!activator"
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "PrototypeMegalaser"
				Action "$RotateTowards"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "PrototypeMegaLaserDamageDetector"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "PrototypeMegaLaserDamageDetector"
				Action "$RotateTowards"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "Glow"
				Action "Enable"
				Delay 0.1
			}
			OnParentKilledOutput
			{
				Target "PrototypeMegalaserAttack"
				Action "CancelPending"
			}

			info_target
			{
				"targetname" "PrototypeTarget"
				"origin" "0 0 0"
			}
			tf_glow
			{
				"targetname" "Glow"
				"target" "!parent"
				"GlowColor" "255 192 255 255"
				"startdisabled" "1"
			}

			logic_case
            {
                "targetname" "PrototypeWeaponChoiceCase"

                "OnCase01" "@p@PrototypeTarget,$GiveItem,PrototypeDefault1,0,-1"
                "OnCase02" "@p@PrototypeTarget,$GiveItem,PrototypeDefault2,0,-1"
            }

			logic_case
			{
				"targetname" "LaserShotgunSoundCase"

				"OnCase01" "LaserShotgunSound1,PlaySound,,0,-1"
				"OnCase01" "LaserShotgunSound1,StopSound,,1,-1"
				"OnCase02" "LaserShotgunSound2,PlaySound,,0,-1"
				"OnCase02" "LaserShotgunSound2,StopSound,,1,-1"
