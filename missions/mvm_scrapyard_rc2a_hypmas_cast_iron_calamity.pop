#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 1600
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"

	PrecacheModel "models/megalaser_beam_v2/megalaser_beam_v2.mdl"

	PrecacheModel "models/bots/boss_bot/combat_tank_mk2/mk2_combat_tank_chassis.mdl"
	PrecacheModel "models/bots/boss_bot/combat_tank_mk2/mk2_combat_tank_cannon.mdl"
	PrecacheModel "models/bots/boss_bot/combat_tank_mk2/mk2_rocket_pod.mdl"
	PrecacheModel "models/bots/boss_bot/combat_tank_mk2/mk2_rocket_dumbfire.mdl"
	PrecacheModel "models/bots/boss_bot/combat_tank_mk2/mk2_rocket_seeker.mdl"

	// Precached Sounds

	PrecacheSound "megalaser_fire.wav"
	PrecacheSound "voidlingshotgun1.mp3"
	PrecacheSound "voidlingshotgun2.mp3"
	PrecacheSound "voidlingshotgun3.mp3"
	PrecacheSound "voidlingshotgun4.mp3"
	PrecacheSound "voidlinglasercharge.mp3"
	PrecacheSound "voidlinglaserstart.mp3"
	PrecacheSound "voidlinglaserloop.mp3"
	PrecacheSound "voidlinglaserend.mp3"

	PrecacheSound "planned_obsolescence_death.mp3"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// PROTOTYPE MINIBOSS ////

		// Weapons
		"PrototypeDefault1"
		{
			OriginalItemName "The Righteous Bison"
			"dmg penalty vs players" 1.25
			"fire rate bonus" 0.1
			"faster reload rate" 0.001
			"projectile spread angle penalty" 3

			"particle color rgb" 16711680
			"custom item model" "models/empty.mdl"
			"custom weapon fire sound" "=75|weapons/bison_main_shot_02.wav"
			"projectile trail particle" "~drg_pomson_projectile"
		}
		"PrototypeDefault2"
		{
			OriginalItemName "The Righteous Bison"
			"dmg penalty vs players" 1.25
			"fire rate bonus" 1.25
			"faster reload rate" 0.001
			"mult projectile count" 20
			"projectile spread angle penalty" 5

			"particle color rgb" 16711680
			"custom item model" "models/empty.mdl"
			"fire input on attack" "LaserShotgunSoundCase^PickRandom"
			"projectile trail particle" "~drg_pomson_projectile"
		}

		"PrototypeBeamDetector"
		{
			OriginalItemName "The Righteous Bison"
			"damage bonus" "0"
			"penetrate teammates" "1"
			"projectile speed increased" "3"
            "noclip projectiles" 1
            "projectile lifetime" 4
		}

		// Cosmetics
		"PrototypeHelmet"
		{
            OriginalItemName "Corona Australis"

            "set item tint rgb" 16711680
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						Convars.SetValue(`tf_playergib`, 0)
						
						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
						IncludeScript(`tankextensions/combattank_weapons/cannon`)
					  "
			}
			point_populator_interface
			{
				"targetname" "pop_interface"
			}
			
			logic_auto
			{
				"targetname" "TankPathSetup"

				"OnMapSpawn" "tank_path_carrier_6,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"
				"OnMapSpawn" "tank_path_carrier_6,AddOutput,OnPass tf_gamerules:PlayVO:hl1/ambience/steamburst1.wav:0:-1,0,-1"
				"OnMapSpawn" "tank_path_carrier_6,AddOutput,OnPass tf_gamerules:PlayVO:doors/heavy_metal_stop1.wav:0:-1,0,-1"
			}

			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		CombatTankPT
		{
			NoFixUp 1

			logic_relay
			{
				"targetname" "TankMoveRelay"

				"OnTrigger" "tank_boss*,SetSpeed,25,0,-1"
				"OnTrigger" "tank_boss*,SetSpeed,50,1.5,-1"
				"OnTrigger" "tank_boss*,SetSpeed,75,3,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"
			}
		}

		MinibossHeavyIntroPT
		{
			OnSpawnOutput
			{
				Target HisFit
				Action TurnOff
			}

			logic_relay
			{
				"targetname" "EvilPortalActivationRelay"
				
				"OnTrigger" "EvilPortalParticle1,Start,,0,-1"
				"OnTrigger" "EvilPortalAmbient,PlaySound,,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`misc/halloween/spell_teleport.wav`);EmitSoundEx({sound_name=`misc/halloween/spell_teleport.wav`,channel = 6,pitch = 80,special_dsp = 25,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`misc/halloween/spell_teleport.wav`);EmitSoundEx({sound_name=`misc/halloween/spell_teleport.wav`,channel = 6,pitch = 80,special_dsp = 25,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/barret_arm_shot.wav`);EmitSoundEx({sound_name=`weapons/barret_arm_shot.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/barret_arm_shot.wav`);EmitSoundEx({sound_name=`weapons/barret_arm_shot.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})0-1"
				"OnTrigger" "EvilPortalParticle2,Start,,2,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/bumper_car_hit_ghost.wav`);EmitSoundEx({sound_name=`weapons/bumper_car_hit_ghost.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})2-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/bumper_car_hit_ghost.wav`);EmitSoundEx({sound_name=`weapons/bumper_car_hit_ghost.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})2-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/vaccinator_charge_tier_03.wav`);EmitSoundEx({sound_name=`weapons/vaccinator_charge_tier_03.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})2-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`weapons/vaccinator_charge_tier_03.wav`);EmitSoundEx({sound_name=`weapons/vaccinator_charge_tier_03.wav`,channel = 6,pitch = 50,special_dsp = 25,filter_type=5})2-1"
				"OnTrigger" "EvilPortalParticle3,Start,,4,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tele_activate.wav`);EmitSoundEx({sound_name=`mvm/mvm_tele_activate.wav`,channel = 6,pitch = 85,special_dsp = 25,filter_type=5})4-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tele_activate.wav`);EmitSoundEx({sound_name=`mvm/mvm_tele_activate.wav`,channel = 6,pitch = 85,special_dsp = 25,filter_type=5})4-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_revive.wav`);EmitSoundEx({sound_name=`mvm/mvm_revive.wav`,channel = 6,pitch = 75,special_dsp = 25,filter_type=5})4-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_revive.wav`);EmitSoundEx({sound_name=`mvm/mvm_revive.wav`,channel = 6,pitch = 75,special_dsp = 25,filter_type=5})4-1"
			}
			logic_relay
			{
				"targetname" "EvilPortalEnableRelay"

				"OnTrigger" "EvilPortalParticle1,Start,,0,-1"
				"OnTrigger" "EvilPortalAmbient,PlaySound,,0,-1"
				"OnTrigger" "EvilPortalParticle2,Start,,0,-1"
				"OnTrigger" "EvilPortalParticle3,Start,,0,-1"
			}

			logic_relay
			{
				"targetname" "EvilPortalSummonRelay"
				"OnTrigger" "EvilPortalLaser,Enable,,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`megalaser_fire.wav`);EmitSoundEx({sound_name=`megalaser_fire.wav`,channel = 6,pitch = 85,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tele_deliver.wav`);EmitSoundEx({sound_name=`mvm/mvm_tele_deliver.wav`,channel = 6,pitch = 100,filter_type=5})0-1"
				"OnTrigger" "EvilPortalLaserParticleTimer,Enable,,0,-1"
				"OnTrigger" "Him,Enable,,0,-1"
				"OnTrigger" "HisFit,TurnOn,,0,-1"
				"OnTrigger" "Him,SetAnimation,taunt_flag_heavy,0,-1"
				"OnTrigger" "Him,SetPlaybackRate,0.01,6,-1"

				"OnTrigger" "tf_gamerules,PlayVO,laser_related_attack.mp3,0,-1"
                "OnTrigger" "tf_gamerules,PlayVO,laser_related_attack.mp3,3.8,-1"
                "OnTrigger" "tf_gamerules,PlayVO,laser_related_attack.mp3,7.6,-1"

				"OnTrigger" "EvilPortalLaser*,AddOutput,renderfx 6,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/spell_spawn_boss_disappear.wav,10,-1"
				"OnTrigger" "EvilPortalParticle1,Stop,,10,-1"
				"OnTrigger" "EvilPortalParticle2,Stop,,10,-1"
				"OnTrigger" "EvilPortalParticle3,Stop,,10,-1"
				"OnTrigger" "EvilPortalParticle4,Stop,,10,-1"
				"OnTrigger" "EvilPortalParticle5,Stop,,10,-1"
				"OnTrigger" "EvilPortalLaserParticleTimer,Disable,,10,-1"
				"OnTrigger" "EvilPortalAmbient,StopSound,,10,-1"
				"OnTrigger" "tf_gamerules,$StopVO,laser_related_attack.mp3,10,-1"
				"OnTrigger" "tf_gamerules,$StopVO,laser_related_attack.mp3,10.1,-1"
				"OnTrigger" "tf_gamerules,$StopVO,laser_related_attack.mp3,10.2,-1"
				"OnTrigger" "EvilPortalLaser,Disable,,11,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_meleedare12.mp3,13,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_meleedare12.mp3,13,-1"

				"OnTrigger" "HisGlow,Enable,,15,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/vaccinator_charge_tier_04.wav,15,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_crits.wav,15,-1"
				"OnTrigger" "playerrunscriptcodeScreenFade(null, 255, 192, 255, 100, 0.7, 0.1, 1)15-1"

				"OnTrigger" "Him,Disable,,17,-1"
				"OnTrigger" "HisGlow,Disable,,17,-1"
				"OnTrigger" "HisFit,TurnOff,,17,-1"
			}

