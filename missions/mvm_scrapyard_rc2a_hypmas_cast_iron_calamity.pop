	// Wave 4 Notes
	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
					EntFire(`bombpath_clearall_relay`, `Trigger`, null, 6)
					EntFire(`bombpath_arrows_clear_relay`, `Trigger`, null, 6)
					EntFire(`bombpath_right_relay`, `Trigger`, null, 6.1)

					TankExt.SetValueOverrides({
						COMBATTANK_ROCKETPOD_ROCKET_DAMAGE = 135
						COMBATTANK_ROCKETPOD_FIRE_DELAY = 0.5
						COMBATTANK_ROCKETPOD_RELOAD_DELAY = 0.5
						COMBATTANK_ROCKETPOD_HOMING_SPEED_MULT = 1
						COMBATTANK_ROCKETPOD_HOMING_DURATION = 2
						COMBATTANK_ROCKETPOD_PARTICLE_TRAIL_HOMING = `scorchshot_trail_crit_blue`
					})
            	  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_classic_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 Homing Rocket Tank
		{
			Name "Wave4_Subwave1_HomingRocketTank"
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100

			FirstSpawnWarningSound "mvm/mvm_tank_start.wav"
			LastSpawnWarningSound "ambient/alarms/manhack_alert_pass1.wav"

			Tank
			{
				Name "combattank|rocketpod_homing|rocketpod_homing$pingsound|npc/combine_gunship/ping_search.wav"
				Template Tank_Combat_Rocket
				ClassIcon tank_combat_rocket_homing_dual_kai
				Health 60000
				StartingPathTrackNode "tank_path_carrier_1"

				SpawnTemplate "CombatTankPT"

				OnBombDroppedOutput
