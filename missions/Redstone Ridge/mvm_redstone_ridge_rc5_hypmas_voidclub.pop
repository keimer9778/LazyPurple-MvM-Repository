#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum_hyper.pop
#base robot_mentrillum.pop
#base robot_click.pop
#base robot_click_giant.pop

WaveSchedule
{
    StartingCurrency 1000
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds	500
	AddSentryBusterWhenKillCountExceeds	10
	PrecacheSound "08_Last_Legs.mp3" [$SIGSEGV]

	Mission
	{
		Objective	Sniper
		Where	spawnbot_top
		BeginAtWave	1
		RunForThisManyWaves	1
		InitialCooldown	30
		CooldownTime	45
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper
			MaxVisionRange 1500
			Classicon	sniper_headshot_crit_mission
			Attributes AlwaysCrit
			Name "Explosive pp Sniper" //haha!! - Mo
			ItemAttributes
			{
				Itemname "the sydney sleeper"
				"explosive sniper shot" 3
			}
			CharacterAttributes
			{
				"attach particle effect" 3083
			}
		}
	}

	Mission
	{
		Objective Spy
		InitialCooldown 30
		Where spawnbot_top
		BeginAtWave 2
		RunForThisManyWaves 4
		CooldownTime 40
		DesiredCount 3

		TFBot
		{
			Class Spy
			Skill Expert
			Attributes AlwaysCrit
		}
	}

	Mission
	{
		Objective	Sniper
		Where	spawnbot_top
		BeginAtWave	3
		RunForThisManyWaves	3
		InitialCooldown	30
		CooldownTime	45
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper
			MaxVisionRange 1500
			Classicon	sniper_headshot_crit_mission
			Attributes AlwaysCrit
			Name "Explosive pp Sniper" //haha!! - Mo
			ItemAttributes
			{
				Itemname "the sydney sleeper"
				"explosive sniper shot" 3
			}
			CharacterAttributes
			{
				"attach particle effect" 3083
			}
		}
	}

	Mission
	{
		Where spawnbot
		Objective DestroySentries
		CooldownTime 30

		TFBot
		{
			Template T_TFBot_SentryBuster
			WeaponRestrictions PrimaryOnly
			Attributes DisableDodge
			CharacterAttributes
			{
				"move speed bonus" 2
				"damage force reduction" 0.5
				"airblast vulnerability multiplier" 0.5
				"override footstep sound set" 7
				"cannot be backstabbed" 1
				"rage giving scale" 0
			}
		}
	}

	//==========================
	//			Wave 1
	//==========================
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_start_relay
			Action RunScriptCode
			Param "EntFire(`wave_finished_relay`, `Trigger`)
			Convars.SetValue(`tf_airblast_cray`, 1);"
		}
		InitWaveOutput
		{
			Target wave_start_relay
			Action RunScriptCode
			Param "local ent = Entities.FindByClassname(null, `tf_objective_resource`)
			if (ent)
			{
				NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `(Hyper Master) VOIDclub`)
			}
			Convars.SetValue(`tf_airblast_cray`, 0);

			PrecacheSound(`#Half-Life11.mp3`)

			if (!(`tankextensions_main` in getroottable()))
			{
				IncludeScript(`tankextensions_main`, getroottable())
			}

			if (!(`tankextensions/bannertank` in getroottable()))
			{
				IncludeScript(`tankextensions/bannertank`, getroottable())
			}

			if (!(`menttags` in getroottable()))
			{
				IncludeScript(`menttags`, getroottable())
			}

			EntFire(`bombpath_choose_relay`, `Kill`)
			EntFire(`bombpath_clearall_relay`, `Trigger`, null, 0.1)
			EntFire(`bombpath_holograms_clear_relay`, `Trigger`, null, 0.1)
			EntFire(`bombpath_4_relay`, `Trigger`, null, 0.5)

			TankExt.SetValueOverrides
			({
				BANNERTANK_RANGE_MULT = 2
			})"
		}

		Checkpoint Yes

		WaveSpawn
		{
			Name "01"
			Where spawnbot
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 0
			WaitBetweenSpawns 18
			TotalCurrency 300
			FirstSpawnWarningSound "misc\doomsday_lift_warning.wav"

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Scout_Hyper_Armored
					Name "Giga Armored Scout"
				}

				TFBot
				{
					Template T_TFBot_Giant_Medic_Regen
					Name "Giant Regen Medic"
				}

				TFBot
				{
					Template T_TFBot_Giant_Medic_Regen
					Name "Giant Regen Medic"
				}
			}
		}

		WaveSpawn
		{
			WaitForAllDead "01"
			WaitBeforeStarting 4
			FirstSpawnWarningSound "Half-Life11.mp3"
		}

		WaveSpawn
		{
			WaitForAllDead "01"
			WaitBeforeStarting 4
			FirstSpawnWarningSound "Half-Life11.mp3"
		}

		WaveSpawn
		{
			Name "02"
			WaitForAllDead "01"
			Where spawnbot
			TotalCount 6
			MaxActive 6
			SpawnCount 1
			WaitBeforeStarting 4
			WaitBetweenSpawns 20
			TotalCurrency 150

			TFBot
			{
				Template T_TFBot_Giant_Soldier_Volley
			}
		}

		WaveSpawn
		{
			Name "02"
			WaitForAllDead "01"
			Where spawnbot
			TotalCount 6
			MaxActive 6
			SpawnCount 1
			WaitBeforeStarting 6
			WaitBetweenSpawns 20
			TotalCurrency 150

			TFBot
			{
				Template T_TFBot_Giant_Pyro_DF_Spammer
			}
		}

		WaveSpawn
		{
			Name "02"
			WaitForAllDead "01"
			Where spawnbot
			TotalCount 1
			SpawnCount 1
			TotalCurrency 100
			WaitBeforeStarting 75

			Tank
			{
				Health 22000
				Speed 75
				Name "bannertank_conch_backup_buff_noselfeffect"
				StartingPathTrackNode "tank_path_right_to_center"
				ClassIcon tank_banner_trio

				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}

				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}

		WaveSpawn
		{
			Name "02"
			WaitForAllDead "01"
			Where spawnbot
			TotalCount 28
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 7
			WaitBetweenSpawns 1
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Scout_Cola_Primary_Markless
