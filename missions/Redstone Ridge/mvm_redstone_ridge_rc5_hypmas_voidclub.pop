					Template T_TFBot_Engineer_Shortcircuit
				}

				TFBot
				{
					Template T_TFBot_Medic_BigHeal
					Name "Big-Heal Medic"
				}
			}
		}

		WaveSpawn
		{
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 45
			WaitBetweenSpawns 28
			Support 1

			TFBot
			{
				Template T_TFBot_Giant_Soldier_RocketPush
			}
		}
	}

