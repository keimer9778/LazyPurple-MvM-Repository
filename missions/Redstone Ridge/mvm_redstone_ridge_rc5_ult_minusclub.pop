#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum_hyper.pop
#base robot_mentrillum.pop
#base robot_click.pop
#base robot_click_giant.pop

WaveSchedule
{
    StartingCurrency 400
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds	500
	AddSentryBusterWhenKillCountExceeds	10
	PrecacheSound "08_Last_Legs.mp3" [$SIGSEGV]
	PrecacheModel "models/mentrillum/bots/demo/bot_sentry_buster.mdl" [$SIGSEGV]

	Mission
	{
		Objective	Sniper
		Where	spawnbot_top
		BeginAtWave	1
		RunForThisManyWaves	1
		InitialCooldown	30
		CooldownTime	45
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper
			MaxVisionRange 1500
			Classicon	sniper_headshot_crit_mission
			Attributes AlwaysCrit
			Name "Explosive pp Sniper" //haha!! - Mo
			ItemAttributes
			{
				Itemname "the sydney sleeper"
				"explosive sniper shot" 3
			}
			CharacterAttributes
			{
				"attach particle effect" 3083
			}
		}
	}

	Mission
	{
		Objective Spy
		InitialCooldown 30
		Where spawnbot_top
		BeginAtWave 2
		RunForThisManyWaves 4
		CooldownTime 40
		DesiredCount 3

		TFBot
		{
			Template T_TFBot_Spy_Hyper
			ClassIcon spy
		}
	}

	Mission
	{
		Objective	Sniper
		Where	spawnbot_top
		BeginAtWave	3
		RunForThisManyWaves	3
		InitialCooldown	30
		CooldownTime	45
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper
			MaxVisionRange 1500
			Classicon	sniper_headshot_crit_mission
			Attributes AlwaysCrit
			Name "Explosive pp Sniper" //haha!! - Mo
			ItemAttributes
			{
				Itemname "the sydney sleeper"
				"explosive sniper shot" 3
			}
			CharacterAttributes
			{
				"attach particle effect" 3083
			}
		}
	}

