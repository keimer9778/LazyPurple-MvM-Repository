		//// ROBOT PTs ////

		RotatingHomewreckerPT
        {
			KeepAlive 1

			RemoveIfKilled "HomewreckerProjectile"

            OnSpawnOutput
            {
                Target "!activator"
                Action "AddOutput"
                Param "rendermode 10"
                Delay 0.01
            }
			OnParentKilledOutput
			{
				Target "HomewreckerRotator"
				Action Stop
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action RunScriptCode
				Param "ScreenShake(self.GetOrigin(), 10, 10, 2, 800, 0, true)"
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `misc/halloween/strongman_fast_impact_01.wav`, channel = 6, sound_level = 100, entity = self})"
			}
			OnParentKilledOutput
			{
				Target "HomewreckerAreaDamage"
				Action Enable
			}
			OnParentKilledOutput
			{
				Target "HomewreckerAreaDamage"
				Action Disable
				Delay 0.01
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action Kill
				Delay 3
			}

            prop_dynamic
            {
                "targetname" "HomewreckerProjectile"
                "parentname" "HomewreckerRotator"
				"origin" "-10 0 -50"
                "model" "models/weapons/c_models/c_sledgehammer/c_sledgehammer.mdl"
				"modelscale" "1.5"
            }
            func_rotating
            {
                "targetname" "HomewreckerRotator"
                "spawnflags" "73"
                "maxspeed" "500"
            }
			trigger_hurt
			{
				"targetname" "HomewreckerAreaDamage"
				"filtername" "filter_redteam_nouber"

				"mins" "-48 -48 -48"
				"maxs" "48 48 48"

				"damagetype" "128"
				"damage" "130"
				"$killicon" "homewrecker"

				"spawnflags" "1"
				"disableshadows" "1"
				"startdisabled" "1"
			}
        }

		CombatTankBossPart1PT
		{
			NoFixUp 1

			OnSpawnOutput
			{
				Target BigBadSetupRelay
				Action Trigger
			}

			logic_relay
			{
				"targetname" "BigBadSetupRelay"

				"OnTrigger" "tf_gamerules,PlayVO,music/mutuallyassureddestruction/abandoned_in_place.mp3,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,npc/strider/fire.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,0,-1"
				"OnTrigger" "CombatTankBossTeleportPT,ForceSpawnAtEntityOrigin,BenedictTank,0,-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1800})0-1"

				"OnTrigger" "BenedictTank,AddOutput,OnHealthBelow50Percent TheTankIsAggressive:Trigger::0:1,0,-1"
				"OnTrigger" "BenedictTank,AddOutput,OnHealthBelow10Percent MyPlanetNeedsMe:Trigger::0:1,0,-1"
			}
			logic_relay
			{
				"targetname" "MyPlanetNeedsMe"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave3_Subwave1_Repairmen,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave3_Subwave1_Repairmen,0,-1"
				"OnTrigger" "BenedictTank,CallScriptFunction,ToggleUber,0,-1"
				"OnTrigger" "BenedictTank,SetSpeed,0,0,-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROTATE_SPEED_DEFAULT = 0.4})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1})0-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/strider/striderx_pain2.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/strider/striderx_pain2.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/scanner/scanner_siren1.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/scanner/scanner_siren1.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/strider/charging.wav,3,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/strider/fire.wav,4.99,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,4.99,-1"
				"OnTrigger" "CombatTankBossTeleportPT,ForceSpawnAtEntityOrigin,BenedictTank,4.99,-1"
