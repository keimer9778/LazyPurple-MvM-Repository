	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Grandmaster) Mutually Assured Destruction`)

						PrecacheSound(`misc/halloween/strongman_fast_impact_01.wav`)
						PrecacheSound(`items/cart_explode_trigger.wav`)
						PrecacheSound(`misc/halloween/spell_teleport.wav`)
						PrecacheSound(`mvm/mvm_tank_deploy.wav`)

                        Convars.SetValue(`tf_playergib`, 0)

						EntFire(`saucer`, `Kill`)
						EntFire(`saucer_sound`, `Kill`)

						EntFire(`tf_gamerules`, `$StopVO`, `music/mutuallyassureddestruction/abandoned_in_place.mp3`)

						IncludeScript(`tank_repair`)
						IncludeScript(`tankhealthbars`)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/blimp`)
						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
						IncludeScript(`tankextensions/combattank_weapons/cannon`)
						IncludeScript(`tankextensions/painttank`)
						IncludeScript(`tankextensions/ubertank`)

						TankExt.NewTankType(`tankexplosion`,
						{
							function OnDeath()
							{
								local flDamage = 600
								local flRange  = 500

								local vecOrigin = self.GetOrigin()
								local vecCenter = self.GetCenter()

								DispatchParticleEffect(`explosionTrail_seeds_mvm`, vecOrigin, Vector(1))
								DispatchParticleEffect(`fluidSmokeExpl_ring_mvm`, vecOrigin, Vector(1))
								ScreenShake(vecOrigin, 25, 5, 5, 1000, SHAKE_START, false)

								local EntityArray = []
								foreach(sClassname in [`player`, `obj_sentrygun`, `obj_dispenser`, `obj_teleporter`])
									for(local hEnt; hEnt = FindByClassnameWithin(hEnt, sClassname, vecOrigin, flRange);)
										EntityArray.append(hEnt)

								foreach(hEnt in EntityArray)
									if(hEnt.IsAlive())
									{
										local vecEntCenter = hEnt.GetCenter()
										local Trace =
										{
											start = vecCenter
											end   = vecEntCenter
											mask  = MASK_SOLID_BRUSHONLY

											startsolid = false
											allsolid   = false
										}
										TraceLineEx(Trace)
										if(!(Trace.fraction < 1 || Trace.allsolid || Trace.startsolid))
										{
											if(hEnt.IsPlayer())
												ScreenFade(hEnt, 255, 255, 255, 255, 1, 0.1, FFADE_IN)

											hEnt.TakeDamageEx(First(), null, null, Vector(), Vector(), flDamage, DMG_BLAST)
										}
									}
							}
						})
					  "
			}

			point_populator_interface
			{
				"targetname" "pop_interface"
			}

