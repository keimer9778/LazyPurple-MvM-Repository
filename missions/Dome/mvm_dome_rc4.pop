WaveSchedule
{
	StartingCurrency 500
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom No

	Mission
	{
		Where spawnbot_left
		Objective DestroySentries
		InitialCooldown 60 
		CooldownTime 45
        TFBot
		{
			Template T_TFBot_SentryBuster
			Attributes DisableDodge
			CharacterAttributes
			{
                "no_attack" 1
				"voice pitch scale" 0
			}
		}
	}
