// Outlands Expert Consternation
//
// Starting Currency: 500
// Respawn Wave Time: 5
// Robots can not attack while in spawn room
//
// +----------+----------+----------+
// | Wave     | Currency | A+       |
// +----------+----------+----------+
// | Wave 1   | 850      | 950      |
// | Wave 2   | 850      | 950      |
// | Wave 3   | 850      | 950      |
// | Wave 4   | 850      | 950      |
// | Wave 5   | 1300     | 1400     |
// | Wave 6   | 850      | 950      |
// | Wave 7   | 1600     | 1600     |
// +----------+----------+----------+
// | Total    | 7650     | 8250     |
// +----------+----------+----------+
// 

WaveSchedule
{
	StartingCurrency 500
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no
	
	//////////====================================
	// Wave 1	[$850] [$950]
