					play_sound = `misc/null.wav`
					show_distance = false
					show_effect = false
					visibilityBitfield = 0
					})
				"
			}
		}
		WaveSpawn 
        {
            TotalCount 1
            SpawnCount 1
            WaitBeforeStarting 99999
            Support 1
            TFBot
            {
                ClassIcon timer_lite
            }
		}
		 WaveSpawn 
