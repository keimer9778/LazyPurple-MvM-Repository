#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot_randomguy.pop
#base robot_randomguy_robots_made_when_bored.pop

WaveSchedule
{
	StartingCurrency 800
	CanBotsAttackWhileInSpawnRoom No
	RespawnWaveTime 2
	Advanced 0
	AddSentryBusterWhenDamageDealtExceeds 3500
	AddSentryBusterWhenKillCountExceeds 25
	
	Mission	// Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_carrier_any
		CooldownTime 50

		TFBot
		{
			Template T_TFBot_SentryBuster
			Tag bot_sentrybuster
			Tag bot_giant
			Tag giant
		}
	}
	Mission //Sniper
	{
		Objective Sniper

		InitialCooldown 40
		Where spawnbot_carrier_altside
		BeginAtWave 6
		RunForThisManyWaves 1
		CooldownTime 60
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission //Spy
	{
		Objective Spy

		InitialCooldown 30
		Where spawnbot_carrier_altside
		BeginAtWave 6
		RunForThisManyWaves 1
		CooldownTime 45
		DesiredCount 2

		TFBot
		{
			Class Spy
			Skill Expert
			Name Spy
		}
	}
	
Templates
{
 T_TFBot_Para_Pyro
		{
			Class Pyro
			Name "Pyro"
			Skill Easy
			ClassIcon pyro_para
			WeaponRestrictions PrimaryOnly
			Item "the b.a.s.e. jumper"
			CharacterAttributes
			{
				"heal rate bonus" 5
			}
		}
Boss_1
		{
			Class Heavyweapons
			Name "Chief Slowdown Heavy"
			ClassIcon heavy_natascha_nys
			Item "Natascha"
			Item "Football Helmet"
			Skill Expert
			Health 40000
			WeaponRestrictions PrimaryOnly
			Attributes MiniBoss
			Attributes UseBossHealthBar
			ItemAttributes
			{
				ItemName "Natascha"
				"damage bonus"	1.3
				"damage penalty" 1
			}
			ItemAttributes
			{
				ItemName "Football Helmet"
				"set item tint RGB" 1315860
			}
			CharacterAttributes
			{
				"move speed bonus"	0.4
				"damage force reduction" 0.0
				"airblast vulnerability multiplier" 0.0
				"airblast vertical vulnerability multiplier" 0.0
				"rage giving scale"	0.25
				"override footstep sound set" 2
			}
		}
}
