#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 750
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 2500
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"

	// Precached Particles

	PrecacheParticle "spell_fireball_small_trail_red"

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Grandmaster) Ice-Pop Advent`)

                        Convars.SetValue(`tf_playergib`, 0)

						IncludeScript(`tankextensions_main`)

						EntFire(`routes`, `Kill`)
					  "
			}
		}

		MissionPT
		{
			logic_relay
			{
				"targetname" "bombpath_left_init_relay"

				"OnTrigger" "route2,Enable,,0,-1"
				"OnTrigger" "route2_holos,Enable,,0,-1"
				"OnTrigger" "route1,Disable,,0,-1"
			}
			logic_relay
			{
				"targetname" "bombpath_right_init_relay"

				"OnTrigger" "route1,Enable,,0,-1"
				"OnTrigger" "route1_holos,Enable,,0,-1"
				"OnTrigger" "route2,Disable,,0,-1"
			}
		}

		// ROBOT PTs //

		MagmaProjectilePT
		{
			KeepAlive 1

			RemoveIfKilled "MagmaFireTarget"

			OnParentKilledOutput
			{
				Target MagmaFirePT
				Action ForceSpawnAtEntityOrigin
				Param "MagmaFireTarget"
			}
			OnParentKilledOutput
			{
				Target MagmaFireTarget
				Action Kill
				Delay 0.1
			}

			info_target
			{
				"targetname" "MagmaFireTarget"
			}
		}
		MagmaFirePT
		{
			KeepAlive 1

			RemoveIfKilled "MagmaFireDamage"

			OnSpawnOutput
			{
				Target MagmaFireParticle
				Action Start
			}
			OnSpawnOutput
			{
				Target MagmaFireDamage
				Action Kill
				Delay 5
			}

			trigger_hurt
			{
				"targetname" "MagmaFireDamage"
				"filtername" "filter_redteam_nouber"
				"mins" "-60 -60 -60"
				"maxs" "60 60 60"
				"damage" "40"
				"damagetype" "8"
				"$killicon" "firedeath"
				"spawnflags" "64"

				"disablebonefollowers" "1"
				"disableshadows" "1"

				"OnHurtPlayer" "!activator,$IgnitePlayerDuration,5,0,-1"
			}
			info_particle_system
			{
				"targetname" "MagmaFireParticle"
				"effect_name" "lava_fireball_01"
				"start_active" "0"
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "MissionPT"

	//// ROBOT TEMPLATES ////

	Templates
	{
		T_TFBot_Giant_Pyro_Magma
		{
			Name "Giant Magma Blaster Pyro"
			Class Pyro
			ClassIcon pyro_magma_entropy_giant
			Skill Expert
			Health 3000
			Attributes MiniBoss
			WeaponRestrictions SecondaryOnly

			ShootTemplate
			{
				Name "MagmaProjectilePT"
				ItemName "TF_WEAPON_SHOTGUN_PYRO"
				AttachToProjectile 1
			}

			CharacterAttributes
            {
                "move speed penalty" 0.5
                "damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"override footstep sound set" 6
            }

			ItemAttributes
			{
				ItemName "TF_WEAPON_SHOTGUN_PYRO"

				"damage bonus" 10
				"add damage type" 2056
				"remove damage type" 64

				"fire rate penalty" 1.25
				"mod max primary clip override" -1

				"override projectile type" 2
				"blast radius decreased" 0.5
				"projectile speed decreased" 0.65
				"mult projectile scale" 2
				"penetrate teammates" 1

				"custom item model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
				"custom projectile model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"
				"projectile trail particle" "~spell_fireball_small_trail_red"
				"custom weapon fire sound" "MVM.GiantSoldierRocketShootCrit"
				"custom kill icon" "firedeath"
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		BeginAtWave 1
		RunForThisManyWaves 6
		InitialCooldown 25
		CooldownTime 25
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	Mission // Sniper (Wave 1)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 15
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}

	Mission // Spy (Wave 3)
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 5
		CooldownTime 35
		DesiredCount 3

		TFBot
		{
			Template T_TFBot_Spy
			Attributes AlwaysCrit
		}
	}

	Mission // Sniper (Wave 4)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 4
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper_Anti_Materiel
		}
	}

	Mission // Spy (Wave 5)
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 5
		RunForThisManyWaves 1
		InitialCooldown 5
		CooldownTime 25
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
			Attributes AlwaysCrit
		}
	}

	//// WAVES ////

	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_right_init_relay`, `Trigger`)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 GHomewrecker Pyro
		{
			Name "Wave1_Subwave1_GHomewrecker"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 60

			TFBot
			{
