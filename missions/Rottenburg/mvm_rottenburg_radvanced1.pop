					Attributes MiniBoss Tag bot_giant
					Attributes UseBossHealthBar
					ItemAttributes
					{
						ItemName "Fists of Steel"
						"fire rate bonus" 0.6
						"damage bonus" 10000000
						"dmg from melee increased" 1.5 /// 0.5x less damage from melee
					}
					CharacterAttributes
					{
