					Target tank_died_relay
					Action Trigger                         
				}

				OnBombDroppedOutput						// output sent when the Tank drops its bomb once it reaches the end of its path 
				{
					Target boss_deploy_relay
					Action Trigger                         
				}
			}
		}
	}
	
	//WAVE boss /////////////////////////////////////////////
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay_classic
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		
		WaveSpawn
		{
			Name stage1
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 10000
			RandomSpawn 1
			
			
				TFBot
				{
					Class Heavyweapons
					Skill Expert
					WeaponRestrictions MeleeOnly
					Name "Hyper Captain Punch"
					ClassIcon heavy_chief
					Health 100000
					Item "War Head"
