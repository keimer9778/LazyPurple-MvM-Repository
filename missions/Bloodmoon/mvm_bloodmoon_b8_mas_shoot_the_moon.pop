				"OnTrigger" "RocketAttack*,FireOnce,,1.95,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,2,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,2.05,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,2.1,-1"
