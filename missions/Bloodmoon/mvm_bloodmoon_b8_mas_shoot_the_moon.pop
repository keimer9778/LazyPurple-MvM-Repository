	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Master) Shoot the Moon`)

                        Convars.SetValue(`tf_playergib`, 0)

						PrecacheSound(`vo/soldier_sf12_zombie02.mp3`)
						PrecacheSound(`vo/soldier_sf12_zombie04.mp3`)
						PrecacheSound(`vo/mvm/mght/taunts/pyro_mvm_m_highfive_success02.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_paincrticialdeath03.mp3`)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)

						::DispatchParticleEffectOn <- function(hEntity, sName)
						{
							if(!sName) { hEntity.AcceptInput(`DispatchEffect`, `ParticleEffectStop`, null, null); return }
							local hParticle = Entities.CreateByClassname(`trigger_particle`)
							NetProps.SetPropBool(hParticle, `m_bForcePurgeFixedupStrings`, true)
							hParticle.KeyValueFromString(`particle_name`, sName)
							hParticle.KeyValueFromInt(`attachment_type`, 1)
							hParticle.KeyValueFromInt(`spawnflags`, 64)
							hParticle.DispatchSpawn()
							hParticle.AcceptInput(`StartTouch`, null, hEntity, hEntity)
							hParticle.Kill()
						}
					  "
			}

			logic_relay
			{
				"targetname" "FlagResetRelay"

				"OnTrigger" "item_teamflag*,ForceReset,,0,-1"
			}
		}

		FrankensteinSoldierPT
		{
			NoFixUp 1

			// Pickaxe Attack //
			OnSpawnOutput
			{
				Target "PickaxeAttackMain"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "PickaxeAttackMain"
				Action "$RotateTowards"
				Param "!activator"
				Delay 0.02
			}

			tf_point_weapon_mimic
			{
				"spawnflags" "1"
				"targetname" "PickaxeAttackMain"
				"$weaponname" "PickaxeAttack"
				"origin" "40 0 80"
				"angles" "-40 0 0"
				"$preventshootparent" "1"
				"teamnum" "3"
				"Crits" "false"
				"modelscale" "1"

				"$modules" "rotator"
				"$lookat" "aim"
				"$rotationspeedx" "300"
				"$rotationspeedy" "300"
				"$rotationlimitx" "180"
				"$rotationlimity" "180"
			}

			// Rocket Attack //
			OnSpawnOutput
			{
				Target "RocketAttackLeft"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "RocketAttackRight"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}

			logic_relay
			{
				"targetname" "RocketBarrageRelay"

				"OnTrigger" "RocketAttack*,FireOnce,,0,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.5,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.5,-1"
			}
			logic_relay
			{
				"targetname" "RocketBarrageRageRelay"

				"OnTrigger" "RocketAttack*,FireOnce,,0,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.25,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.5,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.75,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.25,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.5,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.75,-1"
			}

			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackLeft"
				"origin" "25 50 150"
				"angles" "315 0 0"

				"$weaponname" "RocketAttack"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}
			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackRight"
				"origin" "25 -50 150"
				"angles" "315 0 0"

				"$weaponname" "RocketAttack"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}
		}

		GraveButcherPT
		{
            OnSpawnOutput
            {
                Target "!activator"
                Action "AddOutput"
                Param "rendermode 10"
            }
			OnSpawnOutput
			{
				Target AxeProjectile
				Action RunScriptCode
				Param "
						DispatchParticleEffectOn(self, `burningplayer_blue`)
					  "
			}

            prop_dynamic
            {
                "targetname" "AxeProjectile"
                "parentname" "AxeRotator"
				"origin" "-10 0 -50"
                "model" "models/weapons/w_models/w_fireaxe.mdl"
				"modelscale" "1.5"
            }
            func_rotating
            {
                "targetname" "AxeRotator"
                "spawnflags" "73"
                "maxspeed" "500"
            }
		}

