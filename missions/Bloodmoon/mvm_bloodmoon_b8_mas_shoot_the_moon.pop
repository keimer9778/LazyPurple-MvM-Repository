				"OnTrigger" "RocketAttack*,FireOnce,,2.25,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,2.3,-1"
			}

			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackLeft"
				"origin" "25 50 150"
				"angles" "315 0 0"

				"$weaponname" "RocketRequiemAttack"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}
			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackRight"
