		{
			"engineer sentry build rate multiplier" 2.5
			"engineer teleporter build rate multiplier" 2.5
			"building cost reduction" 0.75
		}
	}

	ItemAttributes [$SIGSEGV]
	{
		ItemName "Crit-a-Cola"
		"effect bar recharge rate increased" 0.5
		"mod_mark_attacker_for_death" 0.0
		"minicrits become crits" 1
	}

	ItemAttributes [$SIGSEGV]
	{
		ItemName "The Ubersaw"
		"add uber charge on hit" 0.13
	}

	Wave
	{
		Explanation [$SIGSEGV]
		{
			Line "{FF0000}THE GATES HAVE OPENED ONCE AGAIN."
			Line "{FF0000}This wave is a 1 wave endurance, the wave bar shows you what will come up in future sub waves."
			Line "Some waves change the bomb path and will reset the bomb, otherwise backtracks it by a short distance."
			Line "Good luck to everyone who plays this..."
		}

		InitWaveOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "
			if (!(`mvm_underground_unending_bloodlust` in getroottable()))
			{
				IncludeScript(`mvm_underground_unending_bloodlust`)
			}
			UnendingBloodlust.StopWaveCycle = false

			if (!(`menttags` in getroottable()))
			{
				IncludeScript(`menttags`, getroottable())
			}

			local ent = null;
			while ((ent = Entities.FindByName(ent, `sentrynest_right3`)) != null)
			{
				ent.Kill();
			}

			while ((ent = Entities.FindByName(ent, `sentrynest_right4`)) != null)
			{
				ent.Kill();
			}

			local bomb = Entities.FindByName(null, `intel`)
			bomb.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)
			if (!(`SetParams` in bomb.GetScriptScope())) return
			bomb.GetScriptScope().SetParams(
				[`hoptime_min`, 999999],
				[`hoptime_max`, 999999],
				[`hoptimerdisplayclock`, false],
				[`hoprange`, 2500.0],
				[`hopheight`, 250.0],
				[`areaheightlimit`, 1400.0]
			)

			UnendingBloodlust.SetWaveBar(0);
			UnendingBloodlust.ChangeBombPath();

			EntFire(`CrusherPit1`, `Unlock`, ``, 0.0);
			EntFire(`CrusherPit1`, `Close`, ``, 0.1);
			EntFire(`CrusherPit2`, `Unlock`, ``, 0.0);
			EntFire(`CrusherPit2`, `Close`, ``, 0.1);
			EntFire(`PitDamage`, `Disable`);
			PrecacheSound(`#mentrillum/mvm/music/slave_knight_gael_phase_two.wav`);
			PrecacheSound(`#mentrillum/mvm/music/slave_knight_gael_phase_three.wav`);

			UnendingBloodlust.SetMissionName();

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/slave_knight_gael_phase_two.wav`
						entity = player
						filter_type = 4
						flags = 4
					})

					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/slave_knight_gael_phase_three.wav`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "EntFire(`wave_finished_relay`, `Trigger`)

			EntFire(`white`, `Fade`);
			EntFire(`tf_gamerules`, `PlayVO`, `ambient/halloween/thunder_06.wav`);
			EntFire(`tf_gamerules`, `PlayVO`, `ambient/halloween/thunder_06.wav`);
			EntFire(`correction`, `Disable`);
			EntFire(`wave9_props`, `Disable`);
			EntFire(`wave9_particles`, `Stop`);

			local ent = Entities.FindByClassname(null, `tf_objective_resource`)
			if (ent)
			{
				local sigmod = Convars.GetInt(`sig_etc_misc`) != null;
				if (sigmod == true)
				{
					ent.AcceptInput(`$SetClientProp$m_iszMvMPopfileName`, `GG!!!`, null, null);
				}
				else
				{
					NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `GG!!!`);
				}
			}

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/slave_knight_gael_phase_two.wav`
						entity = player
						filter_type = 4
						flags = 4
					})

					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/slave_knight_gael_phase_three.wav`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}
		WaitWhenDone 65
		Checkpoint Yes
		Sound	Announcer.MVM_Manned_Up

		WaveSpawn
		{
			Name "Temp"
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			StartWaveOutput
			{
				Target gamerules
				Action RunScriptCode
				Param "
				UnendingBloodlust.SetWaveBar(1)
				AlternateWaves.SetWaveCount(1, 5)"
			}
		}

		//==================
		//		Wave 1
		//==================
		WaveSpawn
		{
			Where spawnbot
			Name "01_Boss"
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
				{
					Template T_TFBot_Demoman_IronBomber_Boss
				}

				TFBot
				{
					Template T_TFBot_Giant_Medic_Kritzkrieg
					ExtAttr MedicLookAtThreats
				}
			}
		}

		WaveSpawn
		{
			Where spawnbot
			Name "01"
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 40
			WaitBetweenSpawns 35

			TFBot
			{
				Template T_TFBot_Giant_Scout_Bat
			}
		}

		WaveSpawn
		{
			Where spawnbot
			Where spawnbot_side
			Name "01"
			TotalCount 30
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 12
			WaitBetweenSpawns 7

			TFBot
			{
				Template T_TFBot_Scout_Bonk_Sandman
				CharacterAttributes
				{
					"damage force reduction" 0.35
					"airblast vulnerability multiplier" 0.35
