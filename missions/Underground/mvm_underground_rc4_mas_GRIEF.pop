					"airblast vulnerability multiplier" 0.35
				}
			}
		}

		WaveSpawn
		{
			WaitForAllDead "09_e"
			WaitBeforeStarting 0
			FirstSpawnOutput
			{
				Target gamerules
				Action RunScriptCode
				Param "EntFire(`pop_interface`, `$FinishWave`)
				local ent = Entities.FindByClassname(null, `tf_objective_resource`)
				if (ent)
				{
					local sigmod = Convars.GetInt(`sig_etc_misc`) != null;
					if (sigmod == true)
					{
						ent.AcceptInput(`$SetClientProp$m_iszMvMPopfileName`, `GG!!!`, null, null);
					}
					else
					{
						NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `GG!!!`);
					}
				}"
			}
		}
	}
}