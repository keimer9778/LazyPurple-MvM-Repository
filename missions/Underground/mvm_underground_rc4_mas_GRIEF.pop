			{
				ItemName "The Reserve Shooter"
				"faster reload rate" -0.8
				"fire rate bonus" 0.5
				"bullets per shot bonus" 2
				"damage penalty" 0.65
			}
			CharacterAttributes
			{
				"move speed bonus"	0.7
				"damage force reduction" 0.2
				"airblast vulnerability multiplier" 0.2
				"override footstep sound set" 3
				"attack projectiles" 1
			}
		}

		T_TFBot_Demoman_IronBomber_Boss
		{
			Class Demoman
			ClassIcon demo_clusterbomb_delay
			Name "Chief Minelayer Demoman"
			Health 15000
			Skill Expert
			Attributes MiniBoss
			Attributes HoldFireUntilFullReload
			Attributes UseBossHealthBar
			//UseMeleeThreatPrioritization 1
			Tag bot_giant
			Item "The Iron Bomber"
			Item "Steel Shako"
			ItemAttributes
			{
				ItemName "The Iron Bomber"
				"projectile spread angle penalty" 3.0
				"faster reload rate" 0.45
				"fire rate bonus" 0.1
				"clip size bonus" 1.5
				"fuse bonus" 2.2
				"Projectile speed increased"	1.15
			}
			CharacterAttributes
			{
				"airblast vulnerability multiplier" 0.2
				"override footstep sound set" 4.0
				"damage force reduction" 0.50
				"move speed bonus" 0.40
			}
		}

		T_TFBot_Heavy_Overclocked_Boss
		{
			Class Heavyweapons
			Name "Chief Overclocked Heavy"
			ClassIcon heavy_hyper
			Skill Expert
			Health 20000
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 1600
			Attributes MiniBoss
			Attributes UseBossHealthBar
			//UseMeleeThreatPrioritization 1
			Item "The Titanium Towel"
			Item "War Head"
			Tag bot_giant
			ItemAttributes
			{
				ItemName "TF_WEAPON_MINIGUN"
				"fire rate bonus" 0.8
				"damage penalty" 0.5
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.2
				"airblast vulnerability multiplier" 0.2
				"override footstep sound set" 2
			}
		}

		T_TFBot_Giant_Medic_Crossbow
		{
			Class Medic
			ClassIcon medic_crossbow_penetration
			Name "Giant Crossbow Medic"
			Health 4500
			Skill Expert
			Attributes MiniBoss
			Item "The Crusader's Crossbow"
			Item	"the crone's dome"
			Item	"the merc's muffler"
			AimAt Head  [$SIGSEGV]
			AimLeadProjectileSpeed 2400 [$SIGSEGV]
			Action FetchFlag [$SIGSEGV]
			WeaponRestrictions	PrimaryOnly
			Tag bot_giant
			Tag crit_fix
			ItemAttributes
			{
				ItemName "The Crusader's Crossbow"
				"faster reload rate" 0.65
				"projectile penetration" 1.0
				"override projectile type"	8
			}
			CharacterAttributes
			{
				"airblast vulnerability multiplier" 0.4
				"damage force reduction" 0.4
				"move speed bonus" 0.45
			}
		}
	}

