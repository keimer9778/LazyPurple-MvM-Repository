// THE GATES HAVE OPENED ONCE AGAIN -icedcave
// Created by Mentrillum

#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum.pop

WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no
	AddSentryBusterWhenKillCountExceeds	10
	AddSentryBusterWhenDamageDealtExceeds	1337
	Advanced 1
	WaveStartCountdown 3 [$SIGSEGV]
	//ForceRedMoney 1 [$SIGSEGV]
	RespecEnabled 0 [$SIGSEGV]

	PrecacheSound "mentrillum/mvm/music/slave_knight_gael_phase_two.wav" [$SIGSEGV]
	PrecacheSound "mentrillum/mvm/music/slave_knight_gael_phase_three.wav" [$SIGSEGV]
	PrecacheSound "mentrillum/mvm/sfx/laughtest.mp3" [$SIGSEGV]
	PrecacheGeneric "materials/colorcorrection/grief.raw" [$SIGSEGV]
	PrecacheGeneric "scripts/items/mvm_upgrades_grief_v6.txt" [$SIGSEGV]
	DisableSound "Announcer.MVM_Final_Wave_End" [$SIGSEGV]

	Mission
	{
		Where spawnbot
		Objective DestroySentries
		CooldownTime 30

		TFBot
		{
			Template T_TFBot_SentryBuster
			WeaponRestrictions PrimaryOnly
			Attributes DisableDodge
			CharacterAttributes
			{
				"move speed bonus" 2
				"damage force reduction" 0.5
				"airblast vulnerability multiplier" 0.5
				"override footstep sound set" 7
				"cannot be backstabbed" 1
				"rage giving scale" 0
			}
		}
	}

	Templates
	{
		T_TFBot_Demoman_Charged
		{
			Class Demoman
			Skill Normal
			Attributes AlwaysCrit
			Name "Charged Demoman"
			ClassIcon demo_charged
			ItemAttributes
			{
				ItemName "TF_WEAPON_GRENADELAUNCHER"
