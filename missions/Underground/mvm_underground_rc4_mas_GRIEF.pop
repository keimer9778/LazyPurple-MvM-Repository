			{
				Target wave_start_relay
				Action RunScriptCode
				Param "for (local i = 1; i <= MAX_CLIENTS; i++)
				{
					local otherPlayer = PlayerInstanceFromIndex(i);
					if (otherPlayer == null || otherPlayer.GetTeam() != 3 || !otherPlayer.IsAlive())
					{
						continue;
					}

					if (NetProps.GetPropString(otherPlayer, `m_szNetname`) == `obnoxious (3)` || NetProps.GetPropString(otherPlayer, `m_szNetname`) == `obnoxious (4)`)
					{
						otherPlayer.SetHealth(0);
						otherPlayer.TakeDamageCustom(otherPlayer, otherPlayer, null, Vector(0, 0, 0), otherPlayer.GetCenter(), otherPlayer.GetHealth().tofloat() + 9001.0, 0, 6);
					}
				}

				ClientPrint(null,3,`\x0899CCFFFFobnoxious (3)\x07fbeccb : \x07fbeccb damn :(`)
				ClientPrint(null,3,`\x0899CCFFFFobnoxious (4)\x07fbeccb : \x07fbeccb damn :(`)"
			}
		}

