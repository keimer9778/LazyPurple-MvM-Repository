			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 100
			TotalCurrency 0
			Support Limited
			
			FirstSpawnOutput
			{
				Target	bignet
				Action	RunScriptCode
				Param "
					/*
					for (local i = 1; i <= Constants.Server.MAX_PLAYERS; i++)
					{
						local player = PlayerInstanceFromIndex(i)
						
						if (player == null) continue
						if (player.IsFakeClient()) continue
						
						EmitSoundEx({ sound_name = `KingFirestorm_masterfinal.mp3`, filter_type = 4, entity = player, channel = 5, flags = 0})
					}
					*/

					SendGlobalGameEvent(`teamplay_broadcast_audio`, 
					{
						sound = `KingFirestorm_masterfinal.mp3`
						//additional_flags = 0x4 // SND_STOP
						team = 255
					})
				"
			}
		}
		
