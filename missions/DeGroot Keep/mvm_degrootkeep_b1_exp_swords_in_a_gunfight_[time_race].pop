		WaveSpawn
		{
			Name w7_r2_boss
			Where spawnbot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 12
			WaitForAllDead w7_r1
			TotalCurrency 100
			FirstSpawnWarningSound ambient/halloween/thunder_04.wav
			FirstSpawnOutput
			{
				Target bignet // gamerules or tf_gamerules, depending on the map
				Action RunScriptCode
				Param "

					::LocalSkybox <- {
					Cleanup = function() {
					SetSkyboxTexture(`sky_trainyard_01`)
					delete ::LocalSkybox
					}
					OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
					OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
					}
					__CollectGameEventCallbacks(LocalSkybox)
					
					SetSkyboxTexture(`sky_harvest_01`)

					// Fireballs

					local spawnfire = function(position) {
						SpawnEntityFromTable(`info_particle_system`,
						{
							targetname = `fire`
							origin = position,
							start_active = 1,
							effect_name = `lava_fireball_01`
						})
						SpawnEntityFromTable(`info_particle_system`,
						{
							targetname = `smoke`
							origin = position,
							start_active = 1,
							effect_name = `hightower_smoke`
						})
					}

					spawnfire(Vector(1179, 3915, 700))
					spawnfire(Vector(-1466, 4463, 50))
					spawnfire(Vector(-791, 3515, 463))

					SpawnEntityFromTable(`env_fade` , {
						targetname = `fire_flash`
						duration		=	2
						holdtime		=	`0.5`
						renderamt		=	255
						fogmaxdensity	=	1.2
						rendercolor		=	`250 187 70`
						spawnflags		=	1
					})

					EntFire(`fire_flash`,`fade`)
				"
			}
			TFBot
			{
				ClassIcon pyro_jug_axtinguisher_firering
				Name	"King Firestorm"
				Class	Pyro
				Skill	Expert
				Item "The Axtinguisher"
				Item "Prince Tavish's Crown"
				Item "The King of Scotland Cape"
				Item "TF_WEAPON_SPELLBOOK"
				Health 120000
				Attributes MiniBoss
				Attributes UseBossHealthBar
				Item "TF_WEAPON_SPELLBOOK"
				Tag bot_giant
				Tag prtl_front_main
				Tag THEBOSS
				RingofFire 10 [$SIGSEGV]
				AlwaysGlow 1 [$SIGSEGV]
				StripItemSlot 0 [$SIGSEGV]
				StripItemSlot 1 [$SIGSEGV]
				Action Mobber [$SIGSEGV]
				CharacterAttributes
				{
					"move speed bonus"	0.5
					"damage force reduction" 0.6
					"airblast vulnerability multiplier" 0.6
					"override footstep sound set" 6
					"attach particle effect" 3042
				}
				ItemAttributes
				{
					ItemName "The Axtinguisher"
					"fire rate penalty" 3
				}
				ItemAttributes               
				{
					ItemName "Prince Tavish's Crown"
					"attach particle effect" 209
				}
				Spell [$SIGSEGV]
				{
					Delay 20
					Cooldown 15
					IfSeeTarget 1
					Charges 1
					Type "Meteor Shower"
				}
			}
		}

