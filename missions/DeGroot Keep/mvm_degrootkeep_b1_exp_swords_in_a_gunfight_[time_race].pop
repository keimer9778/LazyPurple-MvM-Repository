	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 6	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////

	Mission
	{
		Where spawnbot
		Objective Sniper
		BeginAtWave 6
		RunForThisManyWaves 1
		InitialCooldown 0
		CooldownTime 5
		DesiredCount 2
		RandomChoice
		{
			TFBot
			{
				Template T_TFBot_Sniper_Sydney_Sleeper
				Tag prtl_front_main
			}
			TFBot
			{
				Template T_TFBot_Sniper_Sydney_Sleeper
				Tag prtl_front_flank
			}
			TFBot
			{
				Template T_TFBot_Sniper_Sydney_Sleeper
				Tag prtl_flank_right
			}
			TFBot
			{
				Template T_TFBot_Sniper_Sydney_Sleeper
				Tag prtl_top_left
			}
		}
	}

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`pseudo_medieval`)
				IncludeScript(`Degroot_Portals`)

				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/frontlinecart`, getroottable())
				TankExt.CreatePaths({
				ground_path = [
					Vector(368, 4816, -192)    // tank_path_1
					Vector(360, 4168, -152)    // tank_path_2
					Vector(216, 3968, -8)    // tank_path_3
					Vector(-136, 3680, 128)    // tank_path_4
					Vector(-144, 3368, 152)    // tank_path_5
					Vector(-104, 2912, -40)    // tank_path_6
					Vector(-64, 2376, -16)    // tank_path_7
					Vector(-64, 1328, 8)    // tank_path_8
				]
				})
			"
		}
		
		//////////////////////////
		//		 W6SETUP		//
		//////////////////////////
		// Bomb holder and timer
		WaveSpawn
		{
			Name w6_timer
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 1
			WaitBetweenSpawns 8
			TotalCurrency 0
			Support Limited
			FirstSpawnWarningSound	"misc/doomsday_lift_warning.wav"
			
			TFBot
			{
				Template T_TimerBot
				Health 320
				Tag "timerbot"
				Tag "dontdoublehp"
			}
		}
		// Dummy wavespawn
		WaveSpawn
		{
			Name w6_textTemplate
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 1
			WaitBetweenSpawns 8
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	wave6Text
				Action	ForceSpawn
			}
		}
		//Dummy wavespawn
		WaveSpawn
		{
			Name w6_fail
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	sixRoundsText
				Action	ForceSpawn
			}
		}
		
		// Fail condition
		WaveSpawn
		{
			Name w6_fail
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitForAllDead w6_timer
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	bignet
				Action	RunScriptCode
				Param "
					if (Entities.FindByName(null, `_portalsurvivalgameover`) == null) SpawnEntityFromTable(`game_round_win`, {targetname = `_portalsurvivalgameover`, TeamNum = 3, force_map_reset = 1})
					if (GetRoundState() == 4) EntFire(`_portalsurvivalgameover`, `RoundWin`)
				"
			}
		}

