	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 3	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`pseudo_medieval`)
				IncludeScript(`Degroot_Portals`)
			"
		}
		
		//////////////////////////
		//		 TUTORIAL		//
		//////////////////////////
		
		WaveSpawn
		{
			Name w3_tutorial
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	wave3Text
				Action	ForceSpawn
			}
		}		
		
		//////////////////////////
		//		 W3SETUP		//
		//////////////////////////
		// Bomb holder and timer
		WaveSpawn
		{
			Name w3_timer
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 12
			WaitBetweenSpawns 8
			TotalCurrency 0
			Support Limited
			FirstSpawnWarningSound	"misc/doomsday_lift_warning.wav"

			TFBot
			{
				Template T_TimerBot
				Health 180
				Tag "timerbot"
				Tag "dontdoublehp"
			}
		}
		WaveSpawn
		{
			Name w3_dummy
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 12
			WaitBetweenSpawns 8
			TotalCurrency 0
			Support Limited
			
			FirstSpawnOutput
			{
				Target fiveRoundsText
				Action ForceSpawn
			}
		}
		
		// Fail condition
		WaveSpawn
		{
			Name w3_fail
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitForAllDead w3_timer
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	bignet
				Action	RunScriptCode
				Param "
					if (Entities.FindByName(null, `_portalsurvivalgameover`) == null) SpawnEntityFromTable(`game_round_win`, {targetname = `_portalsurvivalgameover`, TeamNum = 3, force_map_reset = 1})
					if (GetRoundState() == 4) EntFire(`_portalsurvivalgameover`, `RoundWin`)
				"
			}
		}

