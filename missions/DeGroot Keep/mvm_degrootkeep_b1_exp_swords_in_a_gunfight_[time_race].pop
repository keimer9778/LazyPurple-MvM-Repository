	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 4	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////

	Mission
	{
		Objective Spy

		InitialCooldown 15
		Where spawnbot
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`pseudo_medieval`)
				IncludeScript(`Degroot_Portals`)

				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/frontlinecart`, getroottable())
				TankExt.CreatePaths({
				ground_path = [
					Vector(368, 4816, -192)    // tank_path_1
					Vector(360, 4168, -152)    // tank_path_2
					Vector(216, 3968, -8)    // tank_path_3
					Vector(-136, 3680, 128)    // tank_path_4
					Vector(-144, 3368, 152)    // tank_path_5
					Vector(-104, 2912, -40)    // tank_path_6
					Vector(-64, 2376, -16)    // tank_path_7
					Vector(-64, 1328, 8)    // tank_path_8
				]
				})
			"
		}
		
		//////////////////////////
		//		 W4SETUP		//
		//////////////////////////
		// Bomb holder and timer
		WaveSpawn
		{
			Name w4_timer
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 1
