	//////////////////////////////////////////
	//////////////////////////////////////////
	////			  WAVE 5	     	  ////
	//////////////////////////////////////////
	//////////////////////////////////////////

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				IncludeScript(`pseudo_medieval`)
				IncludeScript(`Degroot_Portals`)
			"
		}
		
		//////////////////////////
		//		 W5SETUP		//
		//////////////////////////
		// Bomb holder and timer
		WaveSpawn
		{
			Name w5_timer
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 1
			WaitBetweenSpawns 8
			TotalCurrency 0
			Support Limited
			FirstSpawnWarningSound	"misc/doomsday_lift_warning.wav"

			TFBot
			{
				Template T_TimerBot
				Health 200
				Tag "timerbot"
				Tag "dontdoublehp"
			}
		}
		// Dummy wavespawn for text
		WaveSpawn
		{
			Name w5_textTemplate
			Where timerBot										
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 1
			WaitBetweenSpawns 0
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	wave5Text
				Action ForceSpawn
			}
		}
		// Dummy wavespawn to spawn the PointTemplate to print 15 rounds
		WaveSpawn
		{
			Name w5_text
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	fifteenRoundsText
				Action	ForceSpawn
			}
		}
		
		// Fail condition
		WaveSpawn
		{
			Name w5_fail
			Where spawnbot								
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitForAllDead w5_timer
			TotalCurrency 0
			Support Limited
			FirstSpawnOutput
			{
				Target	bignet
				Action	RunScriptCode
				Param "
					if (Entities.FindByName(null, `_portalsurvivalgameover`) == null) SpawnEntityFromTable(`game_round_win`, {targetname = `_portalsurvivalgameover`, TeamNum = 3, force_map_reset = 1})
					if (GetRoundState() == 4) EntFire(`_portalsurvivalgameover`, `RoundWin`)
				"
			}
		}

