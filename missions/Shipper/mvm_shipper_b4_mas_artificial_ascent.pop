#base robot_giant.pop
#base robot_standard.pop
#base robot_mentrillum.pop

WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 12
	CanBotsAttackWhileInSpawnRoom No
	Advanced 1
	NoRomevisionCosmetics 1
	WaveStartCountdown 3

	DisallowUpgrade "generate rage on heal"
	DisallowUpgrade "explode_on_ignite"

	Templates
	{
		T_TFBot_Soldier_Stunner
		{
			Class Soldier
			ClassIcon	vex_soldier_stunburst
			Attributes HoldFireUntilFullReload
			Skill	Expert
			Item	"ghastly gibus"
			Item	"rocket jumper"
			ItemAttributes
			{
				ItemName	"rocket jumper"
				"fire rate bonus"	-1
				"faster reload rate" 0.75
				"rocket specialist"	4
			}
		}

		T_TFBot_Heavy_Mitten_Armored
		{
			Template	T_TFBot_Heavyweapons_Gnome
			Health	600
			ClassIcon	heavy_mittens
			Scale	1.5
			Name	"Big Mitten Heavy"
			Skill	Normal
			Item	"point and shoot"
			Item	"the all-father"
			CharacterAttributes
			{
				"damage force reduction"	0.5
			}
		}

		T_TFBot_Sniper_Bushwacka_Armored
		{
			Template T_TFBot_Sniper_Bushwacka
			Scale 1.5
			Health 600
			Name "Big Bushwacka Sniper"
			Action Mobber
			CharacterAttributes
			{
				"damage force reduction"	0.5
			}
		}

		T_TFBot_Giant_Soldier_Blackbox_Almost
		{
			Class Soldier
			ClassIcon soldier_blackbox_giant
			Name "Giant Almost Black Box Soldier"
			Health 4200
			Item "The Black Box"
			Skill Expert
			Attributes MiniBoss
			WeaponRestrictions PrimaryOnly
			//Attributes HoldFireUntilFullReload
			ItemAttributes
			{
				ItemName "The Black Box"
				"fire rate bonus" 0.001
				"clip size upgrade atomic" 0
				"faster reload rate" 1.7
				//"blast radius increased" 1.25
				//"Projectile speed increased" 0.4
				"projectile spread angle penalty" 4
				"heal on hit for rapidfire" 1000
			}
			CharacterAttributes
			{
				"move speed bonus"    0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
				"Projectile speed increased" 0.9
			}
		}
	}

	Mission
	{
		Objective	Sniper
		Where	spawnbot_mission_sniper
		BeginAtWave	1
		RunForThisManyWaves	1
		InitialCooldown	40
		CooldownTime	40
		DesiredCount	2
		TFBot
		{
			Template	T_TFBot_Sniper
			ClassIcon sniper_giant
		}
	}

	Wave
	{
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
			if (!(`tankextensions_main` in getroottable()))
			{
				IncludeScript(`tankextensions_main`, getroottable())
			}

			if (!(`tankextensions/tankdozer` in getroottable()))
			{
				IncludeScript(`tankextensions/tankdozer`, getroottable())
			}

			if (!(`tankextensions/bannertank` in getroottable()))
			{
				IncludeScript(`tankextensions/bannertank`, getroottable())
			}

			if (!(`tankextensions/ubertank` in getroottable()))
			{
				IncludeScript(`tankextensions/ubertank`, getroottable())
			}

			if (!(`tankextensions/combattank` in getroottable()))
			{
				IncludeScript(`tankextensions/combattank`, getroottable())
			}

			if (!(`tankextensions/combattank_weapons/fireball` in getroottable()))
			{
				IncludeScript(`tankextensions/combattank_weapons/fireball`, getroottable())
			}

			if (!(`tankextensions/combattank_weapons/rocketpod` in getroottable()))
			{
				IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())
			}

			if (!(`tankextensions/combattank_weapons/minigun` in getroottable()))
			{
				IncludeScript(`tankextensions/combattank_weapons/minigun`, getroottable())
			}

			PrecacheSound(`#ui/gamestartup15.mp3`)
			PrecacheSound(`#ui/gamestartup16.mp3`)
			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
				{
					EmitSoundEx({
						sound_name = `#ui/gamestartup15.mp3`
						entity = player
						filter_type = 4
						flags = 4
					})

					EmitSoundEx({
						sound_name = `#ui/gamestartup16.mp3`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}
			"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}

		RedTeamWipeCausesWaveLoss 1
		Explanation
		{
			Line "{FF0000}You have 25 minutes to beat this mission. If everyone dies, it's game over."
			Line "{FF0000}There will be no bomb except for tanks, so give it your all to kill all robots as fast as you can."
			Line "{FF0000}Heavy's miniguns and Engineer's sentry guns have a -25% damage penalty against everything."
			Line "{FF0000}Both the medic shield and explode on ignite are banned."
		}

		ItemAttributes
		{
			ClassName "tf_weapon_wrench"
			"engy sentry damage bonus" 0.75
		}

		ItemAttributes
		{
			ClassName "saxxy"
			"engy sentry damage bonus" 0.75
		}

		ItemAttributes
		{
			ClassName "tf_weapon_robot_arm"
			"engy sentry damage bonus" 0.75
		}

		ItemAttributes
		{
			ClassName "tf_weapon_minigun"
			"damage penalty" 0.75
		}

		Checkpoint Yes

		WaveSpawn
		{
			Where spawnbot_left
			Where spawnbot_right
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBetweenSpawns 35
			WaitBeforeStarting 35
			TotalCurrency 0
			Support 1

			TFBot
			{
				Template T_TFBot_Engineer_Sentry_Battle
			}
		}

		WaveSpawn
		{
			Where spawnbot_left
			Name "01"
			TotalCount 4
			MaxActive 2
			SpawnCount 2
			WaitBetweenSpawns 0
			WaitBeforeStarting 0
			TotalCurrency 50

			FirstSpawnOutput
			{
				Target wave_start_relay
				Action RunScriptCode
				Param "
					if (!(`textualtimer_v3` in getroottable()))
					{
						IncludeScript(`textualtimer_v3`, getroottable())
					}
					TextualTimer.SetParams({
						minutes = 25,
						seconds = 0,
						x = -1,
						y = 0.2,
						color = `255 0 0`,
						relayname = `boss_deploy_relay`
					})
					TextualTimer.AddCallbacks({
						`300` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `vo/announcer_ends_5min.mp3`)
						}
						`120` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `vo/announcer_ends_2min.mp3`)
						}
						`60` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds60seconds`)
						}
						`30` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds30seconds`)
						}
						`20` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds20seconds`);
						}
						`10` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds10seconds`)
						}
						`5` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds5seconds`)
						}
						`4` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds4seconds`)
						}
						`3` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds3seconds`)
						}
						`2` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds2seconds`)
						}
						`1` : function()
						{
							EntFire(`tf_gamerules`, `PlayVO`, `Announcer.RoundEnds1seconds`)
						}
					})
					TextualTimer.Start()
				"
			}

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavyweapons_CritOnKill
					Action Mobber
					ClassIcon heavy_giant
				}

				TFBot
				{
					Template T_TFBot_Giant_Soldier_Extended_Concheror
					Action Mobber
					ClassIcon soldier_giant
				}
			}
		}

