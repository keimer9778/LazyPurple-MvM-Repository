#base robot_standard.pop
#base robot_giant.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_hole.pop
#base robot_lazypurple.pop

WaveSchedule
{
    StartingCurrency 1000
    RespawnWaveTime 3
    CanBotsAttackWhileInSpawnRoom No

    Mission
    {
        Where spawnbot
        Objective DestroySentries // Engineer,Sniper,Spy,DestroySentries
        BeginAtWave 1
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 20
        CooldownTime 30
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Name "Titanium Buster"
            Health	10000
        }
    }
    Mission
    {
        Where spawnbot
        Objective DestroySentries // Engineer,Sniper,Spy,DestroySentries
        BeginAtWave 4
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 10
        CooldownTime 20
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Name "Sturdy Titanium Buster"
            Health	10000
            CharacterAttributes
            {
                "airblast vertical vulnerability multiplier" 0
                "airblast vulnerability multiplier" 0
                "damage force reduction" 0
            }
        }
    }

    Templates
    {
        T_TFBot_Giant_Soldier_Spreader
		{
			ClassIcon soldier_rocketrain_giant
			Class Soldier
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Name "Giant Spreader Soldier"
			Health 4000
			Item "Worms Gear"
			Attributes MiniBoss
			Attributes HoldFireUntilFullReload
			
			ItemAttributes
			{
				ItemName	tf_weapon_rocketlauncher
				"faster reload rate"	0.2
				"fire rate bonus"	0.001
				"clip size upgrade atomic"	48.0
				"projectile spread angle penalty"	10
				"Projectile speed increased"	0.4
				"damage bonus" 2.0
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
			}
		}
    }

    Wave
    {
        Initwaveoutput
        {
            Target bignet
            Action RunScriptCode
            Param "
                EntFire(`wave_init_relay`, `Trigger`)
                IncludeScript(`popextensions_main`, getroottable())
                MissionAttrs({
                NoCrumpkins = 1
                BotHeadshots = 1
                })
                Info(`Welcome to hell! Quite literally.|PAUSE 1|This mission is going to be HARD.|PAUSE 1|Intended players = 20|PAUSE 1|If you make it out alive, you will have joined a small group of the brave few.|PAUSE 1|Good luck LazyPurple. You're gonna need it.|PAUSE 10|P.S. Don't complain about the difficulty. I won't listen lmao`, `00FFFF`, `Waffle`, true)
                "
        }
        StartWaveOutput
        {
	        Target wave_start_relay_boss
	        Action Trigger
        }
        DoneOutput					
        {
	        Target wave_finished_relay
	        Action trigger
        }
        Wavespawn
        {
            Name "Wave1_a1"
            Where Spawnbot
            TotalCount 60
            SpawnCount 2
            MaxActive 6
            Waitbetweenspawns 5
            WaitBeforeStarting 5
            TotalCurrency 75
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                Skill Expert
            }
        }
        Wavespawn
        {
            Support 1
            Name "Wave1_a1_support"
            Where Spawnbot_invasion
            TotalCount 60
            SpawnCount 2
            MaxActive 4
            Waitbetweenspawns 8
            WaitBeforeStarting 0
            Waitforalldead "Wave1_a1"
            TotalCurrency 25
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                Skill Expert
                Attributes AlwaysCrit
                Name "Tough Concheror Soldier"
                Health 500
                BehaviorModifiers Push
            }
        }
        Wavespawn
        {
            Name "Wave1_a2"
            Where Spawnbot_Giant
            TotalCount 4
            SpawnCount 2
            MaxActive 2
            Waitbetweenspawns 40
            WaitBeforeStarting 0
            TotalCurrency 125
            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Heavy_Deflector_Brassbeast
                }
                TFBot
                {
                    Template T_TFBot_Giant_Medic_Shield_Kritzkrieg_Extended
                    Name "Tough Giant Kritz Shield"
                    Health 6750
                }
            }
        }
        Wavespawn
        {
            Name "Wave1_a3" 
            Where Spawnbot_Giant_Side
            TotalCount 10
            SpawnCount 1
            MaxActive 3
            Waitbetweenspawns 18
            WaitBeforeStarting 3
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Giant_Demo_Spammer
                Name "Tough Giant Spammer Demo"
                Health 5700
                Tag nav_prefer_flank_front
                Tag nav_prefer_flank_back
                Skill Expert
            }
        }
        Wavespawn
        {
            Name "Wave1_a4"
            Where Spawnbot
            TotalCount 1
            SpawnCount 1
            MaxActive 1
            Waitbetweenspawns 0 
            WaitBeforeStarting 20
            TotalCurrency 350
            FirstSpawnOutput 			
            {
	            Target boss_spawn_relay                       
	            Action Trigger                         
            }
            Tank
            {
                Health 60000
                Name "tankboss_1"
                Speed 40
                StartingPathTrackNode boss_path_1
                OnKilledOutput
                {
                    Target	boss_dead_relay
                    Action	Trigger
                }
                OnBombDroppedOutput
                {
                    Target	boss_deploy_relay
                    Action	Trigger
                }
            }
        }
        Wavespawn
        {
            Name "Wave1_b2"
            Where Spawnbot_Invasion
            TotalCount 35
            SpawnCount 1
            MaxActive 6
            Waitbetweenspawns 6
            WaitBeforeStarting 30
            Waitforallspawned "Wave1_a2"
            TotalCurrency 50
            RandomChoice
            {
                TFBot
                {
                    Template T_TFBot_Heavy_IronFist_Airblast
