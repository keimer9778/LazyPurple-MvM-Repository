			{
				ItemName	"Natascha"
				"damage penalty" 0.5
				"fire rate bonus" 0.15
				"apply z velocity on damage"	-1150
				"apply look velocity on damage"	-1150
				"slow enemy on hit major" 3
				"projectile penetration" 5
				"attack projectiles" 3
			}
			CharacterAttributes
			{
				"health regen" 200
				"move speed bonus"	0.32
				"damage force reduction" 0.0
				"airblast vulnerability multiplier"	0.1
				"airblast vulnerability multiplier" 0.1
				"override footstep sound set" 2
			}
		}
    }

    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                EntFire(`wave_init_relay`, `Trigger`)
                EntFire(`introText`, `ForceSpawn`)
            "
        }
        StartWaveOutput
        {
	        Target wave_start_relay_boss
	        Action Trigger
        }
        DoneOutput					
        {
	        Target wave_finished_relay
	        Action trigger
        }
        WaveSpawn
        {
            Name "Wave1_a1"
            Where Spawnbot
            TotalCount 60
            SpawnCount 2
            MaxActive 6
            WaitBetweenSpawns 5
            WaitBeforeStarting 5
            TotalCurrency 75
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                Skill Expert
            }
        }
        WaveSpawn
        {
            Support 1
            Name "Wave1_a1_support"
            Where Spawnbot_invasion
            TotalCount 60
            SpawnCount 2
            MaxActive 4
            WaitBetweenSpawns 8
            WaitBeforeStarting 0
            WaitForAllDead "Wave1_a1"
            TotalCurrency 25
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                ClassIcon   soldier_conch_armored
                Skill Expert
                Attributes AlwaysCrit
                Name "Tough Concheror Soldier"
                Health 500
                BehaviorModifiers Push
            }
        }
        WaveSpawn
        {
            Name "Wave1_a2"
            Where Spawnbot_Giant
            TotalCount 4
            SpawnCount 2
            MaxActive 2
            WaitBetweenSpawns 40
            WaitBeforeStarting 0
            TotalCurrency 125
            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Heavy_Deflector_Brassbeast
                }
                TFBot
                {
                    Template T_TFBot_Giant_Medic_Shield_Kritzkrieg_Extended
                    ClassIcon   medic_kritzkrieg_armored_lite_shield_ala
                    Name    "Tough Giant Kritz Shield Medic"
                    Health 6750
                }
            }
        }
        WaveSpawn
        {
            Name "Wave1_a3" 
            Where Spawnbot_Giant_Side
            TotalCount 10
            SpawnCount 1
            MaxActive 3
            WaitBetweenSpawns 18
            WaitBeforeStarting 3
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Giant_Demo_Spammer
                ClassIcon   demo_spammer_armored
                Name "Tough Giant Spammer Demo"
                Health 5700
                Tag nav_prefer_flank_front
                Tag nav_prefer_flank_back
                Skill Expert
            }
        }
        WaveSpawn
        {
            Name "Wave1_a4"
            Where Spawnbot
            TotalCount 1
            SpawnCount 1
            MaxActive 1
            WaitBetweenSpawns 0 
            WaitBeforeStarting 20
            TotalCurrency 350
            FirstSpawnOutput 			
            {
	            Target boss_spawn_relay                       
	            Action Trigger                         
            }
            Tank
            {
                Health 60000
                Name "tankboss_1"
                Speed 40
                StartingPathTrackNode boss_path_1
                OnKilledOutput
                {
                    Target	boss_dead_relay
                    Action	Trigger
                }
                OnBombDroppedOutput
                {
                    Target	boss_deploy_relay
                    Action	Trigger
                }
            }
        }
        WaveSpawn
        {
            Name "Wave1_b2"
            Where Spawnbot_Invasion
            TotalCount 35
            SpawnCount 1
            MaxActive 6
            WaitBetweenSpawns 6
            WaitBeforeStarting 30
            WaitForAllSpawned "Wave1_a2"
            TotalCurrency 50
            RandomChoice
            {
                TFBot
                {
                    Template T_TFBot_Heavy_IronFist_Airblast
                    ClassIcon heavy_steelfist_armored
                    Tag nav_prefer_flank_front
                    Tag nav_prefer_back_main
                    Name "Tough Guantlet Pusher"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Heavy_IronFist_Airblast
                    ClassIcon heavy_steelfist_armored
                    Tag nav_prefer_flank_front
                    Tag nav_prefer_flank_back
                    Name "Tough Gauntlet Pusher"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Heavy_IronFist_Airblast
                    ClassIcon heavy_steelfist_armored
                    Tag nav_prefer_front_main
                    Tag nav_prefer_flank_back
                    Name "Tough Gauntlet Pusher"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Heavy_IronFist_Airblast
                    ClassIcon heavy_steelfist_armored
                    Name "Tough Gauntlet Pusher"
                    Health 1800
                }
            }
        }
        WaveSpawn
        {
            Name "Wave1_b3"
            Where Spawnbot_Giant
            TotalCount 4
            SpawnCount 1
            MaxActive 2
            WaitBetweenSpawns 15
            WaitBeforeStarting 0
            WaitForAllDead "Wave1_a2" 
            TotalCurrency 125
            TFBot
            {
                Template T_TFBot_Giant_Soldier_Spreader
            }
        }
        WaveSpawn
        {
            Support 1
            Name "Wave1_b4"
            Where Spawnbot_Side
            TotalCount 69
            SpawnCount 2
            MaxActive 6
            WaitBetweenSpawns 4
            WaitBeforeStarting 0
            WaitForAllDead "Wave1_a4"
            TotalCurrency 50
            TFBot
            {
                Template T_TFBot_Heavy_Flame
                ClassIcon   heavy_heater_armored
                Health 750
                Name "Tough Flame Heavy"
                Tag nav_prefer_flank_front
                Tag nav_prefer_back_main
                BehaviorModifiers Push
            }
        }
        WaveSpawn
        {
            Name "Wave1_c1"
            Where Spawnbot_Giant
            TotalCount 4
            SpawnCount 2
            MaxActive 2
            WaitBetweenSpawns 30
            WaitBeforeStarting 0
            WaitForAllDead "Wave1_b3"
            TotalCurrency 100
            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Heavy_Deflector_Brassbeast

                }
                TFBot
                {
                    Template T_TFBot_Giant_Medic_Shield_Kritzkrieg_Extended
                    ClassIcon   medic_kritzkrieg_armored_lite_shield_ala
                    Name "Tough Giant Kritz Shield"
                    Health 6750
                }
            }
        }
    }
    Mission
    {
        Where spawnbot
        Objective Engineer 
        BeginAtWave 2
        RunForThisManyWaves 1
        DesiredCount 3
        InitialCooldown 45
        CooldownTime 30
        TFBot
        {
            Template T_TFBot_Engineer_Sentry_Teleporter_Armored
            Attributes TeleportToHint
            TeleportWhere spawnbot
            TeleportWhere spawnbot_giant
            TeleportWhere Spawnbot_Side
            TeleportWhere spawnbot_giant_side
            TeleportWhere spawnbot_invasion
        }
    }
    Mission
    {
        Where spawnbot_mission_sniper
        Objective Sniper 
        BeginAtWave 2
        RunForThisManyWaves 1
        DesiredCount 2
        InitialCooldown 30
        CooldownTime 20
        TFBot
        {
            Template T_TFBot_Sniper_Magnetic_Hyper
            Skill Expert
        }
    }
    Wave
    {
        StartWaveOutput
        {
	        Target wave_start_relay_ironman
	        Action Trigger
        }
        DoneOutput					
        {
	        Target wave_finished_relay
	        Action trigger
        }
        WaveSpawn
        {
            Name "Wave2_a_rush"
            Where Spawnbot_Invasion
            TotalCount 22
            SpawnCount 1
            MaxActive 22
            WaitBetweenSpawns 2
            WaitBeforeStarting 0
            TotalCurrency 150
            RandomChoice
            {
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Tag nav_prefer_back_main
                    Tag nav_prefer_flank_front
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Tag nav_prefer_flank_front
                    Tag nav_prefer_flank_back
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Tag nav_prefer_front_main
                    Tag nav_prefer_flank_back
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Name "Tough Giant Hyper Scout"
                    Health 1800
                }
            }
        }
        WaveSpawn
        {
            Support 1
            Name "Wave2_a_support"
            Where Spawnbot_Invasion
            TotalCount 69
            SpawnCount 1
            MaxActive 2
            WaitBetweenSpawns 12
            WaitBeforeStarting 0
            WaitForAllDead "Wave2_a_rush"
            TotalCurrency 75
            RandomChoice
            {
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    ClassIcon scout_fast_hyper
                    Tag nav_prefer_back_main
                    Tag nav_prefer_flank_front
                    Name "Tough Giant Hyper Scout"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Tag nav_prefer_flank_front
                    Tag nav_prefer_flank_back
                    ClassIcon scout_fast_hyper
                    Name "Tough Giant Hyper Scout"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    Tag nav_prefer_front_main
                    Tag nav_prefer_flank_back
                    ClassIcon scout_fast_hyper
                    Name "Tough Giant Hyper Scout"
                    Health 1800
                }
                TFBot
                {
                    Template T_TFBot_Giant_Scout_Hyper
                    ClassIcon scout_fast_hyper
                    Name "Tough Giant Hyper Scout"
                    Health 1800
                }
            }
        }
        WaveSpawn
        {
            Name "Wave2_b1"
