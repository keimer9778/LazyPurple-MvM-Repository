#base robot_standard.pop
#base robot_giant.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_hole.pop
#base robot_lazypurple.pop

WaveSchedule
{
    StartingCurrency 1000
    RespawnWaveTime 3
    CanBotsAttackWhileInSpawnRoom No
    
    PointTemplates [$SIGSEGV]
	{
		MissionNamePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Ultimate) Hellspawn Holdout`)
					  "
			}
		}

        introText
		{
			OnSpawnOutput
			{
				Target TextDisplay
				Action Trigger
				Delay 0.1
			}
            logic_relay
            {
                "targetname" TextDisplay
                "OnTrigger"  "upper_text1,Display,,1,1"
                "OnTrigger"  "lower_text1,Display,,3,1"

                "OnTrigger"  "upper_text2,Display,,8,1"

                "OnTrigger"  "upper_text3,Display,,13,1"
                "OnTrigger"  "lower_text3,Display,,13,1"

                "OnTrigger"  "upper_text4,Display,,18,1"
                "OnTrigger"  "lower_text4,Display,,18,1"

                "OnTrigger"  "upper_text5,Display,,25,1"
                "OnTrigger"  "lower_text5,Display,,27,1"

                "OnTrigger"  "top_text6,Display,,32,1"
                "OnTrigger"  "upper_text6,Display,,32,1"
                "OnTrigger"  "lower_text6,Display,,34,1"
            }
			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text1"
				"message" "Welcome to hell!"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
				"channel" "1"
			}
			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "lower_text1"
				"message" "Quite literally."
				"x" "-1"
				"y" "0.35"
				"spawnflags" "1"
				"color" "255 140 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
				"channel" "0"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text2"
				"message" "This mission is going to be HARD."
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
                "channel" "1"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text3"
				"message" "I do not doubt some of you"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
                "channel" "1"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "lower_text3"
				"message" "will not see the end of it."
				"x" "-1"
				"y" "0.35"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
				"channel" "0"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text4"
				"message" "If you make it out alive, you will have"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
                "channel" "1"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "lower_text4"
				"message" "joined a small group of the brave few."
				"x" "-1"
				"y" "0.35"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
				"channel" "0"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text5"
				"message" "Good luck LazyPurple."
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 140 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
                "channel" "1"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "lower_text5"
				"message" "You're gonna need it."
				"x" "-1"
				"y" "0.35"
				"spawnflags" "1"
				"color" "255 50 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
				"channel" "0"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "top_text6"
				"message" "P.S. Don't complain about the difficulty."
				"x" "-1"
				"y" "0.27"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
                "channel" "2"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text6"
				"message" "I won't listen lmao"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
                "channel" "1"
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "lower_text6"
				"message" "- Nuclear Waffle"
				"x" "-1"
				"y" "0.33"
				"spawnflags" "1"
				"color" "255 140 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "3"
                "channel" "0"
			}
		}
        wave4Text
		{
			OnSpawnOutput
			{
				Target TextDisplay2
				Action Trigger
				Delay 0.1
			}
            logic_relay
            {
                "targetname" TextDisplay2
                "OnTrigger"  "upper_text7,Display,,1,1"
            }
			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text7"
				"message" "OK. Playtime's over c:"
				"x" "-1"
				"y" "0.4"
				"spawnflags" "1"
				"color" "255 255 0"
				"fadein" "0.5"
				"fadeout" "1"
				"holdtime" "5"
				"channel" "1"
			}
		}
	}

	SpawnTemplate "MissionNamePT" [$SIGSEGV]

    Mission
    {
        Where spawnbot
        Objective DestroySentries
        BeginAtWave 1
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 20
        CooldownTime 30
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Health	10000
            Name    "Titanium Buster"
        }
    }
    Mission
    {
        Where spawnbot
        Objective DestroySentries
        BeginAtWave 4
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 10
        CooldownTime 20
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Health	10000
            Name    "Sturdy Titanium Buster"
            CharacterAttributes
            {
                "airblast vertical vulnerability multiplier" 0
                "airblast vulnerability multiplier" 0
                "damage force reduction" 0
            }
        }
    }

    Templates
    {
        T_TFBot_Soldier_Barrage_Hyper_Hellspawn
        {
            ClassIcon	soldier_barrage_hyper_lite
            Health	650
            Scale	1.4
            Name	"Hyper Barrage Soldier"
            Class	Soldier
            Skill	Expert
            Attributes	"AlwaysCrit"
            Attributes	"HoldFireUntilFullReload"
            ItemAttributes
            {
                ItemName	"Blood Botkiller Rocket Launcher Mk.I"
                "faster reload rate" -0.8
                "fire rate bonus" 0.2
                "damage bonus"	2
                "projectile spread angle penalty"	5
            }
            Item	"Blood Botkiller Rocket Launcher Mk.I"
            Item	"The Cross-Comm Crash Helmet"
        }
		T_TFBot_Demo_Burst_Hyper_Hellspawn
		{
			ClassIcon	demo_burst_hyper
			Name	"Hyper Burst Fire Demo"
			Class	Demoman
			Skill	Expert
			WeaponRestrictions	PrimaryOnly
			Attributes	HoldFireUntilFullReload
			Attributes	AlwaysCrit
			Item	"Prince Tavish's Crown"
			Item	"gentlemanne_grenadelauncher_topshelf"
			ItemAttributes
			{
				ItemName	"gentlemanne_grenadelauncher_topshelf"
				"faster reload rate" 0.1
				"fire rate bonus" 0.7	// Nerfed firing speed to improve server performance
				"clip size upgrade atomic" 10
				"damage bonus" 3.0      // Compensate nerfed firing speed with 2x -> 3x damage
				"Projectile speed increased" 2.0
			}
		}
        T_TFBot_Demo_Loch_Tankbuster_Shield_Hellspawn	// Does not use Aiming corrections from SIGSEGV
		{
			ClassIcon	demo_loch_tankbuster
			Name	"Tank Buster Demo"
			Class	Demoman
			Skill	Expert
			Attributes	HoldFireUntilFullReload
			Item	"The Loch-n-Load"
			Item	"The Chargin' Targe"
			Item	"Sober Stuntman"
			ItemAttributes
			{
				ItemName	"The Loch-n-Load"
				"damage bonus" 1.5
				"fire rate bonus" 0.2
				"faster reload rate" 0.6
				"clip size upgrade atomic" 4.0
				"dmg bonus vs buildings" 5
			}
		}
		T_TFBot_Giant_Soldier_Blast_Spammer_Hyper
		{
			ClassIcon	soldier_blast_spammer_giant
			Health	3800
			Name	"Giant Full-Auto Blast Soldier"
			Class	Soldier
			Skill	Expert
			WeaponRestrictions	PrimaryOnly
			Attributes	MiniBoss
			Item	"The Liberty Launcher"
			Item	"The Reserve Shooter"
			Item	"The Market Gardener"
			Item	"Jumper's Jeepcap"
			ItemAttributes
			{
				ItemName	"The Liberty Launcher"
				"damage bonus" 0.75
				"fire rate bonus" 0.1
				"faster reload rate" -2
				"blast radius decreased" 1.35
				"projectile spread angle penalty" 8
				"damage causes airblast" 1
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier"	0.4
				"override footstep sound set"	3
			}
		}        
        T_TFBot_Giant_Soldier_Spreader
		{
			ClassIcon soldier_rocketrain_giant
			Health  4000
			Name    "Giga Spreader Soldier"
			Class   Soldier
			Skill   Expert
			WeaponRestrictions PrimaryOnly
			Attributes MiniBoss
			Attributes HoldFireUntilFullReload
			Item    "Worms Gear"
			
			ItemAttributes
			{
				ItemName	TF_WEAPON_ROCKETLAUNCHER
				"damage bonus" 2.0
				"fire rate bonus" 0.001
				"faster reload rate" 0.2
				"clip size upgrade atomic" 48.0
				"Projectile speed increased" 0.4
				"projectile spread angle penalty" 10
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
			}
		}
		T_TFBot_Giant_Soldier_Boss_Major_Barrage
		{
			ClassIcon	soldier_barrage_super
			Health	125000
			Name	"Satanic Rain"	// Original name: Major Barrage
			Class	Soldier
			Skill	Expert
			WeaponRestrictions	PrimaryOnly
			Attributes	HoldFireUntilFullReload
			Attributes	AlwaysCrit
			Attributes	MiniBoss
			Attributes  UseBossHealthBar
			Item	"Blood Botkiller Rocket Launcher Mk.I"
			Item    "The Mean Captain"
			Item    "The Diplomat"
			ItemAttributes
			{
				ItemName	"Blood Botkiller Rocket Launcher Mk.I"
				"damage bonus" 3
				"faster reload rate" -2
				"fire rate bonus" 0.175
				"no self blast dmg" 1
				"blast radius increased" 1.35
				"projectile spread angle penalty" 5
				"Projectile speed decreased" 0.75
			}
			CharacterAttributes
			{
				"health regen" 200
				"move speed bonus"	0.30
				"damage force reduction" 0
				"airblast vulnerability multiplier"	0.1
				"airblast vertical vulnerability multiplier" 0.1
				"override footstep sound set" 3
			}
		}
		T_TFBot_Giant_Heavy_Boss_Powered_Natascha
		{
			ClassIcon	heavy_grapple_move
			Health	160000
			Name	"Consigliere Sin"	// Original name: Chief Powered Natascha Heavy
			Class	Heavyweapons
			Skill	Expert
			MaxVisionRange	4000
			WeaponRestrictions	PrimaryOnly
			Attributes	MiniBoss
			Attributes UseBossHealthBar
			Item	"Natascha"
			Item    "Brothers in Blues"
			Item    "Combat Casual"
			Item    "Hog Heels"
