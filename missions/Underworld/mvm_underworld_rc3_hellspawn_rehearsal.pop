    Mission
    {
        Where spawnbot
        Objective DestroySentries // Engineer,Sniper,Spy,DestroySentries
        BeginAtWave 1
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 20
        CooldownTime 30
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Name "Titanium Buster"
            Health	10000
        }
    }
    Mission
    {
        Where spawnbot
        Objective DestroySentries // Engineer,Sniper,Spy,DestroySentries
        BeginAtWave 4
        RunForThisManyWaves 3
        DesiredCount 1
    
        InitialCooldown 10
        CooldownTime 20
    
        TFBot
        {
            Template T_TFBot_SentryBuster
            Name "Sturdy Titanium Buster"
            Health	10000
            CharacterAttributes
            {
                "airblast vertical vulnerability multiplier" 0
                "airblast vulnerability multiplier" 0
                "damage force reduction" 0
            }
        }
    }
    Wave
    {
        Initwaveoutput
        {
            Target bignet
            Action RunScriptCode
            Param "
                EntFire(`wave_init_relay`, `Trigger`)
                IncludeScript(`popextensions_main`, getroottable())
                MissionAttrs({
                NoCrumpkins = 1
                BotHeadshots = 1
                })"
        }
        StartWaveOutput
        {
	        Target wave_start_relay_boss
	        Action Trigger
        }
        DoneOutput					
        {
	        Target wave_finished_relay
	        Action trigger
        }
        Wavespawn
        {
            Name "Wave1_a1"
            Where Spawnbot
            TotalCount 60
            SpawnCount 2
            MaxActive 6
            Waitbetweenspawns 5
            WaitBeforeStarting 5
            TotalCurrency 75
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                Skill Expert
            }
        }
        Wavespawn
        {
            Support 1
            Name "Wave1_a1_support"
            Where Spawnbot_invasion
            TotalCount 60
            SpawnCount 2
            MaxActive 4
            Waitbetweenspawns 8
            WaitBeforeStarting 0
            Waitforalldead "Wave1_a1"
            TotalCurrency 25
            TFBot
            {
                Template T_TFBot_Soldier_Extended_Concheror
                Skill Expert
                Attributes AlwaysCrit
                Name "Tough Concheror Soldier"
                Health 300
                BehaviorModifiers Push
            }
        }
