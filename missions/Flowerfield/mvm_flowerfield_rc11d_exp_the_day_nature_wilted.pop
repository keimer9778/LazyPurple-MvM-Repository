    Wave // Wave #
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }
        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        InitWaveOutput
        {
            Target wave_start_relay // gamerules or tf_gamerules, depending on the map
            Action RunScriptCode
            Param "
                EntFire(`wave_init_relay_left`, `Trigger`, null, 0.5)
                EntFire(`spawnthestorm`,`trigger`, null, 0.15)
                EntFire(`makehimjumpdown`,`enable`)
                EntFire(`bosstime`,`forcespawn`, null, 0.15)
                IncludeScript(`bosstickdown`, getroottable())
                IncludeScript(`meteors`, getroottable())
                IncludeScript(`ignis_logic`, getroottable())
            "
        }
        WaveSpawn
        {
            Name "finalboss"
            Where spawnbot
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 0
        
            TotalCurrency 0
        
            TFBot
            {
                Class Pyro
                Name "Ignis"
                SpawnTemplate additionalbosslogic
                Tag is_chief
                Tag dontdoublehp
                Tag dontdoublehp_damageres
                ClassIcon pyro_membrain_lite
                Skill Expert
                Health 100000
                Scale 2.5
                WeaponRestrictions PrimaryOnly
                Action Mobber
                Attributes MiniBoss
                Attributes UseBossHealthBar
                Item "The Mucous Membrain"
                Item "Potato of Labor"
                Item "Forgotten King's Pauldrons"
                Item "Invisible Flame"
                Item "Scorched Earth Stompers"
                Addcond
                {
                    Index 5
                }
			    ItemModel 
                {
                    ItemName "Potato of Labor" 
                    Model "models/workshop/player/items/pyro/hw2013_rugged_respirator/hw2013_rugged_respirator.mdl"
                }
                CustomEyeGlowColor "255 0 0"
                UseMeleeThreatPrioritization 1
                UseCustomModel "models\bots\pyro_boss\bot_pyro_boss_gibby.mdl"
                CharacterAttributes
                {
                    "move speed bonus"	0.35
                    "damage force reduction" 0.6
                    "airblast vulnerability multiplier" 0.6
                    "override footstep sound set" 0
                    "cancel falling damage" 1
                }
                ItemAttributes
                {
                    ItemName "The Mucous Membrain"
                    "attach particle effect" 1
                }
                WeaponResist [$SIGSEGV] //Multiplies damage received from weapons listed below
                {
                    "TF_WEAPON_KNIFE" 0.6
                    "TF_WEAPON_MINIGUN" 0.7
                }
                FireInput
                {
                    Target "!self"
                    Action "$SetLocalOrigin"
                    Param "270 1000 130"
                    Delay 0
                    Repeats 1
                }
                FireInput
                {
                    Target "phaseswitcher"
                    Action "trigger"
                    IfHealthBelow 50001
                    Delay  0
                    Repeats 1
                }
                FireInput //shake
                {
                    Target "!self"
                    Action "runscriptcode"
                    Param "ScreenShake(self.GetOrigin(), 3, 8, 0.5, 1200, 0, true)"
                    Delay -1
                    Cooldown 0.5
                    Repeats 0
                }
                EventChangeAttributes
                {
                    intro
                    {
                        Item "Taunt: Cremator's Condolences"
                        Taunt
                        {
                            Name "Taunt: Cremator's Condolences"
                            Delay 0
                            Repeats 1
                        }
                        CharacterAttributes
                        {
                            "always allow taunt" 1
                            "no_jump" 1
                        }
                        ChangeAttributes
                        {
                            Name specialattack
                            Delay 12
                            Repeats 1
                        }
                    }
                    phase2transition
                    {
                        Item "The Rainblower"
                        Taunt
                        {
                            Delay 5.5
                            Repeats 1
                        }
                        CharacterAttributes
                        {
                            "dmg from ranged reduced" 0.001
                            "dmg from melee increased" 0.001
                            "no_jump" 1
                            "no_attack" 1
                            "move speed bonus" 0.0001
                        }
                    }
                    interrupttothecenter
                    {
                        CharacterAttributes
                        {
                            "no_attack" 1
                            "move speed bonus" 1
                            "displace touched enemies" 1
                        }
                        InterruptAction
                        {
                            Target "263 432 -31"
                            Delay 0.1
                            Repeats 1
                            Duration 0.1
                            Cooldown 0
                            WaitUntilDone 1
                            Distance 100
                            OnDoneChangeAttributes solar_flare_attack
                        }
                    }
                    solar_flare_attack
                    {
                        Item "The Rainblower"
                        Taunt
                        {
                            Delay 0.1
                            Repeats 1
                        }

                        CharacterAttributes
                        {
                            "no_jump" 1
                            "no_attack" 1
                            "move speed bonus" 0.0001
                            "gesture speed increase" 1.5
                            "always allow taunt" 1
                            "displace touched enemies" 1
                        }
                        FireInput
                        { // this makes the bot move forward in the air
                            Target "!self"
                            Action "RunScriptCode"
                            Param "self.ApplyAbsVelocityImpulse(Vector(200,0,4000))"
                            Delay 2
                            Repeats 1
                            Cooldown 99
                        }
                         FireInput
                        { // this makes the bot move forward in the air
                            Target "player"
                            Action "$PlaySoundToSelf"
                            Param "=140|misc\halloween\spell_meteor_cast.wav"
                            Delay 2
                            Repeats 1
                            Cooldown 99
                        }
                        
                        FireInput
						{
							Target "!self"
							Action "$PlaySequence"
							Param  "taunt_zoomin_broom_exit"
							Delay  1.8
							Cooldown 99
							Repeats 1
						}
                        FireInput
						{
							Target "!self"
							Action "$PlaySequence"
							Param  "swim_ITEM4"
							Delay  2.4
							Cooldown 99
							Repeats 6
                            Cooldown 2
						}
                        AddAttribute   
                        {
                            Item "player" // Item name to which add the attribute, or Player for player attribute, or Active for active weapon
                            Name "no clip" // Attribute name
                            Value 0.001 // Attribute value
                            Delay 2.6 //Delay before adding the attribute
                            Cooldown 99 //Cooldown between adding attributes
                            Repeats 99 //How many times should the attribute be added (Matters only if it was previously removed)
                        }
                        RemoveAttribute   
                        {
                            Item "player" // Item name to which add the attribute, or Player for player attribute, or Active for active weapon
                            Name "no clip" // Attribute name
                            Delay 16.3 //Delay before adding the attribute
                            Cooldown 99 //Cooldown between adding attributes
                            Repeats 99 //How many times should the attribute be added (Matters only if it was previously removed)
                        }
                        FireInput
                        {
                            Target "evilasslaugh"
                            Action "trigger"
                            Delay  0
                            Repeats 1
                        }
                        FireInput
                        {
                            Target "attacksolarflare"
                            Action "trigger"
                            Delay  5
                            Repeats 1
                        }
                        FireInput
