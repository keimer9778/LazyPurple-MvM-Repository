#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
    StartingCurrency 0
    CanBotsAttackWhileInSpawnRoom no
    RespawnWaveTime 3
    BodyPartScaleSpeed 6
    AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15
    // SendBotsToSpectatorImmediately 1
    AllowBotExtraSlots 1
    RobotLimit 28
    WaveStartCountdown 7
    TextPrintTime 0
    PrecacheSound "fuel_barrel_deploy.mp3"
    PrecacheSound "evilassmusicforthunderstorms.mp3"
    PrecacheSound "newrobotkindarises.mp3"
    PrecacheSound "boss_charging_his_shit.mp3"
    PrecacheSound "major_shocks_spin.mp3"
    PrecacheSound "boss_defeated_ignis.mp3"
    PrecacheSound "boss_half_health.mp3"
    PrecacheSound "the_day_nature_wilted.mp3"
    PrecacheSound "the_day_nature_wilted_phase_2.mp3"
    PrecacheGeneric "materials/colorcorrection/inthewakeofignis.raw"
    PrecacheGeneric "materials/colorcorrection/bigredlight.raw"
    PrecacheGeneric "materials/colorcorrection/stormlight.raw"
    PrecacheModel "models/flags/lava_canister.mdl"
    DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"	
	DisableSound "music.mvm_end_last_wave"						   
	DisableSound "music.mvm_end_mid_wave"						   
	DisableSound "music.mvm_end_tank_wave"						   
	DisableSound "music.mvm_end_wave"							   
	DisableSound "music.mvm_lost_wave"							   
	DisableSound "music.mvm_start_last_wave"					   
	DisableSound "music.mvm_start_mid_wave"						   
	DisableSound "music.mvm_start_tank_wave"					   
	DisableSound "music.mvm_start_wave"	
    ExtraTankPath
    {
        Name "justforthecutscene"
        Node "340 1682 900"
        Node "270 1177 628"
        Node "270 1000 120"
    }
    CustomWeapon
    {
        "VolatileBotBarrel"
		{
			OriginalItemName "Potato of Labor"

			"custom item model" "models/flags/lava_canister.mdl"
		}
        "tracerig"
        {
            OriginalItemName "The Rescue Ranger"
            "projectile speed increased" 2
            "custom projectile model" "models/empty.mdl"
            "damage bonus" 0.0001
            "projectile penetration" 1
        }
        "solarflarebossattack"
        {
            OriginalItemName "TF_WEAPON_GRENADELAUNCHER"
            "explosion particle" "~"
            "custom projectile model" "models/empty.mdl"
            "projectile detonate time" 0.0001
            "allow friendly fire" 1
            "Set DamageType Ignite" 5
            "weapon burn dmg increased" 15
            "weapon burn time increased" 0.1
            "blast radius increased" 9999
            "damage bonus" 0.001
            "custom kill icon" "firedeath"
        }
        "flarelauncher"
        {
            OriginalItemName "TF_WEAPON_SHOTGUN_PYRO"
            "mult projectile count" 8
            "damage bonus" 6
            "projectile speed increased" 0.5
            "override projectile type" 6
            "fire rate bonus" 0.6
            "projectile spread angle penalty" 5
            "custom weapon fire sound" "pyro_taunt_roasty_toasty_taunt_fire"
            "custom item model" "models/weapons/c_models/c_firelauncher/c_firelauncher.mdl"
        }
