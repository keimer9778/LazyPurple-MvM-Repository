		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		Initwaveoutput
		{
		    Target  Bombpath_choose_relay
			Action  Trigger
		}
		
		Explanation [$SIGSEGV]
    {
        Line "{red} this mission uses some custom icons"
        Line "{green} download them here"
        Line "{reset} https://www.dropbox.com/sh/6ba1x2b2tz0zzga/AAC9TS5ZuBcsaEHygNY3QQG6a?dl=0 " 
    }
		
