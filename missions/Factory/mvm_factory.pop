#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop
#base robot_factory.pop
population
{
	StartingCurrency						400
	RespawnWaveTime							6
	CanBotsAttackWhileInSpawnRoom			no
	AddSentryBusterWhenDamageDealtExceeds	3000
	AddSentryBusterWhenKillCountExceeds		15
	
	//MISSIONS
	
	//SENTRY BUSTAH
	Mission
	{
		Objective DestroySentries
		Where spawnbot
		CooldownTime 30
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	
	
	//Wave 3 jarate
	Mission
	{
		Objective Sniper							// The mission objective. Available missions: 
													//    "Sniper" (add harassing snipers)
													//    "Spy" (add harassing spies)
													//    "DestroySentries" (send in bots who focus on killing overly successful sentry guns)
													//    "Engineer" (add harassing engineers who will build sentry nests on bot_hint_sentrygun entities)

		Where					spawnbot			// Where the mission bots will spawn

		BeginAtWave				3					// The wave number (1 to N) at which this mission becomes active
		RunForThisManyWaves		1					// How many waves this mission is active. This example would have snipers active for waves 4, 5, and 6
		InitialCooldown			5
		
		CooldownTime			30					// The minimum time between spawning mission sorties
		DesiredCount			4					// How many copies of the spawner should be sent in

		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper_Nerf
		}
	}
	//Wave 4 Spies
	Mission
	{
		Objective Spy								

		Where					spawnbot

		BeginAtWave				4					
		RunForThisManyWaves		1
		InitialCooldown			10
		
		CooldownTime			30
		DesiredCount			4

		TFBot
		{
			Template	T_TFBot_Spy
		}
	}
	//Wave 5 snipers
	Mission
	{
		Objective Sniper							// The mission objective. Available missions: 
													//    "Sniper" (add harassing snipers)
													//    "Spy" (add harassing spies)
													//    "DestroySentries" (send in bots who focus on killing overly successful sentry guns)
													//    "Engineer" (add harassing engineers who will build sentry nests on bot_hint_sentrygun entities)

		Where					spawnbot			// Where the mission bots will spawn

		BeginAtWave				5					// The wave number (1 to N) at which this mission becomes active
		RunForThisManyWaves		1					// How many waves this mission is active. This example would have snipers active for waves 4, 5, and 6
		
		CooldownTime			30					// The minimum time between spawning mission sorties
		DesiredCount			4					// How many copies of the spawner should be sent in

		TFBot
		{
			Template	T_TFBot_Sniper_Sydney_Sleeper_Nerf
		}
	}
	
	//WAVES
	
	//Wave 1 - $850
	Wave
	{
		WaitWhenDone	65
		Checkpoint		Yes
		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_finished_relay
			Action	Trigger
		}
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
				NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Normal Mode`)
				
			"
		}
		WaveSpawn
		{
			Name				a1
			TotalCurrency		200
			TotalCount			18
			MaxActive			4
			SpawnCount			2
			WaitBeforeStarting	0
			WaitBetweenSpawns	10
			Where				spawnbot
			Squad
			{
				TFBot
				{
					Template	T_TFBot_Scout_Melee
				}
				TFBot
				{
					Template	T_TFBot_Medic_QuickFix
				}
			}
		}
		WaveSpawn
		{
			Name				a1b
			TotalCurrency		200
			TotalCount			18
			MaxActive			4
			SpawnCount			2
			WaitBeforeStarting	5
			WaitBetweenSpawns	10
			Where				spawnbot
			Squad
			{
				TFBot
				{
					Template	T_TFBot_Scout_Fish
				}
				TFBot
				{
					Template	T_TFBot_Medic_QuickFix
				}
			}
		}
		WaveSpawn
		{
			Name				a2
			WaitForAllSpawned	a1b
			WaitForAllDead		a1
			TotalCurrency		200
			TotalCount			20
			MaxActive			10
			SpawnCount			4
			WaitBeforeStarting	0
			WaitBetweenSpawns	10
			Where				spawnbot
			Squad
			{
				TFBot
				{
					Template	T_TFBot_Sniper_Huntsman
				}
				TFBot
				{
					Template	T_TFBot_Pyro_ArrowLighter
				}
			}
		}
		WaveSpawn	//Plague Doctors, with accompanying Raven Pyros
		{
			Name				a3
			WaitForAllSpawned	a2
			WaitForAllDead		a1b
			TotalCurrency		250
			TotalCount			35
			MaxActive			14
			SpawnCount			7
			WaitBeforeStarting	0
			WaitBetweenSpawns	10
			Where				spawnbot
			Squad
			{
				TFBot
				{
					Template	T_TFBot_Medic_Plague
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
				TFBot
				{
					Template	T_TFBot_Pyro_Raven
				}
			}
		}
	}
	
	
	
