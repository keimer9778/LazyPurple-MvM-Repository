				"
					subCounter++
					if(subCounter >= 3) EntFire(`spawnbot_placeholder1`, `Enable`)
				"
			}
			
			TFBot
			{
				Class Soldier
				Skill Easy
				BehaviorModifiers Push
				Attributes Aggressive
				Tag fm_soldier
				Tag nav_prefer_flank_left
				Tag flankpusher
			}
		}
		
