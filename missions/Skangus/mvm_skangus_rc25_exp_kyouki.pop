		WaveSpawn
		{
			Where spawnbot
			Name "04"
			WaitForAllSpawned "02"
			TotalCount 6
			MaxActive 6
			SpawnCount 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 20
			TotalCurrency 25

			DoneOutput
			{
				Target gamerules
				Action RunScriptCode
				Param "
				PrecacheSound(`)misc/cp_harbor_red_whistle.wav`);
				for (local tank; tank = Entities.FindByClassname(tank, `tank_boss`);)
				{
					if (tank != null && tank.IsValid())
					{
						NetProps.SetPropFloat(tank, `m_speed`, NetProps.GetPropFloat(tank, `m_speed`) * 2.0);
						EmitSoundEx({
							sound_name = `)misc/cp_harbor_red_whistle.wav`
							sound_level = 95
							entity = tank
							filter_type = 5
						});
						EmitSoundEx({
							sound_name = `)misc/cp_harbor_red_whistle.wav`
							sound_level = 95
							entity = tank
							filter_type = 5
						});
					}
				}
				"
			}

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Laser_Spammer
				}

				TFBot
				{
					Template T_TFBot_Giant_Medic
					ClassIcon medic_pop
				}
			}
		}

