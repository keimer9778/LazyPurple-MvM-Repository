                "Filter02"   "_filter_is_not_ubered2"
                "Filter03"   "_filter_is_not_ubered3"
                "Filter04"   "_filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }   
            trigger_teleport // Wave 3 Spawn Teleporter
            {
