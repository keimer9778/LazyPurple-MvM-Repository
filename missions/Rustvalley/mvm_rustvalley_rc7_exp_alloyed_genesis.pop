        nameboss_typh // Titanic Typhoon Title PT (He's retired)
        {
            OnSpawnOutput
			{
				Target "upper_text"
				Action "Display"
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "text_lower"
				Action "Display"
				Delay 1
			}
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text"
				"message" "MECHANIZED GRAVITY WELL"
				"x" "-1"
				"y" "0.2"
				"spawnflags" "1"
				"effect" "2"
				"channel" "2"
				"color" "255 255 255"
				"fxtime" "0.2"
				"fadeout" "1"
				//"fadein" "0"
				"holdtime" "5"
			}

			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "text_lower"
				"message" "TITANIC TYPHOON"
				"x" "-1"
				"y" "0.25"
				"channel" "1"
				"spawnflags" "1"
				"color" "255 255 255"
				"fadein" "0.2"
				"fadeout" "1"
				"holdtime" "3.8"
			}
        }

        //// WAVE 3 PTs ////

        reversewave // Large and in Charge
        {
            OnSpawnOutput
            {
                Target "setupforreverse"
                Action Trigger
                Delay 1
            }
            logic_relay
            {
                "targetname" "startmovingfatty"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent !self:SetSpeed:13:0:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent !self:SetSpeed:26:2:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent !self:SetSpeed:39:4:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent !self:SetSpeed:52:6:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent !self:SetSpeed:75:8:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent pop_interface:$ResumeWavespawn:forteletank:6:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent tf_gamerules:PlayVO:misc\doomsday_lift_warning.wav:0:-1,0,-1"
                "OnTrigger"  "teletank*,addoutput,OnHealthBelow90Percent tf_gamerules:PlayVO:mvm\mvm_tele_activate.wav:3:-1,0,-1"
            }
            logic_relay
            {
