        ringOwnerGenesis // Alloyed Genesis Shockwave PTs
        {
            NoFixUp 1
            env_entity_maker
            {   
                "targetname" "ring_makerGenesis"
                "entitytemplate" "ringshottestGenesis"
            }
            OnSpawnOutput
            {
                target "!activator"
                action "RunScriptCode"
                param "CzUtil.AddTracking(`ringOwnerGenesis`, self)"
                delay 0.0
            }
            OnParentKilledOutput
            {
                target "ring_makerShocks"
                action "RunScriptCode"
                param "CzUtil.RemoveTracking(`ringOwnerGenesis`)"
                delay 0.0
            }
        }
        ringshottestGenesis // Alloyed Genesis Shockwave PTs
        {
            KeepAlive 1
            OnSpawnOutput
            {
                target "tf_gamerules"
                action "PlayVO"
                Param "ambient\energy\weld2.wav"
                delay "0.0"
            }
            OnSpawnOutput
            {
                target "ringmarkerone"
                action "kill"
                delay "5.5"
            }
            OnSpawnOutput
            {
                target "ringmarkertwo"
                action "kill"
                delay "5.5"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "TurnOff"
                delay "4.5"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "StrikeOnce"
                delay "0"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "kill"
                delay "5.0"
            }
            OnSpawnOutput
            {
                target "ringmarkerone"
                action "RunScriptCode"
                param "SetMoveIgnoreSolid(self, 600)"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "RunScriptCode"
                param "RingRegister(self,500,CzUtil.GetTracking(`ringOwnerGenesis`))"
                delay 0.0
            }
            OnSpawnOutput
            {
                target "ringmarkertwo"
                action "RunScriptCode"
                param "SetMoveIgnoreSolid(self, 600)"
                //delay 0.1
            }
            prop_dynamic
            {
                "parentname" ""
                "targetname" "ringmarkerone"
                "model" "models/empty.mdl"
                "solid" "0"
                "origin" "0 0 40"                
            }
            prop_dynamic
            {
                "parentname" ""
                "targetname" "ringmarkertwo"
                "model" "models/empty.mdl"
                "solid" "0"
                "angles" "0 180 0"
                "origin" "0 0 40"
            }	
            env_beam
            {
                "parentname" ""
                "targetname" "roundbeamtest"
                "BoltWidth" "6"
                "LightningStart" "ringmarkerone"
                "LightningEnd" "ringmarkertwo"
                "origin" "0 0 40"
                "renderamt" "200"
                "rendercolor" "255 255 255"
                "damage" "0"
                "NoiseAmplitude" "0"
                "dissolvetype" "1"
                "texture" "sprites/laserbeam.spr"
                "life" "4"
                "spawnflags" "8" //8
                "TouchType" "1"
            }
        }

        imlosingitandbyitletsjustsaymyconditions // Alloyed Genesis Lose Condition PTs
        {
            OnSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param "
				IncludeScript(`textualtimer_v3`, getroottable())
				TextualTimer.SetParams({
					minutes = 1
					seconds = 0
					x = -1
					y = 0.77
					color = `0 255 555`
					text_prepend = `IMMINENT DEATH AND DESTRUCTION: `
					automatic = false 
        		})
				"
			}
            logic_case
            {
                "targetname" "LoseConditionCase"
                "OnCase01" "BombLoseConditionRelay,Trigger,,0,-1"
                "OnCase02" "GateLoseConditionRelay,Trigger,,0,-1"
                "OnCase03" "TeamWipeLoseConditionRelay,Trigger,,0,-1"
            }
            game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "panic_text"
				"message" "SWITCHING LOSE CONDITIONS..."
				"x" "-1"
				"y" "0.2"
				"spawnflags" "1"
				"effect" "0"
				"channel" "2"
				"color" "255 255 255"
				"fadeout" "0.2"
				"fadein" "0.2"
				"holdtime" "0.2"
			}
            logic_relay
            {
                "targetname" "losecondtimer"
                "OnTrigger"  "switchingthatloosecond,trigger,,0,-1"
                "OnTrigger"  "!self,trigger,,80,-1"
                "spawnflags" "2"
            }
            logic_relay // Blinking Red Warning
			{
				"targetname" "switchingthatloosecond"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,0.05,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,0.75,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,1.45,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,2.15,-1"
                "OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,2.85,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm\mvm_warning.wav,0,-1"
                "OnTrigger"  "panic_text,display,,0.05,-1"
                "OnTrigger"  "panic_text,display,,0.75,-1"
                "OnTrigger"  "panic_text,display,,1.45,-1"
                "OnTrigger"  "panic_text,display,,2.15,-1"
                "OnTrigger"  "panic_text,display,,2.85,-1"
                "OnTrigger"  "panic_text,display,,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm\mvm_warning.wav,7,-1"
                "OnTrigger" "@p@alloyedgenesisrunscriptcodeself.RemoveBotTag(`bot_gatebot`)7-1"
                "OnTrigger"  "LoseConditionCase,pickrandomshuffle,,7,-1"
			}
            logic_relay // Blinking Red Warning
			{
				"targetname" "switchingtothetimer"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,0.05,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,0.75,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,1.45,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,2.15,-1"
                "OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,2.85,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient\alarms\klaxon1.wav,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm\mvm_warning.wav,0,-1"
                "OnTrigger" "panic_text,display,,0.05,-1"
                "OnTrigger" "panic_text,display,,0.75,-1"
                "OnTrigger" "panic_text,display,,1.45,-1"
                "OnTrigger" "panic_text,display,,2.15,-1"
                "OnTrigger" "panic_text,display,,2.85,-1"
                "OnTrigger" "panic_text,display,,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm\mvm_warning.wav,7,-1"
                "OnTrigger" "TimerLoseHintTimer,Enable,,7,-1"
                "OnTrigger" "BombLoseHintTimer,Disable,,7,-1"
                "OnTrigger" "GateLoseHintTimer,Disable,,7,-1"
                "OnTrigger" "TeamWipeLoseHintTimer,Disable,,7,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,thebobcarriers,7,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,thebobcarriers,7,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,IMRUSHINGITRAHHHH,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,IMRUSHINGITRAHHHH,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,fodder,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,fodder,0,-1"
                "OnTrigger" "intel_classic,ForceReset,,7,-1"
                "OnTrigger" "thisbossneedsahero,Disable,,7,-1"
                "OnTrigger" "RedLoseRelay,Disable,,7,-1"
                "OnTrigger" "TimerTriggerRelay,Trigger,,7,-1"
                "OnTrigger"  "@p@alloyedgenesisrunscriptcodeself.RemoveBotTag(`bot_gatebot`)0-1"
			}
            
            logic_relay
            {
                "targetname" "BombLoseConditionRelay"

                "OnTrigger" "BombLoseHintTimer,Enable,,0,-1"
                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "GateLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "TeamWipeLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,fodder,0.1,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,fodder,0.1,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,IMRUSHINGITRAHHHH,0.1,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,IMRUSHINGITRAHHHH,0.1,-1"
                "OnTrigger" "pop_interface,$ResumeWaveSpawn,thebobcarriers,0,-1"
                "OnTrigger" "RedLoseRelay,Disable,,0,-1"
                "OnTrigger"  "@p@alloyedgenesisrunscriptcodeself.RemoveBotTag(`bot_gatebot`)0-1"
            }
            logic_timer
			{
				"targetname"    "BombLoseHintTimer"
				"RefireTime"    "2.0"
				"StartDisabled" 1
				"OnTimer"       "BombLoseHint,showhudhint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "BombLoseHint"
				"message" "[OBJECTIVE] PREVENT THE BOMB FROM DEPLOYING"
				"spawnflags" "1"
			}
            logic_timer
			{
				"targetname"    "TimerLoseHintTimer"
				"RefireTime"    "2.0"
				"StartDisabled" 1
				"OnTimer"       "TimerLoseHint,showhudhint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "TimerLoseHint"
				"message" "[OBJECTIVE] PREVENT THE TIMER FROM REACHING ZERO"
				"spawnflags" "1"
			}

            logic_relay
            {
                "targetname" "TimerTriggerRelay"

                "OnTrigger" "BigNet,RunScriptCode,TextualTimer.Start(),0,-1"
            }

            logic_relay
            {
                "targetname" "GateLoseConditionRelay"

                "OnTrigger" "BombLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "GateLoseHintTimer,Enable,,0,-1"
                "OnTrigger" "TeamWipeLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,thebobcarriers,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,thebobcarriers,0,-1"
                "OnTrigger" "pop_interface,$KillWavespawn,fodder,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,fodder,0,-1"
                "OnTrigger" "pop_interface,$ResumeWaveSpawn,IMRUSHINGITRAHHHH,0.1,-1"
                "OnTrigger" "thisbossneedsahero,Enable,,0,-1"
                "OnTrigger" "intel_classic,ForceReset,,0,-1"
                "OnTrigger" "RedLoseRelay,Enable,,0,-1"
            }
            logic_timer
            {
                "targetname" "thisbossneedsahero"
                "RefireTime" "0.5"
                "StartDisabled" "1"
                "OnTimer" "@p@alloyedgenesisrunscriptcodeself.AddBotTag(`bot_gatebot`)0-1"
            }
            logic_timer
			{
				"targetname"    "GateLoseHintTimer"
				"RefireTime"    "2.0"
				"StartDisabled" 1
				"OnTimer"       "GateLoseHint,showhudhint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "GateLoseHint"
				"message" "[OBJECTIVE] PREVENT THE GATES FROM BEING CAPTURED"
				"spawnflags" "1"
			}

            logic_relay
            {
                "targetname" "TeamWipeLoseConditionRelay"

                "OnTrigger" "BombLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "GateLoseHintTimer,Disable,,0,-1"
                "OnTrigger" "TeamWipeLoseHintTimer,Enable,,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,thebobcarriers,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,thebobcarriers,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,IMRUSHINGITRAHHHH,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,IMRUSHINGITRAHHHH,0,-1"
                "OnTrigger" "pop_interface,$ResumeWaveSpawn,fodder,0.1,-1"
                "OnTrigger" "thisbossneedsahero,Disable,,0,-1"
                "OnTrigger" "intel_classic,ForceReset,,0,-1"
                "OnTrigger" "RedLoseRelay,Enable,,0,-1"
                "OnTrigger" "@p@alloyedgenesisrunscriptcodeself.RemoveBotTag(`bot_gatebot`)0-1"
            }
            logic_timer
			{
				"targetname"    "TeamWipeLoseHintTimer"
				"RefireTime"    "2.0"
				"StartDisabled" 1
				"OnTimer"       "TeamWipeLoseHint,showhudhint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "TeamWipeLoseHint"
				"message" "[OBJECTIVE] DO NOT ALL DIE AT ONCE"
