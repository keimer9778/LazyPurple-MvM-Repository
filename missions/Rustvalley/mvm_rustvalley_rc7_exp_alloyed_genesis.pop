                "OnTrigger"  "trolley2,setplaybackrate,4,4,-1"
                "OnTrigger"  "beam2,start,,4,-1"
                "OnTrigger"  "beam2,stop,,4.1,-1"
                "OnTrigger"  "beam2,start,,5,-1"
                "OnTrigger"  "beam2,stop,,5.1,-1"
                "OnTrigger"  "beam2,start,,6,-1"
                "OnTrigger"  "beam2,stop,,6.1,-1"
