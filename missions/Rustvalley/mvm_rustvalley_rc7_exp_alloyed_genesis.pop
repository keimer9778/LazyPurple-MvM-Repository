        allmyteamwipes // Teamwipe Player Counter
        {
            OnSpawnOutput
            {
                Target "TeamWipeCounter"
                Action "Add"
                Param "1"
                Delay 0
                Repeats 1
                Cooldown -1
            }
            OnParentKilledOutput
            {
                Target "TeamWipeCounter"
                Action "Subtract"
                Param "1"
                Delay 0
                Repeats 1
                Cooldown -1
            }

            info_target
            {
                "targetname" "guh"
            }
        }

