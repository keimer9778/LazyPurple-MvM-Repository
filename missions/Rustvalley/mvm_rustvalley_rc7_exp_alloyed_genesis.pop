        bossintro // Timed Diaster Intro PTs
        {
            RemoveIfKilled trolley2
            OnSpawnOutput
            {
                Target trolley
                Action setplaybackrate
                Param 0.6
                Delay 0
            }
            OnSpawnOutput
            {
                Target incitefearintothem
                Action trigger
                Delay 15
            }
            logic_relay
