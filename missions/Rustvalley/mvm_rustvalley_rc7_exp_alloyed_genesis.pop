                "targetname" "deploymegadeath"
                "OnTrigger"  "playerrunscriptcodeScreenFade(null, 186, 186, 186, 255, 1, 0.1, 1)7-1"
                "OnTrigger"  "pop_interface,$ResumeWavespawn,unleashthebeast,7,-1"
                "OnTrigger" "tf_gamerules,playvo,mvm\mvm_tele_deliver.wav,7,-1"
                "OnTrigger" "tf_gamerules,playvo,mvm\mvm_cpoint_klaxon.wav,0,-1"
                "OnTrigger" "tf_gamerules,playvo,mvm\mvm_cpoint_klaxon.wav,2,-1"
                "OnTrigger" "tf_gamerules,playvo,mvm\mvm_cpoint_klaxon.wav,4,-1"
