    //// POINT TEMPLATES ////

    PointTemplates 
    {
        //// CORE PTs ////

        Core_PTs // I'm full of stuff
        {
            logic_auto
            {
                "OnMapSpawn" "tf_objective_resource,$SetClientProp$m_iszMvMPopfileName,ALLOYED GENESIS (EXPERT),0,-1"
                "OnMapSpawn" "worldspawn,runscriptcode,SetSkyboxTexture(`sky_goldrush_01`),0,1"
            }
            logic_relay
            {
                "targetname" "timeforthefinaleboss"
                "OnTrigger"  "playerrunscriptcodeScreenFade(null, 0, 0, 0, 255, 5, 0.4, 2)2-1"
            }
            info_particle_system
            {
                "targetname"   "spawn_the_finale"
                "origin"       "1389 -1327 -281"
                "effect_name"  "mvm_tank_destroy_bloom"
                "start_active" "0"
            }
            // a set of utility entities
            color_correction
            {
                "targetname" "lowtiergod"
                "origin" "0 0 0"
                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" 0
                "fadeOutDuration" 5
                "StartDisabled" 1
                "filename" "materials/colorcorrection/stormlight.raw"
                "maxweight" "1"
            }
            ambient_generic
            {
                "targetname" "w7_wind_sound"
                "message" "fat_w7_wind.mp3"
				"health" "7"
                "spawnflags" "17"
            }
            ambient_generic
            {
                "targetname" "w7_wind_sound"
                "message" "fat_w7_wind.mp3"
				"health" "7"
                "spawnflags" "17"
            }
            logic_relay
            {
                "targetname"    "timerwind"
                "spawnflags" 2
                "OnTrigger"       "w7_wind_sound,playsound,,0,-1"
                "OnTrigger"       "w7_wind_sound,stopsound,,198.8,-1"
                "OnTrigger"       "!self,trigger,,198.8,-1"
            }
            NoFixUp 1
            point_clientcommand
            {
                "targetname" "client_commander"
            }
            filter_activator_class
            {
                "targetname" "filter_is_not_player"
                "Negated" "1"
                "filterclass" "player"
            }
            filter_activator_class
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
