                "stun_effects" "0"
                "stun_duration" "15"
                "wait" "0.1"
                "StartDisabled" "1"
            }
            logic_relay
            {
                "targetname" "triggerthedeath"
                "OnTrigger"  "playerrunscriptcodeScreenFade(null, 0, 0, 0, 255, 7, 8, 2)0-1"
                "OnTrigger"  "playerrunscriptcodeScreenFade(null, 0, 0, 0, 255, 5, 0.1, 1)14.95-1"
                "OnTrigger"  "playerRunScriptCodeself.SetHudHideFlags(~132)0-1"
                "OnTrigger"  "playerRunScriptCodeself.RemoveHudHideFlags(~132)18-1"
                "OnTrigger"  "boss_stun,enable,,0,-1"
                "OnTrigger"  "telezone_2,enable,,14.8,-1"
                "ontrigger"  "bignetrunscriptcodePrecacheSound(`music/mvm_lost_wave.wav`);EmitSoundEx({sound_name=`music/mvm_lost_wave.wav`,pitch = 60,filter_type=5})01"
                "OnTrigger"  "boss_stun,disable,,0.1,-1"
                "OnTrigger"  "telezone_2,disable,,14.9,-1"
                "OnTrigger" "item_teamflag*,ForceResetSilent,,-1,-1"
                "OnTrigger" "item_teamflag*,Disable,,-1,-1"
				"OnTrigger"  "pop_interface,PauseBotSpawning,,15,-1"
                "OnTrigger"  "pop_interface,UnpauseBotSpawning,,20,-1"
                "OnTrigger"  "cleanupbots,enable,,14.9,-1"
