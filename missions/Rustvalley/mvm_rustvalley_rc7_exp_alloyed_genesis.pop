                "OnTrigger"  "beam2,stop,,7.1,-1"
                "OnTrigger"  "trolley2,kill,,7.2,-1"
                "OnTrigger"  "nosorry,kill,,7,-1"
            }
            logic_relay
            {
                "targetname" "incitefearintothem"
                "OnTrigger"  "trolley,Disable,0,0,1"
                "OnTrigger"  "trolley2,enable,0,0,1"
                "OnTrigger"  "beam,start,,0,1"
                "OnTrigger"  "tf_gamerules,PlayVO,mvm\mvm_tele_activate.wav,0,1"
                "OnTrigger"  "heylook,show,,0,1"
            }
            training_annotation
            {
                "targetname"   "heylook"
                "display_text" "The boss will teleport in from here!"
                "lifetime"     "8"
                "origin"       "1454 -1261 -231"
            }
            
