                "targetname" "somethingiscoming"
                "OnTrigger"  "itsnotrainingtonight,FadeOut,3,0,-1"
                "OnTrigger"  "forward_station_enable,trigger,,0,-1"
                "OnTrigger"  "forward_station_disable,trigger,,30,-1"
                "OnTrigger"  "tf_gamerules,playvo,w3preboss.mp3,0,-1"
                "OnTrigger"  "bossintro,forcespawn,,0,-1"
                "OnTrigger"  "deploymegadeath,trigger,,32,-1"
                "OnTrigger"  "comehere,show,,0,-1"
                "OnTrigger"  "player,$DisplayTextChat,{99C2D8}???{reset}: YOUR RESILIENCE AMAZES ME,7,-1"
                "OnTrigger"  "player,$DisplayTextChat,{99C2D8}???{reset}: BUT TO SHOW ME YOUR WORTH. YOU WILL FIGHT AN OLD FOE,13,-1"
                "OnTrigger"  "player,$DisplayTextChat,{99C2D8}???{reset}: ONLY THEN WILL YOU TRULY GET MY ATTENTION,20,-1"
                "OnTrigger"  "player,$DisplayTextChat,{99C2D8}???{reset}: IT HAS YEARNED FOR REVENGE. I GRANTED ITS WISH.,27,-1"
                "OnTrigger" "tf_gamerules,PlayVO,vo\mvm_get_to_upgrade01.mp3,0,1"

            }
