			{
				"move speed bonus"	0.3
				"damage force reduction" 0.0
				"airblast vulnerability multiplier" 0.0
				"airblast vertical vulnerability multiplier" 0.0
				"override footstep sound set" 6
				"increase buff duration"	90.0
				"deploy time increased" 0.5
				"rage giving scale" 0.1
			}
		}
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 30
		Where spawnbot_left0
		Where spawnbot_main1
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 90
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Mission
	{
		Objective Sniper
		
		Where spawnbot_right0
