						Name	"{blue}John Runeblade {FFFFFF}has used their {9BBF4D}RECALL{FFFFFF} Power Up Canteen!"
						Delay	0
						Repeats	1
					}
					FireInput [$SIGSEGV]
					{
						Target "player"
						Action "$PlaySoundToSelf"
						Param "=40|mvm/mvm_used_powerup.wav"
						Delay 0
						Repeats 1
					}
					FireInput [$SIGSEGV]
					{
						Target "!self"
						Action "$TeleportToEntity"
						Param "bossteleport"
						Delay 0
						Cooldown 1
						Repeats 1
					}
				}
				useRecall_2 [$SIGSEGV]
				{
					ItemAttributes
					{
						ItemName "Three-Rune Blade"
						"damage bonus" 10
						"hit self on miss" 0
						"damage causes airblast" 1
						"bleeding duration" 10
						"mark for death" 1
					}
					CharacterAttributes
					{
						"damage force reduction" 0
						"airblast vulnerability multiplier" 0
						"override footstep sound set" 5
						"move speed bonus" 1.7
						"melee range multiplier" 1.2
						"displace touched enemies" 1
					}
					Message [$SIGSEGV]
					{
						Name	"{blue}John Runeblade {FFFFFF}has used their {9BBF4D}RECALL{FFFFFF} Power Up Canteen!"
						Delay	0
						Repeats	1
					}
					FireInput [$SIGSEGV]
					{
						Target "player"
						Action "$PlaySoundToSelf"
						Param "=40|mvm/mvm_used_powerup.wav"
						Delay 0
						Repeats 1
					}
					FireInput [$SIGSEGV]
					{
						Target "!self"
