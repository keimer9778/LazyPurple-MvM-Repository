// Start: 1200
// Wave 1: 1200	+ [850 + 100] = 2150
// Wave 2: 2150 + [900 + 100] = 3150
// Wave 3: 3150 + [850 + 100] = 4100
// Wave 4: 4100 + [950 + 100] = 5150
// Wave 5: 5150 + [500] 	  = 5650 

WaveSchedule
{
	MaxSpeedLimit	1000 [$SIGSEGV]

	PointTemplates [$SIGSEGV]
	{
		textualtimer_v3
		{
            info_target
            {
                "targetname" "bossteleport"
                "origin" "-1878 2000 -800"
            }
		}
		boss_logic
		{
			OnSpawnOutput
			{
				Target "Title"
				Action "Trigger"
				Delay 0.1
			}
            logic_relay
            {
                "targetname" "Title"
                "OnTrigger"  "upper_text,Display,,0,1"
                "OnTrigger"  "text_lower,Display,,1	,1"
                
            }
			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "upper_text"
				"message" "PHANTOM OF THE SEA PEOPLE"
				"x" "-1"
				"y" "0.4"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 255"
				"fxtime" "0.2"
				//"fadein" "0.6"
				"fadeout" "1"
				"holdtime" "4"
			}
			game_text
			{
				"origin" "1984 1984 99999"
				"targetname" "text_lower"
				"message" "JOHN RUNEBLADE"
				"x" "-1"
				"y" "0.45"
				"channel" "0"
				"spawnflags" "1"
				"color" "255 116 0"
				"fadein" "0.6"
				"fadeout" "1"
				"holdtime" "2.2"
			}
		}
	}

	StartingCurrency				1200
	// Initial test will provide $1200. Add or subtract as needed!
	RespawnWaveTime 				7
	CanBotsAttackWhileInSpawnRoom	No
	MaxSpeedLimit 1000 [$SIGSEGV]

	Templates
	{
		T_TFBot_Giant_Scout_Boss_John_Runeblade
		{
			Class Scout
			Name "John Runeblade"
			ClassIcon scout_runeblade_hyper
			Health 40000
			Scale 2.2
			Skill Expert
			WeaponRestrictions MeleeOnly
			Attributes MiniBoss
			Attributes UseBossHealthBar
			Tag dontdoublehp
			Tag dontdoublehp_damageres
			Item "Three-Rune Blade"
			Item "Athenian Attire"
			Item "The Crown of the Old Kingdom"
			ItemAttributes
			{
				ItemName "Three-Rune Blade"
				"damage bonus" 10
				"hit self on miss" 0
				"damage causes airblast" 1	// Bro this practically does nothing
				"bleeding duration" 10
				"mark for death" 1
			}
			CharacterAttributes
			{
				"damage force reduction" 0
				"airblast vulnerability multiplier" 0
				"override footstep sound set" 5
				"move speed bonus" 1
				"melee range multiplier" 1.2
				"displace touched enemies" 1
			}
			ChangeAttributes [$SIGSEGV]
			{
				Name "useRecall_1"
				Delay 0
				Repeats 1
				IfHealthBelow 30000
			}
			ChangeAttributes [$SIGSEGV]
			{
				Name "useRecall_2"
				Delay 0
				Repeats 1
				IfHealthBelow 20000
			}
			ChangeAttributes [$SIGSEGV]
			{
				Name "useRecall_3"
				Delay 0
				Repeats 1
				IfHealthBelow 10000
			}
			EventChangeAttributes
			{
				useRecall_1 [$SIGSEGV]
				{
					ItemAttributes
