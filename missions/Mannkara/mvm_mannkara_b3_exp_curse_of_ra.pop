#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 750
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Sounds //

	PrecacheSound "music/curseofra/penultimatum.mp3"

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "

                        Convars.SetValue(`tf_playergib`, 0)

						EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)
						EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)
						EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
						IncludeScript(`tankextensions/combattank_weapons/railgun`)
						IncludeScript(`tankextensions/helicopter`)
					  "
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		MissionPT
		{
			logic_relay
			{
				"targetname" "TankStopRelay"
				"OnTrigger" "tank_boss*,SetSpeed,0,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`doors/heavy_metal_stop1.wav`);EmitSoundEx({sound_name=`doors/heavy_metal_stop1.wav`,pitch = 90,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`hl1/ambience/steamburst1.wav`);EmitSoundEx({sound_name=`hl1/ambience/steamburst1.wav`,pitch = 100,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankMoveRelay"

				"OnTrigger" "tank_boss*,SetSpeed,15,0,-1"
				"OnTrigger" "tank_boss*,SetSpeed,35,1.5,-1"
				"OnTrigger" "tank_boss*,SetSpeed,50,3,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}
		}

		MissionNamePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Expert) Curse of Ra`)
					  "
			}
		}

		//// Combat Tank Boss PT ////

		CombatTankBossPT
		{
			OnSpawnOutput
			{
				Target BossSetupRelay
				Action Trigger
			}

			logic_relay
			{
				"targetname" "BossSetupRelay"

				"OnTrigger" "TankStopRelay,Trigger,,10,-1"
				"OnTrigger" "CombatTankBoss,AddOutput,OnHealthBelow90Percent TankMoveRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "CombatTankBoss,AddOutput,OnHealthBelow60Percent TankPhase2Relay:Trigger::0:-1,0,-1"
				"OnTrigger" "CombatTankBoss,AddOutput,OnHealthBelow30Percent TankPhase3Relay:Trigger::0:-1,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,music/curseofra/penultimatum.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,music/curseofra/penultimatum.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,music/curseofra/penultimatum.mp3,0,-1"
			}

			logic_relay
			{
				"targetname" "TankPhase2Relay"

				"OnTrigger" "CombatTankBoss,SetSpeed,0,0,1"
				"OnTrigger" "tf_point_weapon_mimic*,AddOutput,Crits 1,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`hl1/ambience/steamburst1.wav`);EmitSoundEx({sound_name=`hl1/ambience/steamburst1.wav`,pitch = 100,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_FIRE_DELAY = 0.25})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_SND_FIRE = `MVM.GiantSoldierRocketShootCrit`});TankExt.PrecacheSound(COMBATTANK_ROCKETPOD_SND_FIRE)0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROTATE_SPEED_DEFAULT = 1.4})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1})0-1"

				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_crits.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_crits.wav,2,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`npc/strider/striderx_alert6.wav`);EmitSoundEx({sound_name=`npc/strider/striderx_alert6.wav`,pitch = 85,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 2000})3-1"
			}

			logic_relay
			{
				"targetname" "TankPhase3Relay"

				"OnTrigger" "CombatTankBoss,SetSpeed,0,0,1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`hl1/ambience/steamburst1.wav`);EmitSoundEx({sound_name=`hl1/ambience/steamburst1.wav`,pitch = 100,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_ROCKET_DAMAGE = 180})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_ROCKET_SPEED = 1350})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_FIRE_DELAY = 0.2})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_RELOAD_DELAY = 0.5})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROCKETPOD_PARTICLE_TRAIL = `scorchshot_trail_crit_blue`})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_ROTATE_SPEED_DEFAULT = 2})0-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 1})0-1"

				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_knockout.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_knockout.wav,2,-1"
				"OnTrigger" "CombatTankBoss,Color,128 0 0,3,1"
				"OnTrigger" "@c@CombatTankBoss,Color,128 0 0,3,1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`npc/combine_gunship/ping_patrol.wav`);EmitSoundEx({sound_name=`npc/combine_gunship/ping_patrol.wav`,pitch = 85,filter_type=5})3-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ambient/alarms/razortrain_horn1.wav`);EmitSoundEx({sound_name=`ambient/alarms/razortrain_horn1.wav`,pitch = 85,filter_type=5})3-1"
				"OnTrigger" "BigNetRunScriptCodeTankExt.SetValueOverrides({COMBATTANK_MAX_RANGE = 2000})3-1"
				"OnTrigger" "CombatTankBoss,SetSpeed,75,4,1"
			}
		}
	}
	

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "MissionPT"
	SpawnTemplate "MissionNamePT"

