	//// ROBOT TEMPLATES ////

	Templates
	{
		T_TFBot_Sniper_SMG
		{
			Name "SMG Sniper"
			Class Sniper
			ClassIcon sniper_smg_tind
			Skill Easy
			WeaponRestrictions SecondaryOnly
		}
		T_TFBot_Soldier_Bison
		{
			Name "Bison Soldier"
			Class Soldier
			ClassIcon soldier_bison
			Skill Expert
			WeaponRestrictions SecondaryOnly

			Item "The Righteous Bison"
		}
		T_TFBot_Pyro_Airblast
		{
			Class Pyro
			ClassIcon pyro_reflect_daan_nolod
			Skill Expert
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		BeginAtWave 1
		RunForThisManyWaves 7
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	Mission // Razorback Sniper (Wave 1)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper_Razorback
		}
	}

	Mission // Sniper (Wave 2)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission // Engineer (Wave 2-3)
	{
		Objective Engineer
		Where spawnbot
		BeginAtWave 2
		RunForThisManyWaves 2
		InitialCooldown 45
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter_TeleIn

			TeleportWhere spawnbot
		}
	}
	Mission // Spy (Wave 4-5)
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 4
		RunForThisManyWaves 2
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission // Sniper (Wave 5)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 5
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}

	//// WAVES ////

	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 10 Scatter-Bonk Scouts
		{
			Name "Wave1_Subwave1_ScatterBonks"
			Where spawnbot_main
			TotalCount 30
			MaxActive 15
			SpawnCount 10
			WaitBeforeStarting 0
			WaitBetweenSpawns 10
			TotalCurrency 40

			TFBot
			{
				Template T_TFBot_Scout_Bonk_Scatter
				Action Mobber
			}
		}

		WaveSpawn // 12 Demomen and 12 Quick-Uber Medics
		{
			Name "Wave1_Subwave1_Demomen"
			Where spawnbot_main
			TotalCount 24
			MaxActive 9
			SpawnCount 6
			WaitBeforeStarting 3
			WaitBetweenSpawns 8
			TotalCurrency 60

			Squad
			{
				TFBot
				{
					Class Demoman
					Skill Hard
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}

		WaveSpawn // 8 Dive-Bomber Soldiers
		{
			Name "Wave1_Subwave1_DiveBombers"
			Where spawnbot_flank
			TotalCount 8
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 3
			WaitBetweenSpawns 8
			TotalCurrency 50

			TFBot
			{
				Template T_TFBot_Soldier_DiveBomber [$SIGSEGV]
			}
		}

		// Subwave 2
		WaveSpawn // 2 GCharged Soldiers
		{
			Name "Wave1_Subwave2_GChargedSoldier"
			WaitForAllSpawned "Wave1_Subwave1_Demomen"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 8
			WaitBetweenSpawns 16
			TotalCurrency 60

			TFBot
			{
				Template T_TFBot_Giant_Soldier_Crit
			}
		}
		WaveSpawn // 21 Fury Pyros
		{
			Name "Wave1_Subwave2_FuryPyros"
			WaitForAllSpawned "Wave1_Subwave1_Demomen"
			Where spawnbot_flank
			TotalCount 21
			MaxActive 9
			SpawnCount 3
			WaitBeforeStarting 8
			WaitBetweenSpawns 4
			TotalCurrency 60

			TFBot
			{
				Template T_TFBot_Pyro_Dragon_Fury
				Skill Easy
			}
		}

		WaveSpawn // 2 GCharged Soldiers
		{
			Name "Wave1_Subwave2_GChargedSoldier2"
			WaitForAllSpawned "Wave1_Subwave2_GChargedSoldier"
			Where spawnbot
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 8
			WaitBetweenSpawns 16
			TotalCurrency 60

			TFBot
			{
				Template T_TFBot_Giant_Soldier_Crit
			}
		}
		WaveSpawn // 21 Fury Pyros
		{
			Name "Wave1_Subwave2_FuryPyros"
			WaitForAllSpawned "Wave1_Subwave2_GChargedSoldier"
			Where spawnbot_flank
			TotalCount 21
			MaxActive 9
			SpawnCount 3
			WaitBeforeStarting 8
			WaitBetweenSpawns 4
			TotalCurrency 60

			TFBot
			{
				Template T_TFBot_Pyro_Dragon_Fury
				Skill Easy
			}
		}
		WaveSpawn // 6 Demoknights and 12 Big-Heal Medics
		{
			Name "Wave1_Subwave2_Demoknights"
			WaitForAllSpawned "Wave1_Subwave2_GChargedSoldier"
			Where spawnbot_main
			TotalCount 18
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 8
			WaitBetweenSpawns 10
			TotalCurrency 40

			Squad
			{
				TFBot
				{
					Template T_TFBot_Demoman_Knight
					Attributes AlwaysCrit
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}

		// Subwave 3
		WaveSpawn // 1 GBurst Shotgun Heavy and 2 Full-Uber Medics
		{
			Name "Wave1_Subwave3_GBurstShotgunHeavy"
			WaitForAllSpawned "Wave1_Subwave2_GChargedSoldier2"
			Where spawnbot_main
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 16
			WaitBetweenSpawns 0
			TotalCurrency 60

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavy_Shotgun_Burst
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}
		WaveSpawn // 8 Demomen
		{
			Name "Wave1_Subwave3_Demomen"
			WaitForAllSpawned "Wave1_Subwave3_GBurstShotgunHeavy"
			Where spawnbot
			TotalCount 8
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 8
			TotalCurrency 40

			TFBot
			{
				Class Demoman
				Skill Hard
			}
		}
		WaveSpawn // 15 Bowmen
		{
			Name "Wave1_Subwave3_Bowmen"
			WaitForAllSpawned "Wave1_Subwave3_GBurstShotgunHeavy"
			Where spawnbot
			TotalCount 15
			MaxActive 9
			SpawnCount 3
			WaitBeforeStarting 2
			WaitBetweenSpawns 3
			TotalCurrency 40

			TFBot
			{
				Template T_TFBot_Sniper_Huntsman
			}
		}

		WaveSpawn // 1 GBurst Shotgun Heavy and 2 Full-Uber Medics
		{
			Name "Wave1_Subwave3_GBurstShotgunHeavy2"
			WaitForAllSpawned "Wave1_Subwave3_GBurstShotgunHeavy"
			Where spawnbot_main
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 18
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavy_Shotgun_Burst
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}
		WaveSpawn // 4 Demomen
		{
			Name "Wave1_Subwave3_Demomen2"
			WaitForAllSpawned "Wave1_Subwave3_GBurstShotgunHeavy2"
			Where spawnbot
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 0
			TotalCurrency 40

			TFBot
			{
				Class Demoman
				Skill Hard
			}
		}
		WaveSpawn // 6 Bowmen
		{
			Name "Wave1_Subwave3_Bowmen2"
			WaitForAllSpawned "Wave1_Subwave3_GBurstShotgunHeavy2"
			Where spawnbot
			TotalCount 6
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 2
			WaitBetweenSpawns 1
			TotalCurrency 40

			TFBot
			{
				Template T_TFBot_Sniper_Huntsman
			}
		}
	}
	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 GBurst Soldier and 1 GCharged Medic
		{
			Name "Wave2_Subwave1_GBurstSoldier"
