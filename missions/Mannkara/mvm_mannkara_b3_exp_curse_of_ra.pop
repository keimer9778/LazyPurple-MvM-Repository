	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					TankExt.SetValueOverrides({
						COMBATTANK_ROCKETPOD_FIRE_DELAY = 0.4
						COMBATTANK_ROCKETPOD_RELOAD_DELAY = 0.0001
						COMBATTANK_RAILGUN_COOLDOWN_TIME = 5
						COMBATTANK_RAILGUN_SND_FIRE1 = `)weapons/csgo_awp_shoot_crit.wav`
					})

					TankExt.PrecacheSound(COMBATTANK_RAILGUN_SND_FIRE1)
				  "
		}
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)

					EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)
					EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)
					EntFire(`tf_gamerules`, `$StopVO`, `music/curseofra/penultimatum.mp3`)
                  "
        }

