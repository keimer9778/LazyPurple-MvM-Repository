			logic_relay
            {
                "targetname" "endingline33"
                "OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: What did I expect.,0,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: An utter failure that couldn't even earn his gaze.,2,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: How could I have been even a road bump.,4,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: At least...,7,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: I bought it some time.,9,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: If only a little.,11,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: It will be waiting...,15,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: See ya.,16,-1"
            }
			KeepAlive 1
			logic_relay
            {
                "targetname" "endinglinespecial"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: Maybe you really do care.,0,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: If only a little bit.,2,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: The fact you went down this path.,5,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: Let alone finding it to begin with,7,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: It proves you can see it now; we've reached the inflection point,9,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: The messages...,13,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: The most recent attack on rustvalley facility...,15,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: The rifts reopening suddenly—completely off schedule...,18,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: Gray Gravel's contingency plans are falling into place.,21,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: And Mann Co. will reap the whirlwind for what they've sown.,24,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}The Following Star{FFFFFF}: Ciao.,27,-1"
            }

		}
