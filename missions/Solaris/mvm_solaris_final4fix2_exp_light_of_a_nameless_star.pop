			OnSpawnOutput
            {
                Target bignet
                Action RunScriptCode
               Param "local ent = Entities.FindByClassname(null, `item_teamflag`)
				ent.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)
				if (!(`SetParams` in ent.GetScriptScope())) return
				ent.GetScriptScope().SetParams(
					[`hoptime_max`, 99999],
					[`hoptime_min`, 99999],
					[`hoptimerdisplayclock`, false],
					[`hoprange`, 700.0],
					[`hopheight`, 250.0],
					[`areaheightlimit`, 1400.0],
					[`hopduration`, 90.0]
				)"
			}
		}
