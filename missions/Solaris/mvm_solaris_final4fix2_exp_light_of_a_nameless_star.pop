			logic_relay
            {
                "targetname" "finallyitbegins"
                "OnTrigger" "beginningmusic,PlaySound,,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Good evening everyone,0,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: This is Gray Mann speaking,2,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Is something I wish I could say,5,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Why do we remain fighting after his death?,13,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Why do we have the capacity to think when he never programmed it?,16,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Could you perhaps humor us with an answer?,19,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: Whatever,28,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: You wouldn't care anyway,31,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: You never did,34,-1"
				"OnTrigger" "player,$DisplayTextChat,{Blue}???{FFFFFF}: So let me speak in a language you can understand a little better,37,-1"
            }
			ambient_generic
            {
                "targetname" "bossthemephase1and2"
