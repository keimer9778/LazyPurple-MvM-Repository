				"OnCase12" "starterline6,Trigger,,0,-1"
				"OnCase13" "starterline7,Trigger,,0,-1"
				"OnCase14" "starterline1,Trigger,,0,-1"
                "OnCase15" "starterline2,Trigger,,0,-1"
				"OnCase16" "starterline3,Trigger,,0,-1"
            }
			logic_relay
			{
				"targetname" "starterline1"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Alright,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Lets get started.,3,-1"
			}
			logic_relay
			{
				"targetname" "starterline2"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Don't worry.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: I'll try to make this quick.,3,-1"
			}
			logic_relay
			{
				"targetname" "starterline3"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Don't put on airs.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: I'll be winning this one.,3,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Your stars were bad.,5,-1"
			}
			logic_relay
			{
				"targetname" "starterline4"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Not fully operational yet.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: But It'll be more than enough.,3.5,-1"
			}
			logic_relay
			{
				"targetname" "starterline5"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Metal and magic mix better than you'd think.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Here,3.5,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Let me give you a demonstration.,4.5,-1"
			}
			logic_relay
			{
				"targetname" "starterline6"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Boot sequence successful.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Systems nominal.,3,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: War machine Alpha Tauri preparing to engage.,5,-1"
			}
			logic_relay
			{
				"targetname" "starterline7"
				"OnTrigger"  "player,$DisplayTextChat,{Yellow}NOW PLAYING: Limbus Company OST - Canto 9 Boss 1,0,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Only ashes remain.,1,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: And yet the war continues.,3,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: Both of our leaders are nothing but dust now.,5,-1"
				"OnTrigger"  "player,$DisplayTextChat,{Blue}The Following Star {FFFFFF}: What beautiful irony.,7,-1"
			}
			logic_relay
			{
				"targetname" "bossdesperationstart"
				"OnTrigger" "bossthemephase1and22,StopSound,0,0,-1"
				"OnTrigger" "bossthemephase1and2,StopSound,0,0,-1"
				"OnTrigger" "bossthemephase1and22,Kill,0,0,-1"
				"OnTrigger" "bossthemephase1and2,Kill,0,0,-1"
				"OnTrigger" "bossthemephase3,PlaySound,0,0,-1"
                "OnTrigger" "bossthemephase3,StopSound,0,108.5,-1"
				"OnTrigger" "bossthemephase32,PlaySound,0,0,-1"
                "OnTrigger" "bossthemephase32,StopSound,0,108.5,-1"
				"OnTrigger" "stupidsoundfixer,Trigger,0,108.5,-1"
			}
			logic_relay
			{
				"targetname" "stupidsoundfixer"
				"OnTrigger" "bossthemephase3,Kill,0,0,-1"
				"OnTrigger" "bossthemephase3and4,PlaySound,0,0,-1"
                "OnTrigger" "bossthemephase3and4,StopSound,0,203,-1"
				"OnTrigger" "bossthemephase3and42,PlaySound,0,0,-1"
                "OnTrigger" "bossthemephase3and42,StopSound,0,203,-1"
			}
			logic_relay
            {
                "targetname" "self_refund_relay"
                "OnTrigger" "bignetRunScriptCodeactivator.GrantOrRemoveAllUpgrades(true, true)0-1"
            }
			logic_case
            {
                "targetname" "phasetransitionlines"
                "OnCase01" "transitionline1,Trigger,,0,-1"
                "OnCase02" "transitionline2,Trigger,,0,-1"
            }
