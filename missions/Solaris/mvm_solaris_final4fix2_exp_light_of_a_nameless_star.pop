		MagiaRailGunTemplate
        {
            OnSpawnOutput
            {
                target "grenadetrail"
                action "$SetOwner"
                param "!activator"
                delay "0.01"
            }
            OnSpawnOutput
            {
                target "grenadetrail"
                action "FireUser1"
                param ""
                delay "0.1"
            }
            tf_point_weapon_mimic
            {
               "targetname"       "grenadetrail"
				"Crits" "1"
                "$firetime"      "0.1" //Delay between shots for $StartFiring input
				onuser1 "!self,$startfiring,,0.1,-1"
                onuser1 "!self,fireuser1,,0.1,-1"
				"spawnflags" "1"
				"angles" "0 0 0"
				"origin" "0 0 0"
				"teamnum" "3"
				"Damage" "250"
				"ModelScale" "1"
				"SpeedMax" "0"
				"SpeedMin" "0"
				"SplashRadius" "120"
				"SpreadAngle" "0"
				"WeaponType" "3"
                "$preventshootparent" "1"
				"OnUser4" "!self,DetonateStickies,,0.05,-1"

			}
        }
	}
	
