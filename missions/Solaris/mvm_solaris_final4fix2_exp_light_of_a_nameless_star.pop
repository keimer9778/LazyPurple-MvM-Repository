		}
		InitWaveOutput
        {
            Target wave_start_relay
            Action RunScriptCode
            Param "
			//IncludeScript(`popextensions_main`, getroottable())
            EntFire(`bombpath_holograms_clear_relay`, `trigger`, null, 6)
            EntFire(`bombpath_clearall_relay`, `trigger`, null, 6)
            EntFire(`bombpath_right_relay`,`trigger`, null, 7)
			EntFire(`buildupmusic`, `Trigger`, null, 0.4)
			local ent = Entities.FindByClassname(null, `tf_objective_resource`)
				if (ent)
				{
					ent.AcceptInput(`$SetClientProp$m_iszMvMPopfileName`, `(Exp) Starlight Beyond Infinite`, 1, -1)
				}
			
			 ::IsPlayerUbered <- function(player)
                {
                    if(player == null || !player.IsValid() ||(player.GetClassname() != `player`)|| !player.IsAlive()) return false
                    if(player.InCond(Constants.ETFCond.TF_COND_INVULNERABLE) || player.InCond(Constants.ETFCond.TF_COND_INVULNERABLE_USER_BUFF) || player.InCond(Constants.ETFCond.TF_COND_INVULNERABLE_HIDE_UNLESS_DAMAGED)|| player.InCond(Constants.ETFCond.TF_COND_INVULNERABLE_CARD_EFFECT))
                        return true
                    else
                        return false
                }
			
            "
		}
		Explanation [$SIGSEGV] //le cool lore...
