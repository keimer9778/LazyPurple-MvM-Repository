//mission by randomguy
#base robot_randomguy.pop
#base robot_gatebot_randomguy.pop

WaveSchedule
{
	CanBotsAttackWhileInSpawnRoom no
	RespawnWaveTime	2
	StartingCurrency 4500
	Advanced 1
	AddSentryBusterWhenDamageDealtExceeds 6000
	AddSentryBusterWhenKillCountExceeds	45
	EventPopFile Halloween
	ForceHoliday  2 [$SIGSEGV]
	Templates
	{
	T_TFBot_Soldier_BP
		{
			Class Soldier
			Skill Expert
			Name "Crit Soldier"
			Attributes AlwaysCrit
			ItemAttributes 
			{
				ItemName "TF_WEAPON_ROCKETLAUNCHER"
				"damage bonus"	2.0
				"faster reload rate" -0.8
				"fire rate bonus" 0.6
			}
		}
	T_TFBot_Pyro_BP
		{
			Class Pyro
			Skill Expert
			Name "Crit Pyro"
			Attributes AlwaysCrit
			ItemAttributes 
			{
				ItemName "TF_WEAPON_FLAMETHROWER"
				"damage bonus"	2.0
			}
			CharacterAttributes
			{
				"move speed bonus"	1.5
			}
		}
	boss
		{
			Class Demoman
			Name "HellBringer"
			Item "Rimmed Raincatcher"
			ClassIcon demo_bomber
			Health 100000
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Item "The Loose Cannon"
			Attributes MiniBoss Tag bot_giant
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			Attributes AlwaysFireWeapon
			Attributes AlwaysCrit

			ItemAttributes
			{
				ItemName "The Loose Cannon"
				"grenade launcher mortar mode" 0
				"faster reload rate" 1
				"fire rate bonus" 0.5
				"clip size penalty" 0.5
				"Projectile speed increased" 0.8
				"projectile spread angle penalty" 5
				"damage bonus" 1000
				"damage causes airblast" 1
				"blast radius increased" 1.5
				"use large smoke explosion" 1
			}

			CharacterAttributes
			{
				"move speed bonus"	0.3
				"damage force reduction" 0.0
				"airblast vulnerability multiplier" 0.0
				"override footstep sound set" 4
			}
		}
	}
	
	Mission
	{
		Objective Spy

		InitialCooldown 60
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 90
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Mission
	{
		Objective Sniper
		
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 90
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	
	Mission
	{
		Objective	DestroySentries
		
		Where spawnbot
		InitialCooldown 120
		CooldownTime 45
		BeginAtWave 1
		RunForThisManyWaves 10
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	
