		WaveSpawn
		{
			Name "gatecloser"
			Where spawnbot_mid0
			Support 1
			FirstSpawnOutput
			{
				Target cap_a
				Action RunScriptCode
				Param
				"
					MyCapTeam2 <- function()
					{
						EntFire(`fancywoodgate_b`, `Close`)
						EntFire(`gate_b_blocker`, `Enable`)
						EntFire(`spawnbot_main_slow1`, `Disable`)
						EntFire(`nav_interface`, `RecomputeBlockers`)
					}
					self.ConnectOutput(`OnCapTeam2`, `MyCapTeam2`)
				"
			}
		}
		WaveSpawn
		{
			Name "vscript"
			Where spawnbot_mid0
			Support 1
			FirstSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
				::SentryHook <-
				{
					function CleanUp()
					{
						delete ::SentryHook;
					}

					function OnGameEvent_recalculate_holidays(params)
					{
						CleanUp();
					}

					function OnGameEvent_mvm_wave_complete(params)
					{
						CleanUp();
					}

					function OnGameEvent_player_builtobject(params)
					{
						local player = GetPlayerFromUserID(params.userid)
						if (player == null || !player.IsValid() || !player.IsBotOfType(TF_BOT_TYPE))
						{
							return;
						}

						if (params.object != 2)
						{
							return;
						}
						local object = EntIndexToHScript(params.index);

						if (player.HasBotTag(`mini_skin_fix`) && NetProps.GetPropBool(object, `m_bMiniBuilding`))
						{
							object.ValidateScriptScope();
							local scope = object.GetScriptScope();
							scope.Downgraded <- false;
							scope.Think <- function()
							{
								if (!scope.Downgraded && NetProps.GetPropInt(object, `m_iUpgradeLevel`) > 1)
								{
									object.SetSkin(1);
									scope.Downgraded = true;
								}
								return 0;
							}
							AddThinkToEnt(object, `Think`);
						}

						if (!player.HasBotTag(`wrangler_shield`))
						{
							return;
						}

						local shield = SpawnEntityFromTable(`prop_dynamic`, {
							origin = object.GetOrigin(),
							model = `models/buildables/sentry_shield.mdl`,
							skin = object.GetTeam() == 3 ? 1 : 0
						});
						shield.AcceptInput(`SetParent`, `!activator`, object, null);

						local target = Entities.FindByName(null, `sentry_shield_particle_control_point`);
						if (target == null || !target.IsValid())
						{
							target = SpawnEntityFromTable(`info_target` {
								targetname = `sentry_shield_particle_control_point`,
								origin = Vector(50, 150, 255)
							});
						}

						local particle = SpawnEntityFromTable(`info_particle_system`, {
							origin = object.GetOrigin() + Vector(0.0, 0.0, 30.0),
							effect_name = `turret_shield`,
							cpoint1 = `sentry_shield_particle_control_point`,
							start_active = 1
						});
						particle.AcceptInput(`SetParent`, `!activator`, object, null);
					}
				}
				__CollectGameEventCallbacks(SentryHook);
				"
			}
		}
		
