		StartWaveOutput
		{
			Target wave_start_relay_expert
			Action Trigger
		}

		DoneOutput					
		{
			Target wave_finished_relay
			Action Trigger
		}	

		WaveSpawn
		{
			Name "exploding_tank"
			FirstSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "

					EmitSoundEx //extra failsafe
					({
						sound_name = `vehicles/v8/v8_turbo_on_loop1.wav`
						flags = 0x4 // SND_STOP
					})

					local custom_rocket = `models/bots/boss_bot/combat_tank_mk2/mk2_rocket_dumbfire.mdl`;
					local custom_rocket_index = PrecacheModel(custom_rocket);

					::Think_CustomRocket <- function()
					{
						for (local ent; ent = Entities.FindByClassname(ent, `tf_projectile_rocket`);)
						{
							if (ent.GetOwner() != self || NetProps.GetPropInt(ent, `m_nModelIndex`) == custom_rocket_index)
								continue
							
							NetProps.SetPropString(ent, `m_ModelName`, custom_rocket)
							NetProps.SetPropInt(ent, `m_nModelIndex`, custom_rocket_index)
							ent.SetSequence(1)

							local particle = Entities.CreateByClassname( `trigger_particle` )
							particle.KeyValueFromString( `particle_name`, `flaming_arrow` )
							particle.KeyValueFromInt( `attachment_type`, 1 )
							particle.KeyValueFromInt( `spawnflags`, 64 )
							particle.AcceptInput( `StartTouch`, `!activator`, ent, ent )
							particle.Kill()

							local particle2 = Entities.CreateByClassname( `trigger_particle` )
							particle2.KeyValueFromString( `particle_name`, `rockettrail` )
							particle2.KeyValueFromInt( `attachment_type`, 1 )
							particle2.KeyValueFromInt( `spawnflags`, 64 )
							particle2.AcceptInput( `StartTouch`, `!activator`, ent, ent )
							particle2.Kill()

						}
						return -1
					}

					::CALLBACKS <- {}
					::CALLBACKS.OnGameEvent_player_spawn <- function( params )
					{
						local bot = GetPlayerFromUserID( params.userid )
						if ( params.team != 3 || !bot.IsBotOfType( 1337 ) )
							return

						EntFireByHandle( bot, `RunScriptCode`, `if ( self.HasBotTag( \`customrocket\` ) ) AddThinkToEnt( self, \`Think_CustomRocket\` )`, -1, null, null )
					}
					::CALLBACKS.OnGameEvent_player_death <- function( params )
					{
						local player = GetPlayerFromUserID( params.userid )
						if ( !player.IsBotOfType( 1337 ) )
							return

						AddThinkToEnt( player, null )
					}

					__CollectGameEventCallbacks( ::CALLBACKS )

					TankExt.NewTankType(`tankexplosion`, 
					{
						function OnDeath()
						{
							local flDamage = 600
							local flRange  = Convars.GetFloat(`tf_bot_suicide_bomb_range`) * 1.5

							local vecOrigin = self.GetOrigin()
							local vecCenter = self.GetCenter()

							DispatchParticleEffect(`explosionTrail_seeds_mvm`, vecOrigin, Vector(1))
							DispatchParticleEffect(`fluidSmokeExpl_ring_mvm`, vecOrigin, Vector(1))
							ScreenShake(vecOrigin, 25, 5, 5, 1000, SHAKE_START, false)

							local EntityArray = []
							foreach(sClassname in [`player`, `obj_sentrygun`, `obj_dispenser`, `obj_teleporter`])
								for(local hEnt; hEnt = FindByClassnameWithin(hEnt, sClassname, vecOrigin, flRange);)
									EntityArray.append(hEnt)

							foreach(hEnt in EntityArray)
								if(hEnt.IsAlive())
								{
									local vecEntCenter = hEnt.GetCenter()
									local Trace = 
									{
										start = vecCenter
										end   = vecEntCenter
										mask  = MASK_SOLID_BRUSHONLY

										startsolid = false
										allsolid   = false
									}
									TraceLineEx(Trace)
									if(!(Trace.fraction < 1 || Trace.allsolid || Trace.startsolid))
									{
										if(hEnt.IsPlayer())
											ScreenFade(hEnt, 255, 255, 255, 255, 1, 0.1, FFADE_IN)

										hEnt.TakeDamageEx(First(), null, null, Vector(), Vector(), flDamage, DMG_BLAST)
									}
								}
						}
					})"
			}
		}

