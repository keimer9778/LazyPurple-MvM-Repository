				Param "
					::TAG <- `bot_teleported`
					EntityOutputs.AddOutput(Entities.FindByName(null, `cap_a`), `OnCapTeam2`, `bignet`, `runscriptcode`, @`
					for (local i = 1; i <= MaxClients().tointeger(); i++)
					{
						local hEnt = PlayerInstanceFromIndex(i)
						if (hEnt && hEnt.IsAlive() && hEnt.IsBotOfType(1337) && hEnt.HasBotTag(TAG))
