	Wave //WAVE 1 //1000$
	{
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "
				PrecacheSound(`#ui/gamestartup10.mp3`)
				SetSkyboxTexture(`sky_dustbowl_01`)

				Convars.SetValue(`tf_forced_holiday`, 8) //0
				Convars.SetValue(`tf_airblast_cray`, 1)	
				Convars.SetValue(`tf_allow_sliding_taunt`, 0)
				Convars.SetValue(`tf_allow_player_use`, 0)

				Convars.SetValue(`tf_bot_flag_escort_max_count`, 4)	
				Convars.SetValue(`tf_mvm_bot_sniper_target_by_dps`, 1)
				Convars.SetValue(`tf_bot_suspect_spy_touch_interval`, 5)

				EntFire(`game_text_tf`,`kill`)
	
				//ClientPrint( null, 3, `\x0799CCFFYou may adjust \x07F5E042music \x0799CCFFvolume using \x07F5E042snd_musicvolume \x0799CCFFin the console` )

				NetProps.SetPropEntity(Entities.FindByName(null, `cap_a_trigtimer`),`m_hFilter`,Entities.FindByName(null, `filter_blue_bombhat`))
				NetProps.SetPropEntity(Entities.FindByName(null, `cap_b_trigtimer`),`m_hFilter`,Entities.FindByName(null, `filter_blue_bombhat`))

				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/combattank`, getroottable())
				IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())

				TankExt.SetValueOverrides({ COMBATTANK_MAX_RANGE = 5000 })

