					team = 255
				})
				SendGlobalGameEvent(`teamplay_broadcast_audio`, 
				{
					sound = `#ui/gamestartup17.mp3`
					additional_flags = 0x4 // SND_STOP
					team = 255
				})

				PrecacheSound(`#ui/gamestartup15.mp3`)
				SetSkyboxTexture(`sky_gravel_01`)

				Convars.SetValue(`tf_forced_holiday`, 8)
				Convars.SetValue(`tf_airblast_cray`, 0)
				Convars.SetValue(`tf_allow_sliding_taunt`, 1)
				Convars.SetValue(`tf_allow_player_use`, 1)

				Convars.SetValue(`tf_bot_flag_escort_max_count`, 0)
				Convars.SetValue(`tf_mvm_bot_sniper_target_by_dps`, 0)
				Convars.SetValue(`tf_bot_suspect_spy_touch_interval`, 0)

				EntFire(`game_text_tf`,`kill`)

				NetProps.SetPropEntity(Entities.FindByName(null, `cap_a_trigtimer`),`m_hFilter`,Entities.FindByName(null, `filter_blue_bombhat`))
				NetProps.SetPropEntity(Entities.FindByName(null, `cap_b_trigtimer`),`m_hFilter`,Entities.FindByName(null, `filter_blue_bombhat`))

				ClientPrint( null, 3, `\x0799CCFFKeep the \x07F5E042medics \x0799CCFFseparated from their boss using any \x07F5E042knockback` )

				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/ubertank`, getroottable())

				TankExt.AddTankIcon(1, `tank_uber_lite`, `ubertank|0|999^tankexplosion`)

				TankExt.SetValueOverrides({ UBERTANK_SND_UBER = `mvm/mvm_tank_start.wav` })

				for (local kit; kit = Entities.FindByClassname(kit, `item_healthkit_medium`);)
				{
					NetProps.SetPropIntArray(kit, `m_nModelIndexOverrides`, PrecacheModel(`models/items/medkit_medium.mdl`), 0)
					NetProps.SetPropIntArray(kit, `m_nModelIndexOverrides`, 0, 1)
					NetProps.SetPropIntArray(kit, `m_nModelIndexOverrides`, 0, 2)
				}

				SendGlobalGameEvent(`teamplay_broadcast_audio`, 
				{
					sound = `#ui/gamestartup15.mp3`
					additional_flags = 0x4 // SND_STOP
					team = 255
				})
				SendGlobalGameEvent(`teamplay_broadcast_audio`, 
				{
					sound = `#ui/gamestartup15.mp3`
					additional_flags = 0x4 // SND_STOP
					team = 255
				})
			"
