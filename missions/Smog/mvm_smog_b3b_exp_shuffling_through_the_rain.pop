//#base custom_robot_spec_redux.pop
//#base localization_smog.pop
//#base custom_weapon_spadmin.pop

WaveSchedule
{
    StartingCurrency 1500
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 6
    FixedRespawnWaveTime Yes
    AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15
    Advanced 1

    Mission
	{
		Where	spawnbot
        Objective	DestroySentries
		BeginAtWave	1
		RunForThisManyWaves	3
		InitialCooldown	45
		CooldownTime	50
		DesiredCount	1

		TFBot
		{
			Template	T_TFBot_Sentry_Buster_vanilla
		}
	}

    Mission
    {
        Where spawnbot_flank
        Objective Sniper
        BeginAtWave 1
        RunForThisManyWaves 1
        DesiredCount 2
    
        InitialCooldown 30
        CooldownTime 35
    
        TFBot
        {
            Template T_TFBot_Sniper_sydney_vanilla
        }
    }

    Mission
    {
        Where spawnbot_flank
        Objective Spy
        BeginAtWave 2
        RunForThisManyWaves 1
        DesiredCount 2
    
        InitialCooldown 10
        CooldownTime 45
    
        TFBot
        {
            Template T_TFBot_Spy_stock
            Item "KF Pyro Mask"
            ItemAttributes
            {
                ItemName "KF Pyro Mask"
                "set item tint RGB" "2960676"
            }
        }
    }

    Mission
    {
        Where spawnbot_flank
        Objective Engineer
        BeginAtWave 2
        RunForThisManyWaves 1
        DesiredCount 1
    
        InitialCooldown 40
        CooldownTime 30
    
        TFBot
        {
            Template T_TFBot_Engineer_teleporter_vanilla
            TeleportWhere spawnbot
            TeleportWhere spawnbot_flank
            Item "KF Pyro Mask"
            ItemAttributes
            {
                ItemName "KF Pyro Mask"
                
                "set item tint RGB" "2960676"
            }
        }
    }

    Mission
    {
        Where spawnbot_flank
        Objective Spy
        BeginAtWave 3
        RunForThisManyWaves 1
        DesiredCount 2
    
        InitialCooldown 40
        CooldownTime 50
    
        TFBot
        {
            Template T_TFBot_Spy_stock
            Item "KF Pyro Mask"
            ItemAttributes
            {
                ItemName "KF Pyro Mask"
                
                "set item tint RGB" "2960676"
            }
        }
    }

    Templates 
    {
        T_TFBot_Giant_Medic_big_heal // - 官方模板的优化。只能治疗，没有Uber。
        {
            Class Medic
			Name "Giant Medic"
			ClassIcon medic
			Skill Expert
			Health 4500
			Item "The Quick-Fix"
			Attributes MiniBoss
            Tag bot_giant
			ItemAttributes
			{
				ItemName "The Quick-Fix"
				"ubercharge rate bonus" 0.01 // pretty much disables ubercharge
			}
			ItemAttributes
			{
				ItemName "TF_WEAPON_SYRINGEGUN_MEDIC"
				"damage penalty" 0.1
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"heal rate bonus" 200
			}
        }
        T_TFBot_Medic_Uber // - 官方模板的优化。
		{
			Class Medic
			Name "Uber Medic"
			ClassIcon medic_uber
			Skill Hard
			Attributes SpawnWithFullCharge
            ItemAttributes
            {
                ItemName "TF_WEAPON_MEDIGUN"
                "ubercharge rate bonus" 0.01
            }
			ItemAttributes
			{
				ItemName "TF_WEAPON_SYRINGEGUN_MEDIC"
				"damage penalty" 0.1
			}
		}
        T_TFBot_Sniper_bow_conch // [custom icon] - 提供征服者战旗效果的弓箭手。
