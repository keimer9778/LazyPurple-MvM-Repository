#base robot_giant.pop
#base robot_standard.pop
#base robot_click.pop
#base robot_click_giant.pop
#base robot_lazypurple.pop

// A reference list for spawn locations and the starting tank path.
// ----------------------------------------------------------------
// spawnbot (main side)
// spawnbot_flank (left side)
// spawnbot_flank_behind_1 (Gate 1)
// spawnbot_flank_behind_2 (Gate 2)
// spawnbot_flank_behind_3 (Gate 3)
// I'm not using spawn, either of the _limited spawnbots, Ahead, Behind, or Anywhere

// ======================================================================
// Testing Notes:

// WAVE 1:
// 
// 
// 
// 
// 

// WAVE 2:
// 
// 
// 
// 
// 
// 

// WAVE 3:
// The first half seems a little too easy if shield uptime is good, though I think
// for now this is acceptable. We'll see if the first half needs buffing. The second
// half absolutely does not.
// 
// 

// WAVE 4:
// I've set the Giant Deflector + Giant Shield Medic spawn cooldown from 18 -> 20s. We'll see if it really needs to be changed
// to 20s in the next test.
// 
// 

// WAVE 5:
// I may need to remove the last pair of Giant Hyper Pyro + Shield Uber Medic at the end. Not sure, needs another test. If I do,
// I need to lower the Tanker Soldiers TotalCount a little bit to compensate.

// OVERALL THOUGHTS:
// Mission's in a surprisingly good state!
// 
// 
// ======================================================================

WaveSchedule
{
	StartingCurrency				600
	RespawnWaveTime 				1
	FixedRespawnWaveTime			Yes
	CanBotsAttackWhileInSpawnRoom	No
    RobotLimit 26 [$SIGSEGV]

	PointTemplates [$SIGSEGV]
	{
		MissionNamePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Grandmaster) Saturation`)
					  "
			}
		}
	}

	SpawnTemplate "MissionNamePT" [$SIGSEGV]

	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "ClientPrint(null, 3,`\x07E7B53BNOTICE: This mission is in a very early state of testing. Please be patient with its balancing!`)"
		}
		WaitWhenDone 65
		Checkpoint Yes

        // Subwave 1 (maxActive: 26)
        // Giant Rapid Buff Soldier + Uber Medic (8)
        // Giant Sturdy FaN Scout (2)
        // Heavy (8)
		// Soldier (4)
        // Pyro (4)
		WaveSpawn	// 
		{
			Name "wave01aGiant1"
			Where spawnbot
			TotalCount 8
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 8
			TotalCurrency 50
		
			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer_Buff
					CharacterAttributes
					{
						"airblast vertical vulnerability multiplier" 0.2
						"airblast vulnerability multiplier" 0.2
						"damage force reduction" 0.2
					}
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
                TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
                TFBot
				{
					Template T_TFBot_Medic_QuickUber
				}
			}
		}
        WaveSpawn	// 
		{
			Name "wave01aGiant2"
			Where spawnbot_flank
			TotalCount 8
			MaxActive 8
			SpawnCount 4
