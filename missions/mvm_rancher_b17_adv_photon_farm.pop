#base robot_giant.pop
#base robot_standard.pop
#base robot_click_pixelstate.pop
#base robot_click_giant_pixelstate.pop
#base robot_click_updated.pop
#base robot_pixelbitie.pop

//spawn points:
//	spawnbot_main
//	spawnbot_left
//	spawnbot_right
//	spawnbot_center
//	spawnbot_chief

// Start: $1200
// Wave 1: $700 -> $1900 -A> $2000
// Wave 2: $600 -> $2500 -A> $2700
// Wave 3: $700 -> $3200 -A> $3500
// Wave 4: $700 -> $3900 -A> $4300
// Wave 5: $1000 -> $4900 -A> $5400
// Wave 6: $1000 -> $5900 -A> $6500
// Wave 7: $800 -> $6700 -A> $7400

WaveSchedule
{

	StartingCurrency		1200
	RespawnWaveTime 		5
	CanBotsAttackWhileInSpawnRoom no
	
	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 40
		Where spawnbot_main
		BeginAtWave 1
		RunForThisManyWaves 7

		CooldownTime 50           

            TFBot
			{
				Template T_TFBot_SentryBuster
            }
	}

	PointTemplates [$SIGSEGV]
	{
		skyShiftText
		{
			OnSpawnOutput
			{
				Target "skyText"
				Action Trigger
			}
			logic_relay
			{
				"TargetName" "skyText"
				"OnTrigger"  "skyIsShifting,Display,,0,1"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "skyIsShifting"
				"message" "The sky is shifting..."
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "10"
			}
		}
		ufoSpawnText
		{
			OnSpawnOutput
			{
				Target "spawnText"
				Action Trigger
			}
			logic_relay
			{
				"TargetName" "spawnText"
				"OnTrigger"  "messageInvincible,Display,,0,1"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "messageInvincible"
				"message" "The UFO is invincible for now! Defeat the robots!"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "10"
			}
			game_text
			{
				"origin" "10000 10000 10000"
				"TargetName" "messageVulnerable"
				"message" "The UFO's DEFENCE dropped to 0!"
				"x" "-1"
				"y" "0.3"
				"spawnflags" "1"
				"effect" "2"
				"channel" "1"
				"color" "255 255 0"
				"fxtime" "0.2"
				"fadeout" "1"
				"holdtime" "3"
			}
		}
	}
	
	
