	}
	
	Wave
	{
		Checkpoint Yes
		StartWaveOutput
			{
				Target wave_start_relay
				Action Trigger
			}
		InitWaveOutput
		{
			Target	bignet
			Action	RunScriptCode
			Param "
				EntFire(`wave_init_relay_route_l`, `Trigger`, null, 0.5)
				EntFire(`skyShiftText`, `ForceSpawn`, null, 0.0)			// VScript version of spawning the PointTemplate for title text

				// Tankextensions
				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`tankextensions/ufo`, getroottable())
				TankExt.CreatePaths({
				ufo_path_left = [
					Vector(2304, -2496, 688)
					Vector(384, -2560, 1302)
					Vector(64, -1024, 1302)
					Vector(-576, 1920, 1302)
					Vector(-576, 1920, 800)
				]
				})
				ClientPrint(null,3,`\x08FFFF00FFThe sky is shifting...`)
			"
		}
		
		WaveSpawn
		{
			Name w5_ufo
			TotalCount 3
			MaxActive 3
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 45
			TotalCurrency 300
