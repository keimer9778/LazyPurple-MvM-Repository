	WaitWhenDone 65
	Checkpoint Yes
	
	WaveSpawn //WAVE 01c: [TANK1]
	{
		TotalCount 1
		WaitBeforeStarting 0
		TotalCurrency 750

        FirstSpawnOutput                                                                                                                                                            
		{
             Target boss_spawn_relay                                            
             Action Trigger                         
        }

	Tank
		{
			Health 35000
			Speed 75
			Name "boss"
			StartingPathTrackNode "boss_path_b1"

			OnKilledOutput                                  
			{
				Target boss_dead_relay
				Action Trigger                         
			}
			OnBombDroppedOutput                             
			{
				Target boss_deploy_relay 
				Action Trigger                         
			}
		}			
	}	

	WaveSpawn //WAVE 01b: Caberknights
	{
		Where spawnbot_invasion
