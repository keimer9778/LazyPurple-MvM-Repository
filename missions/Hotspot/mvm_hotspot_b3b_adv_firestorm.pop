				ItemName "The Dragon's Fury"
				"speed_boost_on_hit" 5
			}
		}
		
		//Defense Classes
		T_TFBot_Demoknight_Charger
		{
			Class Demoman
			ClassIcon demoknight_claymore_kai
			Item "The Splendid Screen"
