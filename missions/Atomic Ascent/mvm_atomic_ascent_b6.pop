#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop
#base robot_atomicascent.pop
// =============================
// Atomic Ascent Specific Notes
// =============================
//
// Use the following spawnnames:
//
// 	* spawnbot		 -- will dynamically match the arrows or forward spawn
// 	* spawnbot_giant -- always on the road until forward spawn opens
//  		 -- you can use this for any bots you want to spawn on the road
//  * spawnbot_invasion -- random between carrier & road until forward opens
// 
// 	* spawnbot_buster is the same as spawnbot_mission_buster
// 	* spawnbot_mission_sniper
// 	* spawnbot_mission_spy
//
// =============================
WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no
	Mission
	{
		Where spawnbot_buster
		Objective DestroySentries
		InitialCooldown 5
		BeginAtWave 1
		RunForThisManyWaves 7
		CooldownTime 50
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission
	{
		Where spawnbot_mission_spy
		Objective Spy
		InitialCooldown 25
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 25
		BeginAtWave 5
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 20
		BeginAtWave 6
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
		}
	}
	Wave
	{
		InitWaveOutput
		{
			Target atomicRobots
			Action RunScriptFile
			Param "atomicsands/atomicsands_specials.nut"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
		WaveSpawn
		{
			Where spawnbot
			Name "bombbats1"
			TotalCount 15
			MaxActive 5
			SpawnCount 3
			WaitBeforeStarting 0
			WaitBetweenSpawns 4
			TotalCurrency 100
			TFBot
			{
				Template T_AtomicAscent_BombBat_Scout
			}
		}
		WaveSpawn
		{
			Where spawnbot
			Name "gate_crashers"
			TotalCount 10
			MaxActive 5
			SpawnCount 5
			WaitBeforeStarting 5
			WaitBetweenSpawns 4
			TotalCurrency 100
			TFBot
			{
				Template T_TFGateBot_AtomicAscent_Scout
			}
		}
		WaveSpawn
		{
			Where spawnbot_giant
			Name "HeavyPairs"
			TotalCount 6
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 15
			WaitBetweenSpawns 5
			TotalCurrency 200
			Squad
			{
				TFBot
				{
					Template T_TFBot_Heavyweapons_Shotgun
					Tag "gas_station"
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickFix
				}
			}
		}
		WaveSpawn
		{
			Where spawnbot
			Name "bombbats2"
			TotalCount 20
			MaxActive 5
			SpawnCount 3
			WaitForAllDead "gate_crashers"
			WaitBeforeStarting 0
			WaitBetweenSpawns 4
			TotalCurrency 100
			TFBot
			{
				Template T_AtomicAscent_BombBat_Scout
			}
		}
		WaveSpawn
		{
			Where spawnbot_giant
			Name "pyroGiants"
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitForAllDead "gate_crashers"
			WaitBeforeStarting 0
			WaitBetweenSpawns 4
			TotalCurrency 200
			TFBot
			{
				Template T_TFBot_Giant_Pyro
			}
		}
	}
