#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop
#base robot_atomicascent.pop
// =============================
// Atomic Ascent Specific Notes
// =============================
//
// Use the following spawnnames:
//
// 	* spawnbot		 -- will dynamically match the arrows or forward spawn
// 	* spawnbot_giant -- always on the road until forward spawn opens
//  		 -- you can use this for any bots you want to spawn on the road
//  * spawnbot_invasion -- random between carrier & road until forward opens
// 
// 	* spawnbot_buster is the same as spawnbot_mission_buster
// 	* spawnbot_mission_sniper
// 	* spawnbot_mission_spy
//
// =============================
WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no
	Mission
	{
		Where spawnbot_buster
		Objective DestroySentries
		InitialCooldown 5
		BeginAtWave 1
		RunForThisManyWaves 7
		CooldownTime 50
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission
	{
		Where spawnbot_mission_spy
		Objective Spy
		InitialCooldown 25
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 25
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 20
		BeginAtWave 6
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
		}
	}
	Wave
	{
		InitWaveOutput
		{
			Target atomicRobots
			Action RunScriptFile
			Param "atomicsands/atomicsands_specials.nut"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
		WaveSpawn
		{
			Where spawnbot
			Name "fodder"
			TotalCount 30
			MaxActive 10
			SpawnCount 5
			WaitBeforeStarting 0
			WaitBetweenSpawns 5
			TotalCurrency 200
			Squad {
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
				{
					Template T_AtomicAscent_Radioactive_Scout
				}
			}
		}
		WaveSpawn
		{
			Where spawnbot
			Name "gatebots_w1"
			TotalCount 15
			MaxActive 5
			SpawnCount 5
			WaitBeforeStarting 5
			WaitBetweenSpawns 5
			TotalCurrency 100
			TFBot
			{
				Template T_TFGateBot_AtomicAscent_Scout
			}
		}
		WaveSpawn
		{
			Where spawnbot_giant
			Name "giants_gas_roof_w1"
			TotalCount 20
			MaxActive 5
			SpawnCount 5
			WaitBeforeStarting 20
			WaitBetweenSpawns 15
			TotalCurrency 200
			Squad {
				TFBot
				{
					Template T_TFBot_Giant_Pyro
					Tag "gas_station"
				}
				TFBot
				{
					Template T_TFBot_Pyro
					Tag "gas_station"
				}
				TFBot
				{
					Template T_TFBot_Pyro
					Tag "gas_station"
				}
				TFBot
				{
					Template T_TFBot_Pyro
					Tag "gas_station"
				}
				TFBot
				{
					Template T_TFBot_Pyro
					Tag "gas_station"
				}
			}
		}
		WaveSpawn
		{
			Where spawnbot
			Name "gatebots2_w1"
			TotalCount 12
			MaxActive 6
			SpawnCount 6
			WaitForAllDead "gatebots_w1"
			WaitBetweenSpawns 10
			TotalCurrency 200
			Squad {
				TFBot
				{
					Template T_TFGateBot_Heavy_Radioactive
				}
				TFBot
				{
					Template T_TFBot_Medic_QuickFix
				}
			}
		}
	}
	Wave
	{
		InitWaveOutput
		{
			Target atomicRobots
			Action RunScriptCode
			Param "IncludeScript(`atomicsands/atomicsands_specials.nut`)
				   TankExtPacked.AddTankIcon(1, `tank_radioactive`, `Radioactive Tank`)
