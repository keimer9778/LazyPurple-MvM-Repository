	Wave
	{
		InitWaveOutput
		{
			Target atomicRobots
			Action RunScriptCode
			Param "IncludeScript(`atomicsands/atomicsands_specials.nut`)
				   TankExtPacked.AddTankIcon(1, `tank_radioactive`, `Radioactive Tank`)
				   TankExtPacked.AddTankIcon(3, `tank_spam`, `Spammer Tank`)
				  "
		}
		WaveSpawn
		{
			Where spawnbot
