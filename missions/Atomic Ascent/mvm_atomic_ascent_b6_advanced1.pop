			//WaitForAllDead "baby_w3"
			WaitBeforeStarting 0
			TotalCurrency 100
			FirstSpawnOutput
			{
				Target boss_spawn_relay
				Action Trigger
			}

			Tank
			{
				Speed 75
				Health 10000  // these are lightweight tanks
				Name "atomicsands_radioactivetank"
				//ClassIcon tank_radioactive  // just for the purposes of the preview
				StartingPathTrackNode tank_path_b_1
				OnKilledOutput
				{
					Target boss_dead_relay
					Action Trigger
				}
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}
