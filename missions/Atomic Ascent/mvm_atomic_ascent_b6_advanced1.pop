#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop
#base robot_atomicascent.pop
// =============================
// Atomic Ascent Specific Notes
// =============================
//
// Use the following spawnnames:
//
// 	* spawnbot		 -- will dynamically match the arrows or forward spawn
// 	* spawnbot_giant -- always on the road until forward spawn opens
//  		 -- you can use this for any bots you want to spawn on the road
//  * spawnbot_invasion -- random between carrier & road until forward opens
// 
// 	* spawnbot_buster is the same as spawnbot_mission_buster
// 	* spawnbot_mission_sniper
// 	* spawnbot_mission_spy
//
// =============================
WaveSchedule
{
	StartingCurrency 500
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no
	Advanced 1
	Mission
	{
		Where spawnbot_buster
		Objective DestroySentries
		InitialCooldown 5
		BeginAtWave 1
		RunForThisManyWaves 7
		CooldownTime 50
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission
	{
		Where spawnbot_mission_spy
		Objective Spy
		InitialCooldown 25
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 25
		BeginAtWave 3
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission
	{
		Where spawnbot_mission_sniper
		Objective Sniper
		InitialCooldown 20
		BeginAtWave 7
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2
		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
		}
	}
	Wave
	{
		InitWaveOutput
		{
			Target atomicRobots
			Action RunScriptFile
			Param "atomicsands/atomicsands_specials.nut"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		WaitWhenDone 65
		Checkpoint Yes
		WaveSpawn
		{
			Where spawnbot
			Name "fodder_w1"
			TotalCount 40
			MaxActive 10
			SpawnCount 10
			WaitBeforeStarting 0
			WaitBetweenSpawns 15
			TotalCurrency 200
			Squad {
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
				{
					Template T_AtomicAscent_BombBat_Scout_Hard
				}
				TFBot
