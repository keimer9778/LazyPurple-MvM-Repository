		{
			Template        T_TFBot_SentryBuster
				Item "The Last Straw"
				Item "The Mann of the House"
				Name "Hillbilly Buster"
				Tag bot_giant
				CharacterAttributes
			{
				"head scale" 3
                "torso scale" 0.2
                "voice pitch scale" 1.5
			}
		}
	}

