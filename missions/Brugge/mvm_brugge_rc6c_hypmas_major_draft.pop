	Wave
	{
		CustomWaveNumber 1
		CustomMaxWaveNumber 6
		Checkpoint Yes
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		 InitWaveOutput
        {
            Target wave_start_relay
            Action RunScriptCode
            Param "
			EntFire(`tf_objective_resource`, `$SetClientProp$m_iszMvMPopfileName`, `Major Draft (HYPMAS) `)
				::BirdspotSkyBox <- { 
                Cleanup = function() {
             SetSkyboxTexture(`sky_day01_05`)
             delete ::BirdspotSkyBox
                }
            OnGameEvent_recalculate_holidays = function(_) { if (GetRoundState() == 3) Cleanup() }
            OnGameEvent_mvm_wave_complete = function(_) { Cleanup() }
            }
            __CollectGameEventCallbacks(BirdspotSkyBox)
                SetSkyboxTexture(`sky_day01_06`)
                    
            "
		}
		Explanation  
		{
			Line ""
			Line "{12E8EE}This mission contains music that is copyrighted"
			Line "{12E8EE}Music such as: Marvel Tokon: Fighting Souls OST."
			Line "{12E8EE}You can disable the music via Options - Audio - Music Volume."
			Line ""
		}

		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		WaveSpawn
		{
			Where spawnbot_invasion
			Name "BigBot1A"
			TotalCount 6
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 28
			TotalCurrency 150
			Squad
			{
				NoWaitForFormation 1
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer
				}
				TFBot
				{
					Template T_TFBot_Giant_Soldier_Spammer_Reload
				}
			}
		}
		WaveSpawn
