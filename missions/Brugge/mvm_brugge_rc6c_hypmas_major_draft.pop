		wave7countdown
		{
			OnSpawnOutput
            {
				NoFixUp 1
                Target bignet
                Action RunScriptCode
                Param "local hRelay = Entities.CreateByClassname(`logic_relay`), hGameRules = Entities.FindByClassname(null, `tf_gamerules`), iCountdownLast = -1; NetProps.SetPropBool(hRelay, `m_bForcePurgeFixedupStrings`, true); hRelay.ValidateScriptScope(); hRelay.GetScriptScope().Think <- function() { local flRestartRoundTime = NetProps.GetPropFloat(hGameRules, `m_flRestartRoundTime`); if(flRestartRoundTime != -1) { local iCountdown = ceil(flRestartRoundTime - Time()).tointeger(); if(iCountdown != iCountdownLast && iCountdown == 5) EntFire(`fading`, `Trigger`, null, -1, null); iCountdownLast = iCountdown } else iCountdownLast = -1; return -1 } AddThinkToEnt(hRelay, `Think`)"
            }
			logic_relay
			{
				"targetname" fading
				"startdisabled" 1
				"OnTrigger" "fade_in_w1,Fade,,0,-1"
                "OnTrigger" "fade_out_w1,Fade,,4.5,-1"
			}
