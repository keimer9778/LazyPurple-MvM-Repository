population
{
	ClassLimit [$SIGSEGV] //Limits the number of specified classes
    {
		Scout 0
		Soldier 0
        Pyro 0
		Demoman 0
		Heavyweapons 0
		Engineer 0
		Medic 0
		Spy 0
    }
	SpawnTemplate [$SIGSEGV]
		{
			Name "teleportexample"
		}
	StartingCurrency	850
	RespawnWaveTime	5
	AllowBotExtraSlots 1
	RobotLimit 25
	AddSentryBusterWhenDamageDealtExceeds	2000
	AddSentryBusterWhenKillCountExceeds	12
	CanBotsAttackWhileInSpawnRoom	no
	ForceRedMoney 1 [$SIGSEGV]
	ExtraSpawnPoint
	{
       Name "Airdrop"
        TeamNum 3
        X    "-1811.355225"
        Y    "489.016632"
        Z    "409.031311"
	}
	Templates
	{

	}
	PointTemplates	[$SIGSEGV] 
	{
		teleportexample
	{
            NoFixup 1
            KeepAlive 1
            filter_activator_tfteam
            {
                "Negated" "0"
                "TeamNum" "2"
                "targetname" "filter_teleportmid"
            }
            
            trigger_teleport
            {
                "targetname" "trigger_midteleporter"
                "target" "midtp_destination"
                "filtername" "filter_teleportmid"
                "spawnflags" "1"
                "mins" "-50 -50 -50"
                "maxs" "50 50 50"
                "origin" "-141.013794 -5074.305176 225.031311"
            }
            info_teleport_destination
            {
                "targetname" "midtp_destination"
                "origin" "-146.550552 1911.998413 517.315063"
            }
            logic_relay
            {
            "targetname" "midteleporter_relay"
            "OnTrigger" "trigger_midteleporter,toggle,,0,-1"
            }
			prop_dynamic
            {        
                    targetname "props_dynamic"
                    Model "models/buildables/teleporter.mdl"
                    "angles" "0 0 0"
                    "origin" "-141.013794 -4882 158"
                    "modelscale" "1"
            }
	}
	}
	ExtendedUpgrades [$SIGSEGV]
	{
		upgrade
		{
			Name "+20 Max Health per tick" // Custom name of the upgrade displayed on the menu. If absent, uses the attribute localized name instead
