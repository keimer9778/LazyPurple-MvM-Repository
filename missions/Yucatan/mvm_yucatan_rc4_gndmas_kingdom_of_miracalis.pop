	//==========================
	//			Wave 6
	//==========================
	Wave
	{
		StartWaveOutput
		{
			Target wave_dualbomb_start
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		InitWaveOutput
		{
			Target gamerules
			Action RunScriptCode
			Param "EntFire(`wave_dualbomb_initial`, `Trigger`)
			EntFire(`wav_chime`, `Kill`)
			EntFire(`wav_torgue`, `Kill`)
			EntFire(`trg_nuke`, `Kill`)
			EntFire(`trg_time`, `Kill`)
			EntFire(`br_gr_nuke`, `Kill`)
			EntFire(`br_red_nuke`, `Enable`)
			EntFire(`br_gr_time`, `Kill`)
			EntFire(`br_red_time`, `Enable`)
			EntFire(`trgmult_scream`, `Kill`)

			local ent = Entities.FindByClassname(null, `tf_objective_resource`)
			if (ent)
			{
				NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `(Grandmaster) Kingdom of Miracalis`)
			}

			if (!(`timer_ment` in getroottable()))
			{
				IncludeScript(`timer_ment`, getroottable());
			}

			local timer = SpawnEntityFromTable(`logic_relay`,
			{
				targetname = `wave_timer_end`
			});

			timer.ValidateScriptScope();
			local scope = timer.GetScriptScope();

			scope.TimerEnd <- function()
			{
				EntFire(`boss_deploy_relay`, `Trigger`)
				EntFire(`rel_nuke_effects`, `Trigger`)
				PrecacheSound(`misc/doomsday_missile_explosion.wav`);
				for (local i = 1, player; i <= MaxClients().tointeger(); i++)
				{
					if ((player = PlayerInstanceFromIndex(i)) != null && !IsPlayerABot(player))
					{
						EmitSoundEx({
							sound_name = `misc/doomsday_missile_explosion.wav`
							entity = player
							filter_type = 4
							flags = 4
						});
					}
				}
			}

			timer.ConnectOutput(`OnTrigger`, `TimerEnd`);
			TimerMent.BossDeployName = `wave_timer_end`;
			TimerMent.MaxTime = 270;
			ClientPrint(null, 3, `\x07FF3F3FYou have 4 minutes and 30 seconds to complete the wave...`);
			"
		}
		Sound "mvm\ambient_mp3\mvm_siren.mp3"

