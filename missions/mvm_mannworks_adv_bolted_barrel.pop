// mvm_mannworks
// normal skill

#base robot_giant.pop
#base robot_standard.pop

population
{
	StartingCurrency 450
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom No

	Templates
{
	T_TFBot_Giant_Pyro_Flaregun_Super
			{
			Class Pyro
			Skill Expert
			Name "Super Flare Pyro"
			Classicon pyro_flare_giant
			Health 10000
			Item "The Flare Gun"
			WeaponRestrictions SecondaryOnly
			Attributes miniboss
			CharacterAttributes
			{
				"move speed bonus"	0.3
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"override footstep sound set" 6
			}
			ItemAttributes
			{
			ItemName "The Flare Gun"
			    "faster reload rate" 0.1
				"fire rate bonus" 0.1
			}
			}
			
			T_TFBot_Giant_Pyro_Flaregun_Super_2
			{
			Class Pyro
			Skill Expert
			Name "Super Flare Pyro"
			Classicon pyro_flare_giant
			Health 45000
			Item "The Flare Gun"
			WeaponRestrictions SecondaryOnly
			Attributes miniboss
			CharacterAttributes
			{
				"move speed bonus"	0.3
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"override footstep sound set" 6
			}
			ItemAttributes
			{
			ItemName "The Flare Gun"
			    "faster reload rate" 0
				"fire rate bonus" 0
				"damage bonus" 3
			}
			}
}
			
// MISSION: Sentry Buster
	Mission
	{
		Objective DestroySentries
		Where spawnbot
		CooldownTime 30
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

