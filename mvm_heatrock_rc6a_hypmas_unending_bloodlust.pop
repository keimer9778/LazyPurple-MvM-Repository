	Wave
	{
		Explanation [$SIGSEGV]
		{
			Line "{FF0000}THE GATES HAVE OPENED ONCE AGA- {FBECCB}Wait where tf are we?"
			Line "Welcome to the mission that preceded {FF0000}GRIEF{FBECCB} and was made to be impossible for 10 players."
			Line "{FBECCB}This version is compressed down to remove filler sub waves, adjust sub waves, and have both VScript and Rafmod support."
			Line "{FBECCB}Good luck to you LazyPurple's server!"
		}

		WaitWhenDone	65
		Checkpoint	Yes
		Sound	Announcer.MVM_Manned_Up
		InitWaveOutput
		{
			Target wave_start_relay_ironman
			Action RunScriptCode
			Param "local ent = Entities.FindByClassname(null, `tf_objective_resource`)
			if (ent)
			{
				NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `(Hyper Master) Unending Bloodlust`)
			}
			PrecacheSound(`npc/turret_floor/die.wav`);

			::aga <-
			{
				function OnGameEvent_player_death(params)
				{
					local player = GetPlayerFromUserID(params.userid);
					if (player == null || !player.IsValid() || !player.IsBotOfType(1337))
					{
						return;
					}

					if (player.HasBotTag(`generic_kill_effect`))
					{
						DispatchParticleEffect(`rd_robot_explosion`, player.GetOrigin(), player.GetAngles());
						DispatchParticleEffect(`mvm_tank_destroy`, player.GetOrigin(), player.GetAngles());
						ScreenShake(player.GetOrigin(), 16.0, 9.0, 3.0, -1.0, 0, true);
						for (local i = 1, otherPlayer; i <= MAX_CLIENTS; i++)
						{
							if ((otherPlayer = PlayerInstanceFromIndex(i)) != null && otherPlayer.IsValid())
							{
								EmitSoundEx({sound_name = `npc/turret_floor/die.wav`,
								entity = otherPlayer,
								filter_type = 4})
							}
						}
					}
				}
			}
			__CollectGameEventCallbacks(aga);

			PrecacheSound(`#mentrillum/mvm/music/what_im_made_of.wav`);
			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null)
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/what_im_made_of.wav`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}
		StartWaveOutput
		{
			Target wave_start_relay_ironman
			Action Trigger
		}
		DoneOutput
		{
			Target wave_start_relay_ironman
			Action RunScriptCode
			Param "EntFire(`wave_finished_relay`, `Trigger`)

			for (local i = 1, player; i <= MaxClients().tointeger(); i++)
			{
				if ((player = PlayerInstanceFromIndex(i)) != null)
				{
					EmitSoundEx({
						sound_name = `#mentrillum/mvm/music/what_im_made_of.wav`
						entity = player
						filter_type = 4
						flags = 4
					})
				}
			}"
		}
		WaveSpawn
		{
			Name "1"
			TotalCurrency	100
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			WaitBeforeStarting	0
			WaitBetweenSpawns	10
			Where	spawnbot
