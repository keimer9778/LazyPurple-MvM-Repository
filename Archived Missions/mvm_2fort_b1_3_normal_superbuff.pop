			Skill Expert
			Health 166
			Item "The Razorback"
			MaxVisionRange 3500
		}
	}
	Mission // Engineer
	{
		Objective Engineer  

		InitialCooldown 60
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 6
		CooldownTime 120
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
		}
	}
