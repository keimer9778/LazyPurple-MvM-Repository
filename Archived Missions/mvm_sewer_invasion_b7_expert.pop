						"engineer teleporter build rate multiplier" 0.3
						"engineer sentry build rate multiplier" 0.3
						"mark for death" 1
						"maxammo metal increased" 1.5
						"metal regen" 1.5
						"damage bonus" 5
						"fire rate bonus" 0.5
						"energy weapon no drain" 1
					}
				}
			}
		}


		WaveSpawn
		{
			TotalCurrency 200
			TotalCount 1
			
			WaitForAllSpawned "stage1"
			
			Tank
			{
				Health 25000
				Speed 55
				Name "tankboss"
				StartingPathTrackNode "tank_path_a_1"
				
				OnBombDroppedOutput
				{
					Target boss_deploy_relay
					Action Trigger
				}
			}
		}
		
		
