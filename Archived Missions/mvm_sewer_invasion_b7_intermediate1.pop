		RunForThisManyWaves 3							// It remains active for this many waves.
		CooldownTime 15								// This is the time, in seconds, between when Sniper Missions are allowed to spawn, should their spawning conditions be met.
		DesiredCount 2								// Number of spies to spawn each time this mission's criteria are met.

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Battle
			Health 125
			Item "Festive Frontier Justice"				
			Item "TTG Max Pistol - Poker Night"
			Item "Festive Wrench 2011"
			Item "Industrial Festivizer"				
