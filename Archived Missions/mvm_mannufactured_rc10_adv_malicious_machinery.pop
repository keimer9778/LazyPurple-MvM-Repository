	// W1: Let players experience the map, some basic bots with different behaviors.
	// Subwave 1
	// - GATEBOT Bat Scouts (larger crowd)
	// - GATEBOT Giant Charged Soldier (slight delay)

	// Subwave 2
	// - GATEBOT Soldiers (modest crowds)
	// - Soldiers (modest crowds)

	// Subwave 3
	// - Giant Rapid Fire Demo
	// - Shotgun Heavies
	// - Bat Scouts
	Wave
	{
		InitWaveOutput
		{
			Target bignet
			Action RunScriptCode
			Param "SetMissionName(`Malicious Machinery`)
			EntFire(`relay_tank_surprise`,`Disable`)"
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
		
		WaveSpawn // This bot puts the bomb on the field for gatebot to pick up after the gate has been capped.
		{
			Name "Support"
			Where spawnbot
			WaitBeforeStarting 3
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			TotalCurrency 0
			Support Limited
			TFBot
			{
				Template T_TFBot_Heavyweapons_Shotgun
			}
		}
		WaveSpawn
		{
			Name "wave1a"
			Where spawnbot
			WaitBeforeStarting 15
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			TotalCurrency 100
			TFBot
			{
				Template T_TFGateBot_Giant_Soldier_Crit
			}
		}
		WaveSpawn
		{
			Name "wave1a"
			WaitForAllSpawned "wave1a2"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			TotalCurrency 100
			TFBot
			{
				Template T_TFGateBot_Giant_Soldier_Crit
			}
		}
		WaveSpawn
		{
			Name "wave1a2"
			Where spawnbot
			Where spawnbot_upper1_left
			Where spawnbot_upper1_right
			WaitBetweenSpawns 4
			TotalCount 36
			MaxActive 14
			SpawnCount 6
			TotalCurrency 180
			TFBot
			{
				Template T_TFGateBot_Scout_Melee
			}
		}
		WaveSpawn
		{
			Name "wave1b"
			WaitForAllDead "wave1a"
			Where spawnbot
			WaitBetweenSpawns 6
			TotalCount 15
			MaxActive 6
			SpawnCount 3
			TotalCurrency 150
			TFBot
			{
				Class Soldier
				Skill Normal
			}
		}
		WaveSpawn
		{
			Name "wave1b2"
			WaitForAllDead "wave1a2"
			Where spawnbot_upper1_left
			Where spawnbot_upper1_right
			WaitBetweenSpawns 0.5
			TotalCount 12
			MaxActive 4
			SpawnCount 3
			TotalCurrency 120
			TFBot
			{
				Template T_TFGateBot_Soldier_Normal
			}
		}
		WaveSpawn
		{
			Name "wave1c"
			WaitForAllSpawned "wave1b"
			Where spawnbot
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			TotalCurrency 65
			TFBot
			{
				Template T_TFBot_Giant_Demo_RapidFire
			}
		}
		WaveSpawn
		{
			Name "wave1c2"
			WaitForAllSpawned "wave1b2"
			Where spawnbot_upper1_left
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			TotalCurrency 65
			TFBot
			{
				Template T_TFBot_Giant_Demo_RapidFire
			}
		}
		WaveSpawn
		{
			Name "wave1c3"
			WaitForAllDead "wave1b2"
			WaitForAllSpawned "wave1c"
			Where spawnbot
			WaitBeforeStarting 4
