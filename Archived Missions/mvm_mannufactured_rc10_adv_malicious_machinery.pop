// MvM Mannufactured - Malicious Machinery
// Advanced difficulty

// Created by Seelpit - https://steamcommunity.com/profiles/76561198086337571
// Additional assets:
//- "Base" robot templates by Valve
//- Shield Shotgunner custom Logic & Models by Alien31 - https://steamcommunity.com/profiles/76561198130175522
//- Shield Shotgunner custom wavebar icon by Seelpit, based on assets by Alien31

#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop

WaveSchedule
{
	StartingCurrency 850
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom No
	
	Mission
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		InitialCooldown 10
		CooldownTime 45
		BeginAtWave 1
		RunForThisManyWaves 3
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_SentryBuster
			Attributes DisableDodge
			Attributes IgnoreEnemies
		}
	}
	Mission
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		InitialCooldown 20
		CooldownTime 60
		BeginAtWave 4
		RunForThisManyWaves 3
		DesiredCount 1
		TFBot
		{
			Template T_TFBot_SentryBuster
			Attributes DisableDodge
			Attributes IgnoreEnemies
		}
	}
	Mission
	{
		Objective Spy
		Where spawnbot_mission_spy
		InitialCooldown 12
		CooldownTime 40
		BeginAtWave 4
		RunForThisManyWaves 1
		DesiredCount 3
		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Templates
	{
		T_TFGateBot_Soldier_Extended_Battalion_Normal
		{
			Class Soldier
			Name "Extended Backup Soldier"
			ClassIcon soldier_backup

			EventChangeAttributes
			{
				Default
				{
					Tag bot_gatebot 				// having these will cause bots to run towards gates
					Tag nav_prefer_gate1_flank		// having these will cause bots to run towards gates
					BehaviorModifiers push			// having these will cause bots to run towards gates
					Attributes IgnoreFlag 			// having these will cause bots to run towards gates

					Item "The Battalion's Backup"
					Item "MvM GateBot Light Soldier"
					Skill Normal
					Attributes SpawnWithFullCharge
					CharacterAttributes
					{
						"increase buff duration"	9.0
					}
				}
				RevertGateBotsBehavior
				{
					Item "The Battalion's Backup"
					Item "MvM GateBot Light Soldier"
					ItemAttributes               // turn off light hat
					{
						ItemName "MvM GateBot Light Soldier"
						"item style override" 1
					}
					Skill Normal
					Attributes SpawnWithFullCharge
					CharacterAttributes
					{
						"increase buff duration"	9.0
					}
				}
			}
		}
		T_TFGateBot_Pyro_AlwaysFireWeapon_Normal
		{
			Class Pyro

			EventChangeAttributes
			{
				Default
				{
					Tag bot_gatebot 				// having these will cause bots to run towards gates
					Tag nav_prefer_gate1_flank		// having these will cause bots to run towards gates
					BehaviorModifiers push			// having these will cause bots to run towards gates
					Attributes IgnoreFlag 			// having these will cause bots to run towards gates

					Item "MvM GateBot Light Pyro"
					Attributes AlwaysFireWeapon
					Skill Normal
				}
				RevertGateBotsBehavior
				{
					Item "MvM GateBot Light Pyro"
					ItemAttributes               // turn off light hat
					{
						ItemName "MvM GateBot Light Pyro"
						"item style override" 1
					}
					Attributes AlwaysFireWeapon
					Skill Normal
				}
			}
		}
		T_TFGateBot_Giant_Soldier_Crit
		{
			Class Soldier
			Name "Giant Charged Soldier"
			Health 3800
			ClassIcon soldier_crit
			EventChangeAttributes
			{
				Default
				{
					BehaviorModifiers Push
					Tag bot_gatebot
					Tag nav_prefer_gate1_flank
					
					Tag bot_giant
					Skill Normal
					WeaponRestrictions PrimaryOnly
					Attributes AlwaysCrit
					Attributes MiniBoss
					Attributes HoldFireUntilFullReload
					Item "The Original"
					Item "MvM GateBot Light Soldier"
					ItemAttributes
					{
						ItemName "The Original"
						"faster reload rate" 0
						"fire rate penalty" 2
						"Projectile speed increased" 0.5
					}
					CharacterAttributes
					{
						"move speed bonus" 0.5
						"damage force reduction" 0.4
						"airblast vulnerability multiplier" 0.4
						"override footstep sound set" 3
					}
				}
				RevertGateBotsBehavior
				{
					Tag bot_giant
					Skill Normal
					WeaponRestrictions PrimaryOnly
					Attributes AlwaysCrit
					Attributes MiniBoss
					Attributes HoldFireUntilFullReload
					Item "The Original"
					Item "MvM GateBot Light Soldier"
					ItemAttributes
					{
						ItemName "The Original"
						"faster reload rate" 0
						"fire rate penalty" 2
						"Projectile speed increased" 0.5
					}
					ItemAttributes
					{
						ItemName "MvM GateBot Light Soldier"
						"item style override" 1
					}
					CharacterAttributes
					{
						"move speed bonus" 0.5
						"damage force reduction" 0.4
						"airblast vulnerability multiplier" 0.4
						"override footstep sound set" 3
					}
				}
			}
		}
		
		// Giant Shotgun Heavy with weaker (fairer) Shotgun and a shield, reducing damage taken from the front.
		T_TFBot_Giant_Heavyweapons_Shotgun_Shield
		{
			Template T_TFBot_Giant_Heavyweapons // Giant Heavy base: 5000 hp, half speed, kb reduction, MaxVisionRange 1200
			Name "Giant Shield Shotgun Heavy"
			Skill Normal // Reduced skill for fairer aiming
			WeaponRestrictions SecondaryOnly // Necessary to make shield work
			Item "The Eliminators Safeguard"
			ClassIcon heavy_shotgun_shield
			Tag shotgunner_shield
			Tag bot_giant
			ItemAttributes
			{
				ItemName "TF_WEAPON_SHOTGUN_HWG" // Weaker and less accurate shotgun than regular giant variant
				"fire rate penalty" 2
				"faster reload rate" 0.1
				"bullets per shot bonus" 3
				"damage penalty" 0.5
				"spread penalty" 1.5 // More likely to deal chip damage, but cannot one-tap lighter classes
			}
			ItemAttributes
			{
				ItemName "The Eliminators Safeguard"
				"item style override" 1
			}
		}
		// Variant that fires more clips very quickly. Aim is still modest to prevent excessive power.
		T_TFBot_Giant_Heavyweapons_Shotgun_Shield_Burst
		{
			Template T_TFBot_Giant_Heavyweapons // Giant Heavy base: 5000 hp, half speed, kb reduction, MaxVisionRange 1200
			Name "Giant Shield Burst Shotgun Heavy"
			Skill Normal // Reduced skill for fairer aiming
			WeaponRestrictions SecondaryOnly // Necessary to make shield work
			Item "The Eliminators Safeguard"
			ClassIcon heavy_shotgun_shield_burst
			Tag shotgunner_shield
			Tag bot_giant
			ItemAttributes
			{
				ItemName "TF_WEAPON_SHOTGUN_HWG" // Weaker and less accurate shotgun than regular giant variant
				"auto fires when full" 1
				"auto fires full clip" 1 // Trick: make the Shotgun behave like the Beggar's Bazooka.
											// Bot will hold attack to load shells, then fires when clip is full, and fires full clip until empty.
				"fire rate bonus" 0.15
				"faster reload rate" 0.75
				"bullets per shot bonus" 3
				"damage penalty" 0.5
				"spread penalty" 1.5 // More likely to deal chip damage, but cannot one-tap lighter classes
			}
			ItemAttributes
			{
				ItemName "The Eliminators Safeguard"
				"item style override" 1
			}
		}
