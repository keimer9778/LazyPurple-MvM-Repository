///////////////////////////////////////////////////////////////////////////
// shoot the fuckin tank man...
///////////////////////////////////////////////////////////////////////////

#base robot_giant.pop
#base robot_standard.pop


WaveSchedule
{

	StartingCurrency 20000
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no

//WAVE 1 /////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////////////////////////

	Wave
	{
		StartWaveOutput
		{
			Target wave_start
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		
		Checkpoint Yes

		WaveSpawn //
		{
			Name "w1_01"
			Where spawnbot
			TotalCount 1
			SpawnCount 1
			MaxActive 1
			TotalCurrency 300
			WaitBetweenSpawns 5
			FirstSpawnOutput                                                                                                                     
			{
				Target boss_spawn_relay                  
				Action Trigger
			}

			Tank
			{
				Health 300000
				Speed 1
				Name "tank_w1_01"
				StartingPathTrackNode "tank_path_a_1"

				OnKilledOutput   
				{
					Target boss_dead_relay
					Action Trigger
				}
				
				OnBombDroppedOutput 
				{
					Target boss_deploy_relay
					Action Trigger
				}

			}	

		}
	}
}
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
