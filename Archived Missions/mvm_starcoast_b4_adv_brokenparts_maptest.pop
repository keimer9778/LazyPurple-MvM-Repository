#base robot_giant.pop
#base robot_standard.pop

// Bot Spawns
// spawnbot_ocean_shallow, spawnbot_ocean_deep: middle spawn
// spawnbot_pier, spawnbot_pier_flank_shallow, spawnbot_pier_flank_deep: left spawn
// spawnbot_island: right spawn
// Tank Spawnpoints
// tankboss_ocean: middle tank spawn
// tankboss_pier: left-side tank spawn
// Tank Path Relays
//

WaveSchedule
{

	StartingCurrency 1500
	RespawnWaveTime 3
	CanBotsAttackWhileInSpawnRoom no

	// Rafmod specific stuff 
	// Commented with [$SIGSEGV] to prevent them from doing anything if the server is not running rafmod.
	// Increasing the robot limit
	RobotLimit 26 [$SIGSEGV]
	// This is required if you want to set the RobotLimit above 26. breaks freezecams
	AllowBotExtraSlots 1 [$SIGSEGV]
	// For slightly better pacing, and replacing certain subwaves that immediately respawn upon being wiped out
	SendBotsToSpectatorImmediately 1 [$SIGSEGV]
	// Enable halloween-restricted cosmetics while also disabling the thriller taunt
	ForceHoliday 8 [$SIGSEGV]
	NoThrillerTaunt 1 [$SIGSEGV]

	// BOT TEMPLATES
	Templates
	{
		T_TFBot_Giant_Heavyweapons_HealOnKill_Fixed
		// 5500 HP, Tungsten Toque, Deflector.
		{
			Class Heavyweapons
			Name "Giant Heal-on-Kill Deflector"
			ClassIcon heavy_deflector_healonkill
			Skill Expert
			Health 5500
			Item "The Tungsten Toque"
			Item "Deflector"
			WeaponRestrictions PrimaryOnly
			MaxVisionRange 1600
			Attributes MiniBoss

			ItemAttributes
			{
				ItemName "Deflector"
				"damage bonus" 1.2
				"attack projectiles" 2
				"heal on kill" 5000
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.3
				"airblast vulnerability multiplier" 0.3
				"rage giving scale" 0.9
				"override footstep sound set" 2
			}
		}
		T_TFBot_Giant_Soldier_BurstFire_Type_C
		// Middleground between Bigrock and Mannhattan burstfire soldier. no damage bonus.
		{
			Class Soldier
			Name "Giant Burst Fire Soldier"
			ClassIcon soldier_burstfire
			Health 4000
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Attributes MiniBoss
			Attributes HoldFireUntilFullReload
			ItemAttributes
			{
				ItemName "TF_WEAPON_ROCKETLAUNCHER"
				"faster reload rate" 0.5
				"fire rate bonus" 0.15
				"clip size upgrade atomic" 5.0
			}
			CharacterAttributes
			{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
				"Projectile speed increased" 0.775
			}
		}
		T_TFBot_Chief_Soldier_v2
		// Swaped out Tyrant's Helm for Tyrantium Helm and give him an aussie RL
		{
			Class Soldier
			Skill Expert
			WeaponRestrictions PrimaryOnly
			Name "Sergeant Crits"
			ClassIcon soldier_sergeant_crits
			Health 60000
			Scale 2
			Item "Upgradeable TF_WEAPON_ROCKETLAUNCHER"
			Item "Tyrantium Helmet"
			Attributes MiniBoss
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			Attributes AlwaysCrit
			ItemAttributes
			{
				ItemName "Upgradeable TF_WEAPON_ROCKETLAUNCHER"
				"item style override" 1
				"is australium item" 1
				"damage bonus" 2.0
				"faster reload rate" 0.6
				"fire rate bonus" 0.2
				"clip size upgrade atomic" 7.0
				"Projectile speed increased" 1.3
			}
			CharacterAttributes
			{
				"health regen" 250
				"move speed bonus"	0.5
				"damage force reduction" 0.3
				"airblast vulnerability multiplier" 0.3
				"override footstep sound set" 3
				"airblast vertical vulnerability multiplier" 0.1
				"rage giving scale" 0.1
			}
		}
	}

	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 20
		Where spawnbot_random
		BeginAtWave 1
		RunForThisManyWaves 9

		CooldownTime 20            

		TFBot
		{
			Template T_TFBot_SentryBuster
			Attributes DisableDodge
			Attributes IgnoreEnemies
			Tag bot_sentrybuster
			Tag bot_giant
		}
	}
	Mission // Spy - wave 1
	{
		Objective Spy  

		InitialCooldown 45
		Where spawnbot_random
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 30
		DesiredCount 4

		TFBot
		{
			Class Spy
			Skill Easy
			Name Spy
		}
	}
	Mission // Sniper - wave 1
	{
		Objective Sniper

		InitialCooldown 60
		Where spawnbot_random
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Class Sniper
			Skill Hard
			Name Sniper
			MaxVisionRange 3000
		}
	}
	Mission // Sniper - wave 5
	{
		Objective Sniper

		InitialCooldown 30
		Where spawnbot_random
		BeginAtWave 5
		RunForThisManyWaves 1
		CooldownTime 15
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
			Item "The Razorback"
			Name "Razorback Sydney Sniper"
			MaxVisionRange 3000
		}
	}

	Mission // Engineer - wave 1-3
	{
		Objective Engineer  

		InitialCooldown 30
		Where spawnbot_random
		BeginAtWave 1
		RunForThisManyWaves 3
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_random
			TeleportWhere spawnbot_island
			TeleportWhere spawnbot_ocean_shallow
			TeleportWhere spawnbot_ocean_deep
			TeleportWhere spawnbot_pier
			TeleportWhere spawnbot_pier_flank_shallow
			TeleportWhere spawnbot_pier_flank_deep
		}
	}
	Mission // Engineer - wave 4
	{
		Objective Engineer  

		InitialCooldown 30
		Where spawnbot_random
		BeginAtWave 4
		RunForThisManyWaves 1
		CooldownTime 11
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot_random
			TeleportWhere spawnbot_island
			TeleportWhere spawnbot_ocean_shallow
			TeleportWhere spawnbot_ocean_deep
			TeleportWhere spawnbot_pier
			TeleportWhere spawnbot_pier_flank_shallow
			TeleportWhere spawnbot_pier_flank_deep
		}
	}
	Mission // Engineer - wave 5
	{
		Objective Engineer  

		InitialCooldown 30
		Where spawnbot_random
		BeginAtWave 5
		RunForThisManyWaves 1
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			Name "Overclocked Engineer"
			ClassIcon engineer_hyper
			Attributes AlwaysCrit
			Item "Clockwerk's Helm"

			TeleportWhere spawnbot_random
			TeleportWhere spawnbot_island
			TeleportWhere spawnbot_ocean_shallow
			TeleportWhere spawnbot_ocean_deep
			TeleportWhere spawnbot_pier
			TeleportWhere spawnbot_pier_flank_shallow
			TeleportWhere spawnbot_pier_flank_deep

			ItemAttributes
			{
				ItemName TF_WEAPON_WRENCH
				"engy building health bonus" 2
				"fire rate bonus" 0.75
				"Construction rate increased" 1.5
				"engineer teleporter build rate multiplier" 1.33
			}

			CharacterAttributes
			{
				"move speed bonus" 1.5
			}
		}
	}
	
	//WAVE 1
	//Currency 1300
	Wave
	{
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput					
		{
			Target wave_finished_relay
			Action trigger
		}

		// Spy mission - 4 active	
		// Sniper mission - 2 active	

		WaveSpawn //WAVE 01a: 36 total, 18 active, Scout (bonk) + crit soldier 
		{
			Name "wave01a"
