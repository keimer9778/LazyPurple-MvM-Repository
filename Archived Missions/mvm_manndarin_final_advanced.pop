//Custom population file for mvm_manndarin_final made by Geosus Theodore Foxworth.
//Thanks to Valve and the MvM Thread on Facepunch for reference.

//Version 1.0 

#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
	StartingCurrency 500
	RespawnWaveTime 5
	FixedRespawnWaveTime no
	CanBotsAttackWhileInSpawnRoom no
	AddSentryBusterWhenDamageDealtExceeds 3000
	AddSentryBusterWhenKillCountExceeds 15
	Advanced 1

Templates
	{
	T_TFbot_MachinaSniper
		{
		Class Sniper
		Name "Machina Sniper"
		ClassIcon sniper_d
		Skill Expert
		Item "The Machina"
		Item "The Deus Specs"
		WeaponRestrictions PrimaryOnly
		CharacterAttributes
			{
			"sniper charge per sec" 0
			"sniper no headshots" 1
			"damage bonus" 4
			"aiming knockback resistance" 0.5
			"aiming no flinch" 1
			"dmg from sentry reduced" 0
			"dmg taken from blast reduced" 0.25
			"dmg penalty vs players" .5
			}
		}
		
	T_TFbot_EarnerSpy
		{
		Class Spy
		Skill Expert
		Item "The Big Earner"
		Item "The Made Man"
		Item "The Enforcer"
		Item "Cosa Nostra Cap"
		Health 150
		}

	T_TFbot_ZombiePyro
		{
		Class Pyro
		Skill Hard
		Item "The Neon Annihilator"
		WeaponRestrictions MeleeOnly
		Tag nav_prefer_flank_middle
		CharacterAttributes
			{
			"damage force reduction" 0.5
			"fire rate bonus" 1.2
			"dmg from sentry reduced" 0.75
			"move speed bonus" 0.8
			"dmg from melee increased" 1.2
			}
		}

	T_TFbot_GasJockey
			{
			Class Pyro
			Name "Gas Jockey"
			Skill Hard
			Item "The Powerjack"
			Item "The Attendant"
			WeaponRestrictions MeleeOnly
			CharacterAttributes
				{
				"move speed bonus" 1.1
				"dmg taken from bullets increased" 1.1
				}
			}

	T_TFbot_ButcherScout
			{
			Name "Butcher Scout"
			Class Scout
			Skill Expert
			WeaponRestrictions SecondaryOnly
			Item "The Flying Guillotine"
			CharacterAttributes
				{
				"effect bar recharge rate increased" 0.05
				}
			}

	T_TFbot_Giant_UberMedic
			{
			Class Medic
			Name "Uber Medic X"
			ClassIcon medic_uber
			Skill Expert
			Scale 1
			Health 2000
			CharacterAttributes
				{
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.3
				}
			}
	}	

Mission // sentry buster 1
	{
		Objective DestroySentries

		InitialCooldown 30
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 8

		CooldownTime 30        

            TFBot
			{
				Template T_TFbot_SentryBuster
            	}
	}

Mission // pisssniper
	{
		Objective Sniper

		InitialCoolDown 20
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 1
		DesiredCount 2

		CooldownTime 10

