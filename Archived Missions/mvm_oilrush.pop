#base robot_standard.pop
#base robot_giant.pop

//Mission name:
// return -1 *nrm

//POPULATOR/SETTINGS///////////////////////////////////////////////////////////////
MVM_OILRUSH{
	StartingCurrency 700
	RespawnWaveTime 7
    CanBotsAttackWhileInSpawnRoom no
	
	AddSentryBusterWhenDamageDealtExceeds 5000
	AddSentryBusterWhenKillCountExceeds 32

//TEMPLATES////////////////////////////////////////////////////////////////////////	
	Templates{
		T_TFBot_Giant_Soldier_Slow{
			Class Soldier
			Name "Giant Charged Soldier"
			ClassIcon soldier_giant
			Skill Normal
			Health 3800
			
			Item "The Original"
			WeaponRestrictions PrimaryOnly
			Attributes MiniBoss

			ItemAttributes{
				ItemName "The Original"
				"faster reload rate" 0.2
				"fire rate bonus" 2
				"Projectile speed increased" 0.5
			}
			CharacterAttributes{
				"move speed bonus"	0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
			}
		}
		T_TFBot_Giant_Pyro_AlwaysFire{
			Class Pyro
			Name "Giant Pyro"
			ClassIcon pyro_giant
			Skill Easy
			Health 3000

			WeaponRestrictions PrimaryOnly

			Attributes MiniBoss
			Attributes AlwaysFireWeapon

			CharacterAttributes{
				"move speed bonus"	0.5
				"damage force reduction" 0.6
				"airblast vulnerability multiplier" 0.6
				"override footstep sound set" 6
			}
		}
	}
	
//MISSIONS/////////////////////////////////////////////////////////////////////////
	Mission{
		Objective DestroySentries

		InitialCooldown 30
		Where spawnbot
		
		BeginAtWave 1
		RunForThisManyWaves 6

		CooldownTime 40            

        TFBot{
			Template T_TFBot_SentryBuster
		}
	}

//WAVES////////////////////////////////////////////////////////////////////////////
	Wave{
	  	StartWaveOutput{
	        Target wave_start_event
	        Action Trigger
	    }
	    DoneOutput{
	        Target wave_end_event
	        Action trigger
	    }
		
		WaveSpawn{
			Name "Wave01_scout_melee"
			Where spawnbot
			
			TotalCount 20
			MaxActive 8
			SpawnCount 4

			WaitBeforeStarting .5
			WaitBetweenSpawns 5
			
			TotalCurrency 200   
			TFBot{
					Template T_TFBot_Scout_Melee
				}
			}
		WaveSpawn{
			Name "Wave01_hw_champ"
			Where spawnbot
			
			TotalCount 30
			MaxActive 5
			SpawnCount 1
			
			WaitForAllDead "Wave01_scout_melee"
			WaitBeforeStarting 5
			WaitBetweenSpawns .7
			
			TotalCurrency 300   

			RandomChoice{
				TFBot{
					Template T_TFBot_Heavyweapons_Heavyweight_Champ
				}
				TFBot{
					Template T_TFBot_Heavyweapons_Heavyweight_Champ_Fast
				}
			}
		}
	}
	Wave{
		StartWaveOutput{
	        Target wave_start_event
	        Action Trigger
	    }
	    DoneOutput{
	        Target wave_end_event
	        Action trigger
	    }

		WaveSpawn{
			Name "Wave02_giant_soldier_start"
			Where spawnbot
			
			TotalCount 1
			SpawnCount 1
			
			WaitBeforeStarting .5
			
			TotalCurrency 250

			TFBot{
				Template T_TFBot_Giant_Soldier_Slow
			}
		}
		WaveSpawn{
			Name "Wave01_blast"
			Where spawnbot
			
			TotalCount 40
			MaxActive 4
			SpawnCount 4
			
			WaitForAllDead "Wave02_giant_soldier_start"
			WaitBeforeStarting 3
			WaitBetweenSpawns 6
			
			TotalCurrency 300

			RandomChoice{
				TFBot{
					Class Demoman
				}
				TFBot{
					Class Soldier
				}
			}
		}
		WaveSpawn{
			Name "Wave02_giant_soldier_last"
			Where spawnbot
			
			TotalCount 1
			SpawnCount 1
			
			WaitForAllSpawned "Wave01_blast"
			WaitBeforeStarting 6
			
			TotalCurrency 250

			TFBot{
				Template T_TFBot_Giant_Soldier_Slow
			}
		}
	}
	Wave{
		StartWaveOutput{
	        Target wave_start_event
	        Action Trigger
	    }
	    DoneOutput{
	        Target wave_end_event
	        Action trigger
	    }

		WaveSpawn{
			Where spawnbot
			
			TotalCount 6
			MaxActive 6
			SpawnCount 2
			
			WaitForAllDead "Wave02_giant_soldier_start"
			WaitBeforeStarting 12
			WaitBetweenSpawns 25
			
			Support 1

			TotalCurrency 50

			RandomChoice{
				TFBot{
					Class Demoman
				}
				TFBot{
					Class Soldier
				}
			}
		}
		WaveSpawn{
			Name "Wave03_giant_pyro"
			Where spawnbot

			TotalCount 2
			MaxActive 2
			SpawnCount 1
			
			WaitBeforeStarting 40
			WaitBetweenSpawns 30
			
			TotalCurrency 300

			TFBot{
				Template T_TFBot_Giant_Pyro_AlwaysFire
			}
		}

		WaveSpawn{
			TotalCount 1
			SpawnCount 1

			TotalCurrency 450

			Tank{
				Health 8000

				OnBombDroppedOutput{
					Target deploy_event
					Action Trigger   
				}
			}
		}
	}
	Wave{
		StartWaveOutput{
	        Target wave_start_event
	        Action Trigger
	    }
	    DoneOutput{
	        Target wave_end_event
	        Action trigger
	    }

		WaveSpawn{
			Name "Wave04_giant_heavy_uber"
			Where spawnbot
			
			TotalCount 4
			SpawnCount 1
			
			WaitBeforeStarting 30
			WaitBetweenSpawns 20
			
			TotalCurrency 400

			Squad{
				TFBot{
					Template T_TFBot_Giant_Heavyweapons
				}
				TFBot{
					Template T_TFBot_Medic
				}
			}
		}
		WaveSpawn{
			Name "Wave04_pyro"
			Where spawnbot
			
			TotalCount 20
			MaxActive 8
			SpawnCount 4
			
			WaitBeforeStarting .5
			WaitBetweenSpawns 5
			
			TotalCurrency 400

			TFBot{
				Class Pyro
			}
		}
	}
	Wave{
		StartWaveOutput{
	        Target wave_start_event
	        Action Trigger
	    }
	    DoneOutput{
	        Target wave_end_event
	        Action trigger
		}
		
		WaveSpawn{
			Name "Wave05_giant_pyro_uber"
			Where spawnbot
			
			TotalCount 4
			SpawnCount 1
			
			WaitBeforeStarting .5
			WaitBetweenSpawns 10
			
			TotalCurrency 250

			Squad{
				TFBot{
					Template T_TFBot_Giant_Pyro_AlwaysFire
				}
				TFBot{
					Template T_TFBot_Medic
				}
			}
		}
		WaveSpawn{
			Name "Wave05_giant_soldier"
			Where spawnbot
			
			TotalCount 3
			SpawnCount 1
			
			WaitForAllDead "Wave05_giant_pyro_uber"
			WaitBeforeStarting 20
			WaitBetweenSpawns 12
			
			TotalCurrency 250

			Squad{
				TFBot{
					Template T_TFBot_Giant_Soldier_Crit
				}
			}
		}
		WaveSpawn{
			Name "Wave05_giant_heavy_uber"
			Where spawnbot
			
			TotalCount 2
			SpawnCount 1
			
			WaitBeforeStarting 50
			WaitBetweenSpawns 20
			
			TotalCurrency 300

			Squad{
				TFBot{
					Template T_TFBot_Giant_Heavyweapons
				}
				TFBot{
					Template T_TFBot_Medic
				}
			}
		}
		WaveSpawn{
			TotalCount 1
			SpawnCount 1
			
			WaitBeforeStarting 40
			
			TotalCurrency 400

			Tank{
				Health 20000
				Skin 1

				OnBombDroppedOutput{
					Target deploy_event
					Action Trigger   
				}
			}
		}
	}
}