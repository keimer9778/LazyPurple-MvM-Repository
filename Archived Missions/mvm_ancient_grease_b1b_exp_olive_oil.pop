///////////////////////////////////////////////////////////////////////////
//ENGINEER MISSIONS
///////////////////////////////////////////////////////////////////////////

	Mission //Engi teleport wave 1-2
	{
		Objective Engineer  

		InitialCooldown 20
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 2
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot
			TeleportWhere flankers
			Attributes TeleportToHint
			Health 600
		}
	}
	
