#base robot_giant.pop
#base robot_standard.pop


WaveSchedule
{

	StartingCurrency 20000
	RespawnWaveTime 5
	CanBotsAttackWhileInSpawnRoom no

//WAVE 1 /////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////////////////////////

	Wave
	{
		StartWaveOutput
		{
			Target wave_start
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action trigger
		}
		
		Checkpoint Yes

		WaveSpawn //
		{
			Name "w1_01"
			Where spawnbot
			TotalCount 1
			TotalCurrency 300

			TFBot
			{
				Class Heavyweapons
				Name "Prometheus"
				ClassIcon heavy_fist_nys_giant
				Skill Expert
				Health 300000
				WeaponRestrictions MeleeOnly
				MaxVisionRange 1
				Attributes MiniBoss
				Attributes UseBossHealthBar
				CharacterAttributes
				{
					"move speed bonus"	0.1
					"damage force reduction" 0.0
					"airblast vulnerability multiplier" 0.0
					"override footstep sound set" 2
				}
			}	

		}
	}
}
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
