#base bubble_medium_robot_kmlp.pop
#base bubble_medium_standard_robot_kmlp.pop
#base bubble_giant_robot_kmlp.pop
#base daddy_robot_kmlp.pop

WaveSchedule
{

	StartingCurrency 0
	RespawnWaveTime 0
	FixedRespawnWaveTime	1
	CanBotsAttackWhileInSpawnRoom no
	Advanced	1

	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	//WAVE 1

	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes

		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_complete_relay
			Action	Trigger
		}

		/////////////////////////////////////////////PHASE 1
		WaveSpawn
		{
			Name	PHASE1

			TotalCurrency	0
			TotalCount	5

			WaitBeforeStarting	10
			WaitBetweenSpawns	1

			SpawnCount	1

			Where	superultramega

			Squad
			{
				TFBot
				{
					Template	kmlp_soldier_conch_capital_crit
				}
			}
		}

		/////////////////////////////////////////////PHASE 2
		WaveSpawn
		{
			Name	PHASE2

			TotalCurrency	0
			TotalCount	2
			MaxActive	2

			WaitForAllDead	PHASE1
			WaitBeforeStarting	10
			WaitBetweenSpawns	60

			SpawnCount	1

			Where	superultramega

			Squad
			{
				TFBot
				{
					Template	kmlp_soldier_superultramega_chadd
				}
			}
		}

		WaveSpawn
		{
			Support	1

			Name	PHASE2S

			TotalCurrency	0
			TotalCount	21
			MaxActive	10

			WaitForAllDead	PHASE1
			WaitBeforeStarting	0
			WaitBetweenSpawns	1

			SpawnCount	1

			RandomSpawn	1
			Where	left
			Where	right

			RandomChoice
			{
				TFBot
				{
					Template	kmlp_heavy
				}
				TFBot
				{
					Template	kmlp_heavy_crit
				}
			}
		}

		WaveSpawn
		{
			Support	1

			Name	PHASE2S

