	//Wave 1

	wave
	{
		waitwhendone	65
		checkpoint	yes

		startwaveoutput
		{
			target	wave_start_relay_max
			action	trigger
		}
		doneoutput
		{
			target	wave_complete_relay
			action	trigger
		}

		/////////////////////////////////////////////Isolated
		wavespawn
		{
			support	1

			totalcount	1

			waitbeforestarting	0
			waitbetweenspawns	1

			maxactive	1
			spawncount	1

			where	put_bomb_carrier_here

			randomchoice
			{
				squad
				{
					tfbot
					{
						template	kmlp_scout_sunonastick
					}
				}
			}
		}

		/////////////////////////////////////////////Phase 1
		wavespawn
		{
			name	phase1

			totalcount	21

			waitbeforestarting	1
			waitbetweenspawns	0.05

			maxactive	21
			spawncount	1

			where	front

			randomchoice
			{
				tfbot
				{
					template	kmlp_demo_samurai_giant_crit
				}
			}
		}

		/////////////////////////////////////////////Phase 2
