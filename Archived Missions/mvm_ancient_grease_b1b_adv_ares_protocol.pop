			Class Spy
			Skill Expert
			Name Spy
		}
	}
///////////////////////////////////////////////////////////////////////////
//ENGINEER MISSIONS
///////////////////////////////////////////////////////////////////////////

	Mission //Engi teleport wave 1-7
	{
		Objective Engineer  

		InitialCooldown 40
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 7
		CooldownTime 45
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
			TeleportWhere spawnbot
			TeleportWhere flankers
			Attributes TeleportToHint
			Health 600
		}
	}

