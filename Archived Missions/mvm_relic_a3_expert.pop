//Difficulty: Expert

#base robot_giant.pop
#base robot_standard.pop
#base robot_faux.pop

WaveSchedule
{
	StartingCurrency 450
	RespawnWaveTime 7
	FixedRespawnWaveTime Yes
	CanBotsAttackWhileInSpawnRoom no
	Advanced 1


// Missions
	
	Mission // Sentry Busters
	{
		Objective DestroySentries
		Where spawnbot_bomber
		InitialCooldown 45
		CooldownTime 30
		BeginAtWave 1
		RunForThisManyWaves 6
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	
	Mission // Spy
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 15
		CooldownTime 10
		DesiredCount 15
		
		TFBot
		{
			Template T_TFBot_Spy_Fast
		}
	}
	
		// Sniper
	
	Mission // Sydney Sniper
	{
		Objective Sniper
		Where spawnbot
