	Wave // Wave 1
    {
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }
           
        DoneOutput                 
        {
            Target wave_finished_relay
            Action trigger
        }
       
        WaitWhenDone 60
        Checkpoint Yes
       
