///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

//WAVE RELAYS
//wave_start_relay (default bomb mode - Bomb resets after 3 seconds)
//wave_start_relay_ironman (bomb resets after being untouched for 12; this is useful for servers without the bomb reset plugin)

///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

//SPAWNBOT NAMES
//NOTE #1: Sniper, Spy, and Sentry Buster bots have NO dedicated spawnpoints. Engineers ARE Supported!
//NOTE #2: You can identify a bot spawn room by the lighting: if you see a room that is almost pitch black, it is a bot spawn room.
//left
//right

//superultramega


//NOTE FOR "spawnbot":
//-Intended for regular, medium, and giant bots

//NOTE FOR "superultramega":
//-Intended for bots with a scale of 15 and below.  If you attempt to spawn a bot with a scale higher than 15, they will likely get stuck.
//-Do NOT spawn supersized bots in superultramega **while** the supersized Tank has not exited its spawning room; bots **will** teleport and get stuck in the walls.

///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

//TANK PATHS (spawns tanks 40% bigger)
//The following paths spawn tanks at the small garages near the bot spawn.
//tank_path_left_1
//tank_path_right_1

///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

//SPECIAL TANK PATHS
////tank_path_supertank_1 (spawns the supersized tank)

///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////
//---------------------Mission File-------------------------
////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////
#base robot_kmlp.pop
#base robot_kmlp_nojump.pop
#base medium_robot_kmlp.pop
#base medium_standard_robot_kmlp.pop
#base giant_robot_kmlp.pop
#base leaders_kmlp.pop
#base capital_kmlp.pop
#base super_ultra_mega_robot_kmlp.pop
#base master_mundy_kmlp.pop

WaveSchedule
{

	StartingCurrency 0
	RespawnWaveTime 0
	FixedRespawnWaveTime	1
	CanBotsAttackWhileInSpawnRoom no
	Advanced	1

	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////////
	//WAVE 1

	Wave
	{
		WaitWhenDone	65
		Checkpoint	Yes

		StartWaveOutput
		{
			Target	wave_start_relay
			Action	Trigger
		}
		DoneOutput
		{
			Target	wave_complete_relay
			Action	Trigger
		}

		/////////////////////////////////////////////PHASE 1

		WaveSpawn
		{
			Name	PHASE1

			TotalCurrency	0
			TotalCount	1
			MaxActive	1

			WaitBeforeStarting	10
			WaitBetweenSpawns	1

			SpawnCount	1

			Where	superultramega

			FirstSpawnWarningSound	"Demoman.MVM_LaughEvil01"
			DoneWarningSound	"Demoman.MVM_PainCrticialDeath04"

			Squad
			{
				TFBot
				{
					ClassIcon	demoknight_gold_giant

					Name	"Super Big Knight"
					Health	42000
					Scale	12
					Skill	Expert

					Class	Demoman

					Attributes	"AlwaysCrit"
					Attributes	"MiniBoss"
					Attributes	"UseBossHealthBar"
					Attributes	"IgnoreFlag"

					ItemAttributes
					{
						ItemName	"the eyelander"
						"fire rate bonus"	0.40
						"melee range multiplier"	5
					}

					CharacterAttributes
					{
						"cancel falling damage"	1
						"airblast vertical vulnerability multiplier"	0.05
						"move speed penalty"	0.35
					}

					Item	"ali baba's wee booties"
					Item	"the splendid screen"
					Item	"the eyelander"

					BehaviorModifiers	Push
				}
			}
		}

		WaveSpawn
		{
			Support	1

			Name	PHASE1S

			TotalCurrency	0
			TotalCount	21

			WaitBeforeStarting	0
			WaitBetweenSpawns	1

			SpawnCount	1

			RandomSpawn	1
			Where	left
			Where	right

			RandomChoice
			{
				TFBot
				{
					Template	kmlp_demo_samurai
				}
				TFBot
				{
					Template	kmlp_demo_eyelander
				}
			}
		}
	}

