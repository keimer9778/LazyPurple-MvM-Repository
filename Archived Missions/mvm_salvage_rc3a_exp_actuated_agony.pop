// Ismac
#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{
    StartingCurrency                      400
    RespawnWaveTime                       5
    CanBotsAttackWhileInSpawnRoom         No 
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  Yes
    Advanced                              1 
    // Wave 1-3 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot_mission_sentry_buster
        BeginAtWave         1
        RunForThisManyWaves 3
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 2 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         2
        RunForThisManyWaves 1
        CooldownTime        90
        DesiredCount        2
        InitialCooldown     45
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    

    // Wave 3 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         3
        RunForThisManyWaves 1
        CooldownTime        50
        DesiredCount        2
        InitialCooldown     45
        TFBot
        {
            Template T_TFBot_Sniper_Sydney_Sleeper
            Skill Normal
        }
    }
    

    // Wave 1 - 1000
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        //  Pyro Reflectors + Uber Medic
        WaveSpawn
        {
            Name "wave1a"
            Where spawnbot_main
            TotalCount 24
            MaxActive 12
            SpawnCount 2
            WaitBetweenSpawns 2
            TotalCurrency 200
            Squad
            {
                FormationSize 200
                ShouldPreserveSquad 1 
                TFBot
                {
                    Class Pyro
                    Skill Expert
                    ClassIcon pyro_reflect_daan
                    Name "Airblast Pyro"
                    Item "The Triclops"
                    Item "The Degreaser"
                    ItemAttributes
                    {
                        ItemName "The Degreaser"
                        "mult airblast refire time" 0.25
                        "airblast pushback scale" 5
                    }
                }
        
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
         WaveSpawn
