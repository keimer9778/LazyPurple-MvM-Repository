// Ismac
#base robot_giant.pop
#base robot_standard.pop


WaveSchedule
{
    StartingCurrency                      600 
    RespawnWaveTime                       6 
    CanBotsAttackWhileInSpawnRoom         No 
    AddSentryBusterWhenKillCountExceeds   15 
    AddSentryBusterWhenDamageDealtExceeds 3000 
    FixedRespawnWaveTime                  No
   

    // Wave 1-8 Sentry Busters
    Mission
    {
        Objective           DestroySentries
        Where               spawnbot_mission_sentry_buster
        BeginAtWave         1
        RunForThisManyWaves 8
        CooldownTime        70
        DesiredCount        1
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_SentryBuster
        }
    }

    // Wave 8 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         8
        RunForThisManyWaves 1
        CooldownTime        45
        DesiredCount        2
        InitialCooldown     30
        TFBot
        {
            Template T_TFBot_Sniper
        }
    }

    // Wave 8 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         8
        RunForThisManyWaves 1
        CooldownTime        90
        DesiredCount        2
        InitialCooldown     45
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    
    // Wave 8 Engineers
    Mission
    {
        Objective           Engineer
        InitialCooldown     90
        Where               spawnbot_flanker_highground
        BeginAtWave         8
        RunForThisManyWaves 1
        CooldownTime        120
        DesiredCount        1
    
        TFBot
        {
            Template T_TFBot_Engineer_Sentry_Tele_Battle
        }
    }

    // Wave 3 Snipers
    Mission
    {
        Objective           Sniper
        Where               spawnbot_mission_sniper
        BeginAtWave         3
        RunForThisManyWaves 1
        CooldownTime        60
        DesiredCount        2
        InitialCooldown     45
        TFBot
        {
            Template T_TFBot_Sniper
        }
    }
    

    // Wave 6 Spies
    Mission
    {
        Objective           Spy
        Where               spawnbot_mission_spy
        BeginAtWave         6
        RunForThisManyWaves 1
        CooldownTime        90
        DesiredCount        2
        InitialCooldown     60
        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    

    // Wave 1 - 700
    Wave
    {

        StartWaveOutput
        {
            Target wave_start_relay 
            Action Trigger
        }

        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }

        // Attack of the Trash Soldiers!
        WaveSpawn
        {
            Name "wave1a" 
            Where spawnbot_main
            TotalCount 24 
            MaxActive 12
            SpawnCount 6
            WaitBeforeStarting 0 
            WaitBetweenSpawns 6
            TotalCurrency 100
            TFBot
            {
                Name "Shovel Soldier"
                ClassIcon soldier_shovel
                Class Soldier
                WeaponRestrictions MeleeOnly
                Skill Normal
                Item "The Helmet Without a Home"
                CharacterAttributes
                {
                    "hand scale" 2
                    "torso scale" 0.75
                    "melee range multiplier" 1.5
                }
            }
        }
        WaveSpawn
        {
            Name "wave1b" 
            WaitForAllDead "wave1a"
            Where spawnbot_flanker_medium
            TotalCount 24 
            MaxActive 12
            SpawnCount 6
            WaitBeforeStarting 0 
            WaitBetweenSpawns 6
            TotalCurrency 200
            TFBot
            {
                Class Soldier
                Skill Normal
            }
        }
        WaveSpawn
        {
            Name "wave1c" 
            WaitForAllDead "wave1b"
            Where spawnbot_flanker_highground
            TotalCount 16
            MaxActive 8
            SpawnCount 8
            WaitBeforeStarting 0 
            WaitBetweenSpawns 8
            TotalCurrency 200
            TFBot
            {
                Class Demoman
                Skill Normal
            }
        }
        WaveSpawn
        {
            Name "wave1d" 
            WaitForAllDead "wave1c"
            Where spawnbot_main
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 0 
            WaitBetweenSpawns 8
            TotalCurrency 100
            TFBot
            {
                Template T_TFBot_Giant_Soldier_RocketShotgun
            }
        }
        WaveSpawn
        {
            WaitForAllDead "wave1c"
            Where spawnbot_flanker_highground
            TotalCount 16
            MaxActive 8
            SpawnCount 8
            WaitBeforeStarting 0 
            WaitBetweenSpawns 8
            TotalCurrency 100
            TFBot
            {
                Class Pyro
                Skill Easy
            }
        }
    }

