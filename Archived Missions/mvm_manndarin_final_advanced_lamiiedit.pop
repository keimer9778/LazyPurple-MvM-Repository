		CharacterAttributes
			{
			"damage force reduction" 0.5
			"fire rate bonus" 1.2
			"move speed bonus" 0.8
			"dmg from melee increased" 1.2
			}
		}

	T_TFbot_GasJockey
			{
			Class Pyro
			Name "Gas Jockey"
			Skill Hard
			Item "The Powerjack"
			Item "The Attendant"
			WeaponRestrictions MeleeOnly
