            {
                Name "tankboss" 
                Health 23000
                Speed 75
                StartingPathTrackNode "tank_path_a_1"
                OnKilledOutput
                {
                    Target boss_dead_relay
                    Action Trigger
                }
        
                OnBombDroppedOutput
