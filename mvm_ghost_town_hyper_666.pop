// Credits to clickin for the infamous click robot templates

WaveSchedule
{

	StartingCurrency		5000
	RespawnWaveTime 		1
	CanBotsAttackWhileInSpawnRoom no

	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 120
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1

		CooldownTime 120            

            TFBot
			{
				Template T_TFBot_SentryBuster
            }
	}
	Mission // Spy - wave 1
	{
		Objective Spy  

		InitialCooldown 180
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 1
		CooldownTime 35
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy_Ninja
			ClassIcon spy_fast
		}
	}	
	Mission // Sniper - wave 1
	{
		Objective Sniper

		InitialCooldown 80
