	{
		StartWaveOutput
			{
				Target wave_start_relay_666
				Action Trigger
			}

		Checkpoint Yes
		
		InitWaveOutput
        	{
            		Target gamerules
            		Action RunScriptCode
            		Param "
                	local ent = Entities.FindByClassname(null, `tf_objective_resource`)
                	if (ent)
                	{
                    		NetProps.SetPropString(ent, `m_iszMvMPopfileName`, `Caliginous Chaos (666)`)
                	}	
            	"
        	}
		
